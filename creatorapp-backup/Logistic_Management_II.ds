			Set_Update_ShipmentPrice_1 as "Set&Update_ShipmentPrice&TotalPrice"
			{
				type =  form
				form = Package

				record event = on add or edit

				on user input of Total_Weight
				{
					actions 
					{
						custom deluge script
						(
											insured_value = ifnull(input.Insured_value,0.0);
										protection_price = ifnull(input.Insurance_Price,0.0);
										extended_address_price = ifnull(input.Extended_Address_Charge,0.0);
										discount = ifnull(input.Discount,0.0);
										// Check shipment type and calculate shipment price
										auto_calc_total_price = Shipment[ID == input.Shipment_Type].Auto_Calculate_Total_Price;
										//if(input.Shipment_Type != null && auto_calc_total_price == true)
										if(input.Shipment_Type != null)
										{
											RealShipment = Shipment[ID == input.Shipment_Type];
											shipment_price = 0.0;
											shipment_unit_price = ifnull(RealShipment.Total_Price,0.0);
											if(RealShipment != null)
											{
												if(RealShipment.Price_Form == "By Weight" && input.Total_Weight > 0.0)
												{
													// calculate shipment price by weight
													shipment_price = input.Total_Weight * shipment_unit_price;
												}
												else if(RealShipment.Price_Form == "By Weight" && input.Total_Weight == 0.0)
												{
													openUrl("#Page:Warning_Message?mensaje=Total Weight field must be greater than zero.","popup window","height=143,width=380");
													//alert "'Total Weight field must be greater than zero.";
												}
											}
											// Update 'Shipment Price' and 'Total Price' field
											input.Shipment_Price = shipment_price;
											input.Total_Price = insured_value + shipment_price + protection_price + extended_address_price - discount;
										}
										/*else
																				{
																					input.Shipment_Price = 0.0;
																					input.Total_Price = 0.0;
																				}*/
						)
					}
				}

			}
			Set_Update_ShippingPrice_ as "Set&Update_ShippingPrice&Total"
			{
				type =  form
				form = Package

				record event = on add or edit

				on user input of Width_in
				{
					actions 
					{
						custom deluge script
						(
											// Load utils params
										insured_value = ifnull(input.Insured_value,0.0);
										protection_price = ifnull(input.Insurance_Price,0.0);
										extended_address_price = ifnull(input.Extended_Address_Charge,0.0);
										discount = ifnull(input.Discount,0.0);
										// Check shipment type for calculate shipment price
										if(input.Shipment_Type != null)
										{
											// Get shipment unit price
											RealShipment = Shipment[ID == input.Shipment_Type];
											shipment_unit_price = ifnull(RealShipment.Total_Price,0);
											// Calculate shipment price if apply for this width param
											shipment_price = 0;
											if(RealShipment != null)
											{
												if(RealShipment.Price_Form == "By Volumetric weight" && input.Volumetric_weight > 0)
												{
													shipment_price = input.Volumetric_weight * shipment_unit_price;
												}
												else if(RealShipment.Price_Form == "By Greater weight")
												{
													if(input.Total_Weight >= input.Volumetric_weight)
													{
														shipment_price = ifnull(input.Total_Weight,0.0) * shipment_unit_price;
													}
													else
													{
														shipment_price = ifnull(input.Volumetric_weight,0.0) * shipment_unit_price;
													}
												}
											}
											// Update shipment price and total price
											input.Shipment_Price = shipment_price;
											input.Total_Price = insured_value + shipment_price + protection_price + extended_address_price - discount;
										}
						)
					}
				}

			}
