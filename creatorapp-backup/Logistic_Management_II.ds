			Calculate_Amount as "Calculate_Amount"
			{
				type =  form
				form = Service

				record event = on add or edit

				on delete row of Payment_Information
				{
					actions 
					{
						custom deluge script
						(
											if(Service_Type != "Package Receipt" && Service_Type != "Locker")
										{
											pay_info_amount = 0.0;
											for each  r in input.Payment_Information
											{
