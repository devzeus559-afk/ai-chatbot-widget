			Disable_DeclaredValue as "Disable_DeclaredValue"
			{
				type =  form
				form = Package

				record event = on add or edit

				on user input of Auto_Calc_Box
				{
					actions 
					{
						custom deluge script
						(
											if(input.Auto_Calc_Box)
										{
											disable Declared_Value;
										}
										else
										{
											enable Declared_Value;
										}
						)
					}
				}

			}
			Update_DeclaredValue1 as "Update_DeclaredValue"
			{
				type =  form
				form = Package

				record event = on add or edit

				on delete row of Products_Details
				{
					actions 
					{
						custom deluge script
						(
											if(Auto_Calc_Box && !Products_Details.isEmpty() && Number_of_Products1 > 0)
										{
											// Update declared value 
											current = ifnull(input.Declared_Value,0.0);
											decrease = row.Qty * row.Product_Price;
											if(current > decrease)
											{
												calculated = current - decrease;
											}
											else if(current <= decrease)
											{
												calculated = 0.0;
											}
											input.Declared_Value = calculated;
										}
						)
					}
				}

			}
			Validate_DeclaredValue as "Validate_DeclaredValue"
			{
				type =  form
				form = Package

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Declared_Value == 0)
										{
											openUrl("#Page:Error_Message?mensaje=Declared value must be greater than 0.","popup window","height=143,width=380");
											alert "Declared value must be greater than 0.";
										}
						)
					}
				}

			}
			Update_DeclaredValue2 as "Update_DeclaredValue"
			{
				type =  form
				form = Package

				record event = on add or edit

				on user input of Products_Details.Product_Price
				{
					actions 
					{
						custom deluge script
						(
											if(Auto_Calc_Box && row.Product_Price > 0 && row.Qty > 0)
										{
											current = ifnull(input.Declared_Value,0.0);
											qty = row.Qty;
											price = row.Product_Price;
											calculated = current + qty * price;
											input.Declared_Value = calculated;
										}
						)
					}
				}

			}
			Integrate_Relations as "Integrate Relations"
			{
				type =  form
				form = Temporal_Relations

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											TMRelations = Temporal_Relations[Sender_field != null && Integration_Status == null || Integration_Status == ""];
										//info TMRelations;
										for each  TMR in TMRelations
										{
											//Searching the Sender Contact
											SenderName = TMR.Sender_field.getprefix(" ");
											SenderAllLats = TMR.Sender_field.getsuffix(SenderName + " ");
											ClearInfo1 = SenderAllLats.replaceAll("   ",",");
											ClearInfo2 = ClearInfo1.replaceAll("  ",",");
											ClearInfo3 = ClearInfo2.replaceAll(" ",",");
											if(ClearInfo3.find(",") == 0)
											{
												ClearInfo3 = ClearInfo3.replaceFirst(",","");
											}
											if(ClearInfo3.contains(","))
											{
												SenderLast = ClearInfo3.getprefix(",");
											}
											else
											{
												SenderLast = ClearInfo3;
											}
											if(ClearInfo3.getsuffix(SenderLast + ",").contains(","))
											{
												SenderSecondLast = ClearInfo3.getsuffix(SenderLast + ",").getprefix(",");
											}
											else
											{
												SenderSecondLast = ClearInfo3.getsuffix(SenderLast + ",");
											}
											if(SenderSecondLast != "")
											{
												SendContact = Contacts[First_Name.contains(SenderName) && First_Name.contains(SenderLast) && First_Name.contains(SenderSecondLast)];
											}
											else
											{
												SendContact = Contacts[First_Name.contains(SenderName) && First_Name.contains(SenderLast)];
											}
											//Searching the Receiver Contact
											ReceiverName = TMR.Receiver.getprefix(" ");
											ReceiverAllLats = TMR.Receiver.getsuffix(ReceiverName + " ");
											ClearInf1 = ReceiverAllLats.replaceAll("   ",",");
											ClearInf2 = ClearInf1.replaceAll("  ",",");
											ClearInf3 = ClearInf2.replaceAll(" ",",");
											if(ClearInf3.find(",") == 0)
											{
												ClearInf3 = ClearInf3.replaceFirst(",","");
											}
											if(ClearInf3.contains(","))
											{
												ReceiverLast = ClearInf3.getprefix(",");
											}
											else
											{
												ReceiverLast = ClearInf3;
											}
											if(ClearInf3.getsuffix(ReceiverLast + ",").contains(","))
											{
												ReceiverSecondLast = ClearInf3.getsuffix(ReceiverLast + ",").getprefix(",");
											}
											else
											{
												ReceiverSecondLast = ClearInf3.getsuffix(ReceiverLast + ",");
											}
											if(ReceiverSecondLast != "")
											{
												ReceiverContact = Contacts[First_Name.contains(ReceiverName) && First_Name.contains(ReceiverLast) && First_Name.contains(ReceiverSecondLast)];
											}
											else
											{
												ReceiverContact = Contacts[First_Name.contains(ReceiverName) && First_Name.contains(ReceiverLast)];
											}
											/*info ReceiverName;
																					info ReceiverLast;
																					info ReceiverSecondLast;	
																					info "Primero- " + TMR.Receiver;
																					info "Segundo- " + ReceiverContact.First_Name;*/
											if(SendContact.ID != null && ReceiverContact.ID != null)
											{
												//Search if exist Sender Relation
												SRelation = Relations[Sender_field == SendContact.ID];
												if(SRelation.ID != null)
												{
													old_lista = List();
													old_lista = SRelation.Receivers;
													old_lista.add(ReceiverContact.ID);
													SRelation.Receivers=old_lista;
												}
												else
												{
													lista = List();
													lista.add(ReceiverContact.ID);
													creator_relation = insert into Relations
													[
														Added_User=zoho.loginuser
														Sender_field=SendContact.ID
														Receivers=lista
													];
												}
												TMR.Integration_Status="Integrated";
											}
											else
											{
												if(SendContact.ID == null)
												{
													info "Filed: " + TMR.Sender_field;
												}
												else
												{
													info "Filed: " + TMR.Receiver;
												}
											}
										}
						)
					}
				}

			}
			HideORShow_ReceiverInform as "HideORShow_ReceiverInformation"
			{
				type =  form
				form = Service

				record event = on add or edit

				on user input of Service_Type
				{
					actions 
					{
						custom deluge script
						(
											if(input.Service_Type == "Package Receipt" || input.Service_Type == "Locker" || input.Service_Type == "Store" || input.Service_Type == "Other Services")
										{
											input.Receiver2 = "";
											input.Receiver_Contact = null;
											input.Receiver_Not_Found = false;
											input.Receiver_Full_Name.first_name = "";
											input.Receiver_Full_Name.last_name = "";
											input.Receiver_Full_Name.suffix = "";
											input.Receiver_DNI = "";
											input.Receiver_Mobile = "";
											input.Street = "";
											input.City = "";
											input.Location = null;
											input.Update_Receiver_Information = false;
											hide Receiver2;
											hide Receiver_Not_Found;
											hide Receiver_Full_Name;
											hide Receiver_DNI;
											hide Receiver_Mobile;
											hide Street;
											hide City;
											hide Location;
											hide Update_Receiver_Information;
											hide Payer;
										}
										else
										{
											show Receiver2;
											show Receiver_Not_Found;
											show Receiver_Full_Name;
											show Receiver_DNI;
											show Receiver_Mobile;
											show Street;
											show City;
											show Location;
											show Update_Receiver_Information;
											show Payer;
										}
						)
					}
				}

			}
			Set_ReceiverInformation1 as "Set_ReceiverInformation"
			{
				type =  form
				form = Service

				record event = on add

				on load
				{
					actions  (Service_Type == "Remittance" || Service_Type == "Recharge" || Service_Type == "Online Store")
					{
						custom deluge script
						(
											if(input.Receiver_Contact != null)
										{
											search_result = Contacts[ID == input.Receiver_Contact];
											if(search_result != null)
											{
												// Completar los campos de nombre en el formulario usando los datos del contacto encontrado
												recivers_list = List();
												RealSender = Contacts[ID == input.Sender_field.toLong()];
												CRelations = Relations[Sender_field == input.Sender_field];
												Receivers = CRelations.Receivers;
												for each  Reco in Receivers
												{
													Rec = Contacts[ID == Reco];
													if(input.Receiver2 != Rec.First_Name.first_name + " " + Rec.First_Name.last_name + " - " + Rec.Mobile && Rec.Active == true)
													{
														recivers_list.add(Rec.First_Name.first_name + " " + Rec.First_Name.last_name + " - " + Rec.Mobile);
													}
												}
												input.Receiver2:ui.add(recivers_list);
												input.Receiver2 = search_result.First_Name.first_name + " " + search_result.First_Name.last_name + " - " + search_result.Mobile;
												input.Receiver_Full_Name.first_name = search_result.First_Name.first_name;
												input.Receiver_Full_Name.last_name = search_result.First_Name.last_name;
												input.Receiver_Full_Name.suffix = search_result.First_Name.suffix;
												input.Receiver_DNI = search_result.ID;
												input.Receiver_Mobile = search_result.Mobile;
												RealLocation = Coverage_Location[Address_Information1.state_province == search_result.Address.state_province && Address_Information1.country == search_result.Address.country];
												input.Street = search_result.Address.address_line_1;
												input.City = search_result.Address.district_city;
												if(RealLocation.ID != null)
												{
													input.Location = RealLocation.ID;
												}
												else
												{
													newLocation = insert into Coverage_Location
													[
														Location_Name=search_result.Address.state_province + " - " + search_result.Address.country
														Address_Information1.state_province=search_result.Address.state_province
														Address_Information1.country=search_result.Address.country
														Added_User=zoho.loginuser
													];
													RealLocation = newLocation;
													input.Location = RealLocation;
												}
												//info "Receiver Assigned to a Contact with this Mobile";
												// Mensaje de confirmación en logs
											}
										}
										else if(input.Sender_field != null)
										{
											recivers_list = List();
											RealSender = Contacts[ID == input.Sender_field.toLong()];
											CRelations = Relations[Sender_field == input.Sender_field];
											Receivers = CRelations.Receivers;
											for each  Reco in Receivers
											{
												Rec = Contacts[ID == Reco];
												if(input.Receiver2 != Rec.First_Name.first_name + " " + Rec.First_Name.last_name + " - " + Rec.Mobile && Rec.Active == true)
												{
													recivers_list.add(Rec.First_Name.first_name + " " + Rec.First_Name.last_name + " - " + Rec.Mobile);
												}
											}
											input.Receiver2:ui.add(recivers_list);
										}
						)
					}
				}

			}
			Show_ReceiverInformation_1 as "Show_ReceiverInformation_Fields&Clear_Receiver"
			{
				type =  form
				form = Service

				record event = on add or edit

				on user input of Receiver_Not_Found
				{
					actions  (Service_Type == "Remittance" || Service_Type == "Recharge" || Service_Type == "Online Store")
					{
						custom deluge script
						(
											if(input.Receiver_Not_Found == true)
										{
											input.Receiver_Contact = null;
											input.Receiver2 = "";
											disable Receiver2;
											enable Receiver_Full_Name;
											enable Receiver_Mobile;
											input.Street = "";
											input.Location = null;
											enable Street;
											enable Location;
											enable Receiver_DNI;
											//lo agregue
											input.Receiver_Full_Name = null;
											input.Receiver_DNI = null;
											input.Receiver_Mobile = null;
											input.City = null;
											hide Update_Receiver_Information;
										}
										else if(input.Receiver_Not_Found == false)
										{
											enable Receiver2;
											enable Receiver_Full_Name;
											disable Receiver_Mobile;
											input.Receiver_Full_Name.first_name = null;
											input.Receiver_Full_Name.last_name = null;
											input.Receiver_Full_Name.suffix = null;
											disable Receiver_DNI;
											//input.Receiver_Mobile = null;
											show Update_Receiver_Information;
										}
						)
					}
				}

			}
			Manage_ReceiverInformatio1 as "Manage_ReceiverInformation"
			{
				type =  form
				form = Service

				record event = on add or edit

				on load
				{
					actions  (Service_Type == "Remittance" || Service_Type == "Recharge" || Service_Type == "Online Store")
					{
						custom deluge script
						(
											if(input.Receiver_Not_Found == false)
										{
											enable Receiver_Full_Name;
											disable Receiver_Mobile;
											enable Receiver2;
										}
										else if(input.Receiver_Not_Found == true)
										{
											enable Receiver_Full_Name;
											enable Receiver_Mobile;
											disable Receiver2;
										}
						)
					}
				}

			}
			Pass_ValuetoIntegrationFi1 as "Pass_ValuetoIntegrationField"
			{
				type =  form
				form = Service

				record event = on add or edit

				on user input of Receiver2
				{
					actions  (Service_Type == "Remittance" || Service_Type == "Recharge" || Service_Type == "Online Store")
					{
						custom deluge script
						(
											if(input.Receiver2 != "" && input.Receiver2 != "Select Option" && input.Receiver2 != null)
										{
											mobile_number = input.Receiver2.getsuffix(" - ");
											RealContact = Contacts[Mobile == mobile_number];
											if(RealContact == null)
											{
												mobile_number2 = mobile_number.getsuffix("+");
												RealContact = Contacts[Mobile == mobile_number2];
											}
											input.Receiver_Full_Name.first_name = RealContact.First_Name.first_name;
											input.Receiver_Full_Name.last_name = RealContact.First_Name.last_name;
											input.Receiver_Full_Name.suffix = RealContact.First_Name.suffix;
											input.Receiver_DNI = RealContact.DNI;
											input.Receiver_Mobile = RealContact.Mobile;
											input.Street = RealContact.Address.address_line_1;
											input.City = RealContact.Address.district_city;
											RealLocation = Coverage_Location[Address_Information1.state_province == RealContact.Address.state_province && Address_Information1.country == RealContact.Address.country];
											if(RealLocation.ID != null)
											{
												input.Location = RealLocation.ID;
											}
											else
											{
												newLocation = insert into Coverage_Location
												[
													Location_Name=RealContact.Address.state_province + " - " + RealContact.Address.country
													Address_Information1.state_province=RealContact.Address.state_province
													Address_Information1.country=RealContact.Address.country
													Added_User=zoho.loginuser
												];
												RealLocation = newLocation;
												input.Location = RealLocation;
											}
										}
						)
					}
				}

			}
