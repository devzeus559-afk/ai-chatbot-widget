													if(registro.Insurance == p.Insurance)
													{
														exist = true;
													}
												}
												// Si no fue encontrada en ninguna fila la agregamos a la lista de opciones válidas
												if(exist == false)
												{
													pro_list.add(p.Insurance);
												}
											}
										}
										// Agrega dinámicamente al campo 'Protection' (en la UI) las opciones válidas encontradas
										for each  fila in input.Insurances
										{
											valor_actual = fila.Insurance;
											fila.Insurance:ui.add(pro_list);
											fila.Insurance=valor_actual;
										}
						)
					}
				}

			}
			Disable_Required_Protecti2 as "Disable_Required_Protection"
			{
				type =  form
				form = Package

				record event = on add or edit

				on user input of Insurances.Insurance
				{
					actions 
					{
						custom deluge script
						(
											if(input.Shipment_Type != null)
										{
											encontrada = false;
											RealShipment = Shipment[ID == input.Shipment_Type];
											for each  prote in RealShipment.Insurances
											{
												if(row.Previous_Insurance == prote.Insurance && prote.Required == true)
												{
													encontrada = true;
													row.Required=prote.Required;
													row.Insurance=row.Previous_Insurance;
													disable row.Insurance;
													disable row.Required;
													openUrl("#Page:Error_Message?mensaje=The above Protection is required by the selected Shipment. It cannot be changed.","popup window","height=143,width=380");
													//alert "The above Protection is required by the selected Shipment. It cannot be changed.";
												}
											}
											if(encontrada == false)
											{
												for each  prote in RealShipment.Insurances
												{
													if(row.Insurance == prote.Insurance && prote.Required == true)
													{
														row.Required=prote.Required;
														row.Previous_Insurance=row.Insurance;
														disable row.Insurance;
														disable row.Required;
														openUrl("#Page:Error_Message?mensaje=This Protection is required by the selected Shipment.","popup window","height=143,width=380");
														//alert "This Protection is required by the selected Shipment.";
													}
													else if(row.Insurance == prote.Insurance)
													{
														row.Previous_Insurance=row.Insurance;
													}
												}
											}
										}
						)
					}
				}

			}
