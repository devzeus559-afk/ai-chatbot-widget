	     				  type = latitude
	     				  displayname = "latitude"
	     				 visibility = false
     				) 
     				longitude
     				(
	     				  type = longitude
	     				  displayname = "longitude"
	     				 visibility = false
     				) 
					private = true
					width = medium
					personal data = true
				)
