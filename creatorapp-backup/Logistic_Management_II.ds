			Complete_TotalFields as "Complete_TotalFields"
			{
				type =  form
				form = Release

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											total_boxes = 0;
										total_bags = 0;
										total_docs = 0;
										total_full_boxes = 0;
										total_pounds = 0.0;
										// Count and Sum Packages Quantity and Pounds By Type
										if(input.Shipment_Details != null)
										{
											for each  p in input.Shipment_Details
											{
												// Get utils param
												pkg_weight = ifnull(p.Total_Weight,0.0);
												// Calculate totals for boxes
												if(p.Package_Type == "Box")
												{
													total_boxes = total_boxes + 1;
													total_pounds = total_pounds + pkg_weight;
													// Get Shipment registry to know the price form
													RealPkg = Package[ID == p.Package_ID];
													RealShipment = Shipment[ID == RealPkg.Shipment_Type];
													if(RealShipment.Price_Form == "By Package")
													{
														total_full_boxes = total_full_boxes + 1;
													}
												}
												// Calculate totals for bags
												else if(p.Package_Type == "Bag")
												{
													total_bags = total_bags + 1;
													total_pounds = total_pounds + pkg_weight;
												}
												// Calculate totals for docs
												else if(p.Package_Type == "Documents")
												{
													total_docs = total_docs + 1;
												}
											}
											input.Total_Boxes = total_boxes;
											input.Total_Bags = total_bags;
											input.Total_Docs = total_docs;
											input.Total_Full_Packages = total_full_boxes;
											input.Total_Pounds = total_pounds;
										}
						)
					}
				}

			}
