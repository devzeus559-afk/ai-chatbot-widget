					{
						custom deluge script
						(
											disable Transporter;
										disable Freight_Forwarder;
						)
					}
				}

			}
			Filter_Vendors as "Filter_Vendors"
			{
				type =  form
				form = Release

				record event = on add or edit

				on user input of Destination_Country
				{
					actions 
					{
						custom deluge script
						(
											if(input.Destination_Country != null)
										{
											// Temporal lists of vendors for updates vendor fields
											freight_forwarders = List();
											transporters = List();
											// Review all vendors finding location match
											for each  v in Vendor[ID != 0 && Active == true]
											{
												// Get locations covered for this vendor
												locations = v.Shipping_Details.Coverage_Locations;
												// Review all locatios to check any match with destination
												for each  l in locations
												{
													// Get coverage location record
													RealLocation = Coverage_Location[ID == l];
													if(RealLocation.Address_Information1.country == input.Destination_Country)
													{
														// Save vendor ID as freight forward if is not included on the list
														if(v.Vendor_Type.contains("Freight Forwarder") && !freight_forwarders.contains(v.ID))
														{
															freight_forwarders.add(v.ID);
														}
														// Save vendor ID as transporter if is not included on the list
														if(v.Vendor_Type.contains("Transporter") && !transporters.contains(v.ID))
														{
															transporters.add(v.ID);
														}
													}
												}
											}
											// Update and enable vendors fields
											input.Freight_Forwarder:ui.add(freight_forwarders);
											input.Transporter:ui.add(transporters);
											enable Freight_Forwarder;
											enable Transporter;
										}
										else
										{
											input.Freight_Forwarder:ui.add(List());
											input.Transporter:ui.add(List());
										}
						)
					}
				}

			}
			Filter_Services2 as "Filter_Services"
			{
				type =  form
				form = Release

				record event = on add or edit

				on delete row of Shipment_Details
				{
					actions 
					{
						custom deluge script
						(
											// Create service ids list 
										service_ids = List();
										// get elegible locations
										elegible_locs = Coverage_Location[Active == true && Address_Information1.country == input.Destination_Country].distinct(ID);
										// get elegible packages
										// get records of packages type 'Box' that:
										// - has a 'Service'
										// - match with selected 'Office'
										// - has 'Received' status
										// - Destination_Country --> Pkg Destination Address (Country)
										elegible_srvs = Package[Package_Type == "Box" && Office == input.Office && Status == "Received" && Location in elegible_locs && Service != null].distinct(Service);
										// create a tmp var for treat full services : { "serv_id": qty, "40002345": 5, "40002340": 2, ... }
										pkg_qty_by_srv = Collection();
										if(input.Shipment_Details != null)
										{
											// Save service ID if the package isn't included in the list and package isn't in Shipment Details subform
											for each  r in input.Shipment_Details
											{
												// Check if pkg ID is in subform and if service associated to the pkg is in service ids list
												if(r.Service != null)
												{
													if(pkg_qty_by_srv.isEmpty() || !pkg_qty_by_srv.containsKey(r.Service.toString()))
													{
														pkg_qty_by_srv.insert(r.Service.toString():1);
													}
													else if(pkg_qty_by_srv.containsKey(r.Service.toString()))
													{
														// get service id
														srv_key = r.Service.toString();
														// get pkgs qty for service
														pkg_qty = pkg_qty_by_srv.get(srv_key);
														// increase pkg qty for service
														pkg_qty_by_srv.update(srv_key,pkg_qty + 1);
													}
												}
											}
											// remove full selected service
											for each  sid in pkg_qty_by_srv
											{
												pkg_qty = Package[Package_Type == "Box" && Office == input.Office && Status == "Received" && Location in elegible_locs && Service == sid].count(ID);
												if(pkg_qty == pkg_qty_by_srv.get(sid))
												{
													elegible_srvs.deleteKey(sid);
												}
											}
										}
										service_ids = elegible_srvs;
										// Populate with updated services list 
										input.Service_Filter:ui.add(service_ids);
						)
					}
				}

			}
			Filter_Services3 as "Filter_Services"
			{
				type =  form
				form = Release

				record event = on add or edit

				on add row of Shipment_Details
				{
					actions 
					{
						custom deluge script
						(
											// Create service ids list 
										service_ids = List();
										// get elegible locations
										elegible_locs = Coverage_Location[Active == true && Address_Information1.country == input.Destination_Country].distinct(ID);
										// get elegible packages
										// get records of packages type 'Box' that:
										// - has a 'Service'
										// - match with selected 'Office'
										// - has 'Received' status
										// - Destination_Country --> Pkg Destination Address (Country)
										elegible_srvs = Package[Package_Type == "Box" && Office == input.Office && Status == "Received" && Location in elegible_locs && Service != null].distinct(Service);
										// create a tmp var for treat full services: { "serv_id": pkg_qty, "40002345": 5, "40002340": 2, ... }
										pkg_qty_by_srv = Collection();
										if(input.Shipment_Details != null)
										{
											// Save service ID if the package isn't included in the list and package isn't in Shipment Details subform
											for each  r in input.Shipment_Details
											{
												// Check if pkg ID is in subform and if service associated to the pkg is in service ids list
												if(r.Service != null)
												{
													if(pkg_qty_by_srv.isEmpty() || !pkg_qty_by_srv.containsKey(r.Service.toString()))
													{
														pkg_qty_by_srv.insert(r.Service.toString():1);
													}
													else if(pkg_qty_by_srv.containsKey(r.Service.toString()))
													{
														// get service id
														srv_key = r.Service.toString();
														// get pkgs qty for service
														pkg_qty = pkg_qty_by_srv.get(srv_key);
														// increase pkg qty for service
														pkg_qty_by_srv.update(srv_key,pkg_qty + 1);
													}
												}
											}
											// remove full selected service
											for each  sid in pkg_qty_by_srv
											{
												pkg_qty = Package[Package_Type == "Box" && Office == input.Office && Status == "Received" && Location in elegible_locs && Service == sid].count(ID);
												if(pkg_qty == pkg_qty_by_srv.get(sid))
												{
													elegible_srvs.deleteKey(sid);
												}
											}
										}
										service_ids = elegible_srvs;
										// Populate with updated services list 
										input.Service_Filter:ui.add(service_ids);
						)
					}
				}

			}
