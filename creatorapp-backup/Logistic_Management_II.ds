			Delete_CRM_Contact as "Delete_CRM_Contact"
			{
				type =  form
				form = Contacts

				record event = on delete
					status = inactive

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Obtener el número desde el formulario actual
										mobile_number = input.Mobile;
										// Buscar en Zoho CRM el contacto que tenga ese número en el campo Mobile
										search_result = zoho.crm.searchRecords("Contacts","(Mobile:equals:" + mobile_number + ")");
										// Si se encuentra al menos un contacto con ese número
										if(search_result.size() > 0)
										{
											//delete_response = zoho.crm.delete("Contacts",search_result.get(0).get("id").toLong());
											response = invokeurl
											[
												url :"https://www.zohoapis.com/crm/v2/Contacts/" + search_result.get(0).get("id").toLong()
												type :DELETE
												connection:"zohocrm_connection"
											];
										}
						)
					}
				}

			}
			Set_Update_SenderInformat as "Set&Update_SenderInformation_Fields"
			{
				type =  form
				form = Service

				record event = on add or edit

				on user input of Sender_field
				{
					actions 
					{
						custom deluge script
						(
											if(input.Sender_field != null)
										{
											RealSender = Contacts[ID == input.Sender_field];
											input.Sender_Full_Name.first_name = RealSender.First_Name.first_name;
											input.Sender_Full_Name.last_name = RealSender.First_Name.last_name;
											input.Sender_DNI = RealSender.DNI;
											input.Sender_Mobile = RealSender.Mobile;
											input.Sender_Email = RealSender.Email;
											input.Sender_Address.address_line_1 = RealSender.Address.address_line_1;
											input.Sender_Address.district_city = RealSender.Address.district_city;
											input.Sender_Address.state_province = RealSender.Address.state_province;
											input.Sender_Address.country = RealSender.Address.country;
										}
										else
										{
											input.Sender_Full_Name.first_name = "";
											input.Sender_Full_Name.last_name = "";
											input.Sender_DNI = "";
											input.Sender_Mobile = null;
											input.Sender_Email = "";
											input.Sender_Address.address_line_1 = "";
											input.Sender_Address.district_city = "";
											input.Sender_Address.state_province = "";
											input.Sender_Address.country = null;
										}
						)
					}
				}

			}
