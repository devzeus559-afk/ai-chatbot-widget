			Set_Update_SubtotalShipme4 as "Set&Update_SubtotalShipment"
			{
				type =  form
				form = Release

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// === Create auxiliar vars to populate subform ===
										shipment_types = Map();
										subtotal_quantity = Map();
										subtotal_unit_price = Map();
										subtotal_price = Map();
										// Calculate subtotals for boxes
										if(input.Shipment_Details != null)
										{
											for each  r in input.Shipment_Details
											{
												RealBox = Package[ID == r.Package_ID];
												// Getting real props of shipment
												RealShipment = Shipment[ID == RealBox.Shipment_Type];
												shipment = RealShipment.ID.toString();
												shipment_id = RealShipment.Shipment_ID;
												shipment_name = RealShipment.Name;
												shipment_unit_price = ifnull(RealShipment.Total_Price,0.0);
												// Populate subtotal vars
												if(!shipment_types.containKey(shipment))
												{
													// Add shipment if not found in shipments collection
													type = Map();
													type.put("id",shipment_id);
													type.put("name",shipment_name);
													shipment_types.put(shipment,type);
												}
												// Get increment value by weight 
												if(RealShipment.Price_Form == "By Weight")
												{
													quantity = ifnull(RealBox.Total_Weight,0.0);
												}
												// Get increment value by volumetric weight
												else if(RealShipment.Price_Form == "By Volumetric weight")
												{
													quantity = ifnull(RealBox.Volumetric_weight,0.0);
												}
												else if(RealShipment.Price_Form == "By Greater weight")
												{
													if(RealBox.Total_Weight >= RealBox.Volumetric_weight)
													{
														quantity = ifnull(RealBox.Total_Weight,0.0);
													}
													else
													{
														quantity = ifnull(RealBox.Volumetric_weight,0.0);
													}
												}
												// Get increment value by unit
												else if(RealShipment.Price_Form == "By Package")
												{
													quantity = 1;
												}
												// Accumulate quantity and total price
												accum_quantity = ifnull(subtotal_quantity.get(shipment),0.0) + quantity;
												total_price = accum_quantity * ifnull(RealShipment.Total_Price,0.0);
												// Update subtotals
												subtotal_quantity.put(shipment,accum_quantity);
												subtotal_unit_price.put(shipment,shipment_unit_price);
												subtotal_price.put(shipment,total_price);
											}
										}
										// Clean subform
										input.Subtotal_by_Shipment.clear();
										// Populate subform
										if(shipment_types != null)
										{
											for each  s in shipment_types.keys()
											{
												subtotal_row = Release.Subtotal_by_Shipment();
												t = shipment_types.get(s);
												subtotal_row.Shipment_Type_ID=s;
												subtotal_row.Shipment_ID=t.get("id").toString();
												subtotal_row.Shipment_Type=t.get("name").toString();
												subtotal_row.Quantity=subtotal_quantity.get(s);
												subtotal_row.Unit_Price=subtotal_unit_price.get(s);
												subtotal_row.Total_Price=subtotal_price.get(s);
												input.Subtotal_by_Shipment.insert(subtotal_row);
											}
										}
						)
					}
				}

			}
			ManageOriginInformation as "ManageOriginInformation"
			{
				type =  form
				form = Package

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Same_Origin_Address == false)
										{
											enable Sender_Address;
										}
										else if(input.Same_Origin_Address == true)
										{
											disable Sender_Address;
										}
						)
					}
				}

			}
			Change_Origin_Address1 as "Change_Origin_Address"
			{
				type =  form
				form = Package

				record event = on add or edit

				on user input of Same_Origin_Address
				{
					actions 
					{
						custom deluge script
						(
											if(Same_Origin_Address == true && input.Sender_field != null && input.Sender_Not_Found == false)
										{
											SenderContact = zoho.crm.getRecordById("Contacts",input.Sender_field.toLong());
											input.Sender_Address.address_line_1 = SenderContact.get("Mailing_Street");
											input.Sender_Address.district_city = SenderContact.get("Mailing_City");
											input.Sender_Address.state_province = SenderContact.get("Mailing_State");
											input.Sender_Address.country = SenderContact.get("Mailing_Country");
										}
						)
					}
				}

			}
			Show_OriginInformation as "Show_OriginInformation"
			{
				type =  form
				form = Package

				record event = on add or edit

				on user input of Same_Origin_Address
				{
					actions 
					{
						custom deluge script
						(
											if(input.Same_Origin_Address == true)
										{
											disable Sender_Address;
										}
										else if(input.Same_Origin_Address == false)
										{
											enable Sender_Address;
											input.Sender_Address.address_line_1 = "";
											input.Sender_Address.district_city = "";
											input.Sender_Address.state_province = "";
											input.Sender_Address.country = "";
										}
						)
					}
				}

			}
			Show_Hide_ProductsDetails as "Show&Hide_ProductsDetails"
			{
				type =  form
				form = Package

				record event = on add or edit

				on user input of Package_Type
				{
					actions 
					{
						custom deluge script
						(
											if(Package_Type != null)
										{
											if(input.Package_Type == "Documents")
											{
												show Number_of_Products1;
												hide Weight_Limit;
												hide Height_in;
												hide Width_in;
												hide Length_in;
												hide Total_Weight;
											}
											else if(input.Package_Type == "Bag")
											{
												show Weight_Limit;
												hide Number_of_Products1;
												hide Height_in;
												hide Width_in;
												hide Length_in;
												show Total_Weight;
											}
											else if(input.Package_Type == "Box")
											{
												show Weight_Limit;
												hide Number_of_Products1;
												show Height_in;
												show Width_in;
												show Length_in;
												show Total_Weight;
											}
										}
										else
										{
											hide Products_Details;
											hide Weight_Limit;
											hide Number_of_Products1;
											hide Weight_Limit;
											hide Height_in;
											hide Width_in;
											hide Length_in;
											hide Total_Weight;
										}
						)
					}
				}

			}
			Validate_WeightLimit as "Validate_WeightLimit"
			{
				type =  form
				form = Package

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(Package_Type == "Box" || Package_Type == "Bag" && Weight_Limit != null && Total_Weight > Weight_Limit)
										{
											openUrl("#Page:Error_Message?mensaje=Submit Canceled: Total Weight field must be less than Weight Limit field.","popup window","height=143,width=380");
											alert "Submit Canceled: Total Weight field must be less than Weight Limit field.";
											cancel submit;
										}
						)
					}
				}

			}
			Update_TotalWeight1 as "Update_TotalWeight"
			{
				type =  form
				form = Package

				record event = on add or edit

				on delete row of Products_Details
				{
					actions 
					{
						custom deluge script
						(
											if(Products_Details != null && Number_of_Products1 > 0)
										{
											// Update number of products
											input.Number_of_Products1 = input.Number_of_Products1 - 1;
											// Update total weight for boxes or bags
											if(Package_Type == "Box" || Package_Type == "Bag" && row.Product_Name != null)
											{
												total_weight = ifnull(input.Total_Weight,0.0);
												if(total_weight > row.Total_Weight)
												{
													total_weight = total_weight - row.Total_Weight;
												}
												else if(total_weight <= row.Total_Weight)
												{
													total_weight = 0.0;
												}
												input.Total_Weight = total_weight;
											}
										}
						)
					}
				}

			}
			Update_TotalWeight as "Update_TotalWeight"
			{
				type =  form
				form = Package

				record event = on add or edit

				on add row of Products_Details
				{
					actions 
					{
						custom deluge script
						(
											if(Package_Type == "Box" || Package_Type == "Bag" && row.Unit_Weight_in_pounds != null && row.Qty > 0)
										{
											total_weight = ifnull(input.Total_Weight,0.0);
											row.Total_Weight=row.Qty * row.Unit_Weight_in_pounds;
											// Update quantity of pounds
											input.Total_Weight = total_weight + row.Total_Weight;
										}
										else
										{
											input.Total_Weight = 0.0;
										}
										products = ifnull(input.Number_of_Products1,0);
										input.Number_of_Products1 = products + 1;
						)
					}
				}

			}
			Update_TotalWeight3 as "Update_TotalWeight"
			{
				type =  form
				form = Package

				record event = on add or edit

				on user input of Products_Details.Unit_Weight_in_pounds
				{
					actions 
					{
						custom deluge script
						(
											if(input.Package_Type == "Box" || input.Package_Type == "Bag" && row.Unit_Weight_in_pounds > 0.0 && row.Qty > 0)
										{
											// Update product total weight in Product_Details record
											row.Total_Weight=row.Qty * row.Unit_Weight_in_pounds;
											//aki
											// Update Total Weight
											total_weight = 0.0;
											for each  p in input.Products_Details
											{
												// Check that sum all records except the edited row
												if(p.Product_Name != row.Product_Name)
												{
													total_weight = total_weight + p.Total_Weight;
												}
											}
											input.Total_Weight = total_weight + row.Total_Weight;
											// Validate if Total Weight exceed the Limit Weight defined
											if(input.Weight_Limit != null && input.Total_Weight > input.Weight_Limit)
											{
												openUrl("#Page:Warning_Message?mensaje=Total weight exceeds the established limit.","popup window","height=143,width=380");
												//alert "Total weight exceeds the established limit.";
											}
										}
										else
										{
											input.Total_Weight = 0.0;
										}
						)
					}
				}

			}
			Update_ShipmentPrice_Tota as "Update_ShipmentPrice&TotalPrice"
			{
				type =  form
				form = Package

				record event = on add or edit

				on user input of Number_of_Products1
				{
					actions 
					{
						custom deluge script
						(
											// Check shipment type and calculate shipment price
										auto_calc_total_price = Shipment[ID == input.Shipment_Type].Auto_Calculate_Total_Price;
										///if(input.Shipment_Type != null && auto_calc_total_price == true)
										if(input.Shipment_Type != null)
										{
											// Load all params
											total_products = input.Number_of_Products1;
											insured_value = ifnull(input.Insured_value,0.0);
											protection_price = ifnull(input.Insurance_Price,0.0);
											extended_address_price = ifnull(input.Extended_Address_Charge,0.0);
											discount = ifnull(input.Discount,0.0);
											RealShipment = Shipment[ID == input.Shipment_Type];
											// Calculate 'Shipment Price' by 'Price Form'
											shipment_price = 0.0;
											if(RealShipment != null)
											{
												// Get shipment unit price
												shipment_unit_price = ifnull(RealShipment.Total_Price,0.0);
												// Calculate shipment price
												if(RealShipment.Price_Form == "By Package")
												{
													if(Package_Type == "Documents")
													{
														shipment_price = total_products * shipment_unit_price;
													}
													else
													{
														shipment_price = shipment_unit_price;
													}
												}
											}
											// Calculate 'Total Price' field
											input.Shipment_Price = shipment_price;
											input.Total_Price = insured_value + shipment_price + protection_price + extended_address_price - discount;
										}
						)
					}
				}

			}
			Show_Hide_VolumeFields as "Show&Hide_VolumeFields"
			{
				type =  form
				form = Package

				record event = on add or edit

				field rules
				{
					actions  (Package_Type == "Bag" || Package_Type == "Documents")
					{
						hide Volume;
					}
					actions  (Package_Type == "Bag" || Package_Type == "Documents")
					{
						hide Volumetric_weight;
					}
				}

			}
			Update_AccumCustomsDuty1 as "Update_AccumCustomsDuty"
			{
				type =  form
				form = Package

				record event = on add or edit

				on delete row of Products_Details
				{
					actions 
					{
						custom deluge script
						(
											customs_duty = ifnull(input.Customs_Duty,0.0);
										decrease = ifnull(row.Customs_Duty,0.0);
										if(customs_duty > 0.0 && Number_of_Products1 > 0)
										{
											if(decrease < customs_duty)
											{
												input.Customs_Duty = customs_duty - decrease;
											}
											else
											{
												input.Customs_Duty = 0.0;
											}
										}
										else
										{
											input.Customs_Duty = 0.0;
										}
						)
					}
				}

			}
			Update_CustomsDuty as "Update_CustomsDuty"
			{
				type =  form
				form = Package

				record event = on add or edit

				on user input of Products_Details.Customs_Duty
				{
					actions 
					{
						custom deluge script
						(
											if(row.Customs_Duty != null)
										{
											customs_duty = 0.0;
											for each  p in input.Products_Details
											{
												customs_duty = customs_duty + ifnull(p.Customs_Duty,0.0);
											}
											input.Customs_Duty = customs_duty;
											// show or hide Duty Payer field if Customs Duty has a value greatter than zero
											if(customs_duty > 0)
											{
												show Duty_Payer;
											}
											else
											{
												hide Duty_Payer;
											}
										}
						)
					}
				}

			}
