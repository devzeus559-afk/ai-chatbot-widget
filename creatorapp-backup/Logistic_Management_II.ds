			Set_SubtotalFields2 as "Set_SubtotalFields"
			{
				type =  form
				form = Daily_Movement

				record event = on add or edit

				on user input of Service
				{
					actions 
					{
						custom deluge script
						(
											// === Clean subtotal subform ===
										input.Subtotal.clear();
										// === Create auxiliar vars to populate subform ===
										// { id1 : name1, id2 : name2, ...}
										shipment_types = Map();
										// { id1 : qty1, id2 : qty2, ...}
										subtotal_quantity = Map();
										// { id1: price1, id2: price2, ...}
										subtotal_unit_price = Map();
										// { id1 : total1, id2 : total2, ... }
										subtotal_price = Map();
										// === Review packages list of the service 
										if(input.Service != null)
										{
											RealService = Service[ID == input.Service];
											// Calculate subtotals for packages
											if(RealService.Service_Type == "Package Receipt" || RealService.Service_Type == "Locker" && RealService.Packages != null)
											{
												// === Review packages list of the service 
												for each  p in RealService.Packages
												{
													// Getting real props of shipment and package
													RealPkg = Package[ID == p.Package_Name];
													RealShipment = Shipment[ID == RealPkg.Shipment_Type];
													shipment = RealShipment.ID.toString();
													shipment_name = RealShipment.Short_Name;
													shipment_unit_price = ifnull(RealShipment.Total_Price,0.0);
													// Getting prop of pkg
													pkg_pounds = ifnull(RealPkg.Total_Weight,0.0);
													pkg_volumetric_weight = ifnull(RealPkg.Volumetric_weight,0.0);
													// Populate subtotal vars
													if(!shipment_types.containKey(shipment))
													{
														// Add shipment if not found in shipments of the service
														shipment_types.put(shipment,shipment_name);
													}
													if(RealShipment.Price_Form == "By Weight" && p.Package_Type == "Box" || p.Package_Type == "Bag")
													{
														// Calculate accummulate of pounds
														qty_accum = ifnull(subtotal_quantity.get(shipment),0.0) + pkg_pounds;
													}
													else if(RealShipment.Price_Form == "By Volumetric weight" && p.Package_Type == "Box")
													{
														// Calculate accummulate of volumetric weights
														qty_accum = ifnull(subtotal_quantity.get(shipment),0.0) + pkg_volumetric_weight;
													}
													else if(RealShipment.Price_Form == "By Greater weight" && p.Package_Type == "Box")
													{
														if(pkg_pounds >= input.pkg_volumetric_weight)
														{
															qty_accum = ifnull(subtotal_quantity.get(shipment),0.0) + pkg_pounds;
														}
														else
														{
															qty_accum = ifnull(subtotal_quantity.get(shipment),0.0) + pkg_volumetric_weight;
														}
													}
													else if(RealShipment.Price_Form == "By Package")
													{
														// Calculate number of boxes
														qty_accum = ifnull(subtotal_quantity.get(shipment),0.0) + 1;
													}
													// Calculate price by quantity reference term and unit price
													total_price = qty_accum * shipment_unit_price;
													// Update subtotals
													subtotal_quantity.put(shipment,qty_accum);
													subtotal_unit_price.put(shipment,shipment_unit_price);
													subtotal_price.put(shipment,total_price);
												}
											}
										}
										// Populate subform
										if(shipment_types != null)
										{
											shipment_ids = shipment_types.keys();
											for each  s in shipment_ids
											{
												subtotal_row = Daily_Movement.Subtotal();
												subtotal_row.Shipment_Type_ID=s;
												subtotal_row.Books_Items=shipment_types.get(s);
												subtotal_row.Quantity=subtotal_quantity.get(s);
												subtotal_row.Unit_Price=subtotal_unit_price.get(s);
												subtotal_row.Total_Price=subtotal_price.get(s);
												input.Subtotal.insert(subtotal_row);
											}
										}
						)
					}
				}

			}
