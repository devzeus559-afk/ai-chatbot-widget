			Set_Service_Signature as "Set_Service_Signature"
			{
				type =  form
				form = Temporal_Signatures_by_Form

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Signature != "")
										{
											RealEmployee = Employee[Full_Name.contains("VAN")];
											RealOffice = Commercial_Office[Office_Name.contains("VAN")];
											RealService = Service[Created_by_Form == true && Office == RealOffice.ID && Employee == RealEmployee.ID && Insurance_Rejected == true && Signature_Image_by_Form == ""];
											if(RealService.ID == null)
											{
												try 
												{
													getUrl("https://httpstat.us/200?sleep=7000");
												}
												catch (err)
												{
													info "Pause Function Timeout Error: " + err;
												}
												RealService = Service[Created_by_Form == true && Ended_Packages == false && Office == RealOffice.ID && Employee == RealEmployee.ID && Insurance_Rejected == true && Signature_Image_by_Form == ""];
											}
											RealService.Signature_Image_by_Form=input.Signature;
											delete from Temporal_Signatures_by_Form[ID == input.ID];
										}
						)
					}
				}

			}
			Asociate_Package_Service1 as "Asociate_Package_Service"
			{
				type =  form
				form = Package

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Created_by_Form == true)
										{
											RealService = Service[Created_by_Form == true && Sender_Full_Name.first_name == input.Sender_Full_Name.first_name && Sender_Full_Name.last_name == input.Sender_Full_Name.last_name && Ended_Packages == false && Office == input.Office && Employee == input.Employee];
											if(RealService.ID != null)
											{
												/*packagetolist = Service.Packages();
																						packagetolist.Package_Name=input.ID;
																						RealService.Packages.insert(packagetolist);*/
												newRows = Collection();
												Vale = Service.Packages();
												Vale.Package_Name=input.ID;
												Vale.Package_ID=input.ID;
												Vale.Package_Type=input.Package_Type;
												Vale.Status=input.Status;
												Vale.Receipt_Date=input.Receipt_Date;
												Vale.External_Tracking_Number=input.Tracking_Number;
												Vale.Receiver=Contacts[ID == input.Receiver_Contact].CRM_Contact_ID.toLong();
												Vale.Destination_Street=input.Street;
												Vale.Location=input.Location;
												Vale.Width_in_cm=input.Width_in;
												Vale.Length_in_cm=input.Length_in;
												Vale.Height_in_cm=input.Height_in;
												Vale.Weight_in_pounds=input.Total_Weight;
												Vale.Volume=input.Volume;
												Vale.Package_Material=input.Package_Material;
												Vale.Shipment_Type=input.Shipment_Type;
												Vale.Package_Price=input.Total_Price;
												Vale.Service_Employee=input.Employee;
												Vale.Service_Office=input.Office;
												Vale.Service_Sender=input.Sender_field;
												Vale.Sender_Full_Name=input.Sender_Full_Name;
												Vale.Sender_Mobile=input.Sender_Mobile;
												Vale.Sender_DNI=input.Sender_DNI;
												Vale.Sender_Email=input.Sender_Email;
												newRows.insert(Vale);
												thisweight = input.Total_Weight;
												thisprice = input.Total_Price;
												thisduty = ifnull(input.Customs_Duty,0);
												thispackage = ifnull(input.Packaging_Price,0);
												RealService.Total_Weight=ifnull(RealService.Total_Weight,0) + thisweight;
												RealService.Total_Custom_Duty=ifnull(RealService.Total_Custom_Duty,0) + thisduty;
												RealService.Total_Packaging_Price=ifnull(RealService.Total_Packaging_Price,0) + thispackage;
												RealService.Price=ifnull(RealService.Price,0) + thisprice + thisduty + thispackage;
												RealService.Number_of_Packages=ifnull(RealService.Number_of_Packages,0) + 1;
												RealService.Packages.clear();
												RealService.Packages.insert(newRows);
												input.Service = RealService.ID;
												if(input.Last_Package == true)
												{
													RealService.Ended_Packages=true;
												}
											}
											else
											{
												openUrl("#Page:Error_Message?mensaje=Service not founded to asociate the Package.","popup window","height=143,width=380");
												info "Service not founded to asociate the Package.";
											}
										}
						)
					}
				}

			}
