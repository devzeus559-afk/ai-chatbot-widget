			Print_Insurance_Rejected as "Print Insurance Rejected"
			{
				type =  functions
				form = Service
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						variable = input.Service_ID.replaceAll(" ","_");
										openUrl("https://creatorapp.zoho.com/prontoenviosnewjersey/copy-1-of-logistic-management-ii/record-pdf/Hide_All_Services/" + input.ID + "/" + variable + "-Insurance_Rejected","new window","successive=true");
					)
					}
				}
			}
			Send_Email as "Send Email"
			{
				type =  functions
				form = Service
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						newline = "<br> <br>";
										RealOffice = Commercial_Office[ID == input.Office];
										if(RealOffice.Office_Name.contains("Elizabeth"))
										{
											telefono = "+1 (201) 502-3200";
										}
										else if(RealOffice.Office_Name.contains("West New York"))
										{
											telefono = "+1 (201) 502-3200";
										}
										else if(RealOffice.Office_Name.contains("New York"))
										{
											telefono = "+1 (646) 530-6003";
										}
										else if(RealOffice.Office_Name.contains("MIAMI"))
										{
											telefono = "+1 (786) 275-4393";
										}
										else if(RealOffice.Office_Name.contains("VAN"))
										{
											telefono = "+1 (201) 502-3200";
										}
										msg = "Estimado(a) " + input.Sender_Full_Name + ", " + newline;
										msg = msg + "Esperamos que se encuentre bien. " + newline;
										msg = msg + "Mediante este correo le hacemos envío del recibo correspondiente al servicio de paquetería realizado el " + input.Date_field1 + ". En el documento adjunto podrá encontrar el detalle de los paquetes enviados, destinatarios y los métodos de pago utilizados. " + newline;
										msg = msg + "Para su mayor comodidad, se pone a su disposición el sistema de Seguimiento de envíos, donde podrá consultar el estado de cada paquete utilizando el código correspondiente indicado en el recibo adjunto: " + newline;
										msg = msg + "https://www.prontoenvios.us/tracking " + newline;
										msg = msg + "Se recomienda revisar la información y conservar este documento para su control. En caso de cualquier duda o si requiere alguna aclaración, será un placer poder asistirle. " + newline;
										msg = msg + "Con Pronto Envíos lo bueno llega Pronto y llega bien... " + newline;
										msg = msg + "Cordialmente, " + newline;
										msg = msg + "Agencia Pronto Envíos " + newline;
										msg = msg + "https://www.prontoenvios.us " + newline;
										msg = msg + telefono + newline;
										sendmail
										[
											from :"Pronto Envios <" + zoho.loginuserid + ">"
											to :input.Sender_Email
											subject :"Recibo de su envío – Pronto Envíos"
											message :msg
											Attachments :template:Receipt as PDF
										]
					)
					}
				}
			}
