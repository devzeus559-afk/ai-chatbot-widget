				 int chat_data_access.insert_chat_message(map data)
                 {
                 	// --------------------------------------------------------------------------
                 	// Insert helpers — devuelven el ID numérico del registro creado
                 	// --------------------------------------------------------------------------
                 	config = thisapp.chat_config.chat_config();
                 	newId = insert into ChatMessages
                 	[
                 		Session=data.get("Session")
                 		Role=data.get("Role")
                 		Content=data.get("Content")
                 		Created_Time=zoho.currenttime
                 		Added_User=zoho.loginuser
                 	];
                 	return newId;
                 }
				 int chat_data_access.insert_chat_session(map data)
                 {
                 	// --------------------------------------------------------------------------
                 	// Insert helpers — devuelven el ID numérico del registro creado
                 	// --------------------------------------------------------------------------	
                 	employee_record = Employee[User == data.get("User")];
                 	if(employee_record != null)
                 	{
                 		userId = employee_record.ID;
                 		newId = insert into ChatSessions
                 		[
                 			Session_ID=data.get("Session_ID")
                 			Title=data.get("Title")
                 			User=userId
                 			Last_Activity=data.get("Last_Activity")
                 			Added_User=zoho.loginuser
                 		];
                 		return newId;
                 	}
                 	else
                 	{
                 		return 1;
                 	}
                 }
				 string chat_intent.build_intent_prompt(string userPrompt, list history, string catalogText)
                 {
                 	prompt = "CONTRATO DE SALIDA: Devuelve SOLO JSON válido con UNO de estos tres formatos:\n";
                 	prompt = prompt + "1) {\"tool\": \"<nombre_tool>\", \"params\": {<parámetros>}} cuando necesites datos de la app.\n";
                 	prompt = prompt + "2) {\"answer\": \"<texto>\"} cuando puedas responder sin consultar datos.\n";
                 	prompt = prompt + "3) {\"clarify\": \"<pregunta>\"} cuando falte información para elegir una herramienta.\n\n";
                 	prompt = prompt + "HERRAMIENTAS DISPONIBLES:\n" + catalogText + "\n\n";
                 	if(history != null && history.size() > 0)
                 	{
                 		prompt = prompt + "HISTORIAL RECIENTE:\n";
                 		for each  m in history
                 		{
                 			prompt = prompt + m.get("role") + ": " + m.get("content") + "\n";
                 		}
                 		prompt = prompt + "\n";
                 	}
                 	prompt = prompt + "MENSAJE ACTUAL DEL USUARIO:\n" + userPrompt;
                 	return prompt;
                 }
				 map chat_intent.chat_intent(string userPrompt, list history)
                 {
                 	/**
                 	 * chat_intent.dg
                 	 *
                 	 * Router de intención: llama a la tarea Zia de Deluge y normaliza la salida
                 	 * a UNO de estos contratos:
                 	 *
                 	 *   {"tool": "<nombre>", "params": {...}}   → necesita datos de la app
                 	 *   {"answer": "<texto>"}                    → respuesta directa sin tools
                 	 *   {"clarify": "<pregunta>"}                → falta información
                 	 *
                 	 * La salida de Zia es TEXTO; se pide JSON estricto con temperature 0 y se
                 	 * valida con parse_json_strict (chat_common.dg).
                 	 */
                 	config = thisapp.chat_config.chat_config();
                 	catalogText = config.get("toolsText");
                 	context = "Eres un asistente virtual de una agencia internacional de paquetería, " + "remesas y recargas telefónicas. Ayudas a clientes y agentes a consultar " + "datos de la aplicación. Debes responder ÚNICAMENTE con JSON válido, " + "sin texto adicional ni markdown.";
                 	message = thisapp.chat_intent.build_intent_prompt(userPrompt,history,catalogText);
                 	response = zia
                 	[
                 		message:message
                 		context:context
                 		parameters:{"temperature":0.0}
                 	];
                 	// Zia puede devolver null o un Map sin "status" al fallar (p. ej. IA no
                 	// habilitada en la organización). Nunca evaluar !null en Deluge: el
                 	// fallo debe derivar a la rama de error, no romper el turno.
                 	if(response == null)
                 	{
                 		return {"status":"error","kind":"clarify","text":"No pude interpretar tu solicitud. ¿Puedes reformularla?"};
                 	}
                 	// La respuesta de Zia task es un objeto con atributos accedidos por punto:
                 	//   response.status → boolean (éxito de la tarea)
                 	//   response.data   → String (texto del LLM, contiene JSON)
                 	//   response.error  → String/null (mensaje si falló)
                 	if(response.status == true && response.data != null)
                 	{
                 		// Zia puede devolver data como Map (ya parseado) o como String (crudo).
                 		// Si es Map, toMap() produce formato Deluge (sin comillas) → parse_error.
                 		// Solución: intentar usar directamente; si no es Map, parsear como String.
                 		dataValue = response.data;
                 		dataFormatted = dataValue.toMap();
                 		parsed = null;
                 		try 
                 		{
                 			// Si es Map, containsKey funciona directamente
                 			if(dataFormatted.containKey("tool") || dataFormatted.containKey("answer") || dataFormatted.containKey("clarify"))
                 			{
                 				parsed = dataFormatted;
                 			}
                 		}		catch (e)
                 		{
                 			// No es Map — tratar como String
                 		}
                 		if(parsed == null)
                 		{
                 			parsed = thisapp.chat_common.parse_json_strict(dataValue);
                 		}
                 	}
                 	else
                 	{
                 		errorMsg = if(response.error != null,response.error,"Error desconocido");
                 		return {"status":"error","kind":"clarify","text":"No pude interpretar tu solicitud. " + errorMsg};
                 	}
                 	// 	info "parsed: "+ parsed;
                 	// Normalización del contrato (con try/catch por si el JSON no es un objeto)
                 	try 
                 	{
                 		if(parsed.containKey("parse_error"))
                 		{
                 			return {"status":"error","kind":"clarify","text":"No pude interpretar tu solicitud. ¿Puedes reformularla?"};
                 		}
                 		if(parsed.containKey("tool"))
                 		{
                 			params = parsed.get("params");
                 			if(params == null)
                 			{
                 				params = Map();
                 			}
                 			return {"status":"ok","kind":"tool","tool":parsed.get("tool"),"params":params};
                 		}
                 		if(parsed.containKey("answer"))
                 		{
                 			return {"status":"ok","kind":"answer","text":parsed.get("answer")};
                 		}
                 		if(parsed.containKey("clarify"))
                 		{
                 			return {"status":"ok","kind":"clarify","text":parsed.get("clarify")};
                 		}
                 	}	catch (e)
                 	{
                 		// JSON válido pero con otra forma: pedir reformulación
                 	}
                 	return {"status":"error","kind":"clarify","text":"No pude interpretar tu solicitud. ¿Puedes reformularla?"};
                 }
				 map chat_invoke.chat_invoke(int requestId)
                 {
                 	/**
                 	 * chat_invoke.deluge
                 	 *
                 	 * Orquestador del chatbot. Recibe el ID del registro en ChatRequests (creado
                 	 * por el widget o en pruebas) y ejecuta el ciclo completo:
                 	 *
                 	 *   sesión → mensaje user → intención (Zia) → dispatch tool → respuesta → persistencia
                 	 *
                 	 * Todo el acceso a datos es NATIVO (data_access.deluge): 0 llamadas de API de
                 	 * Creator y 0 llamadas externas por turno.
                 	 *
                 	 * Funciones: chat_invoke, resolve_reply, dispatch_tool, compose_with_ai,
                 	 *            get_or_create_session, create_message, get_recent_history,
                 	 *            update_session
                 	 */
                 	config = thisapp.chat_config.chat_config();
                 	requestRecords = thisapp.chat_data_access.fetch_chat_requests_by_id(requestId);
                 	info requestRecords;
                 	if(requestRecords == null || requestRecords.size() == 0)
                 	{
                 		return {"status":"failed","message":"Solicitud no encontrada"};
                 	}
                 	request = requestRecords.get(0);
                 	sessionId = request.get("Session_ID");
                 	prompt = request.get("Prompt");
                 	// 1. Sesión (crear si no existe)
                 	session = thisapp.chat_invoke.get_or_create_session(sessionId);
                 	// 2. Persistir mensaje del usuario
                 	if(session != null)
                 	{
                 		thisapp.chat_invoke.create_message(session.get("ID"),"user",prompt);
                 	}
                 	// 3. Historial para contexto (últimos 10 mensajes, más reciente primero)
                 	history = thisapp.chat_invoke.get_recent_history(session.get("ID"));
                 	// 4. Intención vía Zia
                 	intent = thisapp.chat_intent.chat_intent(prompt,history);
                 	// 5. Dispatch + respuesta
                 	reply = thisapp.chat_invoke.resolve_reply(intent);
                 	// 6. Persistir respuesta AI
                 	thisapp.chat_invoke.create_message(session.get("ID"),"ai",reply);
                 	// 7. Actualizar sesión (título + actividad) mutando el registro enlazado
                 	thisapp.chat_invoke.update_session(session,prompt);
                 	// 8. Marcar la solicitud como respondida (mutación del registro enlazado)
                 	chat_requests_record = ChatRequests[ID == requestId];
                 	chat_requests_record.Status="answered";
                 	chat_requests_record.Reply=reply;
                 	return {"status":"answered","reply":reply,"sessionId":sessionId};
                 }
				 string chat_invoke.compose_with_ai(string toolName, map toolResult, map intent)
                 {
                 	/**
                 	 * chat_invoke.deluge
                 	 *
                 	 * Orquestador del chatbot. Recibe el ID del registro en ChatRequests (creado
                 	 * por el widget o en pruebas) y ejecuta el ciclo completo:
                 	 *
                 	 *   sesión → mensaje user → intención (Zia) → dispatch tool → respuesta → persistencia
                 	 *
                 	 * Todo el acceso a datos es NATIVO (data_access.deluge): 0 llamadas de API de
                 	 * Creator y 0 llamadas externas por turno.
                 	 *
                 	 * Funciones: chat_invoke, resolve_reply, dispatch_tool, compose_with_ai,
                 	 *            get_or_create_session, create_message, get_recent_history,
                 	 *            update_session
                 	 */
                 	// Composición con segunda llamada Zia (opcional, activada con composeWithAI)
                 	// Retorna solo el texto; el envelope JSON (text + visualization) se arma en resolve_reply.
                 	if(!toolResult.get("ok"))
                 	{
                 		return "No pude completar la búsqueda. " + toolResult.get("message");
                 	}
                 	dataText = thisapp.chat_common.compose_reply(toolResult,intent);
                 	response = zia
                 	[
                 		message:"Responde al usuario de forma natural y breve usando estos datos: " + dataText
                 		context:"Eres un asistente de atención al cliente de una agencia de paquetería, remesas y recargas telefónicas."
                 		parameters:{"temperature":0.3}
                 	];
                 	// Null-safe (mismo patrón que chat_intent): Zia puede devolver null o
                 	// un Map sin "status" al fallar; nunca evaluar !null en Deluge.
                 	if(response != null)
                 	{
                 		if(response.get("status") == true)
                 		{
                 			return response.get("data");
                 		}
                 	}
                 	return thisapp.chat_common.compose_reply(toolResult,intent);
                 }
				 void chat_invoke.create_message(string sessionRecordId, string role, string content)
                 {
                 	/**
                 	 * chat_invoke.deluge
                 	 *
                 	 * Orquestador del chatbot. Recibe el ID del registro en ChatRequests (creado
                 	 * por el widget o en pruebas) y ejecuta el ciclo completo:
                 	 *
                 	 *   sesión → mensaje user → intención (Zia) → dispatch tool → respuesta → persistencia
                 	 *
                 	 * Todo el acceso a datos es NATIVO (data_access.deluge): 0 llamadas de API de
                 	 * Creator y 0 llamadas externas por turno.
                 	 *
                 	 * Funciones: chat_invoke, resolve_reply, dispatch_tool, compose_with_ai,
                 	 *            get_or_create_session, create_message, get_recent_history,
                 	 *            update_session
                 	 */
                 	// --------------------------------------------------------------------------
                 	// Persistencia de sesión y mensajes (acceso nativo)
                 	// --------------------------------------------------------------------------	
                 	config = thisapp.chat_config.chat_config();
                 	// Almacenar el envelope completo (text + visualization) para que el widget
                 	// pueda reconstruir la visualización al cargar mensajes históricos.
                 	// El widget hace JSON.parse(content) y extrae text/visualization.	
                 	data = Map();
                 	data.put("Session",sessionRecordId);
                 	data.put("Role",role);
                 	data.put("Content",content);
                 	thisapp.chat_data_access.insert_chat_message(data);
                 }
				 map chat_invoke.dispatch_tool(string toolName, map params)
                 {
                 	/**
                 	 * chat_invoke.deluge
                 	 *
                 	 * Orquestador del chatbot. Recibe el ID del registro en ChatRequests (creado
                 	 * por el widget o en pruebas) y ejecuta el ciclo completo:
                 	 *
                 	 *   sesión → mensaje user → intención (Zia) → dispatch tool → respuesta → persistencia
                 	 *
                 	 * Todo el acceso a datos es NATIVO (data_access.deluge): 0 llamadas de API de
                 	 * Creator y 0 llamadas externas por turno.
                 	 *
                 	 * Funciones: chat_invoke, resolve_reply, dispatch_tool, compose_with_ai,
                 	 *            get_or_create_session, create_message, get_recent_history,
                 	 *            update_session
                 	 */
                 	if(toolName == "track_package")
                 	{
                 		return thisapp.chat_tools.track_package(params);
                 	}
                 	if(toolName == "search_services")
                 	{
                 		return thisapp.chat_tools.search_services(params);
                 	}
                 	if(toolName == "find_offices")
                 	{
                 		return thisapp.chat_tools.find_offices(params);
                 	}
                 	if(toolName == "check_coverage")
                 	{
                 		return thisapp.chat_tools.check_coverage(params);
                 	}
                 	if(toolName == "find_contacts")
                 	{
                 		return thisapp.chat_tools.find_contacts(params);
                 	}
                 	if(toolName == "report_top_customers")
                 	{
                 		return thisapp.chat_tools.report_top_customers(params);
                 	}
                 	return {"ok":false,"message":"Herramienta desconocida: " + toolName};
                 }
				 map chat_invoke.get_or_create_session(string sessionId)
                 {
                 	/**
                 	 * chat_invoke.deluge
                 	 *
                 	 * Orquestador del chatbot. Recibe el ID del registro en ChatRequests (creado
                 	 * por el widget o en pruebas) y ejecuta el ciclo completo:
                 	 *
                 	 *   sesión → mensaje user → intención (Zia) → dispatch tool → respuesta → persistencia
                 	 *
                 	 * Todo el acceso a datos es NATIVO (data_access.deluge): 0 llamadas de API de
                 	 * Creator y 0 llamadas externas por turno.
                 	 *
                 	 * Funciones: chat_invoke, resolve_reply, dispatch_tool, compose_with_ai,
                 	 *            get_or_create_session, create_message, get_recent_history,
                 	 *            update_session
                 	 */
                 	// --------------------------------------------------------------------------
                 	// Persistencia de sesión y mensajes (acceso nativo)
                 	// --------------------------------------------------------------------------	
                 	config = thisapp.chat_config.chat_config();
                 	// Sesión existente: registro ENLAZADO (mutable) vía fetch nativo
                 	records = thisapp.chat_data_access.fetch_chat_sessions_by_session_id(sessionId);
                 	if(records != null && records.size() > 0)
                 	{
                 		return records.get(0);
                 	}
                 	// Sesión nueva: insert -> devuelve solo el ID numérico -> refetch para
                 	// obtener un registro ENLAZADO que update_session pueda mutar.
                 	data = Map();
                 	data.put("Session_ID",sessionId);
                 	data.put("Title","Nueva conversación");
                 	data.put("User",getPrefix(zoho.loginuserid,"@"));
                 	data.put("Last_Activity",zoho.currenttime);
                 	newId = thisapp.chat_data_access.insert_chat_session(data);
                 	newRecords = thisapp.chat_data_access.fetch_chat_sessions_by_id(newId);
                 	if(newRecords != null && newRecords.size() > 0)
                 	{
                 		return newRecords.get(0);
                 	}
                 	return Map();
                 }
				 list chat_invoke.get_recent_history(string sessionRecordId)
                 {
                 	/**
                  	* chat_invoke.deluge
                  	*
                  	* Orquestador del chatbot. Recibe el ID del registro en ChatRequests (creado
                  	* por el widget o en pruebas) y ejecuta el ciclo completo:
                  	*
                  	*   sesión → mensaje user → intención (Zia) → dispatch tool → respuesta → persistencia
                  	*
                  	* Todo el acceso a datos es NATIVO (data_access.deluge): 0 llamadas de API de
                  	* Creator y 0 llamadas externas por turno.
                  	*
                  	* Funciones: chat_invoke, resolve_reply, dispatch_tool, compose_with_ai,
                  	*            get_or_create_session, create_message, get_recent_history,
                  	*            update_session
                  	*/
                 	// --------------------------------------------------------------------------
                 	// Persistencia de sesión y mensajes (acceso nativo)
                 	// --------------------------------------------------------------------------	
                 	config = thisapp.chat_config.chat_config();
                 	// Últimos 10, más reciente primero (desc, range 0-9, SIN reverse)
                 	records = thisapp.chat_data_access.fetch_chat_messages_by_session(sessionRecordId.toNumber());
                 	history = List();
                 	if(records == null || records.size() == 0)
                 	{
                 		return history;
                 	}
                 	for each  m in records
                 	{
                 		item = Map();
                 		item.put("role",m.get("Role"));
                 		item.put("content",m.get("Content"));
                 		history.add(item);
                 	}
                 	return history;
                 }
				 string chat_invoke.resolve_reply(map intent)
                 {
                 	/**
                 	 * chat_invoke.deluge
                 	 *
                 	 * Orquestador del chatbot. Recibe el ID del registro en ChatRequests (creado
                 	 * por el widget o en pruebas) y ejecuta el ciclo completo:
                 	 *
                 	 *   sesión → mensaje user → intención (Zia) → dispatch tool → respuesta → persistencia
                 	 *
                 	 * Todo el acceso a datos es NATIVO (data_access.deluge): 0 llamadas de API de
                 	 * Creator y 0 llamadas externas por turno.
                 	 *
                 	 * Funciones: chat_invoke, resolve_reply, dispatch_tool, compose_with_ai,
                 	 *            get_or_create_session, create_message, get_recent_history,
                 	 *            update_session
                 	 */
                 	if(intent.get("status") != "ok")
                 	{
                 		return "Lo siento, no pude procesar tu solicitud. Por favor intenta de nuevo.";
                 	}
                 	kind = intent.get("kind");
                 	if(kind == "answer" || kind == "clarify")
                 	{
                 		return intent.get("text");
                 	}
                 	if(kind == "tool")
                 	{
                 		toolResult = thisapp.chat_invoke.dispatch_tool(intent.get("tool"),intent.get("params"));
                 		config = thisapp.chat_config.chat_config();
                 		replyText = "";
                 		viz = null;
                 		if(config.get("composeWithAI"))
                 		{
                 			replyText = thisapp.chat_invoke.compose_with_ai(intent.get("tool"),toolResult,intent);
                 			viz = toolResult.get("visualization");
                 		}
                 		else
                 		{
                 			replyObj = thisapp.chat_common.compose_reply(toolResult,intent);
                 			replyText = replyObj.get("text");
                 			viz = replyObj.get("visualization");
                 		}
                 		// Serializar a JSON para que el widget pueda parsear text + visualization
                 		// 		return replyObj.toString();
                 		// Serializar a JSON válido (Deluge Map.toString() NO es JSON)
                 		return thisapp.chat_common.envelope_to_json(replyText,viz);
                 	}
                 	return "Lo siento, no pude procesar tu solicitud. Por favor intenta de nuevo.";
                 }
				 void chat_invoke.update_session(map session, string firstPrompt)
                 {
                 	/**
                 	 * chat_invoke.deluge
                 	 *
                 	 * Orquestador del chatbot. Recibe el ID del registro en ChatRequests (creado
                 	 * por el widget o en pruebas) y ejecuta el ciclo completo:
                 	 *
                 	 *   sesión → mensaje user → intención (Zia) → dispatch tool → respuesta → persistencia
                 	 *
                 	 * Todo el acceso a datos es NATIVO (data_access.deluge): 0 llamadas de API de
                 	 * Creator y 0 llamadas externas por turno.
                 	 *
                 	 * Funciones: chat_invoke, resolve_reply, dispatch_tool, compose_with_ai,
                 	 *            get_or_create_session, create_message, get_recent_history,
                 	 *            update_session
                 	 */
                 	// --------------------------------------------------------------------------
                 	// Persistencia de sesión y mensajes (acceso nativo)
                 	// --------------------------------------------------------------------------	
                 	config = thisapp.chat_config.chat_config();
                 	title = session.get("Title");
                 	sessionId = session.get("Session_ID");
                 	session_record = ChatSessions[Session_ID == sessionId];
                 	// Mutación directa del registro ENLAZADO: persiste sin llamada de API
                 	if(title == null || title == "" || title == "Nueva conversación")
                 	{
                 		newTitle = firstPrompt;
                 		if(newTitle.length() > 50)
                 		{
                 			newTitle = newTitle.substring(0,50);
                 		}
                 		session_record.Title=newTitle;
                 		session_record.Last_Activity=zoho.currenttime;
                 	}
                 	else
                 	{
                 		session_record.Last_Activity=zoho.currenttime;
                 	}
                 }
				 map chat_list.chat_list()
                 {
                 	/**
                 	 * chat_list.deluge
                 	 *
                 	 * Índice de conversaciones del usuario actual, para poblar la sidebar del
                 	 * widget desde servidor (sustituye a la Capa 0 localStorage cuando el adapter
                 	 * del widget apunte a la Client API).
                 	 *
                 	 * Acceso nativo vía data_access.fetch_chat_sessions (0 llamadas de API de Creator):
                 	 * solo las sesiones del usuario logueado, ordenadas por Last_Activity desc.
                 	 *
                 	 * Devuelve:
                 	 *   {"ok": true, "data": [{"id", "title", "lastActivity"}, ...]}
                 	 */
                 	userId = zoho.loginuser.get("Id");
                 	records = thisapp.chat_data_access.fetch_chat_sessions_by_user(userId,0,49);
                 	sessions = List();
                 	if(records == null)
                 	{
                 		return {"ok":true,"data":sessions};
                 	}
                 	for each  s in records
                 	{
                 		item = Map();
                 		item.put("id",s.get("Session_ID"));
                 		item.put("title",s.get("Title"));
                 		item.put("lastActivity",s.get("Last_Activity"));
                 		sessions.add(item);
                 	}
                 	return {"ok":true,"data":sessions};
                 }
				 map chat_tools.check_coverage(map params)
                 {
                 	/**
                 	 * tool_coverage.deluge
                 	 *
                 	 * Consulta la cobertura de países/proveedores desde el módulo Coverage_Location
                 	 * (zonas cubiertas por cada vendor para un tipo de servicio: remesas, recargas,
                 	 * paquetería).
                 	 *
                 	 * Recibe (todos opcionales): {"country", "vendor", "serviceType"}
                 	 * Devuelve: {"ok": true, "data": [{country, vendor, serviceType, details}]}
                 	 *
                 	 * Acceso nativo vía data_access.fetch_coverage (0 llamadas de API de Creator).
                 	 * Límite 200 (range 0-199), orden Country asc; cláusulas unidas con
                 	 * append_criteria (sintaxis nativa, sin comillas dobles en los campos).
                 	 */
                 	config = thisapp.chat_config.chat_config();
                 	locFields = config.get("coverageFields");
                 	vFields = config.get("vendorFields");
                 	// --- ubicaciones (Coverage_Location): TODO el el catálogo y filtro country en memoria ---
                 	records = thisapp.chat_data_access.fetch_coverage_all();
                 	if(records == null)
                 	{
                 		records = List();
                 	}
                 	country = params.get("country");
                 	locList = List();
                 	for each  c in records
                 	{
                 		addr = c.get(locFields.get("address"));
                 		countryValue = "";
                 		stateValue = "";
                 		if(addr != null)
                 		{
                 			co = addr.get(locFields.get("country"));
                 			if(co != null)
                 			{
                 				countryValue = "" + co;
                 			}
                 			st = addr.get(locFields.get("state"));
                 			if(st != null)
                 			{
                 				stateValue = "" + st;
                 			}
                 		}
                 		if(country != null && country != "")
                 		{
                 			if(("" + country).trim().lower() != countryValue.trim().lower())
                 			{
                 				continue;
                 			}
                 		}
                 		item = Map();
                 		item.put("name",c.get(locFields.get("name")));
                 		item.put("locationId",c.get(locFields.get("locationId")));
                 		item.put("country",countryValue);
                 		item.put("state",stateValue);
                 		locList.add(item);
                 	}
                 	// --- proveedores (Vendor): ID-list por Service_Type / nombre, con guard de lista vacía ---
                 	serviceType = params.get("serviceType");
                 	vendor = params.get("vendor");
                 	targetIDs = List();
                 	hasFilter = false;
                 	if(serviceType != null && serviceType != "")
                 	{
                 		targetIDs.addAll(thisapp.chat_data_access.fetch_vendors_ids_by_type(serviceType));
                 		hasFilter = true;
                 	}
                 	if(vendor != null && vendor != "")
                 	{
                 		ids = thisapp.chat_data_access.fetch_vendors_ids_by_name(vendor);
                 		if(hasFilter)
                 		{
                 			targetIDs = targetIDs.intersect(ids);
                 		}
                 		else
                 		{
                 			targetIDs.addAll(ids);
                 			hasFilter = true;
                 		}
                 	}
                 	if(!hasFilter)
                 	{
                 		vendorRecords = thisapp.chat_data_access.fetch_vendors_all();
                 	}
                 	else if(targetIDs.size() == 0)
                 	{
                 		vendorRecords = List();
                 	}
                 	else
                 	{
                 		vendorRecords = thisapp.chat_data_access.fetch_vendors_by_ids(targetIDs);
                 	}
                 	vendorList = List();
                 	if(vendorRecords != null)
                 	{
                 		for each  v in vendorRecords
                 		{
                 			vitem = Map();
                 			vitem.put("name",v.get(vFields.get("name")));
                 			vitem.put("vendorId",v.get(vFields.get("vendorId")));
                 			vitem.put("type",v.get(vFields.get("type")));
                 			vendorList.add(vitem);
                 		}
                 	}
                 	return {"ok":true,"data":locList,"vendors":vendorList};
                 }
				 map chat_tools.find_contacts(map params)
                 {
                 	/**
                 	 * tool_contacts.deluge
                 	 *
                 	 * Busca contactos (remitente o receptor) en el módulo Contacts.
                 	 * Recibe (todos opcionales): {"name", "phone", "document"}
                 	 * Devuelve: {"ok": true, "data": [{fullName, phone, email, document, role}]}
                 	 *
                 	 * Acceso nativo vía data_access.fetch_contacts (0 llamadas de API de Creator).
                 	 * Límite 50 (range 0-49), orden Full_Name asc; criterio vacío -> [ID != 0].
                 	 *
                 	 * NOTA DE PRIVACIDAD: los resultados pueden contener PII. Si el LLM configurado
                 	 * en Zia es externo (OpenAI/Gemini/Anthropic), la data sale de la organización;
                 	 * considera limitar esta tool a agentes internos o usar Zoho GenAI.
                 	 */
                 	targetIDs = List();
                 	hasFilter = false;
                 	name = params.get("name");
                 	if(name != null && name != "")
                 	{
                 		ids = thisapp.chat_data_access.fetch_contacts_ids_by_full_name(name);
                 		targetIDs.addAll(ids);
                 		hasFilter = true;
                 	}
                 	phone = params.get("phone");
                 	if(phone != null && phone != "")
                 	{
                 		ids = thisapp.chat_data_access.fetch_contacts_ids_by_phone(phone);
                 		if(hasFilter)
                 		{
                 			targetIDs = targetIDs.intersect(ids);
                 		}
                 		else
                 		{
                 			targetIDs.addAll(ids);
                 			hasFilter = true;
                 		}
                 	}
                 	document = params.get("document");
                 	if(document != null && document != "")
                 	{
                 		ids = thisapp.chat_data_access.fetch_contacts_ids_by_document(document);
                 		if(hasFilter)
                 		{
                 			targetIDs = targetIDs.intersect(ids);
                 		}
                 		else
                 		{
                 			targetIDs.addAll(ids);
                 			hasFilter = true;
                 		}
                 	}
                 	// Guard: intersección vacía -> data:[] (Form[ID in []] es desconocido en Creator)
                 	if(!hasFilter)
                 	{
                 		records = thisapp.chat_data_access.fetch_contacts_all();
                 	}
                 	else if(targetIDs.size() == 0)
                 	{
                 		records = List();
                 	}
                 	else
                 	{
                 		records = thisapp.chat_data_access.fetch_contacts_by_ids(targetIDs);
                 	}
                 	// Prepare the result
                 	if(records == null)
                 	{
                 		return {"ok":true,"data":{}};
                 	}
                 	return {"ok":true,"data":records};
                 }
