			Set_Transaction_Number as "Set_Transaction_Number"
			{
				type =  form
				form = Service

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Service_Type == "Remittance" || input.Service_Type == "Recharge")
										{
											vendor_rec = Vendor[ID == input.Vendor];
											if(vendor_rec != null)
											{
												vendor_acronyms = vendor_rec.Acronyms;
												vendor_counter = vendor_rec.Counter;
												// Alert when acronyms is empty
												if(vendor_acronyms == "")
												{
													openUrl("#Page:Warning_Message?mensaje=Vender Acronyms Not Found: this field was named 'UNK'.","popup window","height=143,width=380");
													vendor_rec.Acronyms="UNK";
												}
												// Create transaction number
												transaction_number = vendor_rec.Acronyms + "-" + vendor_counter;
												// Update field value
												input.Transaction_Number = transaction_number;
												// Increase counter
												vendor_rec.Counter=vendor_counter + 1;
											}
										}
						)
					}
				}

			}
			Validate_Amount as "Validate_Amount"
			{
				type =  form
				form = Service

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Service_Type == "Remittance" || input.Service_Type == "Recharge" && input.Amount > 0)
										{
											// Getting util fields
											commission = ifnull(input.Commission,0);
											// Amount field must be equal to Transaction Amount plus Commission
											if(input.Amount != input.Transaction_Amount + commission)
											{
												openUrl("#Page:Error_Message?mensaje=La suma de los campos Commission y Transaction Amount debe ser igual al valor del campo Amount. Por favor, revise los datos ingresados.","popup window","height=143,width=380");
												alert "Sum of 'Commission' plus 'Transaction Amount' fields must equal 'Amount' field.";
												cancel submit;
											}
											else if(input.Commission == null)
											{
												openUrl("#Page:Error_Message?mensaje=El campo Commission es requerido.","popup window","height=143,width=380");
												alert "The Commisssion field is required";
												cancel submit;
											}
										}
						)
					}
				}

			}
