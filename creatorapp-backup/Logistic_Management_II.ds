			Filter_Protections5 as "Filter_Protections"
			{
				type =  form
				form = Package

				record event = on add or edit

				on user input of Employee
				{
					actions 
					{
						custom deluge script
						(
											// Crea una lista vacía donde se guardarán las opciones válidas (IDs de Protecciones)
										pro_list = List();
										// Recorre los registros del subformulario 'Protections' dentro del Shipment seleccionado que cumplen las siguientes condiciones:
										// - Son activos
										// - No se encuentra en ninguna otra fila del subformulario Protections
										RealShipment = Shipment[ID == input.Shipment_Type];
										for each  p in RealShipment.Insurances
										{
											// Banderas para determinar si la Protection ya fue agregada en otra fila del subformulario. Además verificar si es activa 	
											exist = false;
											// Recorre todas las filas del subformulario 'Protections' del Shipment
											if(Insurance[ID = p.Insurance].Active == true)
											{
												// Recorre todas las filas del subformulario 'Protections' de la Box
												for each  registro in input.Insurances
												{
													// Si el ID de la Protection actual ya está seleccionado en alguna fila, lo marcamos como existente
													if(registro.Insurance == p.Insurance)
													{
														exist = true;
													}
												}
												// Si no fue encontrada en ninguna fila, la agregamos a la lista de opciones válidas
												if(exist == false)
												{
													pro_list.add(p.Insurance);
												}
											}
										}
										// Agrega dinámicamente al campo 'Protection' (en la UI) las opciones válidas encontradas
										for each  fila in input.Insurances
										{
											valor_actual = fila.Insurance;
											fila.Insurance:ui.add(pro_list);
											fila.Insurance=valor_actual;
										}
						)
					}
				}

			}
			Clear_Old_Protections2 as "Clear_Old_Protections"
			{
				type =  form
				form = Package

				record event = on add or edit

				on user input of Employee
				{
					actions 
					{
						custom deluge script
						(
											// Recorre los registros del subformulario 'Protections' dentro de la Box para validar cuales cumplen las siguientes condiciones:
										// - Son activos
										// - Es una Protection del nuevo Shipment
										RealShipment = Shipment[ID == input.Shipment_Type];
										Actual = input.Insurances;
										clear Insurances;
										for each  p in Actual
										{
											// Banderas para determinar si la Protection ya fue agregada en otra fila del subformulario. Además verificar si es activa 	
											pertenece = false;
											if(Insurance[ID = p.Insurance].Active == true)
											{
												// Recorre todas las filas del subformulario 'Protections' del Shipment
												for each  registro in RealShipment.Insurances
												{
													// Si el ID de la Protection actual es una de las protecciones del Shipment la marcamos como que pertenece
													if(p.Insurance == registro.Insurance)
													{
														pertenece = true;
													}
												}
											}
											// Si no pertenece al nuevo Shipment limpiamos la fila
											if(pertenece == true)
											{
												new_prot = Package.Insurances();
												new_prot.Insurance=p.Insurance;
												new_prot.Required=p.Required;
												new_prot.Previous_Insurance=p.Previous_Insurance;
												input.Insurances.insert(new_prot);
											}
										}
						)
					}
				}

			}
