			(
    			type = text
	 			row = 1
	 			column = 2   
				width = medium
			)
			Counter
			(
				type = number
				displayname = "Counter "
				initial value = 1
	 			row = 1
	 			column = 2   
				width = medium
			)
			Active
			(
    			type = checkbox
				initial value = true
	 			row = 1
	 			column = 2   
				width = medium
			)
			Shipping_Details
			(
				type = grid
				displayname = "Shipping Details"
				must have Shipping_Types
				(
					type = list	
					displayname = "Shipping Types"
					values = {"Air Express","Air","Maritime","Caja Pronto 15","Caja Pronto 12","Caja Naranja 15","Caja Naranja 12"}
					sortorder = ascending
					height = 60px
					width = medium
				)
				must have Types_of_Goods
				(
					type = list	
					displayname = "Types of Goods"
					values = {"Miscellaneous","Durables","Documents","Courier","Toilet Food Medicine"}
					sortorder = ascending
					height = 60px
					width = medium
				)
				must have Coverage_Locations
				(
					type = list	
					displayname = "Coverage Locations"
					values  = Coverage_Location[Active == true].ID
    				displayformat = [Location_Name]
					allow new entries
					[
						displayname = "Agregar nuevo"
					]
					sortorder = ascending
					height = 60px
					width = large
