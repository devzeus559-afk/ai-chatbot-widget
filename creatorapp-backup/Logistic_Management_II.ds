			Disable_PackageFields as "Disable_PackageFields"
			{
				type =  form
				form = Release

				record event = on add or edit

				on add row of Shipment_Details
				{
					actions 
					{
						custom deluge script
						(
											disable row.Package_Name;
										disable row.Package_Type;
										disable row.Status;
										disable row.Sender1;
										disable row.Receipt_Date;
										disable row.External_Tracking_Number;
