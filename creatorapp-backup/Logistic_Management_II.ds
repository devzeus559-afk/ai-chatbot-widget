			Create_Invoice as "Create_Invoice"
			{
				type =  functions
				form = Daily_Movement
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						RealOffice = Commercial_Office[ID == input.Office];
										pos = RealOffice.Book_Location.lastIndexOf(" - ");
										location = RealOffice.Book_Location.subString(pos + 3);
										RealEmployeeName = Employee[ID == input.Employee].Full_Name;
										RealService = Service[ID == input.Service];
										contact_id = "";
										// Buscar en Zoho CRM el contacto sender del Service
										search_result = zoho.crm.searchRecords("Contacts","(Mobile:equals:" + RealService.Sender_Mobile + ")");
										if(search_result.size() <= 0)
										{
											search_result = zoho.crm.searchRecords("Contacts","(Mobile:equals:" + RealService.Sender_Mobile.getsuffix("+") + ")");
										}
										// Si se encuentra al menos un contacto con ese número
										if(search_result.size() > 0)
										{
											// Asignar el ID del contacto al campo 'Sender_Contact' en Zoho Creator, como string
											contact_id = search_result.get(0).get("id").toString();
											//info contact_id;
										}
										else
										{
											openUrl("#Page:Error_Message?mensaje=Sender not found in CRM","popup window","height=143,width=380");
											//info "Sender not found in CRM";
										}
										//Buscar y/o crear Contacto como Customer en Zoho Books
										if(contact_id != "")
										{
											//info contact_id;
											// Buscar el contacto en Zoho Book
											//info RealService.Sender_Full_Name;
											search_customer = "contact_name=" + encodeUrl(RealService.Sender_Full_Name);
											customer = zoho.books.getRecords("Contacts","920092165",search_customer,"zc_books");
											//info customer.get("contacts").size();
											if(customer.get("contacts").size() == 0)
											{
												booksCustomer = invokeurl
												[
													url :"https://books.zoho.com/api/v3/crm/contact/" + contact_id + "/import?organization_id=" + "920092165"
													type :POST
													connection:"zc_books"
												];
												BookCustomID = booksCustomer.get("data").get("customer_id");
												//info "Primero " + BookCustomID;
											}
											else
											{
												customers = customer.get("contacts");
												//info customer.get("contacts");
												for each  contact in customers
												{
													phone1 = RealService.Sender_Mobile.replaceAll("[^0-9]","");
													phone2 = contact.get("mobile").replaceAll("[^0-9]","");
													//info phone1;
													//info phone2;
													//info contact.get("mobile");
													if(phone1.contains(phone2) && contact.get("contact_type") == "customer")
													{
														//info phone1;
														//info phone2;
														BookCustomID = contact.get("contact_id");
														//info "Real " + BookCustomID;
													}
													else
													{
														booksCustomer = invokeurl
														[
															url :"https://books.zoho.com/api/v3/crm/contact/" + contact_id + "/import?organization_id=" + "920092165"
															type :POST
															connection:"zc_books"
														];
														BookCustomID = booksCustomer.get("data").get("customer_id");
													}
												}
											}
										}
										listVar = List();
										if(RealService.Service_Type == "Package Receipt" || RealService.Service_Type == "Locker")
										{
											for each  Ship in input.Subtotal
											{
												items_component = Map();
												RealShipment = Shipment[Short_Name == Ship.Books_Items || Name == Ship.Books_Items && Office == input.Office];
												//info RealShipment.Book_Item_ID;
												if(RealShipment.Book_Item_ID != "" && RealShipment.Book_Item_ID != null)
												{
													//info Ship.Shipment_Type;
													//info RealShipment;
													pos = RealShipment.Book_Item_ID.lastIndexOf(" - ");
													item = RealShipment.Book_Item_ID.subString(pos + 3);
													//info RealShipment.Book_Item_ID;
													items_component.put("item_id",item);
													items_component.put("quantity",Ship.Quantity);
													items_component.put("rate",Ship.Unit_Price);
													items_component.put("description","Shipments");
													listVar.add(items_component);
												}
												else
												{
													openUrl("#Page:Error_Message?mensaje=There is no Shipmnet for " + Ship.Books_Items + " within this Service Type","popup window","height=143,width=380");
													//info "There is no Shipmnet for " + Ship.Books_Items + " within this Service Type";
												}
											}
										}
										else
										{
											for each  Ship in input.Subtotal
											{
												items_component = Map();
												RealItem = Book_Item[Service_Type == RealService.Service_Type && Book_Item_ID.contains(Ship.Books_Items)];
												if(RealItem.Book_Item_ID != "" && RealItem.Book_Item_ID != null)
												{
													pos = RealItem.Book_Item_ID.lastIndexOf(" - ");
													item = RealItem.Book_Item_ID.subString(pos + 3);
													items_component.put("item_id",item);
													items_component.put("quantity",Ship.Quantity);
													items_component.put("rate",Ship.Unit_Price);
													items_component.put("description",RealService.Service_Type);
													listVar.add(items_component);
												}
												else
												{
													openUrl("#Page:Error_Message?mensaje=There is no Book Item for " + Ship.Books_Items + " within this Service Type","popup window","height=143,width=380");
													//info "There is no Book Item for " + Ship.Books_Items + " within this Service Type";
												}
											}
										}
										total_card = 0;
										for each  PayMet in input.Payment_Information
										{
											tosuma = ifnull(PayMet.Fit_Credit_Card,0);
											total_card = total_card + tosuma;
										}
										if(total_card != 0)
										{
											items_component = Map();
											Book_Item = Book_Item[Service_Type == RealService.Service_Type && SubItem == "Fit Credit Card"];
											if(Book_Item.Book_Item_ID != "" && Book_Item.Book_Item_ID != null)
											{
												pos = Book_Item.Book_Item_ID.lastIndexOf(" - ");
												item1 = Book_Item.Book_Item_ID.subString(pos + 3);
												items_component.put("item_id",item1);
												items_component.put("quantity",1);
												items_component.put("rate",total_card);
												items_component.put("description","Fit Credit Card");
												listVar.add(items_component);
											}
											else
											{
												openUrl("#Page:Error_Message?mensaje=There is no Book Item for Credit Card payment within this Service Type","popup window","height=143,width=380");
												//info "There is no Book Item for Credit Card payment within this Service Type";
											}
										}
										if(input.Total_Customs_Duty != 0 && input.Total_Customs_Duty != null)
										{
											items_component = Map();
											Book_Item = Book_Item[Service_Type == RealService.Service_Type && SubItem == "Custom Duty"];
											if(Book_Item.Book_Item_ID != "" && Book_Item.Book_Item_ID != null)
											{
												pos = Book_Item.Book_Item_ID.lastIndexOf(" - ");
												item2 = Book_Item.Book_Item_ID.subString(pos + 3);
												items_component.put("item_id",item2);
												items_component.put("quantity",1);
												items_component.put("rate",input.Total_Customs_Duty);
												items_component.put("description","Custom Duty");
												listVar.add(items_component);
											}
											else
											{
												openUrl("#Page:Error_Message?mensaje=There is not Book Item for Custom Duty within this Service Type","popup window","height=143,width=380");
												//info "There is not Book Item for Custom Duty within this Service Type";
											}
										}
										if(input.Total_Packaging_Price != 0 && input.Total_Packaging_Price != null)
										{
											items_component = Map();
											Book_Item = Book_Item[Service_Type == RealService.Service_Type && SubItem == "Packaging"];
											if(Book_Item.Book_Item_ID != "" && Book_Item.Book_Item_ID != null)
											{
												pos = Book_Item.Book_Item_ID.lastIndexOf(" - ");
												item3 = Book_Item.Book_Item_ID.subString(pos + 3);
												items_component.put("item_id",item3);
												items_component.put("quantity",1);
												items_component.put("rate",input.Total_Packaging_Price);
												items_component.put("description","Packaging");
												listVar.add(items_component);
											}
											else
											{
												openUrl("#Page:Error_Message?mensaje=There is not Book Item for Packaging within this Service Type","popup window","height=143,width=380");
												//info "There is not Book Item for Packaging within this Service Type";
											}
										}
										if(RealService.Employee != null && Employee[ID == RealService.Employee].Full_Name.contains("VAN"))
										{
											items_component = Map();
											Book_Item = Book_Item[Service_Type == RealService.Service_Type && SubItem == "Pickup"];
											if(Book_Item.Book_Item_ID != "" && Book_Item.Book_Item_ID != null)
											{
												pos = Book_Item.Book_Item_ID.lastIndexOf(" - ");
												item5 = Book_Item.Book_Item_ID.subString(pos + 3);
												items_component.put("item_id",item5);
												items_component.put("quantity",1);
												items_component.put("rate",RealService.Pickup_Service);
												items_component.put("description","VAN Pickup");
												listVar.add(items_component);
											}
											else
											{
												openUrl("#Page:Error_Message?mensaje=There is not Book Item for VAN Pickup within this Service Type","popup window","height=143,width=380");
												//info "There is not Book Item for VAN Pickup within this Service Type";
											}
										}
										if(RealService.Service_Type == "Package Receipt" || RealService.Service_Type == "Locker")
										{
											Sumadiscount = 0;
											for each  packa in RealService.Packages
											{
												RealPackage = Package[ID == packa.Package_Name];
												if(RealPackage.Discount != 0 && RealPackage.Discount != null)
												{
													Sumadiscount = Sumadiscount + RealPackage.Discount;
												}
											}
											if(Sumadiscount != 0)
											{
												items_component = Map();
												Book_Item = Book_Item[Service_Type == RealService.Service_Type && SubItem == "Promotional Discount"];
												if(Book_Item.Book_Item_ID != "" && Book_Item.Book_Item_ID != null)
												{
													pos = Book_Item.Book_Item_ID.lastIndexOf(" - ");
													item4 = Book_Item.Book_Item_ID.subString(pos + 3);
													items_component.put("item_id",item4);
													items_component.put("quantity",1);
													items_component.put("rate",Sumadiscount * -1);
													items_component.put("description","Promotional Discount");
													listVar.add(items_component);
												}
												else
												{
													openUrl("#Page:Error_Message?mensaje=There is not Book Item for Promotional Discount within this Service Type","popup window","height=143,width=380");
													//info "There is not Book Item for Promotional Discount within this Service Type";
												}
											}
										}
										insurance_val = 0.0;
										for each  Pkg in RealService.Packages
										{
											RealPackage = Package[ID == Pkg.Package_Name];
											insurance_val = insurance_val + ifnull(RealPackage.Insured_value,0.0);
										}
										if(insurance_val != 0.0)
										{
											items_component = Map();
											Book_Item = Book_Item[Service_Type == RealService.Service_Type && SubItem == "Service Insurance"];
											if(Book_Item.Book_Item_ID != "" && Book_Item.Book_Item_ID != null)
											{
												pos = Book_Item.Book_Item_ID.lastIndexOf(" - ");
												item2 = Book_Item.Book_Item_ID.subString(pos + 3);
												items_component.put("item_id",item2);
												items_component.put("quantity",1);
												items_component.put("rate",insurance_val);
												items_component.put("description","Service Insurance");
												listVar.add(items_component);
											}
											else
											{
												openUrl("#Page:Error_Message?mensaje=There is not Book Item for Service Insurance within this Service Type","popup window","height=143,width=380");
												//info "There is not Book Item for Service Insurance within this Service Type";
											}
										}
										//info listVar;
										customFieldList = List();
										parameters_data = Map();
										customFieldMap1 = Map();
										//customFieldMap1.put('label','Pronto envío');
										customFieldMap1.put('value',true);
										customFieldList.add(customFieldMap1);
										customFieldMap1 = Map();
										customFieldMap1.put('label','Travel Date');
										customFieldMap1.put('value',today);
										customFieldList.add(customFieldMap1);
										parameters_data.put("line_items",listVar);
										parameters_data.put("date",RealService.Date_field1);
										parameters_data.put("location_id",location);
										parameters_data.put("salesperson_name",RealEmployeeName);
										parameters_data.put("template_id","8751034000000017001");
										//parameters_data.put("tax_authority_id","2478877000006717008");
										//parameters_data.put("tax_exemption_id","2478877000006717004");
										parameters_data.put("customer_id",BookCustomID);
										parameters_data.put('custom_fields',customFieldList);
										if(RealOffice.Office_Name.contains("West New York") || RealOffice.Office_Name.contains("VAN"))
										{
											parameters_data.put('template_id',8751034000000141601);
										}
										else if(RealOffice.Office_Name.contains("Elizabeth"))
										{
											parameters_data.put('template_id',8751034000000141487);
										}
										//info parameters_data.get("line_items");
										response = zoho.books.createRecord("Invoices","920092165",parameters_data,"zc_books");
										//info response;
										//info parameters_data;
										//info response.get("code");
										if(response.get("code") == 0)
										{
											//info response;
											vUrl = "https://books.zoho.com/app/920092165#/invoices/" + response.get("invoice").get("invoice_id");
											input.Invoice_ID = response.get("invoice").get("invoice_id");
											invoice_number = response.get("invoice").get("invoice_number");
											vUrl = vUrl + "?" + invoice_number;
											vUrl = vUrl + "%22%7D&sort_column=created_time&sort_order=D";
											Url = "<a target ='_blank' href='" + vUrl + "'>" + invoice_number + "</a>";
											input.Invoice_URL = Url;
											//openUrl(Url,"new window");
											input.Customer_in_Books = BookCustomID;
											openUrl("#Page:Successful_Message?mensaje=The invoice has been created successfully","popup window","height=143,width=380");
											//info "The invoice has been created successfully";
											/*for each  packg in RealService.Packages
																					{
																						openUrl("https://creatorapp.zoho.com/prontoenvios/logistic-management-v2/record-pdf/All_Packages/" + packg.Package_Name.toLong() + "/" + packg.Package_ID,"new window","successive=true");
																					}*/
										}
										else
										{
											openUrl("#Page:Error_Message?mensaje=Invoice not created. Message: " + response.get("message") + "","popup window","height=143,width=380");
											//info "Invoice not created. Message: " + response.get("message");
										}
					)
					}
				}
			}
			Create_Bill as "Create_Bill"
			{
				type =  functions
				form = Release
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						profile = thisapp.permissions.loginUserProfile();
										if(profile == "Administrator" || profile == "Counter" || profile == "Admin" && Was_Dispatched == true)
										{
											RealOffice = Commercial_Office[ID == input.Office];
											pos = RealOffice.Book_Location.lastIndexOf(" - ");
											location = RealOffice.Book_Location.subString(pos + 3);
											RealEmployeeName = Employee[ID == input.Employee].Full_Name;
											RealService = Service[ID == input.Service_Filter];
											contact_id = "";
											// Buscar el Vendor
											search_result = Vendor[ID == input.Freight_Forwarder];
											//info search_result.Vendor_ID;
											// Si se encuentra al menos un contacto con ese número
											if(search_result.ID != null)
											{
												// Asignar el ID del vendor al campo 'Vendor_field' en Zoho Creator, como string
												vendor_id = search_result.ID.toString();
												//info vendor_id;
											}
											else
											{
												openUrl("#Page:Error_Message?mensaje=Vendor not found in Creator","popup window","height=143,width=380");
												//info "Vendor not found in Creator";
											}
											//Buscar y/o crear Vendor como Vendor en Zoho Books
											if(vendor_id != "")
											{
												// Buscar el vendor en Zoho Book
												search_vendor = "vendor_name=" + encodeUrl(search_result.Vendor_Name);
												vendor = zoho.books.getRecords("Vendors","920092165",search_vendor,"zc_books");
												//info vendor;
												if(vendor.get("contacts").size() == 0)
												{
													NewVendor = Map();
													NewVendor.put("contact_name",search_result.Vendor_Name);
													NewVendor.put("contact_type","vendor");
													NewVendor.put("vendor_name",search_result.Vendor_Name);
													//NewVendor.put("first_name",search_result.Vendor_Name);
													//NewVendor.put("phone",search_result.Phone);
													contact_person = Map();
													contact_person.put("first_name",search_result.Vendor_Name);
													contact_person.put("phone",search_result.Phone);
													var = List();
													var.add(contact_person);
													NewVendor.put("contact_persons",var);
													booksVendor = invokeurl
													[
														url :"https://books.zoho.com/api/v3/contacts?organization_id=" + "920092165"
														type :POST
														body:NewVendor.toString()
														connection:"zc_books"
													];
													//info booksVendor;
													BookVendorID = booksVendor.get("contact").get("contact_id");
													//info BookVendorID;
												}
												else
												{
													vendors = vendor.get("contacts");
													//info vendors;
													for each  contact in vendors
													{
														phone1 = search_result.Phone.replaceAll("[^0-9]","");
														phone2 = contact.get("phone").replaceAll("[^0-9]","");
														//info phone1;
														//info phone2;
														if(phone1.contains(phone2))
														{
															//info phone1;
															//info phone2;
															BookVendorID = contact.get("contact_id");
															//info "Real " + BookVendorID;
														}
													}
													if(BookVendorID == null)
													{
														openUrl("#Page:Error_Message?mensaje=Vendor not found in Zoho Book or it has differente phone number","popup window","height=143,width=380");
														//info "Vendor not found in Zoho Book or it has differente phone number";
													}
												}
											}
											listVar = List();
											for each  Ship in input.Subtotal_by_Shipment
											{
												items_component = Map();
												RealShipment = Shipment[ID == Ship.Shipment_Type_ID];
												//info RealShipment;
												pos = RealShipment.Book_Item_ID.lastIndexOf(" - ");
												item = RealShipment.Book_Item_ID.subString(pos + 3);
												RealComission = RealShipment.Our_Commission * Ship.Quantity;
												//info RealShipment.Book_Item_ID;
												items_component.put("item_id",item);
												items_component.put("quantity",Ship.Quantity);
												items_component.put("rate",RealShipment.Basic_Price);
												items_component.put("description","Shipments");
												listVar.add(items_component);
											}
											if(input.Total_Customs_Duty != 0 && input.Total_Customs_Duty != null)
											{
												it_component = Map();
												Book_Item = Book_Item[Service_Type == "Package Receipt" && SubItem == "Custom Duty"];
												pos = Book_Item.Book_Item_ID.lastIndexOf(" - ");
												item2 = Book_Item.Book_Item_ID.subString(pos + 3);
												it_component.put("item_id",item2);
												it_component.put("quantity",1);
												it_component.put("rate",input.Total_Customs_Duty);
												it_component.put("description","Custom Duty");
												listVar.add(it_component);
											}
											customFieldList = List();
											parameters_data = Map();
											parameters_data.put("vendor_id",BookVendorID);
											parameters_data.put("bill_number",input.Release_Name);
											customFieldMap1 = Map();
											//customFieldMap1.put('label','Pronto envío');
											customFieldMap1.put('value',true);
											customFieldList.add(customFieldMap1);
											customFieldMap1 = Map();
											customFieldList.add(customFieldMap1);
											parameters_data.put("line_items",listVar);
											parameters_data.put("date",today);
											parameters_data.put("location_id",location);
											parameters_data.put("salesperson_name",RealEmployeeName);
											//parameters_data.put("template_id","2478877000005172003");
											//parameters_data.put("tax_authority_id","2478877000006717008");
											//parameters_data.put("tax_exemption_id","2478877000006717004");
											parameters_data.put('custom_fields',customFieldList);
											response = zoho.books.createRecord("Bills","920092165",parameters_data,"zc_books");
											//info response;
											//info parameters_data;
											//info listVar;
											if(response.get("code") == 0)
											{
												//info response;
												vUrl = "https://books.zoho.com/app/920092165#/bills/" + response.get("bill").get("bill_id");
												//quitar comentario para que en la lista solo aparezca el bill
												//Url = Url + "?filter_by=Status.All&per_page=200&search_criteria=%7B%22search_text%22%3A%22";
												input.Bill_ID = response.get("bill").get("bill_id");
												bill_number = response.get("bill").get("bill_number");
												vUrl = vUrl + "?" + bill_number;
												vUrl = vUrl + "%22%7D&sort_column=created_time&sort_order=D";
												Url = "<a target ='_blank' href='" + vUrl + "'>" + bill_number + "</a>";
												input.Bill_URL = Url;
												//openUrl(Url,"new window");
												input.Vendor_in_Books = BookVendorID;
												openUrl("#Page:Successful_Message?mensaje=The Bill has been created successfully","popup window","height=143,width=380");
												//info "The bill has been created successfully";
											}
											else
											{
												openUrl("#Page:Error_Message?mensaje=Bill not created: " + response.get("message") + "","popup window","height=143,width=380");
												//info "Bill not created: " + response.get("message");
												//search_billito = "bill_id=" + encodeUrl("2478877000023437085");
												//bilito = zoho.books.getRecords("Bills","920092165",search_billito,"zc_books");
												//info bilito;
											}
										}
										else if(Was_Dispatched == false)
										{
											openUrl("#Page:Error_Message?mensaje=Sorry, the release is not dispatched yet","popup window","height=143,width=380");
											//info "Sorry, the release is not dispatched yet";
										}
										else
										{
											openUrl("#Page:Error_Message?mensaje=Sorry, you do not have permission to create this Bill","popup window","height=143,width=380");
											//info "Sorry, you do not have permission to create this Bill";
										}
					)
					}
				}
			}
			Complete_Service as "Complete_Service"
			{
				type =  functions
				form = Service
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						// Read system ID var
										currentID = thisapp.variables.DAILYMOVEMENT_ID;
										// Create new ID with zero-left-padding style
										dailyid = thisapp.zeroLeftPad(5,currentID);
										// Create the Daily_Movement_Name
										actualid = "DM " + dailyid;
										allrows = Collection();
										for each  fila in input.Payment_Information
										{
											row1 = Daily_Movement.Payment_Information();
											row1.Payment_Method=fila.Payment_Method;
											row1.Fit_Credit_Card=fila.Fit_Credit_Card;
											row1.Amount=fila.Amount;
											row1.Cash_Flow=fila.Cash_Flow;
											row1.Fit=fila.Fit;
											row1.Total_To_Pay1=fila.Total_To_Pay;
											allrows.insert(row1);
										}
										// === Create auxiliar vars to populate 'Subtotal' subform ===
										subtotals = Collection();
										// Calculate Subtotal values By Service using utility function
										subtotal_data = Map();
										subtotal_data = thisapp.getDMSubtotalByService(input.ID);
										subtotal_items = subtotal_data.get("Items");
										// Populate 'Subtotal' subform
										if(subtotal_items != null)
										{
											for each  i in subtotal_items.keys()
											{
												subtotal_row = Daily_Movement.Subtotal();
												subtotal_row.Books_Items=subtotal_data.get("Items").get(i);
												subtotal_row.Quantity=subtotal_data.get("Quantity").get(i);
												subtotal_row.Unit_Price=subtotal_data.get("Unit_Price").get(i);
												subtotal_row.Total_Price=subtotal_data.get("Total_Price").get(i);
												subtotals.insert(subtotal_row);
											}
										}
										//Tomando el valor de Amount
										if(input.Service_Type == "Package Receipt" || input.Service_Type == "Locker")
										{
											totalamount = input.Price;
										}
										else
										{
											totalamount = input.Amount;
										}
										// Crear nuevo registro 
										new_movement = insert into Daily_Movement
										[
											Daily_Movement_ID=actualid
											Employee=input.Employee
											Office=input.Office
											Daily_Movement_Type="Incoming"
											Service=input.ID
											Payment_Information=allrows
											Subtotal=subtotals
											Total_Customs_Duty=input.Total_Custom_Duty
											Amount_Concept=totalamount
											Total_Packaging_Price=input.Total_Packaging_Price
											Added_User=zoho.loginuser
										];
										openUrl("#Page:Successful_Message?mensaje=The Daily Movement has been created successfully","popup window","height=143,width=380");
										thisapp.variables.DAILYMOVEMENT_ID = thisapp.variables.DAILYMOVEMENT_ID + 1;
										//
										//Poniendo en CashFlow
										//
										// Suponiendo que 'input' es el registro actual de Daily_Movements
										RealDM = Daily_Movement[ID == new_movement];
										office_id = input.Office;
										movement_type = "Incoming";
										// Buscar los Cash_Flow para la misma oficina y actulizarlos
										for each  cashf in RealDM.Payment_Information
										{
											if(cashf.Payment_Method == "Cash")
											{
												matching_cash_flows = Cash_Flow[Status == "Pending" && Office == office_id && ID == cashf.Cash_Flow];
												if(matching_cash_flows.count() > 0)
												{
													if(movement_type == "Incoming")
													{
														matching_cash_flows.Total_Incoming=ifnull(matching_cash_flows.Total_Incoming,0) + ifnull(cashf.Amount,0);
														RealDM.In_Cash_Flows=true;
														if(matching_cash_flows.Created_Date_Time < today)
														{
															all_affected_cash = Cash_Flow[Created_Date_Time > matching_cash_flows.Created_Date_Time && Office == office_id];
															for each  affected in all_affected_cash
															{
																affected.Opening_Balance=affected.Opening_Balance + ifnull(cashf.Amount,0);
															}
														}
													}
													else if(movement_type == "Outgoing")
													{
														matching_cash_flows.Total_Outgoing=ifnull(matching_cash_flows.Total_Outgoing,0) + ifnull(cashf.Amount,0);
														RealDM.In_Cash_Flows=true;
														if(matching_cash_flows.Created_Date_Time < today)
														{
															all_affected_cash = Cash_Flow[Created_Date_Time > matching_cash_flows.Created_Date_Time && Office == office_id];
															for each  affected in all_affected_cash
															{
																affected.Opening_Balance=affected.Opening_Balance - ifnull(cashf.Amount,0);
															}
														}
													}
													// Agregar la fila al subformulario Related_Daily_Movements
													fila1 = Cash_Flow.Related_Daily_Movements();
													fila1.Daily_Movement=RealDM.ID;
													fila1.Date_field=today;
													fila1.Daily_Movement_Type="Incoming";
													fila1.Total_to_Pay=cashf.Total_To_Pay1;
													matching_cash_flows.Related_Daily_Movements.insert(fila1);
												}
												else
												{
													openUrl("#Page:Error_Message?mensaje=The associated Cash Flow was not found as unapproved and/or related to this office.","popup window","height=143,width=380");
													//info "The associated Cash Flow was not found as unapproved and/or related to this office.";
												}
											}
										}
										//
										//Creando Invoice
										//
										RealOffice = Commercial_Office[ID == input.Office];
										pos = RealOffice.Book_Location.lastIndexOf(" - ");
										location = RealOffice.Book_Location.subString(pos + 3);
										RealEmployeeName = Employee[ID == input.Employee].Full_Name;
										RealService = Service[ID == RealDM.Service];
										contact_id = "";
										// Buscar en Zoho CRM el contacto sender del Service
										search_result = zoho.crm.searchRecords("Contacts","(Mobile:equals:" + RealService.Sender_Mobile + ")");
										if(search_result.size() <= 0)
										{
											search_result = zoho.crm.searchRecords("Contacts","(Mobile:equals:" + RealService.Sender_Mobile.getsuffix("+") + ")");
										}
										// Si se encuentra al menos un contacto con ese número
										if(search_result.size() > 0)
										{
											// Asignar el ID del contacto al campo 'Sender_Contact' en Zoho Creator, como string
											contact_id = search_result.get(0).get("id").toString();
											//info contact_id;
										}
										else
										{
											openUrl("#Page:Error_Message?mensaje=Sender not found in CRM","popup window","height=143,width=380");
											//info "Sender not found in CRM";
										}
										//Buscar y/o crear Contacto como Customer en Zoho Books
										if(contact_id != "")
										{
											//info contact_id;
											// Buscar el contacto en Zoho Book
											search_customer = "contact_name=" + encodeUrl(RealService.Sender_Full_Name);
											customer = zoho.books.getRecords("Contacts","920092165",search_customer,"zc_books");
											//info customer;
											//info customer.get("contacts").size();
											if(customer.get("contacts").size() == 0)
											{
												booksCustomer = invokeurl
												[
													url :"https://books.zoho.com/api/v3/crm/contact/" + contact_id + "/import?organization_id=" + "920092165"
													type :POST
													connection:"zc_books"
												];
												BookCustomID = booksCustomer.get("data").get("customer_id");
												//info "Primero " + BookCustomID;
											}
											else
											{
												customers = customer.get("contacts");
												for each  contact in customers
												{
													phone1 = RealService.Sender_Mobile.replaceAll("[^0-9]","");
													phone2 = contact.get("mobile").replaceAll("[^0-9]","");
													//info contact.get("mobile");
													if(phone1.contains(phone2) && contact.get("contact_type") == "customer")
													{
														//info phone1;
														//info phone2;
														BookCustomID = contact.get("contact_id");
														//info "Real " + BookCustomID;
													}
													else
													{
														booksCustomer = invokeurl
														[
															url :"https://books.zoho.com/api/v3/crm/contact/" + contact_id + "/import?organization_id=" + "920092165"
															type :POST
															connection:"zc_books"
														];
														BookCustomID = booksCustomer.get("data").get("customer_id");
													}
												}
											}
										}
										listVar = List();
										if(RealService.Service_Type == "Package Receipt" || RealService.Service_Type == "Locker")
										{
											for each  Ship in RealDM.Subtotal
											{
												items_component = Map();
												RealShipment = Shipment[Short_Name == Ship.Books_Items || Name == Ship.Books_Items && Office == input.Office];
												if(RealShipment.Book_Item_ID != "" && RealShipment.Book_Item_ID != null)
												{
													//info Ship.Shipment_Type;
													//info RealShipment;
													pos = RealShipment.Book_Item_ID.lastIndexOf(" - ");
													item = RealShipment.Book_Item_ID.subString(pos + 3);
													//info RealShipment.Book_Item_ID;
													items_component.put("item_id",item);
													items_component.put("quantity",Ship.Quantity);
													items_component.put("rate",Ship.Unit_Price);
													items_component.put("description","Shipments");
													listVar.add(items_component);
												}
												else
												{
													openUrl("#Page:Error_Message?mensaje=There is no Shipmnet for " + Ship.Books_Items + " within this Service Type","popup window","height=143,width=380");
													//info "There is no Shipmnet for " + Ship.Books_Items + " within this Service Type";
												}
											}
										}
										else
										{
											for each  Ship in RealDM.Subtotal
											{
												items_component = Map();
												RealItem = Book_Item[Service_Type == RealService.Service_Type && Book_Item_ID.contains(Ship.Books_Items)];
												if(RealItem.Book_Item_ID != "" && RealItem.Book_Item_ID != null)
												{
													pos = RealItem.Book_Item_ID.lastIndexOf(" - ");
													item = RealItem.Book_Item_ID.subString(pos + 3);
													items_component.put("item_id",item);
													items_component.put("quantity",Ship.Quantity);
													items_component.put("rate",Ship.Unit_Price);
													items_component.put("description",RealService.Service_Type);
													listVar.add(items_component);
												}
												else
												{
													openUrl("#Page:Error_Message?mensaje=There is no Book Item for " + Ship.Books_Items + " within this Service Type","popup window","height=143,width=380");
													//info "There is no Book Item for " + Ship.Books_Items + " within this Service Type";
												}
											}
										}
										total_card = 0;
										for each  PayMet in RealDM.Payment_Information
										{
											tosuma = ifnull(PayMet.Fit_Credit_Card,0);
											total_card = total_card + tosuma;
										}
										if(total_card != 0)
										{
											items_component = Map();
											Book_Item = Book_Item[Service_Type == RealService.Service_Type && SubItem == "Fit Credit Card"];
											if(Book_Item.Book_Item_ID != "" && Book_Item.Book_Item_ID != null)
											{
												pos = Book_Item.Book_Item_ID.lastIndexOf(" - ");
												item1 = Book_Item.Book_Item_ID.subString(pos + 3);
												items_component.put("item_id",item1);
												items_component.put("quantity",1);
												items_component.put("rate",total_card);
												items_component.put("description","Fit Credit Card");
												listVar.add(items_component);
											}
											else
											{
												openUrl("#Page:Error_Message?mensaje=There is no Book Item for Credit Card payment within this Service Type","popup window","height=143,width=380");
												//info "There is no Book Item for Credit Card payment within this Service Type";
											}
										}
										if(RealDM.Total_Customs_Duty != 0 && RealDM.Total_Customs_Duty != null)
										{
											items_component = Map();
											Book_Item = Book_Item[Service_Type == RealService.Service_Type && SubItem == "Custom Duty"];
											if(Book_Item.Book_Item_ID != "" && Book_Item.Book_Item_ID != null)
											{
												pos = Book_Item.Book_Item_ID.lastIndexOf(" - ");
												item2 = Book_Item.Book_Item_ID.subString(pos + 3);
												items_component.put("item_id",item2);
												items_component.put("quantity",1);
												items_component.put("rate",RealDM.Total_Customs_Duty);
												items_component.put("description","Custom Duty");
												listVar.add(items_component);
											}
											else
											{
												openUrl("#Page:Error_Message?mensaje=There is no Book Item for Custom Duty within this Service Type","popup window","height=143,width=380");
												//info "There is no Book Item for Custom Duty within this Service Type";
											}
										}
										if(RealDM.Total_Packaging_Price != 0 && RealDM.Total_Packaging_Price != null)
										{
											items_component = Map();
											Book_Item = Book_Item[Service_Type == RealService.Service_Type && SubItem == "Packaging"];
											if(Book_Item.Book_Item_ID != "" && Book_Item.Book_Item_ID != null)
											{
												pos = Book_Item.Book_Item_ID.lastIndexOf(" - ");
												item3 = Book_Item.Book_Item_ID.subString(pos + 3);
												items_component.put("item_id",item3);
												items_component.put("quantity",1);
												items_component.put("rate",input.Total_Packaging_Price);
												items_component.put("description","Packaging");
												listVar.add(items_component);
											}
											else
											{
												openUrl("#Page:Error_Message?mensaje=There is no Book Item for Packaging within this Service Type","popup window","height=143,width=380");
												//info "There is no Book Item for Packaging within this Service Type";
											}
										}
										if(Employee != null && Employee[ID == input.Employee].Full_Name.contains("VAN"))
										{
											items_component = Map();
											Book_Item = Book_Item[Service_Type == input.Service_Type && SubItem == "Pickup"];
											if(Book_Item.Book_Item_ID != "" && Book_Item.Book_Item_ID != null)
											{
												pos = Book_Item.Book_Item_ID.lastIndexOf(" - ");
												item5 = Book_Item.Book_Item_ID.subString(pos + 3);
												items_component.put("item_id",item5);
												items_component.put("quantity",1);
												items_component.put("rate",input.Pickup_Service);
												items_component.put("description","VAN Pickup");
												listVar.add(items_component);
											}
											else
											{
												openUrl("#Page:Error_Message?mensaje=There is not Book Item for VAN Pickup within this Service Type","popup window","height=143,width=380");
												//info "There is not Book Item for VAN Pickup within this Service Type";
											}
										}
										if(RealService.Service_Type == "Package Receipt" || RealService.Service_Type == "Locker")
										{
											Sumadiscount = 0;
											for each  packa in RealService.Packages
											{
												RealPackage = Package[ID == packa.Package_Name];
												if(RealPackage.Discount != 0 && RealPackage.Discount != null)
												{
													Sumadiscount = Sumadiscount + RealPackage.Discount;
												}
											}
											if(Sumadiscount != 0)
											{
												items_component = Map();
												Book_Item = Book_Item[Service_Type == RealService.Service_Type && SubItem == "Promotional Discount"];
												if(Book_Item.Book_Item_ID != "" && Book_Item.Book_Item_ID != null)
												{
													pos = Book_Item.Book_Item_ID.lastIndexOf(" - ");
													item4 = Book_Item.Book_Item_ID.subString(pos + 3);
													items_component.put("item_id",item4);
													items_component.put("quantity",1);
													items_component.put("rate",Sumadiscount * -1);
													items_component.put("description","Promotional Discount");
													listVar.add(items_component);
												}
												else
												{
													openUrl("#Page:Error_Message?mensaje=There is no Book Item for Promotional Discount within this Service Type","popup window","height=143,width=380");
													//info "There is no Book Item for Promotional Discount within this Service Type";
												}
											}
										}
										insurance_val = 0.0;
										for each  Pkg in input.Packages
										{
											RealPackage = Package[ID == Pkg.Package_Name];
											insurance_val = insurance_val + ifnull(RealPackage.Insured_value,0.0);
										}
										if(insurance_val != 0.0)
										{
											items_component = Map();
											Book_Item = Book_Item[Service_Type == RealService.Service_Type && SubItem == "Service Insurance"];
											if(Book_Item.Book_Item_ID != "" && Book_Item.Book_Item_ID != null)
											{
												pos = Book_Item.Book_Item_ID.lastIndexOf(" - ");
												item2 = Book_Item.Book_Item_ID.subString(pos + 3);
												items_component.put("item_id",item2);
												items_component.put("quantity",1);
												items_component.put("rate",insurance_val);
												items_component.put("description","Service Insurance");
												listVar.add(items_component);
											}
											else
											{
												openUrl("#Page:Error_Message?mensaje=There is not Book Item for Service Insurance within this Service Type","popup window","height=143,width=380");
												//info "There is not Book Item for Service Insurance within this Service Type";
											}
										}
										customFieldList = List();
										parameters_data = Map();
										customFieldMap1 = Map();
										//customFieldMap1.put('label','Pronto envío');
										customFieldMap1.put('value',true);
										customFieldList.add(customFieldMap1);
										customFieldMap1 = Map();
										customFieldMap1.put('label','Travel Date');
										customFieldMap1.put('value',today);
										customFieldList.add(customFieldMap1);
										parameters_data.put("line_items",listVar);
										parameters_data.put("date",RealService.Date_field1);
										parameters_data.put("location_id",location);
										parameters_data.put("salesperson_name",RealEmployeeName);
										parameters_data.put("template_id","8751034000000017001");
										//parameters_data.put("tax_authority_id","2478877000006717008");
										//parameters_data.put("tax_exemption_id","2478877000006717004");
										parameters_data.put("customer_id",BookCustomID);
										parameters_data.put('custom_fields',customFieldList);
										if(RealOffice.Office_Name.contains("West New York") || RealOffice.Office_Name.contains("VAN"))
										{
											parameters_data.put('template_id',8751034000000141601);
										}
										else if(RealOffice.Office_Name.contains("Elizabeth"))
										{
											parameters_data.put('template_id',8751034000000141487);
										}
										response = zoho.books.createRecord("Invoices","920092165",parameters_data,"zc_books");
										//info response;
										//info parameters_data;
										if(response.get("code") == 0)
										{
											//info response;
											vUrl = "https://books.zoho.com/app/920092165#/invoices/" + response.get("invoice").get("invoice_id");
											RealDM.Invoice_ID=response.get("invoice").get("invoice_id");
											invoice_number = response.get("invoice").get("invoice_number");
											vUrl = vUrl + "?" + invoice_number;
											vUrl = vUrl + "%22%7D&sort_column=created_time&sort_order=D";
											Url = "<a target ='_blank' href='" + vUrl + "'>" + invoice_number + "</a>";
											RealDM.Invoice_URL=Url;
											//openUrl(Url,"new window");
											RealDM.Customer_in_Books=BookCustomID;
											openUrl("#Page:Successful_Message?mensaje=The Invoice has been created successfully","popup window","height=143,width=380");
											//info "The invoice has been created successfully";
											/*for each  packg in input.Packages
																					{
																						openUrl("https://creatorapp.zoho.com/prontoenvios/logistic-management-v2/record-pdf/All_Packages/" + packg.Package_Name.toLong() + "/" + packg.Package_ID,"new window","successive=true");
																					}*/
										}
										else
										{
											openUrl("#Page:Error_Message?mensaje=Invoice not created. Message: " + response.get("message") + "","popup window","height=143,width=380");
											//info "Invoice not created. Message: " + response.get("message");
										}
					)
					}
				}
			}
