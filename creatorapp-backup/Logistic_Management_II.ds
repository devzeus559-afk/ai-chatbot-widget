				type =  form
				form = Package

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Created_by_Form == true)
										{
											RealEmployee = Employee[Full_Name.contains("VAN")];
											input.Employee = RealEmployee.ID;
											RealOffice = Commercial_Office[Office_Name.contains("VAN")];
											input.Office = RealOffice.ID;
											RealLocation = Coverage_Location[Address_Information1.state_province == input.Province_by_Form && Address_Information1.country == input.Country_by_Form];
											if(RealLocation.ID != null)
											{
												input.Location = RealLocation.ID;
											}
											else
											{
												new_location = insert into Coverage_Location
												[
													Added_User=zoho.loginuser
													Address_Information1.state_province=input.Province_by_Form
													Address_Information1.country=input.Country_by_Form
													Active=true
													Location_Name=input.Province_by_Form + " - " + input.Country_by_Form
												];
												input.Location = new_location;
											}
											RealShipment = Shipment[Shipping_Type == input.Shipment_Method_by_Form && Type_of_Merchandise == input.Type_of_Merchandise_by_Form && Name.contains(input.Country_by_Form) && Total_Price == input.Shipment_Price_by_Form];
											input.Shipment_Type = RealShipment.ID;
											if(RealShipment.ID != null)
											{
												insured_value = ifnull(input.Insured_value,0.0);
												protection_price = ifnull(input.Insurance_Price,0.0);
												extended_address_price = ifnull(input.Extended_Address_Charge,0.0);
												discount = ifnull(input.Discount,0.0);
												// Check shipment type and calculate shipment price
												auto_calc_total_price = Shipment[ID == input.Shipment_Type].Auto_Calculate_Total_Price;
												if(auto_calc_total_price == true)
												{
													input.Auto_Calculate_Total_Price = true;
													RealShipment2 = Shipment[ID == RealShipment.ID];
													shipment_price = 0.0;
													if(RealShipment2.ID != null)
													{
														if(RealShipment.Price_Form == "By Weight")
														{
															weight = ifnull(input.Total_Weight,0.0);
														}
														// Get weight component by volumetric weight
														else if(RealShipment.Price_Form == "By Volumetric weight")
														{
															weight = ifnull(input.Volumetric_weight,0.0);
														}
														else if(RealShipment.Price_Form == "By Greater weight")
														{
															if(input.Total_Weight >= input.Volumetric_weight)
															{
																weight = ifnull(input.Total_Weight,0.0);
															}
															else
															{
																weight = ifnull(input.Volumetric_weight,0.0);
															}
														}
														// Get weight component per package
														else
														{
															weight = 1;
														}
														// Update shipment price
														shipment_price = ifnull(RealShipment2.Total_Price,0.0) * weight;
													}
													// Update 'Shipment Price' and 'Total Price' field
													input.Shipment_Price = shipment_price;
												}
												input.Total_Price = insured_value + input.Shipment_Price + protection_price + extended_address_price - discount;
											}
										}
						)
					}
				}

			}
