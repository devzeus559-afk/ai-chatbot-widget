		default list All_Contacts
		{
			displayName = "All Contacts"
			show all rows from Contacts    
			(
				First_Name  as "Name"
				Mobile
				(
					displayformat = plainnumber 
				)
				Email
				DNI
				Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				CRM_Contact_ID as "CRM Contact ID"
				Type_field as "Type"
				ID
				Active
				Added_Time as "Added Time"
				Added_User as "Added User"
				Modified_User as "Modified User"
				Modified_Time as "Modified Time"
			)
			filters
			(
				"Senders de Kendall Office"  :  Type_field.contains("Sender") && Added_User.contains("kendalloffice_quooti")
				"Senders Miami"  :  Type_field.contains("Sender") || Type_field.contains("Sender & Receiver") && Added_User.contains("kendalloffice_quooti")
			)
			sort by
			(
				Added_Time descending
			)
		}
