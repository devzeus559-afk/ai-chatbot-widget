			Set_Update_ShipmentPrice_ as "Set&Update_ShipmentPrice&TotalPrice"
			{
				type =  form
				form = Package

				record event = on add or edit

				on user input of Shipment_Type
				{
					actions 
					{
						custom deluge script
						(
											// Check shipment type and calculate shipment price
										shipment_price = 0.0;
										//if(input.Shipment_Type != null && input.Auto_Calculate_Total_Price == true)
										if(input.Shipment_Type != null)
										{
											// Calculate 'Shipment Price' by 'Price Form'
											RealShipment = Shipment[ID == input.Shipment_Type];
											if(RealShipment != null)
											{
												// Get shipment unit price
												shipment_unit_price = ifnull(RealShipment.Total_Price,0);
												// Calculate shipment price by weight
												if(RealShipment.Price_Form == "By Weight" && input.Total_Weight > 0.0)
												{
													shipment_price = input.Total_Weight * shipment_unit_price;
												}
												else if(RealShipment.Price_Form == "By Weight" && input.Total_Weight == 0.0)
												{
													openUrl("#Page:Warning_Message?mensaje=Total Weight field has a wrong value.","popup window","height=143,width=380");
													//alert "'Total Weight field has a wrong value.";
												}
												// Calculate shipment price by volumetric weight
												else if(RealShipment.Price_Form == "By Volumetric weight" && input.Volumetric_weight > 0.0)
												{
													shipment_price = input.Volumetric_weight * shipment_unit_price;
												}
												else if(RealShipment.Price_Form == "By Volumetric weight" && input.Volumetric_weight == 0.0)
												{
													openUrl("#Page:Warning_Message?mensaje=Volumetric weight field has a wrong value (Review required fields: Length / Width / Height).","popup window","height=143,width=380");
													//alert "'Volumetric weight field has a wrong value (Review required fields: Length / Width / Height).";
												}
												else if(RealShipment.Price_Form == "By Greater weight")
												{
													if(input.Total_Weight >= input.Volumetric_weight && input.Total_Weight > 0.0)
													{
														shipment_price = input.Total_Weight * shipment_unit_price;
													}
													else if(input.Total_Weight >= input.Volumetric_weight && input.Total_Weight == 0.0)
													{
														openUrl("#Page:Warning_Message?mensaje=Total Weight field has a wrong value.","popup window","height=143,width=380");
														//alert "'Total Weight field has a wrong value.";
													}
													else if(input.Total_Weight < input.Volumetric_weight && input.Volumetric_weight > 0.0)
													{
														shipment_price = input.Volumetric_weight * shipment_unit_price;
													}
													else if(input.Total_Weight < input.Volumetric_weight && input.Volumetric_weight == 0.0)
													{
														openUrl("#Page:Warning_Message?mensaje=Volumetric weight field has a wrong value (Review required fields: Length / Width / Height).","popup window","height=143,width=380");
														//alert "'Volumetric weight field has a wrong value (Review required fields: Length / Width / Height).";
													}
												}
												// Calculate shipment price by number of products
												else if(RealShipment.Price_Form == "By Package" && input.Number_of_Products1 == 0)
												{
													openUrl("#Page:Warning_Message?mensaje=Number of product must be greater than 0.","popup window","height=143,width=380");
													//alert "'Volumetric weight field has a wrong value (Review required fields: Length / Width / Height).";
												}
												else if(RealShipment.Price_Form == "By Package" && input.Number_of_Products1 > 0)
												{
													// Add number of products if calculate Shipment Price in Documents
													if(Package_Type == "Documents")
													{
														shipment_price = input.Number_of_Products1 * shipment_unit_price;
													}
													else
													{
														shipment_price = shipment_unit_price;
													}
												}
											}
											// Load utils params
											insured_value = ifnull(input.Insured_value,0.0);
											protection = ifnull(input.Insurance_Price,0.0);
											extended_address = ifnull(input.Extended_Address_Charge,0.0);
											discount = ifnull(input.Discount,0.0);
											// Calculate 'Total Price' field
											input.Shipment_Price = shipment_price;
											input.Total_Price = insured_value + shipment_price + protection + extended_address - discount;
										}
										else if(input.Shipment_Type == null)
										{
											input.Shipment_Price = 0.0;
											input.Total_Price = 0.0;
										}
										/*else if(input.Auto_Calculate_Total_Price == false)
																				{
																					input.Shipment_Price = 0.0;
																					input.Total_Price = 0.0;
																				}*/
						)
					}
				}

			}
