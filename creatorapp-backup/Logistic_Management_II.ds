		page Public_Tracking(int pkg_id, string search_code)
		{
			displayname = "Public Tracking"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\twebDeviceConfig='{\"layout\":{\"displayType\":\"card\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'\n\t\t\n\t\t\n\t\t\ttabletDeviceConfig='{\"layout\":{\"displayType\":\"card\",\"design\":\"onebyone\",\"forcedOrientation\":false}}'\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '5px'\n\tpaddingLeft = '10px'\n\tpaddingRight = '0px'\n\tpaddingBottom = '5px'\n\tbgColor = 'theme'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '5px'\n\tmarginTop = '5px'\n\n    borderColor = '#2D2D2D'\n    borderWidth = '0px'\n\tcolor = '#2D2D2D'\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\twidth = '130px'\n\theight = '37.2625px'\n\ttype = 'gallery'\n\tvalue = 'tracking-banner.png'\n\tcornerRadius = '0px'\n/>\n</pc><pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '5px' \n\tmarginBottom = '5px'\n\tmarginTop = '0px'\n\tpadding = '0px'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n\titalic = 'true' \n\tfontFamily = 'arimo, sans-serif' \n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n\n\t  value = 'Seguimiento de Env\u00EDos'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<form \n\telementName='Form'\n\n\tappLinkName = 'thisapp'\n\tlinkName = 'Pkg_Tracking_Search'\n\tallowPublicAccess = 'true'\n\theightType = 'auto'\n\turlType = 'none'\n\tzc_Header = 'false'\n/> \n</column>\n</row>\n</layout>\n</zml>"
