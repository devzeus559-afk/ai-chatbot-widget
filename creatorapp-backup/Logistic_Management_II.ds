				)
				Length_in_cm
				(
					type = decimal
					displayname = "Length in cm"
					width = 100px
				)
				Height_in_cm
				(
					type = decimal
					displayname = "Height in cm"
					width = 100px
				)
				must have Total_Weight
				(
					type = decimal
					displayname = "Total Weight"
					width = 80px
