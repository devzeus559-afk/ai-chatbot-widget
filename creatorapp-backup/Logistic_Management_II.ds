			Get_Required_Protections_1 as "Get_Required_Protections&UpdTotalPrice"
			{
				type =  form
				form = Package

				record event = on add or edit

				on user input of Shipment_Type
				{
					actions 
					{
						custom deluge script
						(
											// Crea una lista vacía donde se guardarán las opciones válidas (IDs de Protecciones)
										pro_list = List();
										// Recorre los registros del subformulario 'Protections' dentro del Shipment seleccionado que cumplen las siguientes condiciones:
										// - Son activos
										// - Son requeridos por el Shipment
										// - No se encuentra en ninguna otra fila del subformulario Protections como requeridos
										RealShipment = Shipment[ID == input.Shipment_Type];
										for each  p in RealShipment.Insurances
										{
											// Banderas para determinar si la Protection ya fue agregada en otra fila del subformulario como requerida. Además verificar si es activa y si es requerido por el Shipment	
											exist = false;
											// Recorre todas las filas del subformulario 'Protections' del Shipment
											if(Insurance[ID = p.Insurance].Active == true && p.Required == true)
											{
												// Recorre todas las filas del subformulario 'Protections' de la Box
												for each  registro in input.Insurances
												{
													// Si el ID de la Protection actual ya está seleccionado en alguna fila y está como requerido, lo marcamos como existente
													if(registro.Insurance == p.Insurance && registro.Required == true)
													{
														exist = true;
													}
													else if(registro.Insurance == p.Insurance && registro.Required == false)
													{
														registro.Required=true;
														exist = true;
													}
												}
												// Si no fue encontrada en ninguna fila como requerido, la agregamos al subformulario Protections del Shipment
												if(exist == false)
												{
													new_required = Package.Insurances();
													new_required.Insurance=p.Insurance;
													new_required.Required=p.Required;
													new_required.Previous_Insurance=p.Insurance;
													input.Insurances.insert(new_required);
												}
											}
										}
										//Recall Protection Price
										input.Insurance_Price = 0;
										for each  Prote in input.Insurances
										{
											RealProte = Insurance[ID = Prote.Previous_Insurance];
											if(RealProte.Price_Form == "By Package")
											{
												input.Insurance_Price = input.Insurance_Price + RealProte.Price_by_Box;
											}
											else if(RealProte.Price_Form == "By Percent")
											{
												RealShippment = Shipment[ID == input.Shipment_Type];
												var1 = input.Shipment_Price - RealShippment.Our_Commission;
												percent = RealProte.Percentage_of_price / 100;
												var2 = var1 * percent;
												input.Insurance_Price = input.Insurance_Price + var2;
											}
											else if(RealProte.Price_Form == "By Range")
											{
												RealShippment = Shipment[ID == input.Shipment_Type];
												var3 = input.Shipment_Price - RealShippment.Our_Commission;
												for each  Price in RealProte.Price_Ranges
												{
													if(var3 >= Price.From && var3 <= Price.To)
													{
														var4 = Price.Range_Price;
														break;
													}
												}
												input.Insurance_Price = input.Insurance_Price + var4;
											}
										}
										//Recall Shipment Price
										shipment = input.Shipment_Type;
										auto_calc_total_price = input.Auto_Calculate_Total_Price;
										// if(shipment != null && auto_calc_total_price == true)
										if(shipment != null)
										{
											RealShipment = Shipment[ID == shipment];
											if(RealShipment != null)
											{
												if(RealShipment.Price_Form == "By Weight")
												{
													Weight = ifnull(input.Total_Weight,0);
													input.Shipment_Price = Weight * RealShipment.Total_Price;
												}
												else if(RealShipment.Price_Form == "By Volumetric weight")
												{
													VolumetricWeight = ifnull(input.Volumetric_weight,0);
													input.Shipment_Price = VolumetricWeight * RealShipment.Total_Price;
												}
												else if(RealShipment.Price_Form == "By Greater weight")
												{
													if(input.Total_Weight >= input.Volumetric_weight)
													{
														Weight = ifnull(input.Total_Weight,0.0);
													}
													else
													{
														Weight = ifnull(input.Volumetric_weight,0.0);
													}
													input.Shipment_Price = Weight * RealShipment.Total_Price;
												}
												else if(RealShipment.Price_Form == "By Package")
												{
													input.Shipment_Price = RealShipment.Total_Price;
												}
											}
										}
										// else if(auto_calc_total_price == false)
										// {
										// 	input.Shipment_Price = 0.0;
										// }
										//Update Total Price
										insured_value = ifnull(input.Insured_value,0.0);
										shipping = ifnull(input.Shipment_Price,0.0);
										protection = ifnull(input.Insurance_Price,0.0);
										extended_address = ifnull(input.Extended_Address_Charge,0.0);
										discount = ifnull(input.Discount,0.0);
										if(input.Shipment_Type != null)
										{
											input.Total_Price = insured_value + shipping + protection + extended_address - discount;
										}
										else if(input.Shipment_Type == null)
										{
											input.Total_Price = 0.0;
										}
						)
					}
				}

			}
