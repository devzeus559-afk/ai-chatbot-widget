			Filter_DestinationCountry as "Filter_DestinationCountry"
			{
				type =  form
				form = Release

				record event = on add or edit

				on user input of Office
				{
					actions 
					{
						custom deluge script
						(
											if(input.Office != null)
										{
											countries = List();
											for each  s in Shipment[Office == input.Office && Active == true]
											{
												locations = s.Coverage_Locations;
												if(locations != null)
												{
													for each  l in locations
													{
														RealLocation = Coverage_Location[ID == l.ID];
														country = RealLocation.Address_Information1.country;
														if(!countries.contains(country))
														{
															countries.add(country);
														}
													}
												}
											}
											input.Destination_Country:ui.add(countries);
											enable Destination_Country;
										}
										else
										{
											disable Destination_Country;
										}
						)
					}
				}

			}
			Set_Update_TotalFields as "Set&Update_TotalFields"
			{
				type =  form
				form = Release

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											total_boxes = 0;
										total_bags = 0;
										total_docs = 0;
										total_full_boxes = 0;
										total_weight = 0.0;
										total_customs_duty = 0.0;
										if(input.Shipment_Details != null)
										{
											// Visiting all boxes and updating all total vars
											for each  r in input.Shipment_Details
											{
												// Get box object
												RealPkg = Package[ID == r.Package_ID];
												pkg_weight = ifnull(RealPkg.Total_Weight,0.0);
												pkg_customs_duty = ifnull(RealPkg.Customs_Duty,0.0);
												// Calculate for boxes
												if(RealPkg.Package_Type == "Box")
												{
													// Update number of boxes
													total_boxes = total_boxes + 1;
													// Update quantity of pounds
													total_weight = total_weight + pkg_weight;
													// Update customs duty
													total_customs_duty = total_customs_duty + pkg_customs_duty;
													// Get shipment object and update full boxes
													RealShipment = Shipment[ID == RealPkg.Shipment_Type];
													if(RealShipment.Price_Form == "By Package")
													{
														total_full_boxes = total_full_boxes + 1;
													}
												}
												// Calculate for bags
												else if(RealPkg.Package_Type == "Bag")
												{
													// Update number of bags
													total_bags = total_bags + 1;
													// Update quantity of pounds
													total_weight = total_weight + pkg_weight;
													// Update customs duty
													total_customs_duty = total_customs_duty + pkg_customs_duty;
												}
												// Calculate for documents
												else if(RealPkg.Package_Type == "Documents")
												{
													// Update number of docs
													total_docs = total_docs + 1;
													// Update customs duty
													total_customs_duty = total_customs_duty + pkg_customs_duty;
												}
											}
										}
										input.Total_Boxes = total_boxes;
										input.Total_Bags = total_bags;
										input.Total_Docs = total_docs;
										input.Total_Full_Packages = total_full_boxes;
										input.Total_Pounds = total_weight;
										input.Total_Customs_Duty = total_customs_duty;
						)
					}
				}

			}
