			Establish_Package_ID as "Establish_Package_ID"
			{
				type =  form
				form = Package

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Read system ID var
										current_ID = thisapp.variables.PACKAGE_ID;
										// Create new ID with zero-left-padding style
										package_id = thisapp.zeroLeftPad(5,current_ID);
										// Create the Release_Name
										input.Package_ID = "P-" + package_id;
										// Update ID var
										thisapp.variables.PACKAGE_ID = thisapp.variables.PACKAGE_ID + 1;
						)
					}
				}

			}
			Hide_Fields_Create_Edit1 as "Hide_Fields_Create&Edit"
			{
				type =  form
				form = Package

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											hide Package_ID;
										hide Receiver_Contact;
										hide Office;
										hide Insurances.Previous_Insurance;
										hide Sender_Not_Found;
										hide Same_Origin_Address;
										hide Sender_Email;
										hide Update_Sender_Information;
										hide Created_by_Form;
										hide Province_by_Form;
										hide Country_by_Form;
										hide Shipment_Method_by_Form;
										hide Type_of_Merchandise_by_Form;
										hide Shipment_Price_by_Form;
										hide Product_Information;
										hide Last_Package;
										//hide Sender_Address;
										// hide Employee;
										if(input.Package_Type == "Documents")
										{
											//show Number_of_Products1;
											hide Weight_Limit;
											hide Height_in;
											hide Width_in;
											hide Length_in;
											hide Total_Weight;
										}
										else if(input.Package_Type == "Bag")
										{
											show Weight_Limit;
											//hide Number_of_Products1;
											hide Height_in;
											hide Width_in;
											hide Length_in;
											show Total_Weight;
										}
										else if(input.Package_Type == "Box")
										{
											show Weight_Limit;
											//hide Number_of_Products1;
											show Height_in;
											show Width_in;
											show Length_in;
											show Total_Weight;
										}
										if(input.Sender_field != null)
										{
											hide Sender_Not_Found;
										}
										hide Manifest;
										hide Manifest_in_HTML;
										hide HBL;
										hide HBL_in_HTML;
										hide Supplier_Label;
										hide Invoice_in_HTML;
										hide Label_in_HTML;
										hide Last_Solved_Update;
										hide Latest_Solved_Status;
										hide Sync_Solved;
										hide Not_Found_in_Solved;
										if(Customs_Duty == null || Customs_Duty == 0)
										{
											hide Duty_Payer;
										}
										else
										{
											show Duty_Payer;
										}
						)
					}
				}

			}
