			Create_Solvedc_Labels as "Create_Solvedc_Labels"
			{
				type =  functions
				form = Service
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						if(input.Packages != null)
										{
											info "Generating Labels from Service!!!";
											// Getting package ids
											package_ids = List();
											for each  p in input.Packages
											{
												PkgRec = Package[ID == p.Package_Name];
												if(isNull(PkgRec.HBL))
												{
													package_ids.add(PkgRec.ID);
												}
											}
											// == Creates SolvedC Labels ==
											// Determine SolvedCargo API user
											OfficeRec = Commercial_Office[ID == input.Office];
											user = OfficeRec.SolvedCargo_User;
											// == Call utility to create a SolvedCargo record and get a package label ==
											// 'createSovedCargoRecord' return a list of created records and receive: 
											// - a list of 'package ids', 
											// - 'user' for office, 
											// .. in this case only one 'package id' is passed
											// validate if exist package ids before !!!
											solve_resp = if(isNull(package_ids),{},thisapp.solvedc.createSolvedRecord(package_ids,user));
											// Fill HBL and Tag fields
											if(solve_resp != null)
											{
												// Check elements of Solved response and update package fields
												for each index idx in solve_resp
												{
													// Getting real record of package
													PkgRec = Package[ID == package_ids.get(idx)];
													if(solve_resp.get(idx).get("code") != null)
													{
														// Update HBL field
														PkgRec.HBL=solve_resp.get(idx).get("code");
													}
													if(solve_resp.get(idx).get("label") != null)
													{
														// Update package label or tag
														PkgRec.Label_in_HTML=solve_resp.get(idx).get("label");
													}
													if(solve_resp.get(idx).get("awbhbl") != null)
													{
														// Update HBL label
														PkgRec.HBL_in_HTML=solve_resp.get(idx).get("awbhbl");
													}
												}
											}
										}
					)
					}
				}
			}
