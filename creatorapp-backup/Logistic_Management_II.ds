										lm2_path = "/prontoenviosnewjersey/copy-1-of-logistic-management-ii/";
										// public_tracking_details page (Status History) private token
										token = "PZjrddX88bbZ1Y4W1skymNCWgwj8OODMO9NsdRj6NWSdST4GjwWugEJwym7EkwEsHFu3z9WQfvjjXZvBFYeQdbmT6vxSCbfjApr0";
										// proxy utility
										cloudflare_url = "https://nameless-boat-9e84.yirodev26.workers.dev";
										// public path if iframe: page-embed vs page: page-perma
										page_path = "page-embed/Public_Tracking_Details";
										// processing
										if(search_code != "")
