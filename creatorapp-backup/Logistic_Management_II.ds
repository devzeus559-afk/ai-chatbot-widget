		list VAN_Releases
		{
			displayName = "VAN Releases"
			show all rows from Release  [Office.ID == 4893007000000126905]  
			(
				Release_Name as "Release Name"
				(
					width = 92px
				)
				Dispatch_Date as "Dispatch Date"
				(
					width = 125px
				)
				Employee
				(
					width = 118px
				)
				Transporter
				Freight_Forwarder as "Freight Forwarder"
				(
					width = 136px
				)
				Office
				(
					width = 131px
				)
				Total_Boxes as "Total Boxes"
				(
					width = 120px
				)
				Total_Pounds as "Total Pounds"
				Total_Full_Packages as "Total Full Packages"
				Destination_Country as "Destination Country"
				Total_Bags as "Total Bags"
				(
					width = 109px
				)
				Total_Docs as "Total Docs"
				(
					width = 113px
				)
				custom action "Create Bill"
				(
	  			workflow = Create_Bill
				show action in edit record menu = true
				column header = "Create Bill"
				condition = (Freight_Forwarder.Vendor_ID is not null && Bill_ID == "")
				confirmation before execution
				(
					message for individual record = "Are you sure you want to create an Bill from this record?"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
				Bill_URL as "Bill URL"
				Was_Dispatched as "Dispatched"
			)
			sort by
			(
				Dispatch_Date descending
				Release_Name descending
			)
			custom actions
			(
				"Carrier"
				(
	  			workflow = Print_to_Carrier1
				show action in view header = true
				)
			)
			customlayouts
			(
				template
	 			(
	 	  			displayname="Custom Layout 1"
	 	  			content="<panel  \n >\n	<pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		padding = '17px'\n	bgColor = '#FFFFFF'\n\n		width = '100%'\n		hAlign = 'center'\n		vAlign = 'middle'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>"
	    		)
			)
		}
