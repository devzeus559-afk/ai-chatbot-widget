			Disable_Required_Protecti as "Disable_Required_Protection"
			{
				type =  form
				form = Shipment

				record event = on add or edit

				on user input of Insurances.Required
				{
					actions 
					{
						custom deluge script
						(
											if(input.Vendor != null)
										{
											RealVendor = Vendor[ID == input.Vendor];
											for each  prote in RealVendor.Insurances
											{
												if(row.Insurance == prote.Insurance && prote.Required == true)
												{
													row.Required=prote.Required;
													disable row.Insurance;
													disable row.Required;
													openUrl("#Page:Error_Message?mensaje=This Protection is required by the selected Vendor.","popup window","height=143,width=380");
													//alert "This Protection is required by the selected Vendor.";
												}
											}
										}
						)
					}
				}

			}
			NotDelete_Require_Protect as "NotDelete_Require_Protections"
			{
				type =  form
				form = Shipment

				record event = on add or edit

				on delete row of Insurances
				{
					actions 
					{
						custom deluge script
						(
											if(input.Vendor != null)
										{
											RealVendor = Vendor[ID == input.Vendor];
											for each  prote in RealVendor.Insurances
											{
												if(row.Insurance == prote.Insurance && prote.Required == true)
												{
													new_required = Shipment.Insurances();
													new_required.Insurance=row.Insurance;
													new_required.Required=row.Required;
													new_required.Previous_Insurance=row.Insurance;
													input.Insurances.insert(new_required);
													openUrl("#Page:Error_Message?mensaje=This Protection is required by the selected Vendor. It cannot be removed.","popup window","height=143,width=380");
													//alert "This Protection is required by the selected Vendor. It cannot be removed.";
												}
											}
										}
						)
					}
				}

			}
			Filter_ShipmentType as "Filter_ShipmentType"
			{
				type =  form
				form = Package

				record event = on edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Limpiar selección previa del campo Shipment_Type
										actualShipment = input.Shipment_Type;
										input.Shipment_Type:ui.add(list());
										input.Shipment_Type = null;
										if(input.Location != null && input.Office != null)
										{
											// Valores del formulario actual
											selected_coverage_location = input.Location;
											// Lista para guardar Shipments que cumplen la condición
											matching_shipments = list();
											// Obtener todos los Shipments
											all_shipments = Shipment[ID != 0 && Coverage_Locations.contains(selected_coverage_location) && Office == input.Office && Active == true];
											for each  shipment in all_shipments
											{
												matching_shipments.add(shipment);
											}
											// Actualizar opciones del campo Shipment_Type
											input.Shipment_Type:ui.add(matching_shipments);
										}
										else
										{
											// Si no hay condiciones válidas, limpiar opciones
											input.Shipment_Type:ui.add(list());
										}
										input.Shipment_Type = actualShipment;
						)
					}
				}

			}
