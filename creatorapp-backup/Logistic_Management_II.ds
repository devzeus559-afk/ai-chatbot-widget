			Filter_Boxes as "Filter_Boxes"
			{
				type =  form
				form = Service

				record event = on add or edit

				on add row of Packages
				{
					actions 
					{
						custom deluge script
						(
											// Limpia las opciones previamente disponibles en el campo de búsqueda 'Box_Name' en la fila actual del subformulario
										clear row.Package_Name;
										// Crea una lista vacía donde se guardarán las opciones válidas (IDs de cajas)
										box_list = List();
										// Recorre los registros del formulario 'Box' que cumplen TODAS estas condiciones:
										// - No están asignados a ningún 'Service'
										// - Coinciden con la 'Office' seleccionada en el formulario Service
										// - Coinciden con el Sender seleccionado en el formulario Service
										// - Tienen estado 'Received' o no tienen estado (Status == null)
										for each  b in Package[Service == null && Office == input.Office && Sender_field == input.Sender_field && Sender_field != null && Status == "Received" || Status == null]
										{
											// Bandera para determinar si el box ya fue agregado en otra fila del subformulario
											exist = false;
											// Recorre todas las filas del subformulario 'Boxes'
											for each  registro in input.Packages
											{
												// Si el ID del box actual ya está seleccionado en alguna fila, lo marcamos como existente
												if(registro.Package_Name == b.ID)
												{
													exist = true;
												}
											}
											// Si no fue encontrado en ninguna fila, lo agregamos a la lista de opciones válidas
											if(exist == false)
											{
												box_list.add(b.ID);
											}
										}
										// Agrega dinámicamente al campo 'Box_Name' (en la UI) las opciones válidas encontradas
										row.Package_Name:ui.add(box_list);
						)
					}
				}

			}
			Filter_Boxes1 as "Filter_Boxes"
			{
				type =  form
				form = Service

				record event = on add or edit

				on user input of Office
				{
					actions 
					{
						custom deluge script
						(
											// Inicializa una lista vacía que contendrá los IDs de las cajas válidas para seleccionar
										box_list = List();
										// Recorre todos los registros del formulario 'Box' que cumplen estas condiciones:
										// - No están asignados a ningún 'Service'
										// - Coinciden con la 'Office' seleccionada
										// - Coinciden con el Sender seleccionado
										// - Tienen estado "Received" o ningún estado asignado (null)
										for each  b in Package[Service == null && Office == input.Office && Sender_field == input.Sender_field && Sender_field != null && Status == "Received" || Status == null]
										{
											// Variable bandera que servirá para verificar si el box ya fue seleccionado en el subformulario
											exist = false;
											// Recorre todas las filas actuales del subformulario 'Boxes'
											for each  registro in input.Packages
											{
												// Si el Box ya está en alguna fila del subformulario, se marca como existente
												if(registro.Package_Name == b.ID)
												{
													exist = true;
												}
											}
											// Si la caja no fue encontrada en ninguna fila, se añade a la lista de opciones válidas
											if(exist == false)
											{
												box_list.add(b.ID);
											}
										}
										// Ahora se recorre cada fila del subformulario 'Boxes'
										for each  fila in input.Packages
										{
											// Se busca el registro real del Box asociado a esa fila (usando su ID)
											RealBox = Package[ID == fila.Package_Name];
											// Verifica si la caja seleccionada en esta fila pertenece a la nueva Office
											if(RealBox.Office != input.Office)
											{
												// Si no pertenece a la nueva Office, se limpia el campo de Box y otros campos asociados
												clear fila.Package_Name;
												// Limpia el campo de búsqueda
												fila.Package_ID="";
												// Borra el ID de la caja
												fila.Package_Type="";
												fila.Status="";
												// Borra el estado
												fila.Receipt_Date=null;
												// Borra la fecha de recepción
												fila.External_Tracking_Number="";
												// Borra el número de rastreo
												fila.Receiver="";
												// Borra el nombre del receptor
												fila.Destination_Street="";
												// Borra la calle destino
												fila.Location=null;
												// Borra la ubicación
												fila.Width_in_cm=null;
												// Borra el ancho
												fila.Length_in_cm=null;
												// Borra el largo
												fila.Height_in_cm=null;
												// Borra la altura
												fila.Weight_in_pounds=null;
												// Borra el peso
												fila.Volume=null;
												// Borra el volumen
												fila.Package_Material="";
												// Borra el material de la caja
												fila.Shipment_Type=null;
												// Borra el tipo de envío
												fila.Package_Price=null;
												// Borra el precio de la caja
											}
											// Aplica dinámicamente las opciones válidas en el campo Box_Name de esta fila
											fila.Package_Name:ui.add(box_list);
										}
						)
					}
				}

			}
			Update_PackageStatus2 as "Update_PackageStatus"
			{
				type =  form
				form = Service

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Recorre cada fila del subformulario 'Boxes' del registro actual
										for each  fila in input.Packages
										{
											if(fila.Package_Name != null)
											{
												// Obtiene el registro real del formulario 'Box'
												pkg_registro = Package[ID == fila.Package_Name];
												// Verifica que el registro fue encontrado (seguridad)
												if(pkg_registro != null)
												{
													// Actualiza los campos directamente (los cambios se guardan automáticamente)
													pkg_registro.Status="Received";
													pkg_registro.Service=input.ID;
												}
											}
										}
						)
					}
				}

			}
			Require_ContactInfo as "Require_ContactInfo"
			{
				type =  form
				form = Service

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(Sender_Not_Found == false)
										{
											if(Sender_field == null)
											{
												openUrl("#Page:Error_Message?mensaje=The field Sender is required","popup window","height=143,width=380");
												alert "The field Sender is required";
												cancel submit;
											}
										}
										else if(Sender_Not_Found == true)
										{
											if(Sender_Mobile == "" || Sender_Full_Name.first_name == "" || Sender_Full_Name.last_name == "" || Sender_DNI == "")
											{
												openUrl("#Page:Error_Message?mensaje=The fields First Name, Last Name, Sender Mobile and Sender ID are required","popup window","height=143,width=380");
												alert "The fields First Name, Last Name, Sender Mobile and Sender ID are required";
												cancel submit;
											}
										}
										if(Receiver_Not_Found == false && Service_Type == "Remittance" || Service_Type == "Recharge" || Service_Type == "Online Store")
										{
											if(Receiver2 == null)
											{
												openUrl("#Page:Error_Message?mensaje=The field Receiver is required","popup window","height=143,width=380");
												alert "The field Receiver is required";
												cancel submit;
											}
										}
										else if(Receiver_Not_Found == true && Service_Type == "Remittance" || Service_Type == "Recharge" || Service_Type == "Online Store")
										{
											if(Receiver_Mobile == "" || Receiver_Full_Name.first_name == "" || Receiver_Full_Name.last_name == "" || Receiver_Full_Name.suffix == "" || Receiver_DNI == "")
											{
												openUrl("#Page:Error_Message?mensaje=The fields First Name, Last Name, Second Last Name, Receiver DNI and Receiver Mobile are required","popup window","height=143,width=380");
												alert "The fields First Name, Last Name, Second Last Name, Receiver DNI and Receiver Mobile are required";
												cancel submit;
											}
										}
						)
					}
				}

			}
