			Create_Solvedc_Label as "Create_Solvedc_Label"
			{
				type =  functions
				form = Package
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						if(input.HBL == "")
										{
											// == Determine SolvedCargo API user ==
											OfficeRec = Commercial_Office[ID == input.Office];
											user = OfficeRec.SolvedCargo_User;
											// == Call utility to create a SolvedCargo record and get a package label ==
											package_ids = List();
											package_ids.add(input.ID);
											// 'createSovedCargoRecord' return a list of created records and receive: 
											// - a list of 'package ids', 
											// - 'user' for office, 
											// .. in this case only one 'package id' is passed
											solve_resp = thisapp.solvedc.createSolvedRecord(package_ids,user);
											// Fill field HBL and Tag
											if(!solve_resp.isEmpty())
											{
												if(solve_resp.get(0).get("code") != null)
												{
													input.HBL = solve_resp.get(0).get("code");
												}
												// Save pack label
												if(!isEmpty(solve_resp.get(0).get("label")))
												{
													input.Label_in_HTML = solve_resp.get(0).get("label");
												}
												else
												{
													openUrl("#Page:Error_Message?mensaje=Label in HTML can't retrived. The SolveDCargo must be reviewed.","popup window","height=143,width=380");
													//info "Label in HTML can't retrived. The SolveDCargo must be reviewed.";
												}
												// Save HBL label
												if(!isEmpty(solve_resp.get(0).get("awbhbl")) || !solve_resp.get(0).get("awbhbl").contains("File not Found"))
												{
													input.HBL_in_HTML = solve_resp.get(0).get("awbhbl");
												}
												else
												{
													openUrl("#Page:Error_Message?mensaje=HBL in HTML can't retrived. The SolveDCargo must be reviewed.","popup window","height=143,width=380");
													//info "HBL in HTML can't retrived. The SolveDCargo must be reviewed.";
												}
												// Save Invoice in HTML
												if(!isEmpty(solve_resp.get(0).get("invoice")))
												{
													input.Invoice_in_HTML = solve_resp.get(0).get("invoice");
												}
												else
												{
													openUrl("#Page:Error_Message?mensaje=Invoice in HTML can't retrived. The SolveDCargo must be reviewed.","popup window","height=143,width=380");
													//info "Invoice in HTML can't retrived. The SolveDCargo must be reviewed.";
												}
											}
											openUrl("#Page:Successful_Message?mensaje=Package is generated in SolvedCargo with HBL: " + input.HBL + "","popup window","height=143,width=380");
											//info "Package is generated in SolvedCargo with HBL: " + input.HBL;
										}
										else if(input.HBL != null)
										{
											openUrl("#Page:Successful_Message?mensaje=Package has HBL: " + input.HBL + "","popup window","height=143,width=380");
											//info "Package has HBL: " + input.HBL;
										}
					)
					}
				}
			}
