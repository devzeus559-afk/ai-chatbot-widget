			Show_Packages5 as "Show Packages"
			{
				type =  form
				form = Service

				record event = on add or edit

				on user input of Sender_DNI
				{
					actions 
					{
						custom deluge script
						(
											if(input.Service_Type == "Package Receipt" || input.Service_Type = "Locker" && input.Employee != null && Sender_Full_Name.first_name != "" && Sender_Full_Name.last_name != "" && input.Sender_Mobile != "" && input.Sender_DNI != "")
										{
											show Packages;
											show Payment_Information;
										}
										else if(input.Service_Type == "Package Receipt" || input.Service_Type = "Locker")
										{
											hide Packages;
											hide Payment_Information;
										}
										else if(Sender_Full_Name.first_name != "" && Sender_Full_Name.last_name != "" && input.Sender_Mobile != "" && input.Sender_DNI != "")
										{
											hide Packages;
											show Payment_Information;
										}
										else
										{
											hide Packages;
											hide Payment_Information;
										}
						)
					}
				}

			}
			TestingWorkflow as "TestingWorkflow"
			{
				type =  form
				form = Shipment

				record event = on add
					status = inactive

				on load
				{
					actions 
					{
						custom deluge script
						(
											for each  ship in Shipment[Active == false]
										{
											criteriasearch = ship.Book_Item_ID.getprefix(" - ");
											org_id = "920092165";
											per_page = 200;
											options_list = List();
											response = invokeurl
											[
												url :"https://www.zohoapis.com/books/v3/items?organization_id=" + org_id
												type :GET
												connection:"zc_books"
											];
											if(response != null && response.get("items") != null)
											{
												items_list = response.get("items");
												//info items_list;
												if(items_list.size() > 0)
												{
													for each  loc in items_list
													{
														name = loc.get("item_name");
														id = loc.get("item_id");
														status = loc.get("status");
														type = loc.get("item_type");
														p_type = loc.get("product_type");
														c_service = loc.get("cf_service");
														account_name = loc.get("account_name");
														if(name != null && name.contains("" + criteriasearch + "") && !name.contains("Recogida") && !name.contains("Travel") && id != null && type == "sales_and_purchases" && c_service != "Tienda Virtual" && !c_service.contains("Viaje") && !c_service.contains("Cruceros") && !account_name.contains("Myenvio") && !account_name.contains("Travel") && !account_name.contains("Tramites") && !account_name.contains("Notaria") && !account_name.contains("Renta") && !account_name.contains("Seguro") && status != "inactive")
														{
															//&& p_type == "service"
															visible_and_saved = name + " - " + id;
															options_list.add(visible_and_saved);
															// Se ve y se guarda tal cual
														}
													}
												}
											}
											if(options_list.size() > 0)
											{
												//info options_list;
												ship.Book_Item_ID=options_list;
												ship.Active=true;
											}
										}
						)
					}
				}

			}
			Update_CRM_Contact_Test1 as "Update CRM Contact Test"
			{
				type =  form
				form = Contacts

				record event = on edit
					status = inactive

				on load
				{
					actions 
					{
						custom deluge script
						(
											lista_contacts = Contacts[CRM_Contact_ID == ""];
										//info lista_contacts;
										for each  contact in lista_contacts
										{
											// Obtener el número desde el formulario actual
											mobile_number = contact.Mobile;
											// Buscar en Zoho CRM el contacto que tenga ese número en el campo Mobile
											search_result = zoho.crm.searchRecords("Contacts","(Mobile:equals:" + mobile_number + ")");
											if(search_result.size() <= 0)
											{
												search_result = zoho.crm.searchRecords("Contacts","(Mobile:equals:" + mobile_number.getsuffix("+") + ")");
												if(search_result.size() <= 0)
												{
													search_result = zoho.crm.searchRecords("Contacts","(Mobile:equals:" + mobile_number.getsuffix("+1") + ")");
												}
												if(search_result.size() <= 0)
												{
													search_result = zoho.crm.searchRecords("Contacts","(Mobile:equals:" + mobile_number.getsuffix("+53") + ")");
												}
											}
											// Si se encuentra al menos un contacto con ese número
											if(search_result.size() > 0 && search_result.get(0) != null)
											{
												// Asignar el ID del contacto al campo 'CRM_Contact_ID' en Zoho Creator, como string
												contact.CRM_Contact_ID=search_result.get(0).get("id").toString();
												// También actualizar los datos en el CRM
												up_contact_map = Map();
												up_contact_map.put("First_Name",contact.First_Name.first_name);
												up_contact_map.put("Last_Name",contact.First_Name.last_name);
												up_contact_map.put("Sender_Receiver_ID",contact.ID.toString());
												up_contact_map.put("Email",contact.Email);
												up_contact_map.put("Mailing_Street",contact.Address.address_line_1);
												up_contact_map.put("Mailing_City",contact.Address.district_city);
												up_contact_map.put("Mailing_State",contact.Address.state_province);
												up_contact_map.put("Mailing_Country",contact.Address.country);
												up_contact_map.put("Creator_Type",contact.Type_field);
												up_contact_map.put("DNI",contact.DNI);
												update_response = zoho.crm.updateRecord("Contacts",search_result.get(0).get("id").toLong(),up_contact_map);
												openUrl("#Page:Successful_Message?mensaje=Updated contact information on the CRM","popup window","height=143,width=380");
												//info "Contact Information Updated";
												// Mensaje de confirmación en logs
											}
											else
											{
												// Si no se encontró contacto, se procede a crear uno nuevo en Zoho CRM
												// Crear un mapa con los campos requeridos por CRM
												new_contact_map = Map();
												new_contact_map.put("First_Name",contact.First_Name.first_name);
												new_contact_map.put("Last_Name",contact.First_Name.last_name);
												new_contact_map.put("Email",contact.Email);
												new_contact_map.put("Mobile",contact.Mobile);
												new_contact_map.put("Mailing_Street",contact.Address.address_line_1);
												new_contact_map.put("Mailing_City",contact.Address.district_city);
												new_contact_map.put("Mailing_State",contact.Address.state_province);
												new_contact_map.put("Mailing_Country",contact.Address.country);
												new_contact_map.put("Sender_Receiver_ID",contact.ID.toString());
												new_contact_map.put("Creator_Type",contact.Type_field);
												new_contact_map.put("DNI",contact.DNI);
												// Crear el nuevo contacto en el módulo Contacts de Zoho CRM
												create_response = zoho.crm.createRecord("Contacts",new_contact_map);
												info create_response;
												// Guardar el ID del nuevo contacto en el campo 'Sender_field'
												if(create_response.get("id") != null)
												{
													contact.CRM_Contact_ID=create_response.get("id").toString();
													//info create_response;
													openUrl("#Page:Successful_Message?mensaje=New Contact Created","popup window","height=143,width=380");
													//info "New Contact Created";
													// Mensaje de confirmación en logs
												}
												else if(create_response.get("code") == "DUPLICATE_DATA" && create_response.get("details").get("api_name") == "Mobile")
												{
													openUrl("#Page:Error_Message?mensaje=A new contact could not be created because there is already a record with the same mobile number.","popup window","height=143,width=380");
												}
											}
										}
						)
					}
				}

			}
			TemporalTest as "TemporalTest"
			{
				type =  form
				form = Package

				record event = on add
					status = inactive

				on load
				{
					actions 
					{
						custom deluge script
						(
