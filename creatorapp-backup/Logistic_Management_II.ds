			Update_ShipmentPrice_Tota1 as "Update_ShipmentPrice&TotalPrice"
			{
				type =  form
				form = Package

				record event = on edit
					status = inactive

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Shipment_Type != null)
										{
											RealShipment = Shipment[ID == input.Shipment_Type];
											// Calculate 'Shipment Price' by 'Price Form'
											if(RealShipment != null)
											{
												// Get weight component by standard weight
												if(RealShipment.Price_Form == "By Weight")
												{
													weight = ifnull(input.Total_Weight,0.0);
												}
												// Get weight component by volumetric weight
												else if(RealShipment.Price_Form == "By Volumetric weight")
												{
													weight = ifnull(input.Volumetric_weight,0.0);
												}
												else if(RealShipment.Price_Form == "By Greater weight")
												{
													if(input.Total_Weight >= input.Volumetric_weight)
													{
														weight = ifnull(input.Total_Weight,0.0);
													}
													else
													{
														weight = ifnull(input.Volumetric_weight,0.0);
													}
												}
												// Get weight component per package
												else
												{
													weight = 1;
												}
												// Update shipment price
												input.Shipment_Price = ifnull(RealShipment.Total_Price,0.0) * weight;
											}
										}
										// Calculate 'Total Price'
										insured_value = ifnull(input.Insured_value,0.0);
										shipping = ifnull(input.Shipment_Price,0.0);
										protection = ifnull(input.Insurance_Price,0.0);
										extended_address = ifnull(input.Extended_Address_Charge,0.0);
										discount = ifnull(input.Discount,0.0);
										input.Total_Price = insured_value + shipping + protection + extended_address - discount;
						)
					}
				}

			}
