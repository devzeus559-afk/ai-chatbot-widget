	reports
	{
		default list All_Services
		{
			displayName = "All Services"
			print template = Receipt
			show all rows from Service    
			(
				Service_Type as "Service Type"
				Service_ID as "Service ID"
				Office
				Date_field1 as "Date"
				Notes1 as "Notes"
				Employee
				custom action "Create Daily Movement"
				(
	  			workflow = Create_Daily_Movement
				show action in edit record menu = true
				column header = "Create Daily Movement"
				condition = (Daily_Movement.ID is null)
				confirmation before execution
				(
					message for individual record = "Are you sure you want to create and associate a Daily Movement for this record?"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
				Number_of_Packages as "Number of Packages"
				Total_Weight as "Total Weight"
				(
					display = total,average,min,max	
				)
				Price as "Total Price"
				Daily_Movement as "Daily Movement"
				Total_Packaging_Price as "Total Packaging Price"
				Total_Custom_Duty as "Total Custom Duty"
				Sender_Full_Name  as "Sender Full Name"
	 			(
	      			displayformat = [first_name+""+last_name]
	 			)
				custom action "Complete"
				(
	  			workflow = Complete_Service
				show action in view header = true
				show action in edit record menu = true
				column header = "Complete"
				condition = (Daily_Movement.Daily_Movement_ID is null)
				confirmation before execution
				(
					message for individual record = "Are you sure you want to create and associate a Daily Movement, put the cash movements in the selected Cash Flows and create an Invoice for this record?"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
				custom action "Print Insurance Rejected"
				(
	  			workflow = Print_Insurance_Rejected
				show action in edit record menu = true
				column header = "Print Insurance Rejected"
				condition = (Insurance_Rejected == true)
				)
				Amount
				custom action "Send Email"
				(
	  			workflow = Send_Email
				show action in edit record menu = true
				column header = "Send Email"
				condition = (Service_Type == "Package Receipt" || Service_Type == "Locker")
				confirmation before execution
				(
					message for individual record = "Are you sure you want to send the customer an email with information about this Service?"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
				Added_Time as "Hora agregado"
				Insurance_Rejected as "Insurance Rejected"
				Signature
				Transaction_Number as "Transaction Number "
				custom action "Print Transation"
				(
	  			workflow = Print_Transation
				show action in edit record menu = true
				column header = "Print Transation"
				condition = (Service_Type == "Remittance" || Service_Type == "Recharge")
				)
				Transaction_Amount as "Transaction Amount"
				Commission
				Receiver_Full_Name  as "Receiver Full Name"
				Sender_Mobile as "Sender Mobile"
				(
					displayformat = plainnumber 
				)
			)
			sort by
			(
				Date_field1 descending
				Service_ID descending
			)
			custom actions
			(
				"Generate Labels"
				(
	  			workflow = Create_Solvedc_Labels
				show action in view header = true
				show action in edit record menu = true
				condition = (Service_Type == "Package Receipt")
				)
			)
		}
		default list All_Commercial_Offices
		{
			displayName = "Commercial Offices"
			show all rows from Commercial_Office    
			(
				Office_Name as "Office Name"
				Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Book_Location as "Book Location"
				Active
				(
						displaytrue = "Activo"
						displayfalse = "No Activo"
				)
				ID as "IDENTIFICACIÓN"
				SolvedCargo_User as "SolvedCargo User"
				SolvedCargo_Agency as "SolvedCargo Agency"
			)
		}
		default list All_Packages
		{
			displayName = "All Packages"
			print template = Etiqueta
			show all rows from Package    
			(
				Package_ID as "Package ID"
				(
					width = 100px
				)
