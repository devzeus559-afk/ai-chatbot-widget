			Set_Update_SubtotalShippi as "Set&Update_SubtotalShippingTypes"
			{
				type =  form
				form = Release

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Transform subform to list<map> for calculate totals and subtotals
										subform = List();
										if(input.Shipment_Details != null)
										{
											for each  r in input.Shipment_Details
											{
												// Populate packages list<map>
												Row1 = Map();
												// Assign lookup (Pass the record var, not the field)
												Row1.put("Package_ID",r.Package_ID.toLong());
												Row1.put("Package_Name",r.Package_Name);
												Row1.put("Package_Type",r.Package_Type);
												Row1.put("Status",r.Status);
												Row1.put("Location",r.Location);
												Row1.put("Total_Weight",r.Total_Weight);
												Row1.put("Shipping_Type",r.Shipping_Type);
												Row1.put("Package_Price",r.Package_Price);
												Row1.put("Customs_Duty",r.Customs_Duty);
												Row1.put("Service",r.Service.toLong());
												// Insert new subform row
												subform.add(Row1);
											}
										}
										// ===================================================	
										// Calculate subtotal rows by shipping types
										shipping_type_subs = Map();
										// Call function that generate subform values from shipment details 
										shipping_type_subs = thisapp.getShipmentTypesSubsBySubform(subform);
										// Clear subform records
										input.Subtotals_By_Shipping_Type.clear();
										// Populate subform
										shipping_types = List();
										shipping_types = shipping_type_subs.get("Shipping_Type");
										if(!shipping_types.isEmpty())
										{
											for each  r in shipping_types
											{
												SubtotalRow = Release.Subtotals_By_Shipping_Type();
												SubtotalRow.Shipping_Type=r.toString();
												SubtotalRow.Total_Packages=shipping_type_subs.get("Total_Packages").get(r);
												SubtotalRow.Total_Pounds=shipping_type_subs.get("Total_Pounds").get(r);
												input.Subtotals_By_Shipping_Type.insert(SubtotalRow);
											}
										}
						)
					}
				}

			}
			Pass_ValuetoIntegrationFi as "Pass_ValuetoIntegrationField"
			{
				type =  form
				form = Package

				record event = on add or edit

				on user input of Receiver2
				{
					actions 
					{
						custom deluge script
						(
											if(input.Receiver2 != "" && input.Receiver2 != "Select Option" && input.Receiver2 != null)
										{
											mobile_number = input.Receiver2.getsuffix(" - ");
											RealContact = Contacts[Mobile == mobile_number];
											if(RealContact == null)
											{
												mobile_number2 = mobile_number.getsuffix("+");
												RealContact = Contacts[Mobile == mobile_number2];
											}
											input.Receiver_Full_Name.first_name = RealContact.First_Name.first_name;
											input.Receiver_Full_Name.last_name = RealContact.First_Name.last_name;
											input.Receiver_Full_Name.suffix = RealContact.First_Name.suffix;
											input.Receiver_DNI = RealContact.DNI;
											input.Receiver_Mobile = RealContact.Mobile;
											input.Street = RealContact.Address.address_line_1;
											input.City = RealContact.Address.district_city;
											RealLocation = Coverage_Location[Address_Information1.state_province == RealContact.Address.state_province && Address_Information1.country == RealContact.Address.country];
											if(RealLocation.ID != null)
											{
												input.Location = RealLocation.ID;
											}
											else
											{
												newLocation = insert into Coverage_Location
												[
													Location_Name=RealContact.Address.state_province + " - " + RealContact.Address.country
													Address_Information1.state_province=RealContact.Address.state_province
													Address_Information1.country=RealContact.Address.country
													Added_User=zoho.loginuser
												];
												RealLocation = newLocation;
												input.Location = RealLocation;
											}
										}
						)
					}
				}

			}
			UpdateInformation_ExistCo as "UpdateInformation_ExistContact"
			{
				type =  form
				form = Package

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											//Update Receiver
										if(Receiver_Not_Found == false && Receiver_Mobile != null)
										{
											// Obtener el número desde el formulario actual
											mobile_number = input.Receiver_Mobile;
											// Buscar en Zoho CRM el contacto que tenga ese número en el campo Mobile
											search_result = Contacts[Mobile == mobile_number];
											// Si se encuentra al menos un contacto con ese número
											if(search_result.ID != null && input.Update_Receiver_Information == true)
											{
												// Actualizar los datos del contacto encontrado con los datos del formulario
												search_result.DNI=input.Receiver_DNI;
												search_result.Address.address_line_1=input.Street;
												search_result.Address.district_city=input.City;
												search_result.Address.state_province=input.Location.Address_Information1.state_province;
												search_result.Address.country=input.Location.Address_Information1.country;
												search_result.First_Name.first_name=input.Receiver_Full_Name.first_name;
												search_result.First_Name.last_name=input.Receiver_Full_Name.last_name;
												search_result.First_Name.suffix=input.Receiver_Full_Name.suffix;
												if(search_result.Type_field == "Sender" || search_result.Type_field == "Sender & Receiver")
												{
													search_result.Type_field="Sender & Receiver";
												}
												else
												{
													search_result.Type_field="Receiver";
												}
												crm_result = zoho.crm.searchRecords("Contacts","(Mobile:equals:" + mobile_number + ")");
												if(crm_result.size() > 0)
												{
													up_contact_map = Map();
													up_contact_map.put("First_Name",input.Receiver_Full_Name.first_name);
													up_contact_map.put("Last_Name",input.Receiver_Full_Name.last_name);
													up_contact_map.put("Sender_Receiver_ID",search_result.ID.toString());
													up_contact_map.put("Mailing_Street",input.Street);
													up_contact_map.put("Mailing_City",input.City);
													up_contact_map.put("Mailing_State",input.Location.Address_Information1.state_province);
													up_contact_map.put("Mailing_Country",input.Location.Address_Information1.country);
													up_contact_map.put("DNI",input.Receiver_DNI);
													if(search_result.Type_field == "Sender" || search_result.Type_field == "Sender & Receiver")
													{
														up_contact_map.put("Creator_Type","Sender & Receiver");
													}
													else
													{
														up_contact_map.put("Creator_Type","Receiver");
													}
													update_response = zoho.crm.updateRecord("Contacts",crm_result.get(0).get("id").toLong(),up_contact_map);
												}
												input.Update_Receiver_Information = false;
												openUrl("#Page:Successful_Message?mensaje=Receiver Information Updated","popup window","height=143,width=380");
												info "Receiver Information Updated";
												//info "Receiver Information Updated";
												// Mensaje de confirmación en logs
											}
											else if(search_result.ID == null && input.Update_Receiver_Information == true)
											{
												openUrl("#Page:Error_Message?mensaje=Receiver not found","popup window","height=143,width=380");
												info "Receiver not found";
												//info "Receiver not found";
											}
											else if(search_result.ID != null && input.Update_Receiver_Information == false)
											{
												// Asignar el ID del contacto al campo 'Receiver' en Zoho Creator, como string
												input.Receiver_Contact = search_result.ID;
												input.Receiver2 = search_result.First_Name.first_name + " " + search_result.First_Name.last_name + " - " + search_result.Mobile;
												input.Receiver_Full_Name.first_name = search_result.First_Name.first_name;
												input.Receiver_Full_Name.last_name = search_result.First_Name.last_name;
												if(search_result.First_Name.suffix != null)
												{
													input.Receiver_Full_Name.suffix = search_result.First_Name.suffix;
												}
												else
												{
													input.Receiver_Full_Name.suffix = "-";
												}
												input.Receiver_DNI = search_result.DNI;
												input.Receiver_Not_Found = false;
												if(search_result.Type_field == "Sender" || search_result.Type_field == "Sender & Receiver")
												{
													search_result.Type_field="Sender & Receiver";
												}
												else
												{
													search_result.Type_field="Receiver";
												}
												openUrl("#Page:Successful_Message?mensaje=Receiver assigned to a Contact with this Mobile","popup window","height=143,width=380");
												info "Receiver assigned to a Contact with this Mobile";
												//info "Receiver assigned to a Contact with this Mobile";
												//Temporal creación del contacto en el CRM
												info "mobile_number: " + mobile_number;
												crm_result = zoho.crm.searchRecords("Contacts","(Mobile:equals:" + mobile_number + ")");
												info "crm_result: " + crm_result;
												if(crm_result.size() > 0)
												{
													up_contact_map = Map();
													up_contact_map.put("First_Name",input.Receiver_Full_Name.first_name);
													up_contact_map.put("Last_Name",input.Receiver_Full_Name.last_name);
													up_contact_map.put("Sender_Receiver_ID",search_result.ID.toString());
													up_contact_map.put("Mailing_Street",input.Street);
													up_contact_map.put("Mailing_City",input.City);
													up_contact_map.put("Mailing_State",input.Location.Address_Information1.state_province);
													up_contact_map.put("Mailing_Country",input.Location.Address_Information1.country);
													up_contact_map.put("DNI",input.Receiver_DNI);
													if(search_result.Type_field == "Sender" || search_result.Type_field == "Sender & Receiver")
													{
														up_contact_map.put("Creator_Type","Sender & Receiver");
													}
													else
													{
														up_contact_map.put("Creator_Type","Receiver");
													}
													update_response = zoho.crm.updateRecord("Contacts",crm_result.get(0).get("id").toLong(),up_contact_map);
													search_result.CRM_Contact_ID=update_response.get("id").toLong();
													input.Update_Receiver_Information = false;
													input.Receiver_Not_Found = false;
													openUrl("#Page:Successful_Message?mensaje=Receiver assigned to a Contact with this Mobile and Updated the Information","popup window","height=143,width=380");
													info "Receiver assigned to a Contact with this Mobile and Updated the Information";
												}
												else
												{
													// Si no se encontró contacto, se procede a crear uno nuevo en Zoho CRM
													// Crear un mapa con los campos requeridos por Creator
													creator_contact = insert into Contacts
													[
														Added_User=zoho.loginuser
														Address.address_line_1=input.Street
														Address.district_city=input.City
														Address.state_province=input.Location.Address_Information1.state_province
														Address.country=input.Location.Address_Information1.country
														DNI=input.Receiver_DNI
														Active=true
														First_Name.first_name=input.Receiver_Full_Name.first_name
														First_Name.last_name=input.Receiver_Full_Name.last_name
														First_Name.suffix=input.Receiver_Full_Name.suffix
														Mobile=input.Receiver_Mobile
														Type_field="Receiver"
													];
													input.Receiver_Contact = creator_contact;
													input.Receiver_Not_Found = false;
													search_result = Contacts[ID == creator_contact];
													new_contact_map = Map();
													new_contact_map.put("First_Name",input.Receiver_Full_Name.first_name);
													new_contact_map.put("Last_Name",input.Receiver_Full_Name.last_name);
													new_contact_map.put("Mobile",input.Receiver_Mobile);
													new_contact_map.put("Sender_Receiver_ID",creator_contact.toString());
													new_contact_map.put("Mailing_Street",input.Street);
													new_contact_map.put("Mailing_City",input.City);
													new_contact_map.put("Mailing_State",input.Location.Address_Information1.state_province);
													new_contact_map.put("Mailing_Country",input.Location.Address_Information1.country);
													new_contact_map.put("Creator_Type","Receiver");
													// Crear el nuevo contacto en el módulo Contacts de Zoho CRM
													create_response = zoho.crm.createRecord("Contacts",new_contact_map);
													// Guardar el ID del nuevo contacto en el campo 'Receiver'
													//info create_response;
													input.Receiver2 = input.Receiver_Full_Name.first_name + " " + input.Receiver_Full_Name.last_name + " - " + input.Receiver_Mobile;
													id_contacto = creator_contact.toString();
													if(create_response.get("id") == null && create_response.get("code") != "DUPLICATE_DATA" && create_response.get("details").get("api_name") != "Mobile")
													{
														crm_result = zoho.crm.searchRecords("Contacts","(Mobile:equals:" + mobile_number + ")");
														if(crm_result.size() <= 0)
														{
															crm_result = zoho.crm.searchRecords("Contacts","(Mobile:equals:" + mobile_number.getsuffix("+") + ")");
														}
														if(crm_result.size() > 0)
														{
															up_contact_map = Map();
															up_contact_map.put("First_Name",input.Receiver_Full_Name.first_name);
															up_contact_map.put("Last_Name",input.Receiver_Full_Name.last_name);
															mobile = input.Receiver_Mobile;
															up_contact_map.put("Mailing_Street",input.Street);
															up_contact_map.put("Mailing_City",input.City);
															up_contact_map.put("Mailing_State",input.Location.Address_Information1.state_province);
															up_contact_map.put("Mailing_Country",input.Location.Address_Information1.country);
															up_contact_map.put("Sender_Receiver_ID",creator_contact.toString());
															up_contact_map.put("DNI",input.Receiver_DNI);
															up_contact_map.put("Creator_Type","Receiver");
															update_response = zoho.crm.updateRecord("Contacts",crm_result.get(0).get("id").toLong(),up_contact_map);
															search_result.CRM_Contact_ID=update_response.get("id").toLong();
														}
														else if(create_response.get("code") == "DUPLICATE_DATA" && create_response.get("details").get("api_name") == "Mobile")
														{
															openUrl("#Page:Error_Message?mensaje=A new contact could not be created on CRM because there is already a record with the same mobile number.","popup window","height=143,width=380");
															info "A new contact could not be created on CRM because there is already a record with the same mobile number.";
															//cancel submit;
														}
													}
													else if(create_response.get("code") == "DUPLICATE_DATA" && create_response.get("details").get("api_name") == "Mobile")
													{
														openUrl("#Page:Error_Message?mensaje=A new contact could not be created on CRM because there is already a record with the same mobile number.","popup window","height=143,width=380");
														info "A new contact could not be created on CRM because there is already a record with the same mobile number.";
														//cancel submit;
													}
													else
													{
														search_result.CRM_Contact_ID=create_response.get("id").toLong();
														openUrl("#Page:Successful_Message?mensaje=New Contact Created and Assigned like Receiver","popup window","height=143,width=380");
														info "New Contact Created and Assigned like Receiver";
														//info "New Contact Created and Assigned like Receiver";
														// Mensaje de confirmación en logs
													}
												}
												//Termina el temporal	
												// Mensaje de confirmación en logs
												// Mensaje de confirmación en logs
											}
										}
										//Update Sender
										/**if(Sender_Not_Found == false && Sender_Mobile != null)
																				{
																					// Obtener el número desde el formulario actual
																					mobile_number = input.Sender_Mobile;
																					// Buscar en Zoho CRM el contacto que tenga ese número en el campo Mobile
																					search_result = zoho.crm.searchRecords("Contacts","(Mobile:equals:" + mobile_number + ")");
																					// Si se encuentra al menos un contacto con ese número
																					if(search_result.size() > 0 && input.Update_Sender_Information == true)
																					{
																						// Actualizar los datos del contacto encontrado con los datos del formulario
																						up_contact_map = Map();
																						up_contact_map.put("First_Name",input.Sender_Full_Name.first_name);
																						up_contact_map.put("Last_Name",input.Sender_Full_Name.last_name);
																						up_contact_map.put("Sender_Receiver_ID",input.Sender_DNI.toString());
																						mobile = input.Sender_Mobile;
																						up_contact_map.put("Mailing_Street",input.Sender_Address.address_line_1);
																						up_contact_map.put("Mailing_City",input.Sender_Address.district_city);
																						up_contact_map.put("Mailing_State",input.Sender_Address.state_province);
																						up_contact_map.put("Mailing_Country",input.Sender_Address.country);
																						up_contact_map.put("Creator_Type","Sender");
																						update_response = zoho.crm.updateRecord("Contacts",search_result.get(0).get("id").toLong(),up_contact_map);
																						info "Sender Information Updated";
																						// Mensaje de confirmación en logs
																					}
																					else
																					{
																						info "Sender not found";
																					}
																				}**/
						)
					}
				}

			}
			Show_Hide_FieldsByService as "Show&Hide_FieldsByServiceType"
			{
				type =  form
				form = Service

				record event = on add or edit

				field rules
				{
					actions 
					{
						hide Number_of_Packages,NotCanBePackageDelete,Total_Packaging_Price,Receipt_Details,Sender_Not_Found;
					}
					actions  (Service_Type == "Package Receipt" || Service_Type == "Locker")
					{
						show Total_Packaging_Price,Receipt_Details,Number_of_Packages,Insurance_Rejected;
					}
					actions  (Service_Type == "Package Receipt" || Service_Type == "Locker")
					{
						hide Invoice_Recipient,Amount,Service_Subtype;
					}
					actions  (Service_Type == "Remittance" || Service_Type == "Recharge" || Service_Type == "Online Store")
					{
						show Service_Subtype,Amount;
					}
					actions  (Service_Type != "Package Receipt" && Service_Type != "Locker")
					{
						hide Number_of_Packages,Total_Packaging_Price,NotCanBePackageDelete,Packages,Insurance_Rejected;
					}
					actions  (Service_Type == "Package Receipt" || Service_Type == "Locker" || Service_Type == "Store" || Service_Type == "Other Services")
					{
						hide Receiver2,Receiver_DNI,Receiver_Full_Name,Receiver_Mobile,Receiver_Not_Found,Update_Receiver_Information,Payer,Street,City,Location;
					}
					actions  (Service_Type == "Remittance" || Service_Type == "Recharge")
					{
						show Vendor;
					}
					actions  (Service_Type != "Remittance" && Service_Type != "Recharge")
					{
						hide Vendor;
					}
				}

			}
			Establish_RemittenceID as "Establish_RemittenceID"
			{
				type =  form
				form = Remittance

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Read system ID var
										current_id = thisapp.variables.REMITTANCE_ID;
										// Create new ID with zero-left-padding style
										remittance_id = thisapp.zeroLeftPad(5,current_id);
										// Create the Release_Name
										input.Remittance_ID = "RM-" + remittance_id;
										// Update ID var
										thisapp.variables.REMITTANCE_ID = thisapp.variables.REMITTANCE_ID + 1;
						)
					}
				}

			}
			Update_TotalPrice_Field as "Update_TotalPrice_Field"
			{
				type =  form
				form = Package

				record event = on add or edit

				on user input of Discount
				{
					actions 
					{
						custom deluge script
						(
											// Load price components
										insured_value = ifnull(input.Insured_value,0.0);
										shipment = ifnull(input.Shipment_Price,0.0);
										protection = ifnull(input.Insurance_Price,0.0);
										extended_address = ifnull(input.Extended_Address_Charge,0.0);
										// Price without dicount
										price1 = insured_value + shipment + protection + extended_address;
										if(input.Discount > 0)
										{
											// Load price components
											// 	insured_value = ifnull(input.Insured_value,0.0);
											// 	shipment = ifnull(input.Shipment_Price,0.0);
											// 	protection = ifnull(input.Insurance_Price,0.0);
											// 	extended_address = ifnull(input.Extended_Address_Charge,0.0);
											discount = input.Discount;
											// Price without dicount
											// 	price1 = insured_value + shipment + protection + extended_address;
											if(price1 >= discount)
											{
												input.Total_Price = price1 - discount;
											}
											else
											{
												input.Total_Price = 0.0;
												openUrl("#Page:Warning_Message?mensaje=Discount value is greater than Price value.","popup window","height=143,width=380");
												alert "Discount value is greater than Price value.";
											}
										}
										else
										{
											// Load price components
											// 	insured_value = ifnull(input.Insured_value,0.0);
											// 	shipment = ifnull(input.Shipment_Price,0.0);
											// 	protection = ifnull(input.Insurance_Price,0.0);
											// 	extended_address = ifnull(input.Extended_Address_Charge,0.0);
											input.Total_Price = price1;
										}
						)
					}
				}

			}
			Set_Update_ShortName_Fiel as "Set&Update_ShortName_Field"
			{
				type =  form
				form = Shipment

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Shipping_Type != null && input.Type_of_Merchandise != null && input.Total_Price != null)
										{
											input.Short_Name = input.Shipping_Type + ", " + input.Type_of_Merchandise + ", " + input.Total_Price;
										}
						)
					}
				}

			}
			NoMorePackages_IfDM as "NoMorePackages_IfDM"
			{
				type =  form
				form = Service

				record event = on edit

				field rules
				{
					actions  (Daily_Movement is not null)
					{
					hide add row of Packages,Payment_Information;
					hide delete row of Packages,Payment_Information;
					}
				}

			}
			NotChangePayment_ifDM as "NotChangePayment_ifDM"
			{
				type =  form
				form = Service

				record event = on edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Daily_Movement != null)
										{
											disable Payment_Information.Payment_Method;
											disable Payment_Information.Amount;
											disable Payment_Information.Fit;
											disable Payment_Information.Fit_Credit_Card;
											disable Payment_Information.Total_To_Pay;
											disable Payment_Information.Cash_Flow;
										}
						)
					}
				}

			}
			PutPAckage_OnService as "PutPAckage_OnService"
			{
				type =  form
				form = Package

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Service != null)
										{
											RealService = Service[ID == input.Service];
											if(RealService.Daily_Movement == null)
											{
												newRows = Collection();
												for each  fila in RealService.Packages
												{
													Vale = Service.Packages();
													Vale.Package_Name=fila.Package_Name;
													Vale.Package_ID=fila.Package_ID;
													Vale.Package_Type=fila.Package_Type;
													Vale.Status=fila.Status;
													Vale.Receipt_Date=fila.Receipt_Date;
													Vale.External_Tracking_Number=fila.External_Tracking_Number;
													Vale.Receiver=fila.Receiver;
													Vale.Destination_Street=fila.Destination_Street;
													Vale.Location=fila.Location;
													Vale.Width_in_cm=fila.Width_in_cm;
													Vale.Length_in_cm=fila.Length_in_cm;
													Vale.Height_in_cm=fila.Height_in_cm;
													Vale.Weight_in_pounds=fila.Weight_in_pounds;
													Vale.Volume=fila.Volume;
													Vale.Package_Material=fila.Package_Material;
													Vale.Shipment_Type=fila.Shipment_Type;
													Vale.Package_Price=fila.Package_Price;
													Vale.Service_Employee=fila.Service_Employee;
													Vale.Service_Office=fila.Service_Office;
													Vale.Service_Sender=fila.Service_Sender;
													Vale.Sender_Full_Name=fila.Sender_Full_Name;
													Vale.Sender_Mobile=fila.Sender_Mobile;
													Vale.Sender_DNI=fila.Sender_DNI;
													Vale.Sender_Email=fila.Sender_Email;
													newRows.insert(Vale);
												}
												Vale = Service.Packages();
												Vale.Package_Name=input.ID;
												Vale.Package_ID=input.ID;
												Vale.Package_Type=input.Package_Type;
												Vale.Status=input.Status;
												Vale.Receipt_Date=input.Receipt_Date;
												Vale.External_Tracking_Number=input.Tracking_Number;
												Vale.Receiver=Contacts[ID == input.Receiver_Contact].CRM_Contact_ID.toLong();
												Vale.Destination_Street=input.Street;
												Vale.Location=input.Location;
												Vale.Width_in_cm=input.Width_in;
												Vale.Length_in_cm=input.Length_in;
												Vale.Height_in_cm=input.Height_in;
												Vale.Weight_in_pounds=input.Total_Weight;
												Vale.Volume=input.Volume;
												Vale.Package_Material=input.Package_Material;
												Vale.Shipment_Type=input.Shipment_Type;
												Vale.Package_Price=input.Total_Price;
												Vale.Service_Employee=input.Employee;
												Vale.Service_Office=input.Office;
												Vale.Service_Sender=input.Sender_field;
												Vale.Sender_Full_Name=input.Sender_Full_Name;
												Vale.Sender_Mobile=input.Sender_Mobile;
												Vale.Sender_DNI=input.Sender_DNI;
												Vale.Sender_Email=input.Sender_Email;
												newRows.insert(Vale);
												thisweight = input.Total_Weight;
												thisprice = input.Total_Price;
												thisduty = ifnull(input.Customs_Duty,0);
												thispackage = ifnull(input.Packaging_Price,0);
												RealService.Total_Weight=RealService.Total_Weight + thisweight;
												RealService.Total_Custom_Duty=RealService.Total_Custom_Duty + thisduty;
												RealService.Total_Packaging_Price=RealService.Total_Packaging_Price + thispackage;
												RealService.Price=ifnull(RealService.Price,0) + thisprice + thisduty + thispackage;
												RealService.Number_of_Packages=RealService.Number_of_Packages + 1;
												RealService.Packages.clear();
												RealService.Packages.insert(newRows);
											}
											else
											{
												input.Service = null;
												openUrl("#Page:Error_Message?mensaje=The Service associated with this Package cannot be modified because a Daily Movement has been created from it. Please select another Service","popup window","height=163,width=380");
												//info "The Service associated with this Package cannot be modified because a Daily Movement has been created from it. Please select another Service.";
											}
										}
						)
					}
				}

			}
			Show_sender_information as "Show sender information"
			{
				type =  form
				form = Service

				record event = on add or edit

				on user input of Update_Sender
				{
					actions 
					{
						custom deluge script
						(
											if(Update_Sender == true)
										{
											enable Sender_Full_Name;
											enable Sender_field;
											enable Sender_DNI;
										}
										else
										{
											disable Sender_Full_Name;
											disable Sender_field;
											disable Sender_DNI;
										}
						)
					}
				}

			}
			UpdateInformation_ExistCo1 as "UpdateInformation_ExistContact"
			{
				type =  form
				form = Service

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(Sender_Not_Found == false && Sender_Mobile != null)
										{
											// Obtener el número desde el formulario actual
											mobile_number = input.Sender_Mobile;
											// Buscar en Zoho CRM el contacto que tenga ese número en el campo Mobile
											search_result = Contacts[Mobile == mobile_number];
											// Si se encuentra al menos un contacto con ese número
											if(search_result.ID != null && input.Update_Sender == true)
											{
												// Actualizar los datos del contacto encontrado con los datos del formulario
												search_result.DNI=input.Sender_DNI;
												search_result.Address.address_line_1=input.Sender_Address.address_line_1;
												search_result.Address.district_city=input.Sender_Address.district_city;
												search_result.Address.state_province=input.Sender_Address.state_province;
												search_result.Address.country=input.Sender_Address.country;
												search_result.Email=input.Sender_Email;
												search_result.First_Name.first_name=input.Sender_Full_Name.first_name;
												search_result.First_Name.last_name=input.Sender_Full_Name.last_name;
												if(search_result.Type_field == "Receiver" || search_result.Type_field == "Sender & Receiver")
												{
													search_result.Type_field="Sender & Receiver";
												}
												else
												{
													search_result.Type_field="Sender";
												}
												crm_result = zoho.crm.searchRecords("Contacts","(Mobile:equals:" + mobile_number + ")");
												if(crm_result.size() > 0)
												{
													up_contact_map = Map();
													up_contact_map.put("First_Name",input.Sender_Full_Name.first_name);
													up_contact_map.put("Last_Name",input.Sender_Full_Name.last_name);
													mobile = input.Sender_Mobile;
													up_contact_map.put("Mailing_Street",input.Sender_Address.address_line_1);
													up_contact_map.put("Mailing_City",input.Sender_Address.district_city);
													up_contact_map.put("Mailing_State",input.Sender_Address.state_province);
													up_contact_map.put("Mailing_Country",input.Sender_Address.country);
													up_contact_map.put("Email",input.Sender_Email);
													up_contact_map.put("Sender_Receiver_ID",search_result.ID.toString());
													up_contact_map.put("DNI",input.Sender_DNI);
													if(search_result.Type_field == "Receiver" || search_result.Type_field == "Sender & Receiver")
													{
														up_contact_map.put("Creator_Type","Sender & Receiver");
													}
													else
													{
														up_contact_map.put("Creator_Type","Sender");
													}
													update_response = zoho.crm.updateRecord("Contacts",crm_result.get(0).get("id").toLong(),up_contact_map);
												}
												input.Update_Sender = false;
												openUrl("#Page:Successful_Message?mensaje=Sender Information Updated","popup window","height=143,width=380");
												info "Sender Information Updated";
												//info "Sender Information Updated";
												// Mensaje de confirmación en logs
											}
											else if(search_result.ID == null && input.Update_Sender == true)
											{
												openUrl("#Page:Error_Message?mensaje=Sender not found","popup window","height=143,width=380");
												info "Sender not found";
												//info "Sender not found";
											}
											else if(search_result.ID != null && input.Update_Sender == false)
											{
												// Asignar el ID del contacto al campo 'Receiver' en Zoho Creator, como string
												input.Sender_field = search_result.ID;
												// También completar los campos de nombre en el formulario usando los datos del contacto encontrado
												input.Sender_Full_Name.first_name = search_result.First_Name.first_name;
												input.Sender_Full_Name.last_name = search_result.First_Name.last_name;
												input.Sender_Email = search_result.Email;
												input.Sender_DNI = search_result.DNI;
												if(search_result.Type_field == "Receiver" || search_result.Type_field == "Sender & Receiver")
												{
													search_result.Type_field="Sender & Receiver";
												}
												else
												{
													search_result.Type_field="Sender";
												}
												//Temporal crear en el CRM
												crm_result = zoho.crm.searchRecords("Contacts","(Mobile:equals:" + mobile_number + ")");
												if(crm_result.size() > 0)
												{
													//info crm_result;
													up_contact_map = Map();
													up_contact_map.put("First_Name",input.Sender_Full_Name.first_name);
													up_contact_map.put("Last_Name",input.Sender_Full_Name.last_name);
													mobile = input.Sender_Mobile;
