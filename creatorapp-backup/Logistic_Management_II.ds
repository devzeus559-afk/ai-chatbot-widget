			Filter_Packages as "Filter_Packages"
			{
				type =  form
				form = Release

				record event = on add or edit

				on add row of Shipment_Details
				{
					actions 
					{
						custom deluge script
						(
											// Limpia las opciones previamente disponibles en el campo de búsqueda 'Package_ID' en la fila actual del subformulario
										clear row.Package_ID;
										// Crea una lista vacía donde se guardarán las opciones válidas (IDs de pack)
										pkg_ids = List();
										// get elegible locations
										elegible_locs = Coverage_Location[Active == true && Address_Information1.country == input.Destination_Country].distinct(ID);
										// get elegible packages
										// get records of packages type 'Box' that:
										// - has a 'Service'
										// - match with selected 'Office'
										// - has 'Received' status
										// - Destination_Country --> Pkg Destination Address (Country)
										elegible_pkgs = Package[Package_Type == "Box" || Package_Type == "Bag" && Office == input.Office && Status == "Received" && Location in elegible_locs && Service != null];
										// get the right selected packages IDs from release subform
										// - create a temp list with selected ids
										selected_ids = List();
										// - populate temp list
										if(input.Shipment_Details != null)
										{
											for each  rec in input.Shipment_Details
											{
												selected_ids.add(rec.Package_ID);
											}
										}
										// get unselected packages ids
										if(elegible_pkgs != null)
										{
											for each  b in elegible_pkgs
											{
												RealService = Service[ID == b.Service];
												// Filter boxes that match with criterias: 
												// - Service_Type --> "Package Receipt" 
												if(RealService.Service_Type == "Package Receipt" || RealService.Service_Type == "Locker" && !selected_ids.contains(b.ID))
												{
													pkg_ids.add(b.ID);
												}
											}
										}
										// Agrega dinámicamente al campo 'Package_ID' (en la UI) las opciones válidas encontradas
										row.Package_ID:ui.add(pkg_ids);
						)
					}
				}

			}
			Filter_Packages3 as "Filter_Packages"
			{
				type =  form
				form = Release

				record event = on edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Crea una lista vacía donde se guardarán las opciones válidas (IDs de pkgs)
										pkg_ids = List();
										// get elegible locations
										elegible_locs = Coverage_Location[Active == true && Address_Information1.country == input.Destination_Country].distinct(ID);
										// get elegible packages
										// get records of packages type 'Box' that:
										// - has a 'Service'
										// - match with selected 'Office'
										// - has 'Received' status
										// - Destination_Country --> Pkg Destination Address (Country)
										elegible_pkgs = Package[Package_Type == "Box" && Office == input.Office && Status == "Received" && Location in elegible_locs && Service != null];
										// get the right selected packages IDs from release subform
										// - create a temp list with selected ids
										selected_ids = List();
										// - populate temp list
										for each  rec in input.Shipment_Details
										{
											selected_ids.add(rec.Package_ID);
										}
										// get unselected packages ids
										for each  b in elegible_pkgs
										{
											RealService = Service[ID == b.Service];
											// Filter boxes that match with criterias: 
											// - Service_Type --> "Package Receipt" 
											if(RealService.Service_Type == "Package Receipt" && !selected_ids.contains(b.ID))
											{
												pkg_ids.add(b.ID);
											}
										}
										// Agrega dinámicamente al campo 'Package_ID' (en la UI) las opciones válidas encontradas
										for each  r in input.Shipment_Details
										{
											valor_actual = r.Package_ID;
											r.Package_ID:ui.add(pkg_ids);
											r.Package_ID=valor_actual;
										}
						)
					}
				}

			}
