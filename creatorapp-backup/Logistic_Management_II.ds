			Update_TotalPrice6 as "Update_TotalPrice"
			{
				type =  form
				form = Package

				record event = on add or edit

				on user input of Extended_Address_Charge
				{
					actions 
					{
						custom deluge script
						(
											insured_value = ifnull(input.Insured_value,0.0);
										shipping = ifnull(input.Shipment_Price,0.0);
										protection = ifnull(input.Insurance_Price,0.0);
										extended_address = ifnull(input.Extended_Address_Charge,0.0);
