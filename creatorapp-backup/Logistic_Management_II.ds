		 functions
		 {
			 Deluge
			 {
				 void createPkgsTrackingSyncNotification(string office_name, string shipping_type, bool isSuccess)
                 {
                 	// Params: office_name = {"Elizabeth", "West New York", "New York"} ; shipping_type = {"AIR", "SEA", "ALL"}
                 	// get the office id field
                 	office_id = Commercial_Office[Office_Name == office_name].ID sort by ID;
                 	// cuban locations (batch wf not support Distinct aggregation)
                 	cuban_location_ids = List();
                 	CubanLocations = Coverage_Location[Active == true && Address_Information1.country == "Cuba"];
                 	for each  l in CubanLocations
                 	{
                 		if(!cuban_location_ids.contains(l.ID))
                 		{
                 			cuban_location_ids.add(l.ID);
                 		}
                 	}
                 	// air shipments
                 	air_shipment_ids = List();
                 	AirShipments = Shipment[Active == true && Short_Name.contains("Air")];
                 	for each  a in AirShipments
                 	{
                 		if(!air_shipment_ids.contains(a.ID))
                 		{
                 			air_shipment_ids.add(a.ID);
                 		}
                 	}
                 	// mar shipments
                 	mar_shipment_ids = List();
                 	SeaShipments = Shipment[Active == true && !Short_Name.contains("Air")];
                 	for each  s in SeaShipments
                 	{
                 		if(!mar_shipment_ids.contains(s.ID))
                 		{
                 			mar_shipment_ids.add(s.ID);
                 		}
                 	}
                 	// Filter by shipping type
                 	if(shipping_type == "AIR")
                 	{
                 		// dispatched air pkgs to cuba
                 		dispatched_pkgs = Package[Status == "Dispatched" && Package_Type == "Box" && Office == office_id && Location in cuban_location_ids && Shipment_Type in air_shipment_ids && HBL != null && Departure_Date != null].count(ID);
                 		// pkgs updated
                 		updated_pkgs = Package[Status == "Dispatched" && Package_Type == "Box" && Office == office_id && Location in cuban_location_ids && Shipment_Type in air_shipment_ids && HBL != null && Departure_Date != null && Last_Solved_Update == zoho.currentdate].count(ID);
                 		// pks unchanged
                 		unchanged_pkgs = dispatched_pkgs - updated_pkgs;
                 		// pkgs missed (without HBL)
                 		invalid_pkgs = Package[Status == "Dispatched" && Package_Type == "Box" && Office == office_id && Location in cuban_location_ids && Shipment_Type in air_shipment_ids && HBL == null];
                 		missed_pkgs = invalid_pkgs.count(ID);
                 		// pkgs with issues (with errors)
                 		error_pkgs = Package[Status == "Dispatched" && Package_Type == "Box" && Office == office_id && Location in cuban_location_ids && Shipment_Type in air_shipment_ids && HBL != null && Departure_Date != null && Not_Found_in_Solved == true];
                 		exception_pkgs = error_pkgs.count(ID);
                 	}
                 	else if(shipping_type == "SEA")
                 	{
                 		// dispatched air pkgs to cuba
                 		dispatched_pkgs = Package[Status == "Dispatched" && Package_Type == "Box" && Office == office_id && Location in cuban_location_ids && Shipment_Type in mar_shipment_ids && HBL != null && Departure_Date != null].count(ID);
                 		// pkgs updated
                 		updated_pkgs = Package[Status == "Dispatched" && Package_Type == "Box" && Office == office_id && Location in cuban_location_ids && Shipment_Type in mar_shipment_ids && HBL != null && Departure_Date != null && Last_Solved_Update == zoho.currentdate].count(ID);
                 		// pks unchanged
                 		unchanged_pkgs = dispatched_pkgs - updated_pkgs;
                 		// pkgs missed (without HBL)
                 		invalid_pkgs = Package[Status == "Dispatched" && Package_Type == "Box" && Office == office_id && Location in cuban_location_ids && Shipment_Type in mar_shipment_ids && HBL == null];
                 		missed_pkgs = invalid_pkgs.count(ID);
                 		// pkgs with issues (with errors)
                 		error_pkgs = Package[Status == "Dispatched" && Package_Type == "Box" && Office == office_id && Location in cuban_location_ids && Shipment_Type in mar_shipment_ids && HBL != null && Departure_Date != null && Not_Found_in_Solved == true];
                 		exception_pkgs = error_pkgs.count(ID);
                 	}
                 	else if(shipping_type == "ALL")
                 	{
                 		// dispatched pkgs to cuba
                 		dispatched_pkgs = Package[Status == "Dispatched" && Package_Type == "Box" && Office == office_id && Location in cuban_location_ids && HBL != null && Departure_Date != null].count(ID);
                 		// pkgs updated
                 		updated_pkgs = Package[Status == "Dispatched" && Package_Type == "Box" && Office == office_id && Location in cuban_location_ids && HBL != null && Departure_Date != null && Last_Solved_Update == zoho.currentdate].count(ID);
                 		// pks unchanged
                 		unchanged_pkgs = dispatched_pkgs - updated_pkgs;
                 		// pkgs missed (without HBL)
                 		invalid_pkgs = Package[Status == "Dispatched" && Package_Type == "Box" && Office == office_id && Location in cuban_location_ids && HBL == null];
                 		missed_pkgs = invalid_pkgs.count(ID);
                 		// pkgs with issues (with errors)
                 		error_pkgs = Package[Status == "Dispatched" && Package_Type == "Box" && Office == office_id && Location in cuban_location_ids && HBL != null && Departure_Date != null && Not_Found_in_Solved == true];
                 		exception_pkgs = error_pkgs.count(ID);
                 	}
                 	// check if processing was finished successfully
                 	error_msg = if(isSuccess == true,"","FAILED!");
                 	// create message
                 	msg = error_msg + "[" + office_name + " - " + shipping_type + "] Dispatched: " + dispatched_pkgs + ", Updated: " + updated_pkgs + ", Unchanged: " + unchanged_pkgs;
                 	// Add exception pkgs stats
                 	if(exception_pkgs > 0)
                 	{
                 		// get missed pkgs Ids
                 		error_pkg_ids = List();
                 		for each  ep in error_pkgs
                 		{
                 			if(!error_pkg_ids.contains(ep.Package_ID))
                 			{
                 				error_pkg_ids.add(ep.Package_ID);
                 			}
                 		}
                 		msg = msg + ", Not Found: " + exception_pkgs + " (" + error_pkg_ids + ")";
                 	}
                 	else
                 	{
                 		msg = msg + ", Not Found: 0";
                 	}
                 	// get the first pkg id not updated
                 	pkg_id = Pkg_Tracking[Office == office_id && Last_Updated < zoho.currentdate].ID sort by Last_Updated asc;
                 	// notify
                 	resp = zoho.pushNotification({"prontoenviosnewjersey@outlook.com"},"LM2 Package Tracking Issue",msg,"Tracking_Pkg_Info_Report",pkg_id);
                 	if(resp.get("status") != "success")
                 	{
                 		info "Review Packages Records, Notifications Has Problems: " + resp.get("status");
                 	}
                 }
				 void deleteObsoleteTrackingPkg()
                 {
                 	// Delete All Tracking Pkgs Delivered 6 Months Before (180 days = 6 months) 
                 	delete from Pkg_Tracking[Latest_Status == "Entregado al Cliente" && Last_Updated <= zoho.currentdate.subDay(thisapp.variables.Tracking.DAYS_OBSOLETE_PKG)];
                 }
				 list filterServicesForAddPkgs(list packages, int office_id, string country)
                 {
                 	// Create service ids and number of pkgs associated
                 	// {serv1_id : 2, serv2_id: 1, ...}
                 	service_ids = Map();
                 	// Search received packages of this office and with a service associated
                 	for each  p in Package[Office == office_id && Status == "Received" && Service != null]
                 	{
                 		// Get service and coverage location records
                 		RealService = Service[ID == p.Service];
                 		RealLocation = Coverage_Location[ID == p.Location];
                 		// Filter packages that match with criterias: 
                 		// - Service_Type --> "Package Receipt"
                 		// - Destination_Country --> Pkg Destination Address (Country) 
                 		if(RealService.Service_Type == "Package Receipt" && RealLocation.Address_Information1.country == country)
                 		{
                 			// Populate services set and its pkgs quantity
                 			if(service_ids != null && service_ids.containKey(p.Service))
                 			{
                 				pkg_qty = service_ids.get(p.Service) + 1;
                 				service_ids.put(p.Service,pkg_qty);
                 			}
                 			else
                 			{
                 				service_ids.put(p.Service,1);
                 			}
                 			// Update service set with subform pkg, remove service id if all pkgs are in subform
                 			if(!packages.isEmpty())
                 			{
                 				for each  r in packages
                 				{
                 					// If pkg ID is in subform decrement pkg qty for it service, or remove if qty = 0
                 					if(r.get("Package_ID") == p.ID)
                 					{
                 						new_qty = service_ids.get(p.Service) - 1;
                 						if(new_qty > 0)
                 						{
                 							service_ids.put(p.Service,new_qty);
                 						}
                 						else
                 						{
                 							service_ids.remove(p.Service);
                 						}
                 					}
                 				}
                 			}
                 		}
                 	}
                 	// Return list
                 	return service_ids.keys();
                 }
				 list filterServicesForRemovePkgs(list packages, int office_id, string country)
                 {
                 	// Create service ids list 
                 	service_ids = List();
                 	// Search received packages of this office and with a service associated
                 	if(!packages.isEmpty())
                 	{
                 		// Save service ID if the package isn't included in the list and package isn't in Shipment Details subform
                 		for each  r in packages
                 		{
                 			// Si el ID del pkg actual ya está seleccionado en alguna fila, lo marcamos como existente
                 			if(!service_ids.contains(r.get("Service")))
                 			{
                 				service_ids.add(r.get("Service"));
                 			}
                 		}
                 	}
                 	// Return list
                 	return service_ids;
                 }
				 string generateProductsDescByPkgId(int pkgId)
                 {
                 	description = "";
                 	PkgRec = Package[ID == pkgId];
                 	if(PkgRec != null && PkgRec.Products_Details != null)
                 	{
                 		category_ids = {};
                 		for each  p in PkgRec.Products_Details
                 		{
                 			// check that count just one category (that hide product quantities in box label) 
                 			if(!category_ids.contains(p.Product_Category))
                 			{
                 				// Add new category Id to list
                 				category_ids.add(p.Product_Category);
                 				// Get product name from SolvedCargo Category, mandatory
                 				//.. concat all product names
                 				SolvedCategoryRec = SolvedCargo_Categories[ID == p.Product_Category];
                 				pname = ifNull(ltrim(SolvedCategoryRec.Category_Name),"Unknown");
                 				// Get product quantity to concat with name
                 				// 				pqty = if(p.Qty > 1,concat(toString(p.Qty)," ").concat(pname),pname);
                 				// concat names
                 				description = if(!isNull(description),description.concat(", ").concat(pname),pname);
                 			}
                 		}
                 	}
                 	return description;
                 }
				 map getDMSubtotalByService(int service_id)
                 {
                 	result = Map();
                 	ServiceRec = Service[ID == service_id];
                 	if(ServiceRec != null)
                 	{
                 		// temporal variables
                 		items = Map();
                 		quantity = Map();
                 		unit_price = Map();
                 		total_price = Map();
                 		if(ServiceRec.Service_Type == "Package Receipt" || ServiceRec.Service_Type == "Locker")
                 		{
                 			// process packages (shipment types)
                 			if(!ServiceRec.Packages.isEmpty())
                 			{
                 				for each  p in ServiceRec.Packages
                 				{
                 					// Getting package record and props
                 					pkg_id = p.Package_ID;
                 					pkg_weight = ifnull(p.Weight_in_pounds,0.0);
                 					pkg_volume = ifnull(p.Volume,0.0);
                 					pkg_volumetric_weight = round(pkg_volume / 166,2);
                 					pkg_greater_weight = pkg_weight.max(pkg_volumetric_weight);
                 					// Getting shipment record and props
                 					RealShipment = Shipment[ID == p.Shipment_Type];
                 					shipment_id = RealShipment.ID.toString();
                 					shipment_name = RealShipment.Short_Name;
                 					shipment_unit_price = ifnull(RealShipment.Total_Price,0.0);
                 					// Populate subtotal vars
                 					if(!items.containKey(shipment_id))
                 					{
                 						// Add shipment if not found in shipment types list and initialize subtotals
                 						items.put(shipment_id,shipment_name);
                 						quantity.put(shipment_id,0.0);
                 						unit_price.put(shipment_id,0.0);
                 						total_price.put(shipment_id,0.0);
                 					}
                 					// Get increment value by weight 
                 					if(RealShipment.Price_Form == "By Weight")
                 					{
                 						accum_quantity = quantity.get(shipment_id) + pkg_weight;
                 					}
                 					// Get increment value by volumetric weight
                 					else if(RealShipment.Price_Form == "By Volumetric weight")
                 					{
                 						accum_quantity = quantity.get(shipment_id) + pkg_volumetric_weight;
                 					}
                 					// Get increment value by greater between actual weight and volumetric weight
                 					else if(RealShipment.Price_Form == "By Greater weight")
                 					{
                 						accum_quantity = quantity.get(shipment_id) + pkg_greater_weight;
                 					}
                 					// Get increment value by unit
                 					else if(RealShipment.Price_Form == "By Package")
                 					{
                 						accum_quantity = quantity.get(shipment_id) + 1;
                 					}
                 					// Accumulate quantity and total price
                 					t_price = round(accum_quantity * shipment_unit_price,2);
                 					// Update subtotals
                 					quantity.put(shipment_id,accum_quantity);
                 					unit_price.put(shipment_id,shipment_unit_price);
                 					total_price.put(shipment_id,t_price);
                 				}
                 			}
                 			result.put("Items",items);
                 			result.put("Quantity",quantity);
                 			result.put("Unit_Price",unit_price);
                 			result.put("Total_Price",total_price);
                 		}
                 		else if(ServiceRec.Service_Type != "Package Receipt" && ServiceRec.Service_Type != "Locker")
                 		{
                 			// process other books items
                 			if(ServiceRec.Service_Subtype != null)
                 			{
                 				// process
                 				BooksItemRec = Book_Item[ID == ServiceRec.Service_Subtype];
                 				if(BooksItemRec != null)
                 				{
                 					item_name = BooksItemRec.Book_Item_ID.getprefix(" - ");
                 					item_amount = ServiceRec.Amount;
                 					// Fill data
                 					items.put(BooksItemRec.ID.toString(),item_name);
                 					quantity.put(BooksItemRec.ID.toString(),1);
                 					unit_price.put(BooksItemRec.ID.toString(),item_amount);
                 					total_price.put(BooksItemRec.ID.toString(),item_amount);
                 				}
                 				else
                 				{
                 					info "Books Item Not Found.";
                 					return result;
                 				}
                 				result.put("Items",items);
                 				result.put("Quantity",quantity);
                 				result.put("Unit_Price",unit_price);
                 				result.put("Total_Price",total_price);
                 			}
                 		}
                 	}
                 	else
                 	{
                 		info "Service Not Found.";
                 	}
                 	return result;
                 }
				 list getEmployeesByLoggedinUser()
                 {
                 	employees = List();
                 	// Get logged-in user
                 	loggedin_user = zoho.loginuser;
                 	// Get role for logged-in user
                 	role_name = thisapp.permissions.roleForUser(zoho.loginuserid);
                 	if(role_name != "CEO")
                 	{
                 		// Save employee IDs by logged-in user office
                 		for each  e in Employee[User == loggedin_user]
                 		{
                 			employees.add(e.ID);
                 		}
                 	}
                 	else if(role_name == "CEO")
                 	{
                 		// Save all employee IDs by CEO
                 		for each  e in Employee[ID != 0]
                 		{
                 			employees.add(e.ID);
                 		}
                 	}
                 	// Return employee IDs
                 	return employees;
                 }
				 list getPackageReceiversBySenderName(string sender_name, string sender_last_name, int office_id)
                 {
                 	receivers = List();
                 	// Getting all packages sended by a Sender
                 	packages = Package[Sender_Full_Name.first_name == sender_name && Sender_Full_Name.last_name == sender_last_name && Office == office_id];
                 	for each  p in packages
                 	{
                 		if(packages != null)
                 		{
                 			// Add in receiver_ids list if package receiver is not in it
                 			if(receivers.isEmpty())
                 			{
                 				receivers.add(p.Receiver_Full_Name);
                 			}
                 			else
                 			{
                 				for each  r in receivers
                 				{
                 					if(r.get("first_name") == p.Receiver_Full_Name.first_name && r.get("last_name") == p.Receiver_Full_Name.last_name)
                 					{
                 						receivers.add(p.Receiver_Full_Name);
                 					}
                 				}
                 			}
                 		}
                 	}
                 	return receivers;
                 }
				 map getReceiverInfoByName(string receiver_name, string receiver_last_name, int office_id)
                 {
                 	// To save mobile and other info
                 	receiver_info = Map();
                 	// To save mobile numbers if are more than one
                 	phone_list = List();
                 	if(receiver_name != null)
                 	{
                 		// Search receivers in package records
                 		for each  p in Package[Receiver_Full_Name.first_name == receiver_name && Receiver_Full_Name.last_name == receiver_last_name && Status != null && Service != null && Office == office_id]
                 		{
                 			if(!phone_list.contains(p.Receiver_Mobile))
                 			{
                 				phone_list.add(p.Receiver_Mobile);
                 			}
                 		}
                 		if(!phone_list.isEmpty())
                 		{
                 			receiver_info.put("Phones",phone_list);
                 		}
                 	}
                 	return receiver_info;
                 }
				 float getServiceAmountByPaymentInfo(int service_id)
                 {
                 	// function that determine service amount by amaount field of payment information
                 	service_amount = 0.0;
                 	// getting service record
                 	ServiceRec = Service[ID == service_id];
                 	if(ServiceRec != null)
                 	{
                 		if(ServiceRec.Payment_Information != null)
                 		{
                 			// service amount is the sum of Amount field in Payment_Information subform
                 			for each  r in ServiceRec.Payment_Information
                 			{
                 				service_amount = service_amount + r.Amount;
                 			}
                 		}
                 		else
                 		{
                 			info "Payment Information Not Found.";
                 		}
                 	}
                 	return service_amount;
                 }
				 map getShipmentDetailsTotalsBySubform(list packages)
                 {
                 	// Initialize totals vars
                 	boxes_number = 0;
                 	bags_number = 0;
                 	docs_number = 0;
                 	full_boxes_number = 0;
                 	total_weight = 0.0;
                 	total_customs_duty = 0.0;
                 	// Check release packages
                 	if(!packages.isEmpty())
                 	{
                 		// Get data and calculate totals
                 		for each  r in packages
                 		{
                 			// Getting value of new package
                 			RealShipment = Shipment[ID == r.get("Shipping_Type")];
                 			pkg_pounds = ifnull(r.get("Total_Weight"),0.0);
                 			pkg_customs_duty = ifnull(r.get("Customs_Duty"),0.0);
                 			if(r.get("Package_Type") == "Box")
                 			{
                 				// Update totals values
                 				boxes_number = boxes_number + 1;
                 				total_weight = total_weight + pkg_pounds;
                 				total_customs_duty = total_customs_duty + pkg_customs_duty;
                 				// Update full boxes
                 				if(RealShipment.Price_Form == "By Package")
                 				{
                 					full_boxes_number = full_boxes_number + 1;
                 				}
                 			}
                 			else if(r.get("Package_Type") == "Bag")
                 			{
                 				// Update number of bags
                 				bags_number = bags_number + 1;
                 				total_weight = total_weight + pkg_pounds;
                 				total_customs_duty = total_customs_duty + pkg_customs_duty;
                 			}
                 			else if(r.get("Package_Type") == "Documents")
                 			{
                 				// Update number of docs
                 				docs_number = docs_number + 1;
                 				total_customs_duty = total_customs_duty + pkg_customs_duty;
                 			}
                 		}
                 	}
                 	result = Map();
                 	result.put("Total_Boxes",boxes_number);
                 	result.put("Total_Bags",bags_number);
                 	result.put("Total_Docs",docs_number);
                 	result.put("Total_Full_Packages",full_boxes_number);
                 	result.put("Total_Pounds",total_weight);
                 	result.put("Total_Customs_Duty",total_customs_duty);
                 	return result;
                 }
				 map getShipmentSubs2BySubform(list packages)
                 {
                 	// Calculate types list and subtotals by 'Shipment Details' subform
                 	shipments = list();
                 	subtotal_pkgs = Map();
                 	subtotal_pounds = Map();
                 	// Check release packages
                 	if(!packages.isEmpty())
                 	{
                 		// Get data and calculate totals
                 		for each  r in packages
                 		{
                 			// Getting value of new package
                 			pkg_id = r.get("Package_ID");
                 			pkg_shipping_type = r.get("Shipping_Type");
                 			RealShipment = Shipment[ID == pkg_shipping_type];
                 			// dummy step to update 'Presentation_Name' formula
                 			// RealShipment.Type_of_Merchandise=RealShipment.Type_of_Merchandise;
                 			shipment = RealShipment.Presentation_Name;
                 			// Add new shipping type to subtotals summary
                 			if(!shipments.contains(shipment))
                 			{
                 				shipments.add(shipment);
                 				subtotal_pkgs.put(shipment,0);
                 				subtotal_pounds.put(shipment,0.0);
                 			}
                 			if(r.get("Package_Type") == "Documents")
                 			{
                 				// Update number of bags
                 				total_weight = 1;
                 			}
                 			else
                 			{
                 				total_weight = ifnull(r.get("Total_Weight"),0.0);
                 			}
                 			// Update subtotals values
                 			pkgs_qty = subtotal_pkgs.get(shipment) + 1;
                 			pkgs_pounds = subtotal_pounds.get(shipment) + total_weight;
                 			subtotal_pkgs.put(shipment,pkgs_qty);
                 			subtotal_pounds.put(shipment,pkgs_pounds);
                 		}
                 	}
                 	result = Map();
                 	result.put("Shipments",shipments);
                 	result.put("Total_Packages",subtotal_pkgs);
                 	result.put("Total_Pounds",subtotal_pounds);
                 	return result;
                 }
				 map getShipmentSubsBySubform(list packages)
                 {
                 	// === Create auxiliar vars to populate subform subtotal shipment ===
                 	shipment_types = Map();
                 	subtotal_quantity = Map();
                 	subtotal_unit_price = Map();
                 	subtotal_price = Map();
                 	// Calculate subtotals for packages
                 	if(!packages.isEmpty())
                 	{
                 		for each  r in packages
                 		{
                 			// Getting package record and props
                 			pkg_id = r.get("Package_ID");
                 			pkg_weight = ifnull(r.get("Total_Weight"),0.0);
                 			pkg_volumetric_weight = ifnull(r.get("Volumetric_weight"),0.0);
                 			pkg_greater_weight = pkg_weight.max(pkg_volumetric_weight);
                 			// Getting shipment record and props
                 			RealShipment = Shipment[ID == r.get("Shipping_Type")];
                 			shipment_id = RealShipment.ID.toString();
                 			shipment_name = RealShipment.Short_Name;
                 			shipment_unit_price = RealShipment.Total_Price;
                 			// Populate subtotal vars
                 			if(!shipment_types.containKey(shipment_id))
                 			{
                 				// Add shipment if not found in shipment types list and initialize subtotals
                 				shipment_types.put(shipment_id,shipment_name);
                 				subtotal_quantity.put(shipment_id,0.0);
                 				subtotal_unit_price.put(shipment_id,0.0);
                 				subtotal_price.put(shipment_id,0.0);
                 			}
                 			// Get increment value by weight 
                 			if(RealShipment.Price_Form == "By Weight")
                 			{
                 				accum_quantity = subtotal_quantity.get(shipment_id) + pkg_weight;
                 			}
                 			// Get increment value by volumetric weight
                 			else if(RealShipment.Price_Form == "By Volumetric weight")
                 			{
                 				accum_quantity = subtotal_quantity.get(shipment_id) + pkg_volumetric_weight;
                 			}
                 			// Get increment value by greater between actual weight and volumetric weight
                 			else if(RealShipment.Price_Form == "By Greater weight")
                 			{
                 				accum_quantity = subtotal_quantity.get(shipment_id) + pkg_greater_weight;
                 			}
                 			// Get increment value by unit
                 			else if(RealShipment.Price_Form == "By Package")
                 			{
                 				accum_quantity = subtotal_quantity.get(shipment_id) + 1;
                 			}
                 			// Accumulate quantity and total price
                 			total_price = accum_quantity * shipment_unit_price;
                 			// Update subtotals
                 			subtotal_quantity.put(shipment_id,accum_quantity);
                 			subtotal_unit_price.put(shipment_id,shipment_unit_price);
                 			subtotal_price.put(shipment_id,total_price);
                 		}
                 	}
                 	result = Map();
                 	result.put("Shipment_Type",shipment_types);
                 	result.put("Quantity",subtotal_quantity);
                 	result.put("Unit_Price",subtotal_unit_price);
                 	result.put("Total_Price",subtotal_price);
                 	return result;
                 }
