			Complete_PaymentInformati2 as "Complete_PaymentInformation_byForm"
			{
				type =  form
				form = Service

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Created_by_Form == true)
										{
											// Convertir el texto JSON a lista
											paymentList = input.Temporal_Payment_Information.toJSONList();
											info paymentList;
											// Crear lista vacía para el subform
											subformList = Service.Payment_Information();
											// Iterar productos
											for each  payItem in paymentList
											{
												itemmap = payItem.toMap();
												subformList.Payment_Method=itemmap.get("Dropdown4");
												subformList.Amount=itemmap.get("Currency7").getsuffix("$ ").toDecimal();
												numValue = itemmap.get("Number");
												if(numValue != null)
												{
													numText = numValue.toString().trim();
													if(numText != "" && numText.isNumber())
													{
														subformList.Fit=numText.toDecimal();
													}
												}
												if(itemmap.get("Formula2") != "")
												{
													subformList.Fit_Credit_Card=itemmap.get("Formula2").toDecimal();
												}
												subformList.Total_To_Pay=itemmap.get("Formula").toDecimal();
												RealOffice = Commercial_Office[Office_Name.contains("VAN")];
												if(itemmap.get("Dropdown4") == "Cash")
												{
													RealCF = Cash_Flow[Office == RealOffice.ID && Created_Date_Time == itemmap.get("Date").toDate("dd-MMM-yyyy")];
													if(RealCF.ID != null)
													{
														subformList.Cash_Flow=RealCF.ID;
													}
												}
												input.Payment_Information.insert(subformList);
											}
										}
						)
					}
				}

			}
