			{
				type =  form
				form = Package

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Shipment_Type != null)
										{
											RealShipment = Shipment[ID == input.Shipment_Type];
											if(RealShipment != null)
											{
												if(RealShipment.Price_Form == "By Weight" && input.Total_Weight == 0)
												{
													openUrl("#Page:Error_Message?mensaje=Weight field must be greatter than 0","popup window","height=143,width=380");
