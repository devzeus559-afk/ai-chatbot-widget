			Set_Update_SubtotalShipme as "Set&Update_SubtotalShipmentTypes"
			{
				type =  form
				form = Release

				record event = on add or edit

				on user input of Shipment_Details.Package_ID
				{
					actions 
					{
						custom deluge script
						(
											// === Calculate types list and subtotals ===
										shipping_types = list();
										subtotal_of_pkgs = Map();
										subtotal_of_pounds = Map();
										// Load last subtotals summary 
										if(input.Subtotals_By_Shipping_Type != null)
										{
											for each  r in input.Subtotals_By_Shipping_Type
											{
												if(r.Shipping_Type != null)
												{
													shipping_types.add(r.Shipping_Type);
													subtotal_of_pkgs.put(r.Shipping_Type,r.Total_Packages);
													subtotal_of_pounds.put(r.Shipping_Type,r.Total_Pounds);
												}
											}
										}
										// Clear subform registries
										input.Subtotals_By_Shipping_Type.clear();
										// Getting value of new box
										if(row.Package_ID != null)
										{
											RealPkg = Package[ID == row.Package_ID];
											RealShipment = Shipment[ID == RealPkg.Shipment_Type];
											type = RealShipment.Shipping_Type;
											pkg_pounds = ifnull(RealPkg.Total_Weight,0.0);
											// Add new shipping type to subtotals summary
											if(!shipping_types.contains(type))
											{
												shipping_types.add(type);
											}
											// Update subtotals values
											pkgs_qty = ifnull(subtotal_of_pkgs.get(type),0) + 1;
											pkgs_pounds = ifnull(subtotal_of_pounds.get(type),0) + pkg_pounds;
											subtotal_of_pkgs.put(type,pkgs_qty);
											subtotal_of_pounds.put(type,pkgs_pounds);
										}
										// Create rows by shipping type
										if(shipping_types != null)
										{
											for each  t in shipping_types
											{
												SubtotalRow = Release.Subtotals_By_Shipping_Type();
												SubtotalRow.Shipping_Type=t;
												SubtotalRow.Total_Packages=subtotal_of_pkgs.get(t);
												SubtotalRow.Total_Pounds=subtotal_of_pounds.get(t);
												input.Subtotals_By_Shipping_Type.insert(SubtotalRow);
											}
										}
						)
					}
				}

			}
			Update_TotalFields1 as "Update_TotalFields"
			{
				type =  form
				form = Release

				record event = on add or edit

				on user input of Shipment_Details.Package_ID
				{
					actions 
					{
						custom deluge script
						(
											// Check changes of 'Package_ID' field
										if(row.Package_ID != null)
										{
											// Initialize temp vars from fields
											total_boxes = ifnull(input.Total_Boxes,0);
											total_bags = ifnull(input.Total_Bags,0);
											total_docs = ifnull(input.Total_Docs,0);
											full_boxes_number = ifnull(input.Total_Full_Packages,0);
											total_weight = ifnull(input.Total_Pounds,0.0);
											total_customs_duty = ifnull(input.Total_Customs_Duty,0.0);
											// Get package registry
											RealPkg = Package[ID == row.Package_ID];
											pkg_weight = ifnull(RealPkg.Total_Weight,0.0);
											pkg_customs_duty = ifnull(RealPkg.Customs_Duty,0.0);
											if(RealPkg.Package_Type == "Box")
											{
												// Increment totals values
												total_boxes = total_boxes + 1;
												total_weight = total_weight + pkg_weight;
												total_customs_duty = total_customs_duty + pkg_customs_duty;
												// Get shipment object and update full boxes total
												RealShipment = Shipment[ID == RealPkg.Shipment_Type];
												if(RealShipment.Price_Form == "By Package")
												{
													full_boxes_number = full_boxes_number + 1;
												}
											}
											else if(RealPkg.Package_Type == "Bag")
											{
												// Increment totals values
												total_bags = total_bags + 1;
												total_weight = total_weight + pkg_weight;
												total_customs_duty = total_customs_duty + pkg_customs_duty;
											}
											else if(RealPkg.Package_Type == "Documents")
											{
												// Increment totals values
												total_docs = total_docs + 1;
												total_customs_duty = total_customs_duty + pkg_customs_duty;
											}
											// Update totals fields
											input.Total_Boxes = total_boxes;
											input.Total_Bags = total_bags;
											input.Total_Docs = total_docs;
											input.Total_Full_Packages = full_boxes_number;
											input.Total_Pounds = total_weight;
											input.Total_Customs_Duty = total_customs_duty;
										}
						)
					}
				}

			}
			Filter_Packages1 as "Filter_Packages"
			{
				type =  form
				form = Release

				record event = on add or edit

				on user input of Shipment_Details.Package_ID
				{
					actions 
					{
						custom deluge script
						(
											if(row.Package_ID == null)
										{
											// Limpia las opciones previamente disponibles en el campo de búsqueda 'Package_ID' en la fila actual del subformulario
											clear row.Package_ID;
											// Crea una lista vacía donde se guardarán las opciones válidas (IDs de cajas)
											pkg_ids = List();
											// Recorre los registros del formulario 'Package' que cumplen TODAS estas condiciones:
											// - Están asignados a un 'Service'
											// - Coinciden con la 'Office' seleccionada en el formulario Service
											// - Tienen estado 'Received'
											for each  p in Package[Office == input.Office && Status == "Received" && Service != null]
											{
												exist = false;
												RealService = Service[ID == p.Service];
												RealLocation = Coverage_Location[ID == p.Location];
												// Filter boxes that match with criterias: 
												// - Service_Type --> "Package Receipt"
												// - Destination_Country --> Package Destination Address (Country) 
												if(RealService.Service_Type == "Package Receipt" && RealLocation.Address_Information1.country == input.Destination_Country)
												{
													// Recorre las filas del subform 'Shipment Details' para descartar duplicados
													for each  r in input.Shipment_Details
													{
														// Si el ID del package actual ya está en alguna fila, lo marcamos como existente
														if(r.Package_ID == p.ID)
														{
															exist = true;
														}
													}
												}
												// Si no fue encontrado en ninguna fila, lo agregamos a la lista de opciones válidas
												if(!exist)
												{
													pkg_ids.add(p.ID);
												}
											}
											// Agrega dinámicamente al campo 'Package_ID' (en la UI) las opciones válidas encontradas
											row.Package_ID:ui.add(pkg_ids);
										}
						)
					}
				}

			}
			Show_Hide_ServiceFilter as "Show&Hide_ServiceFilter"
			{
				type =  form
				form = Release

				record event = on add or edit

				on user input of Add_Multiple_Packages
				{
					actions 
					{
						custom deluge script
						(
											if(Add_Multiple_Packages)
										{
											show Service_Filter;
											input.Add_Packages_Option = "Add";
											// Reset to 'Add' option
											show Add_Packages_Option;
										}
										else
										{
											hide Service_Filter;
											clear Service_Filter;
											hide Add_Packages_Option;
										}
						)
					}
				}

			}
			Filter_Packages2 as "Filter_Packages"
			{
				type =  form
				form = Release

				record event = on add or edit

				on user input of Office
				{
					actions 
					{
						custom deluge script
						(
											// Limpiar Shipment_Details subform si cambia la Office
										if(input.Office != null)
										{
											input.Shipment_Details.clear();
										}
										// Inicializa una lista vacía que contendrá los IDs de las cajas válidas para seleccionar
										pkg_ids = List();
										// Recorre todos los registros del formulario 'Box' que cumplen estas condiciones:
										// - Asignados a un 'Service'
										// - Coinciden con la 'Office' seleccionada
										// - Tienen estado "Received"
										packages = Package[Service != null && Office == input.Office && Status == "Received"];
										for each  b in packages
										{
											RealService = Service[ID == b.Service];
											RealLocation = Coverage_Location[ID == b.Location];
											// Filter packages that match with criterias: 
											// - Service_Type --> "Package Receipt"
											// - Destination_Country --> PAckage Destination Address (Country) 
											if(RealService.Service_Type == "Package Receipt" && RealLocation.Address_Information1.country == input.Destination_Country)
											{
												exist = false;
												// Recorre todas las filas actuales del subformulario 'Boxes'
												for each  r in input.Shipment_Details
												{
													// Si el Box no está en alguna fila del subformulario se adiciona a la lista
													if(r.Package_ID == b.ID)
													{
														exist = true;
													}
												}
												if(!exist)
												{
													pkg_ids.add(b.ID);
												}
											}
										}
										// Ahora se recorre cada fila del subformulario 'Shipment Details'
										for each  pkg in input.Shipment_Details
										{
											// Se busca el registro real del Package asociado a esa fila (usando su ID)
											RealPkg = Package[ID == pkg.Package_ID];
											// Verifica si la caja seleccionada en esta fila pertenece a la nueva Office
											if(RealPkg.Office != input.Office)
											{
												// Si no pertenece a la nueva Office, se limpia el campo de Box y otros campos asociados
												clear pkg.Package_ID;
												// Limpia el campo de búsqueda
												pkg.Package_Name="";
												// Borra el nombre
												pkg.Package_Type="";
												// Borra el tipo
												pkg.Status="";
												// Borra el estado
												pkg.Receipt_Date=null;
												// Borra la fecha de recepción
												pkg.External_Tracking_Number="";
												// Borra el número de rastreo
												pkg.Receiver1="";
												// Borra el nombre del receptor
												pkg.Destination_Street="";
												// Borra la calle destino
												pkg.Location=null;
												// Borra la ubicación
												pkg.Width_in_cm=null;
												// Borra el ancho
												pkg.Length_in_cm=null;
												// Borra el largo
												pkg.Height_in_cm=null;
												// Borra la altura
												pkg.Total_Weight=null;
												// Borra el peso
												pkg.Volume=null;
												// Borra el volumen
												pkg.Package_Material="";
												// Borra el material de la caja
												pkg.Shipping_Type=null;
												// Borra el tipo de envío
												pkg.Package_Price=null;
												// Borra el precio de la caja
											}
											// Aplica dinámicamente las opciones válidas en el campo Box_Name de esta fila
											pkg.Package_ID:ui.add(pkg_ids);
										}
						)
					}
				}

			}
			Enable_AddMultiplePackage as "Enable_AddMultiplePackages"
			{
				type =  form
				form = Release

				record event = on add or edit

				on user input of Office
				{
					actions 
					{
						custom deluge script
						(
											if(input.Office != null)
										{
											enable Add_Multiple_Packages;
										}
										else
										{
											input.Add_Multiple_Packages = false;
											disable Add_Multiple_Packages;
										}
						)
					}
				}

			}
			Add_MultiPkgs_Update_Serv1 as "Add_MultiPkgs&Update_ServiceFilter"
			{
				type =  form
				form = Release

				record event = on add or edit

				on user input of Service_Filter
				{
					actions 
					{
						custom deluge script
						(
											if(input.Service_Filter != null && Add_Packages_Option == "Add")
										{
											// Getting packages associated to selected service but out of shipment details subform
											// list with packages ids not included in subform 
											pkg_ids = list:int();
											// collection that contain all records of subform
											for each  p in Package[Service == input.Service_Filter && Office == input.Office && Status == "Received"]
											{
												RealService = Service[ID == p.Service];
												RealLocation = Coverage_Location[ID == p.Location];
												// Filter packages that match with criterias: 
												// - Service_Type --> "Package Receipt"
												// - Destination_Country --> Pkg Destination Address (Country) 
												if(RealService.Service_Type == "Package Receipt" && RealLocation.Address_Information1.country == input.Destination_Country)
												{
													if(input.Shipment_Details == null)
													{
														pkg_ids.add(p.ID);
													}
													else if(input.Shipment_Details != null)
													{
														for each  r in input.Shipment_Details
														{
															// Save pkg ID in the list if is not included in subform neither in pkg list
															if(r.Package_ID != p.ID && !pkg_ids.contains(p.ID))
															{
																pkg_ids.add(p.ID);
															}
														}
													}
												}
											}
											// === Adding packages ===
											if(!pkg_ids.isEmpty())
											{
												for each  id in pkg_ids
												{
													try 
													{
														RealPkg = Package[ID == id];
														if(RealPkg == null)
														{
															openUrl("#Page:Error_Message?mensaje=No matching Package found for ID: " + id + "","popup window","height=143,width=380");
															//info "No matching Package found for ID: " + id;
														}
														else
														{
															// Create new row in subform
															SubformRow = Release.Shipment_Details();
															// Assign lookup (Pass the record var, not the field)
															SubformRow.Package_ID=RealPkg.ID;
															SubformRow.Package_Name=RealPkg.Package_Name;
															SubformRow.Package_Type=RealPkg.Package_Type;
															SubformRow.Status=RealPkg.Status;
															SubformRow.Receipt_Date=RealPkg.Receipt_Date;
															SubformRow.External_Tracking_Number=RealPkg.Tracking_Number;
															SubformRow.Sender1=RealPkg.Sender_field;
															SubformRow.Receiver1=RealPkg.Receiver_Contact;
															SubformRow.Destination_Street=RealPkg.Street;
															SubformRow.Location=RealPkg.Location;
															SubformRow.Width_in_cm=RealPkg.Width_in;
															SubformRow.Length_in_cm=RealPkg.Length_in;
															SubformRow.Height_in_cm=RealPkg.Height_in;
															SubformRow.Total_Weight=RealPkg.Total_Weight;
															SubformRow.Volume=RealPkg.Volume;
															SubformRow.Package_Material=RealPkg.Package_Material;
															SubformRow.Shipping_Type=RealPkg.Shipment_Type;
															SubformRow.Package_Price=RealPkg.Total_Price;
															SubformRow.Customs_Duty=RealPkg.Customs_Duty;
															SubformRow.Service=RealPkg.Service;
															// Insert new subform row
															input.Shipment_Details.insert(SubformRow);
														}
													}
													catch (e)
													{
														openUrl("#Page:Error_Message?mensaje=ERROR: " + e.toString() + "","popup window","height=143,width=380");
														//info "ERROR: " + e.toString();
													}
												}
											}
											// Transform subform to list<map> for calculate totals and subtotals
											subform = List();
											if(input.Shipment_Details != null)
											{
												for each  r in input.Shipment_Details
												{
													// Populate packages list<map>
													Row1 = Map();
													// Assign lookup (Pass the record var, not the field)
													Row1.put("Package_ID",r.Package_ID.toLong());
													Row1.put("Package_Name",r.Package_Name);
													Row1.put("Package_Type",r.Package_Type);
													Row1.put("Status",r.Status);
													Row1.put("Location",r.Location);
													Row1.put("Total_Weight",r.Total_Weight);
													Row1.put("Shipping_Type",r.Shipping_Type);
													Row1.put("Package_Price",r.Package_Price);
													Row1.put("Customs_Duty",r.Customs_Duty);
													Row1.put("Service",r.Service.toLong());
													// Insert new subform row
													subform.add(Row1);
												}
											}
											// === Update subtotals && totals ===
											// Calculate totals fiels by 'Shipment Details' subform
											totals = Map();
											// Call function that calculate totals values from shipment details 
											totals = thisapp.getShipmentDetailsTotalsBySubform(subform);
											// Update totals fields
											input.Total_Boxes = totals.get("Total_Boxes");
											input.Total_Bags = totals.get("Total_Bags");
											input.Total_Docs = totals.get("Total_Docs");
											input.Total_Full_Packages = totals.get("Total_Full_Packages");
											input.Total_Pounds = totals.get("Total_Pounds");
											input.Total_Customs_Duty = totals.get("Total_Customs_Duty");
											// ===================================================
											// Calculate types list and subtotals by 'Shipment Details' subform	
											// Calculate subtotal rows by shipping types
											shipping_type_subs = Map();
											// Call function that generate subform values from shipment details 
											shipping_type_subs = thisapp.getShipmentTypesSubsBySubform(subform);
											// Clear subform records
											input.Subtotals_By_Shipping_Type.clear();
											// Populate subform
											shipping_types = List();
											shipping_types = shipping_type_subs.get("Shipping_Type");
											if(!shipping_types.isEmpty())
											{
												for each  r in shipping_types
												{
													SubtotalRow = Release.Subtotals_By_Shipping_Type();
													SubtotalRow.Shipping_Type=r.toString();
													SubtotalRow.Total_Packages=shipping_type_subs.get("Total_Packages").get(r);
													SubtotalRow.Total_Pounds=shipping_type_subs.get("Total_Pounds").get(r);
													input.Subtotals_By_Shipping_Type.insert(SubtotalRow);
												}
											}
											// ===================================================
											// Calculate shipment list and subtotals by 'Shipment Details' subform	
											// Calculate subtotal rows by shipments
											shipment_subs2 = Map();
											// Call function that generate subform values from shipment details 
											shipment_subs2 = thisapp.getShipmentSubs2BySubform(subform);
											// Clear subform records
											input.Subtotals_By_Shipment.clear();
											// Populate subform
											shipments = List();
											shipments = shipment_subs2.get("Shipments");
											if(!shipments.isEmpty())
											{
												for each  r in shipments
												{
													SubtotalRow2 = Release.Subtotals_By_Shipment();
													SubtotalRow2.Shipment=r.toString();
													SubtotalRow2.Total_Packages=shipment_subs2.get("Total_Packages").get(r);
													SubtotalRow2.Total_Pounds=shipment_subs2.get("Total_Pounds").get(r);
													input.Subtotals_By_Shipment.insert(SubtotalRow2);
												}
											}
											// ===================================================
											// Calculate subtotals by shipment from 'Shipment Details' subform
											shipment_subs = Map();
											// Call function that generate subform values from shipment details 
											shipment_subs = thisapp.getShipmentSubsBySubform(subform);
											// Clear Subform
											input.Subtotal_by_Shipment.clear();
											// Populate subform
											shipment_types = Map();
											shipment_types = shipment_subs.get("Shipment_Type");
											if(shipment_types != null)
											{
												for each  s in shipment_types.keys()
												{
													subtotal_row = Release.Subtotal_by_Shipment();
													subtotal_row.Shipment_Type_ID=s;
													subtotal_row.Shipment_Type=shipment_types.get(s);
													subtotal_row.Quantity=shipment_subs.get("Quantity").get(s);
													subtotal_row.Unit_Price=shipment_subs.get("Unit_Price").get(s);
													subtotal_row.Total_Price=shipment_subs.get("Total_Price").get(s);
													input.Subtotal_by_Shipment.insert(subtotal_row);
												}
											}
											// === Remove Service of Service_Filter ===
											service_ids = List();
											// Call function that filter services
											service_ids = thisapp.filterServicesForAddPkgs(subform,input.Office,input.Destination_Country);
											// 	service_ids.removeElement(input.Service_Filter);
											// Clear service filter
											input.Service_Filter:ui.add(List());
											input.Service_Filter:ui.add(service_ids);
										}
						)
					}
				}

			}
			Filter_Protections1 as "Filter_Protections"
			{
				type =  form
				form = Shipment

				record event = on add or edit

				on user input of Vendor
				{
					actions 
					{
						custom deluge script
						(
											// Crea una lista vacía donde se guardarán las opciones válidas (IDs de Protecciones)
										pro_list = List();
										// Recorre los registros del subformulario 'Protections' dentro del Vendor seleccionado que cumplen las siguientes condiciones:
										// - Son activos
										// - Coinciden con los 'Country' seleccionados en el Coverage Locations
										// - No se encuentra en ninguna otra fila del subformulario Protections
										RealVendor = Vendor[ID == input.Vendor];
										for each  p in RealVendor.Insurances
										{
											// Banderas para determinar si la Protection ya fue agregada en otra fila del subformulario o no es de uno de los Country del Shipment. Además verificar si es activa 	
											exist = false;
											have_country = false;
											// Recorre todas las filas del subformulario 'Protections' del Vendor
											if(Insurance[ID = p.Insurance].Active == true)
											{
												// Recorre todas las filas del subformulario 'Protections' del Shipment
												for each  registro in input.Insurances
												{
													// Si el ID de la Protection actual ya está seleccionado en alguna fila, lo marcamos como existente
													if(registro.Insurance == p.Insurance)
													{
														exist = true;
													}
												}
												// Recorre todas las Coverage Locations del Shipment para verificar si el país de la Protection del Vendor está dentro de las Coverages del Shipment
												for each  local in input.Coverage_Locations
												{
													local2 = Coverage_Location[ID == local];
													if(p.Country == local2.Address_Information1.country)
													{
														have_country = true;
													}
												}
												// Si no fue encontrada en ninguna fila y su Country coincide con el Country de una de las Coverage_Locations del Shipment, la agregamos a la lista de opciones válidas
												if(exist == false && have_country == true)
												{
													pro_list.add(p.Insurance);
												}
											}
										}
										// Agrega dinámicamente al campo 'Protection' (en la UI) las opciones válidas encontradas
										for each  fila in input.Insurances
										{
											valor_actual = fila.Insurance;
											fila.Insurance:ui.add(pro_list);
											fila.Insurance=valor_actual;
										}
						)
					}
				}

			}
			Clear_Old_Protections as "Clear_Old_Protections"
			{
				type =  form
				form = Shipment

				record event = on add or edit

				on user input of Vendor
				{
					actions 
					{
						custom deluge script
						(
											// Recorre los registros del subformulario 'Protections' dentro del Shipment para validar cuales cumplen las siguientes condiciones:
										// - Son activos
										// - Coinciden con los 'Country' seleccionados en el Coverage Locations
										// - Es una Protection del nuevo Vendor
										RealVendor = Vendor[ID == input.Vendor];
										Actual = input.Insurances;
										clear Insurances;
										for each  p in Actual
										{
											// Banderas para determinar si la Protection ya fue agregada en otra fila del subformulario o no es de uno de los Country del Shipment. Además verificar si es activa 	
											pertenece = false;
											have_country = false;
											if(Insurance[ID = p.Insurance].Active == true)
											{
												// Recorre todas las filas del subformulario 'Protections' del Vendor
												for each  registro in RealVendor.Insurances
												{
													// Si el ID de la Protection actual es una de las protecciones del Vendor la marcamos como que pertenece
													if(p.Insurance == registro.Insurance)
													{
														pertenece = true;
														// Recorre todas las Coverage Locations del Shipment para verificar si el país de la Protection está dentro de las Coverages del Shipment
														for each  local in input.Coverage_Locations
														{
															local2 = Coverage_Location[ID == local];
															if(registro.Country == local2.Address_Information1.country)
															{
																have_country = true;
															}
														}
													}
												}
											}
											// Si no pertenece al nuevo Vendor o su Country no coincide con ningún Country de una de las Coverage_Locations del Shipment limpiamos la fila
											if(pertenece == true && have_country == true)
											{
												new_prot = Shipment.Insurances();
												new_prot.Insurance=p.Insurance;
												new_prot.Required=p.Required;
												new_prot.Previous_Insurance=p.Previous_Insurance;
												input.Insurances.insert(new_prot);
											}
										}
						)
					}
				}

			}
