				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Name
			(
    			type = text
				initial value = "Value filled automatically"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Short_Name
			(
    			type = text
				displayname = "Short Name"
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Active
			(
    			type = checkbox
				initial value = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Shipment_ID
			(
    			type = text
				displayname = "Shipment ID"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Office
			(
				type = picklist	
				values  = Commercial_Office[Active == true].ID
    			displayformat = [Office_Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Shipment_Information
			(
				type = section
				displayname = "Shipment Information"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Shipping_Type
			(
				type = picklist
				displayname = "Shipping Type"
				maxchar = 100
				values = {"Air Express","Air","Maritime","Caja Pronto 15","Caja Pronto 12","Caja Naranja 15","Caja Naranja 12"}
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Type_of_Merchandise
			(
				type = picklist
				displayname = " Type of Merchandise"
				maxchar = 100
				values = {"Miscellaneous","Durables","Documents","Toilet Food Medicine","Courier"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Coverage_Locations
			(
				type = list	
				displayname = "Coverage Locations"
				values  = Coverage_Location[Active == true].ID
    			displayformat = [Location_Name]
				sortorder = ascending
				height = 60px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Vendor
			(
				type = picklist	
				values  = Vendor.ID
    			displayformat = [Vendor_Name]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Price_Details
			(
				type = section
				displayname = "Price Details"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Our_Commission
			(
				displayname = "Our Commission"
				type = USD
				format = commadotwestern
				initial value = 0
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Basic_Price
			(
				displayname = "Basic Price"
				type = USD
				format = commadotwestern
				initial value = 0
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Price_Form
			(
				type = radiobuttons
				displayname = "Price Form"
				maxchar = 100
				values = {"By Weight","By Volumetric weight","By Greater weight","By Package"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Total_Price
			(
				displayname = "Total Price"
				type = USD
				format = commadotwestern
				initial value = 0
	 			row = 3
	 			column = 1   
				width = medium
			)
			Auto_Calculate_Total_Price
			(
    			type = checkbox
				displayname = "Automatically Calculate Total Price"
				initial value = false
	 			row = 3
	 			column = 1   
				width = medium
			)
			Insurances
			(
				type = grid
				must have Insurance
				(
					type = picklist	
					values  = Insurance.ID
    				displayformat = [Insurance_Name]
					sortorder = ascending
					width = large
				)
				Required
				(
    				type = checkbox
					initial value = false
					width = medium
				)
				Previous_Insurance
				(
					type = picklist	
					displayname = "Previous Insurance"
					values  = Insurance.ID
    				displayformat = [Insurance_ID]
					sortorder = ascending
					width = medium
				)
	 			row = 4
	 			column = 1   
				width = medium
			)
			Relations
			(
				type = section
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			must have Book_Item_ID
			(
				type = picklist
				displayname = "Book Item ID"
				maxchar = 100
				values = {"None"}
				others option = true
	 			row = 5
	 			column = 1   
				width = medium
			)
			Hide_Section
			(
				type = section
				displayname = "Hide Section"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			Presentation_Name
			(
    			type = formula
				displayname = "Presentation Name"
				value =  input.Shipping_Type + ", " + input.Type_of_Merchandise
				visibility = false
				display type = text
				format = plaintext
	 			row = 6
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Enviar"
					)
					reset
					(
   						type = reset
   						displayname = "Restablecer"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Actualizar"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancelar"
					)
				}
			}
		}
