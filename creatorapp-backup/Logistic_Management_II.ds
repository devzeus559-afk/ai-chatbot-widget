		page Public_Tracking_Details(int pkg_id, string search_code, string trck_page_tk, string url_base)
		{
			displayname = "Public Tracking Details"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '5px'\n\tpaddingLeft = '10px'\n\tpaddingRight = '0px'\n\tpaddingBottom = '5px'\n\tbgColor = 'theme'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '5px'\n\tmarginTop = '5px'\n\n    borderColor = '#2D2D2D'\n    borderWidth = '0px'\n\tcolor = '#2D2D2D'\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\twidth = '130px'\n\theight = '37.25px'\n\ttype = 'gallery'\n\tvalue = 'tracking-banner.png'\n\tcornerRadius = '0px'\n/>\n</pc><pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '5px' \n\tmarginBottom = '5px'\n\tmarginTop = '0px'\n\tpadding = '0px'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n\titalic = 'true' \n\tfontFamily = 'arimo, sans-serif' \n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n\n\t  value = 'Seguimiento de Env\u00EDos'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dspZml id='zml_snippet2' elementName='ZML Snippet'\n>\n\t<![CDATA[htmlpage zml_snippet2()\ncontent\n&lt;%{\n\t%&gt;\n&lt;panel&gt;\n  &lt;pr width=&apos;fill&apos; height=&apos;fill&apos;&gt;\n    &lt;pc bgColor=&apos;#FFFFFF&apos; width=&apos;100%&apos; hAlign=&apos;left&apos; vAlign=&apos;middle&apos;&gt;\n&lt;%\n\t// to display tracking info\n\t// processing\n\tif(input.pkg_id != null)\n\t{\n\t\tPkgTrck = Pkg_Tracking[Package_ID == input.pkg_id];\n\t\tif(PkgTrck != null &amp;&amp; PkgTrck.Latest_Status != null &amp;&amp; PkgTrck.Last_Updated != null)\n\t\t{\n\t\t\tpkg_code = input.search_code;\n\t\t\tlatest_status = PkgTrck.Latest_Status;\n\t\t\tlast_updated = PkgTrck.Last_Updated.toString();\n\t\t\t%&gt;\n&lt;!-- Status Details --&gt;\n&lt;pr width=&apos;fill&apos; height=&apos;fill&apos;&gt;\n        &lt;pc paddingTop=&apos;0px&apos; paddingLeft=&apos;40px&apos; paddingRight=&apos;17px&apos; paddingBottom=&apos;5px&apos; bgColor=&apos;transparent&apos; width=&apos;100%&apos; hAlign=&apos;left&apos;&gt;\n          &lt;pr width=&apos;auto&apos; height=&apos;auto&apos;&gt;\n            &lt;pc&gt;\n              &lt;text margin=&apos;17px&apos; padding=&apos;0px&apos; color=&apos;#FF7A1B&apos; size=&apos;18px&apos; bold=&apos;true&apos; type=&apos;Text&apos; bgColor=&apos;transparent&apos; bgColorType=&apos;noFill&apos; cornerRadius=&apos;0px&apos; borderColor=&apos;#000000&apos; borderWidth=&apos;0px&apos; value=&apos;Estado Actual del Env\u00EDo&apos;&gt; &lt;/text&gt;\n            &lt;/pc&gt;\n          &lt;/pr&gt;\n        &lt;/pc&gt;\n      &lt;/pr&gt;\n\t  &lt;pr width=&apos;fill&apos; height=&apos;fill&apos;&gt;\n\t\t\t&lt;pc paddingTop=&apos;5px&apos; paddingLeft=&apos;32px&apos; paddingRight=&apos;10px&apos; paddingBottom=&apos;10px&apos; bgColor=&apos;#FFFFFF&apos; width=&apos;100%&apos; hAlign=&apos;left&apos; vAlign=&apos;middle&apos;&gt;\n\t\t\t  &lt;pr width=&apos;auto&apos; height=&apos;auto&apos;&gt;\t  \n\t  \t\t\t&lt;pc&gt;\n\t\t\t\t\n      \t\t\t\t&lt;pr width=&apos;fill&apos; height=&apos;fill&apos;&gt;\n      \t\t\t\t  &lt;pc paddingTop=&apos;5px&apos; paddingLeft=&apos;0px&apos; paddingRight=&apos;17px&apos; paddingBottom=&apos;5px&apos; bgColor=&apos;transparent&apos; width=&apos;100%&apos; hAlign=&apos;left&apos;&gt;\n      \t\t\t\t    &lt;pr width=&apos;auto&apos; height=&apos;auto&apos;&gt;\n      \t\t\t\t      &lt;pc&gt;\n      \t\t\t\t        &lt;text margin=&apos;0px&apos; padding=&apos;0px&apos; color=&apos;#000000&apos; size=&apos;15px&apos; type=&apos;Text&apos; bgColor=&apos;transparent&apos; bgColorType=&apos;noFill&apos; cornerRadius=&apos;0px&apos; borderColor=&apos;#000000&apos; borderWidth=&apos;0px&apos; value=&apos;C\u00F3digo:&apos;&gt; &lt;/text&gt;\t\t\t\n      \t\t\t\t      &lt;/pc&gt;\n      \t\t\t\t      &lt;pc&gt;\t\t\t\n      \t\t\t\t        &lt;text margin=&apos;0px&apos; paddingLeft=&apos;32px&apos; color=&apos;#FF7A1B&apos; size=&apos;18px&apos; bold=&apos;true&apos; type=&apos;Text&apos; bgColor=&apos;transparent&apos; bgColorType=&apos;noFill&apos; cornerRadius=&apos;0px&apos; borderColor=&apos;#000000&apos; borderWidth=&apos;0px&apos; value=&apos;&lt;%=pkg_code%&gt;&apos;&gt; &lt;/text&gt;\n      \t\t\t\t      &lt;/pc&gt;\t\t\t\n      \t\t\t\t    &lt;/pr&gt;\n      \t\t\t\t  &lt;/pc&gt;\n\t\t\t\t\t&lt;/pr&gt;\t\t\t\t\n\t\t\t\t\t&lt;pr width=&apos;fill&apos; height=&apos;fill&apos;&gt;\n\t\t\t\t\t        &lt;pc paddingTop=&apos;5px&apos; paddingLeft=&apos;0px&apos; paddingRight=&apos;17px&apos; paddingBottom=&apos;5px&apos; bgColor=&apos;transparent&apos; width=&apos;100%&apos; hAlign=&apos;left&apos;&gt;\n\t\t\t\t\t          &lt;pr width=&apos;auto&apos; height=&apos;auto&apos;&gt;\n\t\t\t\t\t            &lt;pc&gt;\n\t\t\t\t\t              &lt;text margin=&apos;0px&apos; padding=&apos;0px&apos; color=&apos;#000000&apos; size=&apos;15px&apos; type=&apos;Text&apos; bgColor=&apos;transparent&apos; bgColorType=&apos;noFill&apos; cornerRadius=&apos;0px&apos; borderColor=&apos;#000000&apos; borderWidth=&apos;0px&apos; value=&apos;Estado:&apos;&gt; &lt;/text&gt;\t\t\t\n\t\t\t\t\t            &lt;/pc&gt;\n\t\t\t\t\t            &lt;pc&gt;\t\t\t\n\t\t\t\t\t              &lt;text margin=&apos;0px&apos; paddingLeft=&apos;32px&apos; color=&apos;#000000&apos; size=&apos;16px&apos; type=&apos;Text&apos; bgColor=&apos;transparent&apos; bgColorType=&apos;noFill&apos; cornerRadius=&apos;0px&apos; borderColor=&apos;#000000&apos; borderWidth=&apos;0px&apos; value=&apos;&lt;%=latest_status%&gt;&apos;&gt; &lt;/text&gt;\n\t\t\t\t\t            &lt;/pc&gt;\t\t\t\n\t\t\t\t\t          &lt;/pr&gt;\n\t\t\t\t\t        &lt;/pc&gt;\n\t\t\t\t\t&lt;/pr&gt;  \n\t\t\t\t\t&lt;pr width=&apos;fill&apos; height=&apos;fill&apos;&gt;\n\t\t\t\t\t        &lt;pc paddingTop=&apos;5px&apos; paddingLeft=&apos;0px&apos; paddingRight=&apos;17px&apos; paddingBottom=&apos;28px&apos; bgColor=&apos;transparent&apos; width=&apos;100%&apos; hAlign=&apos;left&apos;&gt;\n\t\t\t\t\t          &lt;pr width=&apos;auto&apos; height=&apos;auto&apos;&gt;\n\t\t\t\t\t            &lt;pc&gt;\n\t\t\t\t\t              &lt;text margin=&apos;0px&apos; padding=&apos;0px&apos; color=&apos;#000000&apos; size=&apos;15px&apos; type=&apos;Text&apos; bgColor=&apos;transparent&apos; bgColorType=&apos;noFill&apos; cornerRadius=&apos;0px&apos; borderColor=&apos;#000000&apos; borderWidth=&apos;0px&apos; value=&apos;Fecha Act.:&apos;&gt; &lt;/text&gt;\t\t\t\n\t\t\t\t\t            &lt;/pc&gt;\n\t\t\t\t\t            &lt;pc&gt;\t\t\t\n\t\t\t\t\t              &lt;text margin=&apos;0px&apos; paddingLeft=&apos;10px&apos; color=&apos;#000000&apos; size=&apos;15px&apos; type=&apos;Text&apos; bgColor=&apos;transparent&apos; bgColorType=&apos;noFill&apos; cornerRadius=&apos;0px&apos; borderColor=&apos;#000000&apos; borderWidth=&apos;0px&apos; value=&apos;&lt;%=last_updated%&gt;&apos;&gt; &lt;/text&gt;\n\t\t\t\t\t            &lt;/pc&gt;\t\t\t\n\t\t\t\t\t          &lt;/pr&gt;\n\t\t\t\t\t        &lt;/pc&gt;\n\t\t\t\t\t&lt;/pr&gt;\t\t\n\t\t\n            &lt;/pc&gt;\t\t\t\n          &lt;/pr&gt;\n        &lt;/pc&gt;\n\t\t&lt;/pr&gt;\n&lt;%\n\t\t}\n\t\telse if(input.pkg_id == 0 || input.pkg_id == 1)\n\t\t{\n\t\t\tstatus_info = if(input.pkg_id == 0,&quot;No hay informaci\u00F3n de este env\u00EDo.&quot;,&quot;Recibido en Agencia.&quot;);\n\t\t\t%&gt;\n&lt;!-- Not Found Status --&gt;\t\n\t  &lt;pr width=&apos;fill&apos; height=&apos;fill&apos;&gt;\n\t\t\t&lt;pc paddingTop=&apos;5px&apos; paddingLeft=&apos;32px&apos; paddingRight=&apos;10px&apos; paddingBottom=&apos;10px&apos; bgColor=&apos;#FFFFFF&apos; width=&apos;100%&apos; hAlign=&apos;left&apos; vAlign=&apos;middle&apos;&gt;\n\t\t\t  &lt;pr width=&apos;auto&apos; height=&apos;auto&apos;&gt;\t  \n\t  \t\t\t&lt;pc&gt;\n\t\t\t\t\n      \t\t\t\t&lt;pr width=&apos;fill&apos; height=&apos;fill&apos;&gt;\n      \t\t\t\t  &lt;pc paddingTop=&apos;5px&apos; paddingLeft=&apos;0px&apos; paddingRight=&apos;17px&apos; paddingBottom=&apos;5px&apos; bgColor=&apos;transparent&apos; width=&apos;100%&apos; hAlign=&apos;left&apos;&gt;\n      \t\t\t\t    &lt;pr width=&apos;auto&apos; height=&apos;auto&apos;&gt;\n      \t\t\t\t      &lt;pc&gt;\t\t\t\n      \t\t\t\t        &lt;text margin=&apos;0px&apos; paddingLeft=&apos;32px&apos; color=&apos;#FF7A1B&apos; size=&apos;18px&apos; bold=&apos;true&apos; type=&apos;Text&apos; bgColor=&apos;transparent&apos; bgColorType=&apos;noFill&apos; cornerRadius=&apos;0px&apos; borderColor=&apos;#000000&apos; borderWidth=&apos;0px&apos; value=&apos;&lt;%=status_info%&gt;&apos;&gt; &lt;/text&gt;\n      \t\t\t\t      &lt;/pc&gt;\t\t\t\n      \t\t\t\t    &lt;/pr&gt;\n      \t\t\t\t  &lt;/pc&gt;\n\t\t\t\t\t&lt;/pr&gt;\t\t\n            &lt;/pc&gt;\t\t\t\n          &lt;/pr&gt;\n        &lt;/pc&gt;\n\t\t&lt;/pr&gt;\n&lt;%\n\t\t}\n\t}\n\t%&gt;\n&lt;/pc&gt;\n  &lt;/pr&gt;\n&lt;/panel&gt;\n&lt;%\n\n}%&gt;]]>\n</dspZml>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dspZml id='zml_snippet3' elementName='ZML Snippet 1'\n>\n\t<![CDATA[htmlpage zml_snippet3()\ncontent\n&lt;%{\n\t// to display tracking info\n\tif(input.search_code != null)\n\t{\n\t\t%&gt;\n&lt;panel&gt;\n  &lt;pr width=&apos;fill&apos; height=&apos;fill&apos;&gt;\n    &lt;pc bgColor=&apos;#FFFFFF&apos; width=&apos;100%&apos; hAlign=&apos;center&apos; vAlign=&apos;middle&apos;&gt;\n&lt;%\n\t\t// print tracking data\n\t\t// ..get real pakage ID\n\t\t// \t\tPkgID = Package[Package_ID == input.search_code].ID sort by ID;\n\t\t// ..get Package record\n\t\tPkgRec = Package[Package_ID == input.search_code];\n\t\t// ..get Tracking Info record\n\t\tPkgInfo = Pkg_Tracking[Package_ID == input.pkg_id];\n\t\tif(PkgInfo.ID != null &amp;&amp; PkgInfo.Status_History != null)\n\t\t{\n\t\t\t%&gt;\n&lt;!-- Status History Header --&gt;\n&lt;pr width=&apos;fill&apos; height=&apos;auto&apos;&gt;\n      \t  &lt;pc paddingTop=&apos;0px&apos; paddingLeft=&apos;40px&apos; paddingRight=&apos;17px&apos; paddingBottom=&apos;5px&apos; bgColor=&apos;transparent&apos; width=&apos;100%&apos; hAlign=&apos;left&apos;&gt;\n      \t        &lt;text margin=&apos;17px&apos; padding=&apos;0px&apos; color=&apos;#FF7A1B&apos; size=&apos;18px&apos; bold=&apos;true&apos; type=&apos;Text&apos; bgColor=&apos;transparent&apos; bgColorType=&apos;noFill&apos; cornerRadius=&apos;0px&apos; borderColor=&apos;#000000&apos; borderWidth=&apos;0px&apos; value=&apos;Historial de Estados&apos;&gt; &lt;/text&gt;\n      \t  &lt;/pc&gt;\n        &lt;/pr&gt;\n&lt;%\n\t\t\t// print each tracking status data\n\t\t\tisLastStatus = true;\n\t\t\tfor each  r in PkgInfo.Status_History\n\t\t\t{\n\t\t\t\ttrack_icon = if(isLastStatus,&quot;ui-1-check-bold&quot;,&quot;shopping-box-3d-67&quot;);\n\t\t\t\ticon_type = if(isLastStatus,&quot;solid&quot;,&quot;outline&quot;);\n\t\t\t\t%&gt;\n&lt;!-- Status Detail --&gt;\n&lt;pr width=&apos;fill&apos; height=&apos;fill&apos;&gt;\n\t\t\t&lt;pc paddingTop=&apos;5px&apos; paddingLeft=&apos;32px&apos; paddingRight=&apos;10px&apos; paddingBottom=&apos;10px&apos; bgColor=&apos;#FFFFFF&apos; width=&apos;100%&apos; hAlign=&apos;left&apos; vAlign=&apos;middle&apos;&gt;\n\t\t\t  &lt;pr width=&apos;auto&apos; height=&apos;auto&apos;&gt;\n\t\t\t  \n\t\t\t    &lt;pc&gt;\n\t\t\t          &lt;image marginRight=&apos;7px&apos; color=&apos;#FFFFFF&apos; bgColor=&apos;#FF7A1B&apos; width=&apos;36px&apos; height=&apos;36px&apos; type=&apos;icon&apos; value=&apos;&lt;%=track_icon%&gt;&apos; size=&apos;24px&apos; cornerRadius=&apos;26px&apos; iconType=&apos;&lt;%=icon_type%&gt;&apos; /&gt; \t\t\n\t\t\t\t&lt;/pc&gt;\n\t\t\t\t\n\t\t\t\t&lt;pc margin=&apos;5px&apos; hAlign=&apos;left&apos;&gt;\n\t\t\t\t&lt;!-- Status Name --&gt;\n\t\t\t\t  &lt;pr width=&apos;fill&apos; height=&apos;fill&apos;&gt;\n\t\t\t        &lt;pc paddingTop=&apos;5px&apos; paddingLeft=&apos;17px&apos; paddingRight=&apos;17px&apos; paddingBottom=&apos;5px&apos; bgColor=&apos;transparent&apos; width=&apos;100%&apos; hAlign=&apos;left&apos;&gt;\n\t\t\t              &lt;text margin=&apos;0px&apos; padding=&apos;0px&apos; color=&apos;#000000&apos; size=&apos;15px&apos; type=&apos;Text&apos; bgColor=&apos;transparent&apos; bgColorType=&apos;noFill&apos; cornerRadius=&apos;0px&apos; borderColor=&apos;#000000&apos; borderWidth=&apos;0px&apos; value=&apos;&lt;%=r.Status%&gt;&apos;&gt; &lt;/text&gt;\n\t\t\t        &lt;/pc&gt;\n\t\t\t      &lt;/pr&gt;\n\t\t\t\t  &lt;!-- Status Update --&gt;\n\t\t\t      &lt;pr width=&apos;fill&apos; height=&apos;fill&apos;&gt;\n\t\t\t        &lt;pc paddingTop=&apos;0px&apos; paddingLeft=&apos;17px&apos; paddingRight=&apos;17px&apos; paddingBottom=&apos;5px&apos; bgColor=&apos;transparent&apos; width=&apos;100%&apos; hAlign=&apos;left&apos;&gt;\n\t\t\t              &lt;text margin=&apos;0px&apos; padding=&apos;0px&apos; color=&apos;#000000&apos; size=&apos;12px&apos; type=&apos;Text&apos; bgColor=&apos;transparent&apos; bgColorType=&apos;noFill&apos; cornerRadius=&apos;0px&apos; borderColor=&apos;#000000&apos; borderWidth=&apos;0px&apos; value=&apos;&lt;%=r.Status_Date.toDate()%&gt;&apos;&gt; &lt;/text&gt;\n\t\t\t        &lt;/pc&gt;\n\t\t\t      &lt;/pr&gt;\n\t\t\t\t  \n\t\t\t\t&lt;/pc&gt;\n\t\t\t\t\n\t\t\t   &lt;/pr&gt;\n\t\t\t &lt;/pc&gt;\n\t\t\t&lt;/pr&gt;\n&lt;%\n\t\t\t\tisLastStatus = false;\n\t\t\t}\n\t\t\t%&gt;\n&lt;!-- Registred Status --&gt;\n&lt;pr width=&apos;fill&apos; height=&apos;fill&apos;&gt;\n\t\t\t&lt;pc paddingTop=&apos;0px&apos; paddingLeft=&apos;32px&apos; paddingRight=&apos;10px&apos; paddingBottom=&apos;10px&apos; bgColor=&apos;#FFFFFF&apos; width=&apos;100%&apos; hAlign=&apos;left&apos; vAlign=&apos;middle&apos;&gt;\n\t\t\t  &lt;pr width=&apos;auto&apos; height=&apos;auto&apos;&gt;\t\t  \n\t\t\t    &lt;pc&gt;\n\t\t\t          &lt;image marginRight=&apos;7px&apos; color=&apos;#FFFFFF&apos; bgColor=&apos;#FF7A1B&apos; width=&apos;36px&apos; height=&apos;36px&apos; type=&apos;icon&apos; value=&apos;shopping-box-3d-67&apos; size=&apos;24px&apos; cornerRadius=&apos;26px&apos; iconType=&apos;outline&apos; /&gt; \t\t\n\t\t\t\t&lt;/pc&gt;\t\t\t\t\t\t\n\t\t\t\t\n\t\t\t\t&lt;pc margin=&apos;5px&apos; hAlign=&apos;left&apos;&gt;\n\t\t\t\t\n\t\t\t\t  &lt;pr width=&apos;fill&apos; height=&apos;auto&apos;&gt;\n\t\t \t       &lt;pc paddingTop=&apos;5px&apos; paddingLeft=&apos;17px&apos; paddingRight=&apos;17px&apos; paddingBottom=&apos;5px&apos; bgColor=&apos;transparent&apos; width=&apos;100%&apos; hAlign=&apos;left&apos;&gt;\n\t\t \t             &lt;text margin=&apos;0px&apos; padding=&apos;0px&apos; color=&apos;#000000&apos; size=&apos;15px&apos; type=&apos;Text&apos; bgColor=&apos;transparent&apos; bgColorType=&apos;noFill&apos; cornerRadius=&apos;0px&apos; borderColor=&apos;#000000&apos; borderWidth=&apos;0px&apos; value=&apos;Registrado para Entrega&apos;&gt; &lt;/text&gt;\n\t\t \t       &lt;/pc&gt;\n\t\t \t     &lt;/pr&gt;\n\t\t\t\t \n\t\t \t     &lt;pr width=&apos;fill&apos; height=&apos;auto&apos;&gt;\n\t\t \t       &lt;pc paddingTop=&apos;0px&apos; paddingLeft=&apos;17px&apos; paddingRight=&apos;17px&apos; paddingBottom=&apos;28px&apos; bgColor=&apos;transparent&apos; width=&apos;100%&apos; hAlign=&apos;left&apos;&gt;\n\t\t \t             &lt;text margin=&apos;0px&apos; padding=&apos;0px&apos; color=&apos;#000000&apos; size=&apos;12px&apos; type=&apos;Text&apos; bgColor=&apos;transparent&apos; bgColorType=&apos;noFill&apos; cornerRadius=&apos;0px&apos; borderColor=&apos;#000000&apos; borderWidth=&apos;0px&apos; value=&apos;&lt;%=PkgRec.Receipt_Date%&gt;&apos;&gt; &lt;/text&gt;\n\t\t \t       &lt;/pc&gt;\n\t\t \t     &lt;/pr&gt;\n\t\t\t\t \n\t\t\t  &lt;/pc&gt;\n\t\t    &lt;/pr&gt;\n\t\t  &lt;/pc&gt;\t\t\t  \n\t\t&lt;/pr&gt;\n&lt;%\n\t\t}\n\t\t// print receipt status if not found tracking data\n\t\telse if(PkgInfo.ID != null &amp;&amp; PkgInfo.Status_History == null)\n\t\t{\n\t\t\t%&gt;\n&lt;pr width=&apos;fill&apos; height=&apos;auto&apos;&gt;\n         &lt;pc paddingTop=&apos;0px&apos; paddingLeft=&apos;44px&apos; paddingRight=&apos;17px&apos; paddingBottom=&apos;5px&apos; bgColor=&apos;transparent&apos; width=&apos;100%&apos; hAlign=&apos;center&apos;&gt;\n               &lt;text margin=&apos;17px&apos; padding=&apos;0px&apos; color=&apos;#FF7A1B&apos; size=&apos;18px&apos; bold=&apos;true&apos; type=&apos;Text&apos; bgColor=&apos;transparent&apos; bgColorType=&apos;noFill&apos; cornerRadius=&apos;0px&apos; borderColor=&apos;#000000&apos; borderWidth=&apos;0px&apos; value=&apos;Historial de Estados&apos;&gt; &lt;/text&gt;\n          &lt;/pc&gt;\n\t\t&lt;/pr&gt;\n&lt;%\n\t\t\t// add dispatched status if has activated\n\t\t\tisDispatched = if(PkgRec.Status == &quot;Dispatched&quot;,true,false);\n\t\t\tfirst_track_icon = if(isDispatched,&quot;shopping-box-3d-67&quot;,&quot;ui-1-check-bold&quot;);\n\t\t\tfirst_icon_type = if(isDispatched,&quot;outline&quot;,&quot;solid&quot;);\n\t\t\t%&gt;\n&lt;!-- Registred Status --&gt;\n&lt;pr width=&apos;fill&apos; height=&apos;auto&apos;&gt;\n\t\t\t&lt;pc paddingTop=&apos;5px&apos; paddingLeft=&apos;32px&apos; paddingRight=&apos;10px&apos; paddingBottom=&apos;10px&apos; bgColor=&apos;#FFFFFF&apos; width=&apos;100%&apos; hAlign=&apos;left&apos; vAlign=&apos;middle&apos;&gt;\n\t\t\t  &lt;pr width=&apos;auto&apos; height=&apos;auto&apos;&gt;\t\t  \n\t\t\t    &lt;pc&gt;\n\t\t\t          &lt;image marginRight=&apos;7px&apos; color=&apos;#FFFFFF&apos; bgColor=&apos;#FF7A1B&apos; width=&apos;36px&apos; height=&apos;36px&apos; type=&apos;icon&apos; value=&apos;&lt;%=first_track_icon%&gt;&apos; size=&apos;24px&apos; cornerRadius=&apos;26px&apos; iconType=&apos;&lt;%=first_icon_type%&gt;&apos; /&gt; \t\t\n\t\t\t\t&lt;/pc&gt;\t\t\t\t\t\t\n\t\t\t\t\n\t\t\t\t&lt;pc margin=&apos;5px&apos; hAlign=&apos;left&apos;&gt;\n\t\t\t\t\n\t\t\t\t  &lt;pr width=&apos;fill&apos; height=&apos;auto&apos;&gt;\n\t\t \t       &lt;pc paddingTop=&apos;5px&apos; paddingLeft=&apos;17px&apos; paddingRight=&apos;17px&apos; paddingBottom=&apos;5px&apos; bgColor=&apos;transparent&apos; width=&apos;100%&apos; hAlign=&apos;left&apos;&gt;\n\t\t \t             &lt;text margin=&apos;0px&apos; padding=&apos;0px&apos; color=&apos;#000000&apos; size=&apos;15px&apos; type=&apos;Text&apos; bgColor=&apos;transparent&apos; bgColorType=&apos;noFill&apos; cornerRadius=&apos;0px&apos; borderColor=&apos;#000000&apos; borderWidth=&apos;0px&apos; value=&apos;Registrado para Entrega&apos;&gt; &lt;/text&gt;\n\t\t \t       &lt;/pc&gt;\n\t\t \t     &lt;/pr&gt;\n\t\t\t\t \n\t\t \t     &lt;pr width=&apos;fill&apos; height=&apos;auto&apos;&gt;\n\t\t \t       &lt;pc paddingTop=&apos;0px&apos; paddingLeft=&apos;17px&apos; paddingRight=&apos;17px&apos; paddingBottom=&apos;28px&apos; bgColor=&apos;transparent&apos; width=&apos;100%&apos; hAlign=&apos;left&apos;&gt;\n\t\t \t             &lt;text margin=&apos;0px&apos; padding=&apos;0px&apos; color=&apos;#000000&apos; size=&apos;12px&apos; type=&apos;Text&apos; bgColor=&apos;transparent&apos; bgColorType=&apos;noFill&apos; cornerRadius=&apos;0px&apos; borderColor=&apos;#000000&apos; borderWidth=&apos;0px&apos; value=&apos;&lt;%=PkgRec.Receipt_Date%&gt;&apos;&gt; &lt;/text&gt;\n\t\t \t       &lt;/pc&gt;\n\t\t \t     &lt;/pr&gt;\n\t\t\t\t \n\t\t\t  &lt;/pc&gt;\n\t\t    &lt;/pr&gt;\n\t\t  &lt;/pc&gt;\t\t\t  \n\t\t&lt;/pr&gt;\n&lt;!-- New Search Button --&gt;\n&lt;%\n\t\t}\n\t\telse if(PkgInfo.ID == null)\n\t\t{\n\t\t\t%&gt;\n&lt;!-- Pkg Not Found --&gt;\t\t\t\n&lt;pr width=&apos;auto&apos; height=&apos;auto&apos;&gt;  \n        &lt;pc&gt;\n          &lt;image margin=&apos;0px&apos; borderColor=&apos;#2D2D2D&apos; borderWidth=&apos;0px&apos; color=&apos;#2D2D2D&apos; bgColor=&apos;transparent&apos; bgColorType=&apos;noFill&apos; width=&apos;192px&apos; height=&apos;137px&apos; type=&apos;gallery&apos; value=&apos;img3.png&apos; cornerRadius=&apos;0px&apos; /&gt;\n\t\t&lt;/pc&gt;\t   \n      &lt;/pr&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/pc&gt;\n  &lt;/pr&gt;\n&lt;/panel&gt;\n&lt;%\n\t}\n\t// print a message if not found a package with the input code\n\telse\n\t{\n\t\t%&gt;\n&lt;!-- Empty Status History --&gt;\n&lt;panel&gt;\n  &lt;pr width=&apos;fill&apos; height=&apos;auto&apos;&gt;\n\t&lt;pc padding=&apos;0px&apos; bgColor=&apos;#FFFFFF&apos; width=&apos;100%&apos; hAlign=&apos;center&apos; vAlign=&apos;middle&apos;&gt;\n          &lt;image margin=&apos;0px&apos; borderColor=&apos;#2D2D2D&apos; borderWidth=&apos;0px&apos; color=&apos;#2D2D2D&apos; bgColor=&apos;transparent&apos; bgColorType=&apos;noFill&apos; width=&apos;140px&apos; height=&apos;100px&apos; type=&apos;gallery&apos; value=&apos;img3.png&apos; cornerRadius=&apos;0px&apos; /&gt;\n\t&lt;/pc&gt;\t\t\n  &lt;/pr&gt;\n&lt;/panel&gt;\n&lt;%\n\t}\n\n}%&gt;]]>\n</dspZml>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\tvAlign = 'middle'\n>\n\t<button \n\t\tmargin = '0px'\n\tpaddingTop = '12px'\n\tpaddingLeft = '15px'\n\tpaddingRight = '15px'\n\tpaddingBottom = '12px'\n\n    action = 'OpenURL'\n\t\turl = 'https://creatorapp.zohopublic.com/prontoenvios/logistic-management-v2/page-embed/Public_Tracking/2tvQV988PUNTs9EFZ1XAkpPRZRmErP8zsaCnMEtJP48tFq33VtTEH4eZfruWpQzkeyTv7JBGMOvBCyEjzGUaEAvq6xFOFOS3eD55' \n\t\ttarget = 'same-window'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n    borderColor = '#FFFFFF'\n    borderWidth = '0px'\n\ttext ='Realizar nueva b\u00FAsqueda'\n\t\tbgColor = 'theme'\n\t\tcornerRadius = '60px' \n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row>\n</layout>\n