												// Guardar el ID del nuevo contacto en el campo 'Receiver'
												//info create_response;
												input.Receiver2 = input.Receiver_Full_Name.first_name + " " + input.Receiver_Full_Name.last_name + " - " + input.Receiver_Mobile;
												id_contacto = creator_contact.toString();
												if(create_response.get("id") == null && create_response.get("code") != "DUPLICATE_DATA" && create_response.get("details").get("api_name") != "Mobile")
												{
													crm_result = zoho.crm.searchRecords("Contacts","(Mobile:equals:" + mobile_number + ")");
													if(crm_result.size() <= 0)
													{
														crm_result = zoho.crm.searchRecords("Contacts","(Mobile:equals:" + mobile_number.getsuffix("+") + ")");
													}
													if(crm_result.size() > 0)
													{
														up_contact_map = Map();
														up_contact_map.put("First_Name",input.Receiver_Full_Name.first_name);
														up_contact_map.put("Last_Name",input.Receiver_Full_Name.last_name);
														mobile = input.Receiver_Mobile;
														up_contact_map.put("Mailing_Street",input.Street);
														up_contact_map.put("Mailing_City",input.City);
														up_contact_map.put("Mailing_State",input.Location.Address_Information1.state_province);
														up_contact_map.put("Mailing_Country",input.Location.Address_Information1.country);
														up_contact_map.put("Sender_Receiver_ID",creator_contact.toString());
														up_contact_map.put("DNI",input.Receiver_DNI);
														up_contact_map.put("Creator_Type","Receiver");
														update_response = zoho.crm.updateRecord("Contacts",crm_result.get(0).get("id").toLong(),up_contact_map);
														search_result.CRM_Contact_ID=update_response.get("id").toLong();
													}
													else if(create_response.get("code") == "DUPLICATE_DATA" && create_response.get("details").get("api_name") == "Mobile")
													{
														openUrl("#Page:Error_Message?mensaje=A new contact could not be created on CRM because there is already a record with the same mobile number.","popup window","height=143,width=380");
														alert "A new contact could not be created on CRM because there is already a record with the same mobile number.";
														cancel submit;
													}
												}
												else if(create_response.get("code") == "DUPLICATE_DATA" && create_response.get("details").get("api_name") == "Mobile")
												{
													openUrl("#Page:Error_Message?mensaje=A new contact could not be created on CRM because there is already a record with the same mobile number.","popup window","height=143,width=380");
													alert "A new contact could not be created on CRM because there is already a record with the same mobile number.";
													cancel submit;
												}
												else
												{
													search_result.CRM_Contact_ID=create_response.get("id").toLong();
													openUrl("#Page:Successful_Message?mensaje=New Contact Created and Assigned like Receiver","popup window","height=143,width=380");
													alert "New Contact Created and Assigned like Receiver";
													//info "New Contact Created and Assigned like Receiver";
													// Mensaje de confirmación en logs
												}
											}
										}
										if(input.Sender_field != null && id_contacto != "" || Receiver_Contact != null)
										{
											// Buscar contacto principal
											sender_result = Contacts[ID == input.Sender_field];
											contact_id = sender_result.ID.toString();
											// Obtener el registro completo para traer el subformulario actual
											contact_record = Contacts[ID == contact_id.toLong()];
											// Obtener las filas existentes del subformulario
											if(id_contacto != "")
											{
												exist_relation = Relations[Sender_field == sender_result.ID && Receivers.contains(id_contacto)];
											}
											else
											{
												id_contacto = input.Receiver_Contact.toString();
												exist_relation = Relations[Sender_field == sender_result.ID && Receivers.contains(input.Receiver_Contact.toLong())];
											}
											if(exist_relation.ID == null)
											{
												sender_relation = Relations[Sender_field == sender_result.ID];
												if(sender_relation.ID != null)
												{
													old_lista = List();
													old_lista = sender_relation.Receivers;
													old_lista.add(id_contacto.toLong());
													sender_relation.Receivers=old_lista;
												}
												else
												{
													lista = List();
													lista.add(id_contacto);
													creator_relation = insert into Relations
													[
														Added_User=zoho.loginuser
														Sender_field=sender_result.ID
														Receivers=lista
													];
												}
											}
										}
						)
					}
				}

			}
