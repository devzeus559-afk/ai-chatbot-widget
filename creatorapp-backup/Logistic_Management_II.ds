			Set_Update_SubtotalsShipm as "Set&Update_SubtotalsShipment2"
			{
				type =  form
				form = Release

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Transform subform to list<map> for calculate totals and subtotals
										subform = List();
										if(input.Shipment_Details != null)
										{
											for each  r in input.Shipment_Details
											{
												// Populate packages list<map>
												Row1 = Map();
												// Assign lookup (Pass the record var, not the field)
												Row1.put("Package_ID",r.Package_ID.toLong());
												Row1.put("Package_Name",r.Package_Name);
												Row1.put("Package_Type",r.Package_Type);
												Row1.put("Status",r.Status);
												Row1.put("Location",r.Location);
												Row1.put("Total_Weight",r.Total_Weight);
												Row1.put("Shipping_Type",r.Shipping_Type);
												Row1.put("Package_Price",r.Package_Price);
												Row1.put("Customs_Duty",r.Customs_Duty);
												Row1.put("Service",r.Service.toLong());
												// Insert new subform row
												subform.add(Row1);
											}
										}
										// ===================================================	
										// Calculate subtotal rows by shipments
										shipments_subs = Map();
										// Call function that generate subform values from shipment details 
										shipments_subs = thisapp.getShipmentSubs2BySubform(subform);
										// Clear subform records
										input.Subtotals_By_Shipment.clear();
										// Populate subform
										shipments = List();
										shipments = shipments_subs.get("Shipments");
										if(!shipments.isEmpty())
										{
											for each  r in shipments
											{
												SubtotalRow = Release.Subtotals_By_Shipment();
												SubtotalRow.Shipment=r.toString();
												SubtotalRow.Total_Packages=shipments_subs.get("Total_Packages").get(r);
												SubtotalRow.Total_Pounds=shipments_subs.get("Total_Pounds").get(r);
												input.Subtotals_By_Shipment.insert(SubtotalRow);
											}
										}
						)
					}
				}

			}
			Update_SubtotalShipment2 as "Update_SubtotalShipment2"
			{
				type =  form
				form = Release

				record event = on add or edit

				on delete row of Shipment_Details
				{
					actions 
					{
						custom deluge script
						(
											deletedPkg = row.Package_ID;
										subtotals = input.Subtotals_By_Shipment;
										// Calculate types list and subtotals ===
										shipments = list();
										subtotalOfPkgs = Map();
										subtotalOfPounds = Map();
										// Load last subtotals summary ===
										for each  r in subtotals
										{
											if(r.Shipment != null)
											{
												shipments.add(r.Shipment);
												subtotalOfPkgs.put(r.Shipment,r.Total_Packages);
												subtotalOfPounds.put(r.Shipment,r.Total_Pounds);
											}
										}
										// Clear subform registries ===
										input.Subtotals_By_Shipment.clear();
										// Getting value of deleted box (refs, type, pounds)
										RealPkg = Package[ID == deletedPkg];
										RealShipment = Shipment[ID == RealPkg.Shipment_Type];
										shipment = RealShipment.Presentation_Name.toString();
										// Remove shipment without pkgs to subtotals summary ===
										if(subtotalOfPkgs.get(shipment) == 1)
										{
											// Remove last type and its subtotals ===
											shipments.removeElement(shipment);
											subtotalOfPkgs.remove(shipment);
											subtotalOfPounds.remove(shipment);
										}
										else if(subtotalOfPkgs.get(shipment) > 1)
										{
											// Update subtotals values ===
											pkgsQty = subtotalOfPkgs.get(shipment) - 1;
											pkgsPounds = subtotalOfPounds.get(shipment) - RealPkg.Total_Weight;
											subtotalOfPkgs.put(shipment,pkgsQty);
											subtotalOfPounds.put(shipment,pkgsPounds);
										}
										// Create rows by types ===
										if(shipments != null)
										{
											for each  t in shipments
											{
												subtotalRow = Release.Subtotals_By_Shipment();
												subtotalRow.Shipment=t;
												subtotalRow.Total_Packages=subtotalOfPkgs.get(t);
												subtotalRow.Total_Pounds=subtotalOfPounds.get(t);
												input.Subtotals_By_Shipment.insert(subtotalRow);
											}
										}
						)
					}
				}

			}
			Set_Update_SubtotalsShipm1 as "Set&Update_SubtotalsShipment2"
			{
				type =  form
				form = Release

				record event = on add or edit

				on user input of Shipment_Details.Package_ID
				{
					actions 
					{
						custom deluge script
						(
											// === Calculate types list and subtotals ===
										shipments = list();
										subtotal_of_pkgs = Map();
										subtotal_of_pounds = Map();
										// Load last subtotals summary 
										if(input.Subtotals_By_Shipment != null)
										{
											for each  r in input.Subtotals_By_Shipment
											{
												if(r.Shipment != null)
												{
													shipments.add(r.Shipment);
													subtotal_of_pkgs.put(r.Shipment,r.Total_Packages);
													subtotal_of_pounds.put(r.Shipment,r.Total_Pounds);
												}
											}
										}
										// Clear subform registries
										input.Subtotals_By_Shipment.clear();
										// Getting value of new box
										if(row.Package_ID != null)
										{
											RealPkg = Package[ID == row.Package_ID];
											RealShipment = Shipment[ID == RealPkg.Shipment_Type];
											shipment = RealShipment.Presentation_Name.toString();
											pkg_pounds = ifnull(RealPkg.Total_Weight,0.0);
											// Add new shipping type to subtotals summary
											if(!shipments.contains(shipment))
											{
												shipments.add(shipment);
											}
											// Update subtotals values
											pkgs_qty = ifnull(subtotal_of_pkgs.get(shipment),0) + 1;
											pkgs_pounds = ifnull(subtotal_of_pounds.get(shipment),0) + pkg_pounds;
											subtotal_of_pkgs.put(shipment,pkgs_qty);
											subtotal_of_pounds.put(shipment,pkgs_pounds);
										}
										// Create rows by shipment
										if(shipments != null)
										{
											for each  t in shipments
											{
												SubtotalRow = Release.Subtotals_By_Shipment();
												SubtotalRow.Shipment=t;
												SubtotalRow.Total_Packages=subtotal_of_pkgs.get(t);
												SubtotalRow.Total_Pounds=subtotal_of_pounds.get(t);
												input.Subtotals_By_Shipment.insert(SubtotalRow);
											}
										}
						)
					}
				}

			}
			Complete_SubtotalsShipmen as "Complete_SubtotalsShipment2"
			{
				type =  form
				form = Release

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Clear subform registries
										input.Subtotals_By_Shipment.clear();
										// Calculate shipments list and subtotals by 'Shipment Details' subform
										shipments = list();
										subtotal_of_pkgs = Map();
										subtotal_of_pounds = Map();
										if(input.Shipment_Details != null)
										{
											for each  r in input.Shipment_Details
											{
												// Getting value of new package
												if(r.Package_ID != null)
												{
													RealPkg = Package[ID == r.Package_ID];
													RealShipment = Shipment[ID == RealPkg.Shipment_Type];
													shipment = RealShipment.Presentation_Name.toString();
													pkg_weight = ifnull(RealPkg.Total_Weight,0.0);
													// Add new shipping type to subtotals summary
													if(!shipments.contains(shipment))
													{
														shipments.add(shipment);
													}
													// Update subtotals values
													pkgs_qty = ifnull(subtotal_of_pkgs.get(shipment),0) + 1;
													pkg_weight = ifnull(subtotal_of_pounds.get(shipment),0.0) + pkg_weight;
													subtotal_of_pkgs.put(shipment,pkgs_qty);
													subtotal_of_pounds.put(shipment,pkg_weight);
												}
											}
										}
										// Create rows by types
										if(shipments != null)
										{
											for each  t in shipments
											{
												SubtotalRow = Release.Subtotals_By_Shipment();
												SubtotalRow.Shipment=t;
												SubtotalRow.Total_Packages=subtotal_of_pkgs.get(t);
												SubtotalRow.Total_Pounds=subtotal_of_pounds.get(t);
												input.Subtotals_By_Shipment.insert(SubtotalRow);
											}
										}
						)
					}
				}

			}
