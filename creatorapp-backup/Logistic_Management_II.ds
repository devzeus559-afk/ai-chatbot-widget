		form C_lculo_de_Conversi_n
		{
			displayname = "Cálculo de Conversión"
			success message = "Data Added Successfully!"
			feature property = 512
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Largo_pulgadas
			(
				type = decimal
				displayname = "Largo (pulgadas)"
	 			row = 1
	 			column = 1   
				width = small
			)
			must have Cantidad_de_Cajas
			(
				type = number
				displayname = "Cantidad de Cajas"
	 			row = 1
	 			column = 1   
				width = small
			)
			must have Ancho_pulgadas
			(
				type = decimal
				displayname = "Ancho (pulgadas)"
	 			row = 1
	 			column = 2   
				width = small
			)
			must have Peso_por_Caja
			(
				type = decimal
				displayname = "Peso por Caja (Lbs)"
	 			row = 1
	 			column = 2   
				width = small
			)
			must have Alto_pulgadas
			(
				type = decimal
				displayname = "Alto (pulgadas)"
	 			row = 1
	 			column = 3   
				width = small
			)
			Section2
			(
				type = section
				displayname = " "
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Lb_Vol
			(
    			type = formula
				displayname = "Lb/Vol"
				value =  round((input.Ancho_pulgadas * input.Largo_pulgadas * input.Alto_pulgadas) / 166 * input.Cantidad_de_Cajas,2)
				visibility = true
	 			row = 2
	 			column = 1   
				width = small
			)
			Pies_C_bicos
			(
    			type = formula
				displayname = "Pies Cúbicos"
				value =  round((input.Largo_pulgadas * input.Ancho_pulgadas * input.Alto_pulgadas * input.Cantidad_de_Cajas) / 1728,2)
				visibility = true
	 			row = 2
	 			column = 1   
				width = small
			)
			Kg_Vol
			(
    			type = formula
				displayname = "Kg/Vol"
				value =  round((input.Ancho_pulgadas * input.Largo_pulgadas * input.Alto_pulgadas) / 166 * 0.453592 * input.Cantidad_de_Cajas,2)
				visibility = true
	 			row = 2
	 			column = 2   
				width = small
			)
			Metros_C_bicos
			(
    			type = formula
				displayname = "Metros Cúbicos"
				value =  round((input.Largo_pulgadas * input.Ancho_pulgadas * input.Alto_pulgadas * input.Cantidad_de_Cajas) / 61023.7441,2)
				visibility = true
	 			row = 2
	 			column = 2   
				width = small
			)
			Peso_Total_en_kg
			(
    			type = formula
				displayname = "Peso Total en Kg"
				value =  round(input.Peso_por_Caja * input.Cantidad_de_Cajas * 0.453592,2)
				visibility = true
	 			row = 2
	 			column = 3   
				width = small
			)
			M_ximo_Valor
			(
    			type = formula
				displayname = "Máximo Valor"
				value =  round(if(input.Peso_por_Caja * input.Cantidad_de_Cajas >= (input.Largo_pulgadas * input.Ancho_pulgadas * input.Alto_pulgadas * input.Cantidad_de_Cajas) / 166,input.Peso_por_Caja * input.Cantidad_de_Cajas,(input.Largo_pulgadas * input.Ancho_pulgadas * input.Alto_pulgadas * input.Cantidad_de_Cajas) / 166),2)
				visibility = true
	 			row = 2
	 			column = 3   
				width = small
			)
	
			actions
			{
				on add
				{
					Cont_ctenos
					(
   						type = submit
   						displayname = "Contáctenos"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
