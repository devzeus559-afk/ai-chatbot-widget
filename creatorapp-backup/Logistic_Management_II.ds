		list VAN_Daily_Movements
		{
			displayName = "VAN Daily Movements"
			show all rows from Daily_Movement  [Office.ID == 4893007000000126905]  
			(
				Daily_Movement_ID as "Daily Movement ID"
				Employee
				Daily_Movement_Type as "Daily Movement Type"
				custom action "Unlink this DM"
				(
	  			workflow = Unlik_Daily_Movement
				show action in edit record menu = true
				column header = "Unlink this DM"
				condition = (Service.Service_ID is not null)
				confirmation before execution
				(
					message for individual record = "Are you sure you want to unlink this Daily Movement from its Service?"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
				custom action "Put in Cash Flow"
				(
	  			workflow = Put_in_Cash_Flow
				show action in edit record menu = true
				column header = "Put in Cash Flow"
				condition = (Payment_Information.Payment_Method == "Cash" && Payment_Information.Cash_Flow is not null && In_Cash_Flows == false)
				confirmation before execution
				(
					message for individual record = "Are you sure you want to put the cash movements in the selected Cash Flows?"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
				custom action "Remove of Cash Flow"
				(
	  			workflow = Remove_of_Cash_Flow
				show action in edit record menu = true
				column header = "Remove of Cash Flow"
				condition = (Payment_Information.Payment_Method == "Cash" && Payment_Information.Cash_Flow is not null && In_Cash_Flows == true)
				confirmation before execution
				(
					message for individual record = "Are you sure you want to withdraw the cash movements in the Cash Flow associated with this record?"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
				Service
				custom action "Create Invoice"
				(
	  			workflow = Create_Invoice
				show action in edit record menu = true
				column header = "Create Invoice"
				condition = (Service.ID is not null && Daily_Movement_Type == "Incoming" && Invoice_ID == "")
				confirmation before execution
				(
					message for individual record = "Are you sure you want to create an Invoice from this record?"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
				Invoice_URL as "Invoice URL"
				Total_Customs_Duty as "Total Customs Duty"
				Total_Packaging_Price as "Total Packaging Price"
				Accounted
				Amount_Concept as "Amount"
				Payment_Information.Payment_Method as "Payment Information"
				Service.Price as "Total Price"
				Service.Amount
				Service.Service_Type as "Service Type"
				Service.Sender_Full_Name  as "Sender Full Name"
				Service.Date_field1 as "Date"
				Payment_Concept as "Payment Concept"
				Notes1 as "Notes"
				Cash_Flow_Concept.Created_Date_Time as "Created Date-Time"
				Added_Time as "Hora agregado"
			)
			sort by
			(
				Added_Time descending
				Daily_Movement_ID descending
			)
			custom actions
			(
				"Account"
				(
	  			workflow = Account
				show action in view header = true
				condition = (Accounted == false && Daily_Movement_Type == "Outgoing")
				confirmation before execution
				(
					message for individual record = "Are you sure you want to set this Daily Movement as Accounted?"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
			)
		}
