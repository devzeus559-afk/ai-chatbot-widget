		functions
		{
			Unlink_this_Package as "Unlink_this_Package"
			{
				type =  functions
				form = Package
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						//Inicia Desvinculando Box de Service
										RealService = Service[ID == input.Service];
										if(RealService.Daily_Movement == null)
										{
											newRows = Collection();
											for each  fila in RealService.Packages
											{
												if(fila.Package_Name == input.ID)
												{
													thisweight = fila.Weight_in_pounds;
													thisprice = fila.Package_Price;
													thisduty = ifnull(input.Customs_Duty,0);
													thispackage = ifnull(input.Packaging_Price,0);
												}
												else if(fila.Package_Name != input.ID)
												{
													Vale = Service.Packages();
													Vale.Package_Name=fila.Package_Name;
													Vale.Package_ID=fila.Package_ID;
													Vale.Package_Type=fila.Package_Type;
													Vale.Package_Name=fila.Package_Name;
													Vale.Status=fila.Status;
													Vale.Receipt_Date=fila.Receipt_Date;
													Vale.External_Tracking_Number=fila.External_Tracking_Number;
													Vale.Receiver=fila.Receiver;
													Vale.Destination_Street=fila.Destination_Street;
													Vale.Location=fila.Location;
													Vale.Width_in_cm=fila.Width_in_cm;
													Vale.Length_in_cm=fila.Length_in_cm;
													Vale.Height_in_cm=fila.Height_in_cm;
													Vale.Weight_in_pounds=fila.Weight_in_pounds;
													Vale.Volume=fila.Volume;
													Vale.Package_Material=fila.Package_Material;
													Vale.Shipment_Type=fila.Shipment_Type;
													Vale.Package_Price=fila.Package_Price;
													Vale.Service_Employee=fila.Service_Employee;
													Vale.Service_Office=fila.Service_Office;
													Vale.Service_Sender=fila.Service_Sender;
													Vale.Sender_Full_Name=fila.Sender_Full_Name;
													Vale.Sender_Mobile=fila.Sender_Mobile;
													Vale.Sender_DNI=fila.Sender_DNI;
													Vale.Sender_Email=fila.Sender_Email;
													newRows.insert(Vale);
												}
											}
											if(RealService.Total_Weight >= thisweight)
											{
												RealService.Total_Weight=RealService.Total_Weight - thisweight;
											}
											else if(RealService.Total_Weight < thisweight)
											{
												RealService.Total_Weight=0.0;
											}
											if(RealService.Total_Custom_Duty >= thisduty)
											{
												RealService.Total_Custom_Duty=RealService.Total_Custom_Duty - thisduty;
											}
											else if(RealService.Total_Custom_Duty < thisduty)
											{
												RealService.Total_Custom_Duty=0.0;
											}
											if(RealService.Total_Packaging_Price >= thispackage)
											{
												RealService.Total_Packaging_Price=RealService.Total_Packaging_Price - thispackage;
											}
											else if(RealService.Total_Packaging_Price < thispackage)
											{
												RealService.Total_Packaging_Price=0.0;
											}
											compare = thisprice + thisduty + thispackage;
											if(thisprice != null && RealService.Price >= compare)
											{
												RealService.Price=ifnull(RealService.Price,0.0) - thisprice - thisduty - thispackage;
											}
											else
											{
												if(RealService.Employee != null && Employee[ID == RealService.Employee].Full_Name.contains("VAN"))
												{
													RealService.Price=ifnull(RealService.Pickup_Service,0.0);
												}
												else
												{
													RealService.Price=0.0;
												}
											}
											if(RealService.Number_of_Packages > 0)
											{
												RealService.Number_of_Packages=RealService.Number_of_Packages - 1;
											}
											else
											{
												RealService.Number_of_Packages=0;
											}
											RealService.Packages.clear();
											RealService.Packages.insert(newRows);
											input.Service = null;
											//Termina Desvinculando Package de Service
											// ==================================
											// === Unlink from release ===
											if(input.Release != null)
											{
												thisapp.unlinkPackageFromRelease(input.ID,input.Release);
											}
										}
										else
										{
											openUrl("#Page:Error_Message?mensaje=The Service associated with this Package has a related Daily Movement. You must disassociate this Daily Movement first.","popup window","height=163,width=380");
											//info "The Service associated with this Package has a related Daily Movement. You must disassociate this Daily Movement first.";
										}
					)
					}
				}
			}
			Create_Daily_Movement as "Create_Daily_Movement"
			{
				type =  functions
				form = Service
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						// Read system ID var
										currentID = thisapp.variables.DAILYMOVEMENT_ID;
										// Create new ID with zero-left-padding style
										dailyid = thisapp.zeroLeftPad(5,currentID);
										// Create the Daily_Movement_Name
										actualid = "DM " + dailyid;
										allrows = Collection();
										for each  fila in input.Payment_Information
										{
											row1 = Daily_Movement.Payment_Information();
											row1.Payment_Method=fila.Payment_Method;
											row1.Fit_Credit_Card=fila.Fit_Credit_Card;
											row1.Amount=fila.Amount;
											row1.Cash_Flow=fila.Cash_Flow;
											row1.Fit=fila.Fit;
											row1.Total_To_Pay1=fila.Total_To_Pay;
											allrows.insert(row1);
										}
										// === Create auxiliar vars to populate 'Subtotal' subform ===
										subtotals = Collection();
										// Calculate Subtotal values By Service using utility function
										subtotal_data = Map();
										subtotal_data = thisapp.getDMSubtotalByService(input.ID);
										subtotal_items = subtotal_data.get("Items");
										// Populate 'Subtotal' subform
										if(subtotal_items != null)
										{
											for each  i in subtotal_items.keys()
											{
												subtotal_row = Daily_Movement.Subtotal();
												subtotal_row.Books_Items=subtotal_data.get("Items").get(i);
												subtotal_row.Quantity=subtotal_data.get("Quantity").get(i);
												subtotal_row.Unit_Price=subtotal_data.get("Unit_Price").get(i);
												subtotal_row.Total_Price=subtotal_data.get("Total_Price").get(i);
												subtotals.insert(subtotal_row);
											}
										}
										//Tomar valor de campo Amount
										if(input.Service_Type == "Package Receipt" || input.Service_Type == "Locker")
										{
											totalamount = input.Price;
										}
										else
										{
											totalamount = input.Amount;
										}
										// Crear nuevo registro 
										new_movement = insert into Daily_Movement
										[
											Daily_Movement_ID=actualid
											Employee=input.Employee
											Office=input.Office
											Daily_Movement_Type="Incoming"
											Service=input.ID
											Payment_Information=allrows
											Subtotal=subtotals
											Total_Customs_Duty=input.Total_Custom_Duty
											Total_Packaging_Price=input.Total_Packaging_Price
											Amount_Concept=totalamount
											Added_User=zoho.loginuser
										];
										openUrl("#Page:Successful_Message?mensaje=The Daily Movement has been created successfully","popup window","height=143,width=380");
										// Update ID var
										thisapp.variables.DAILYMOVEMENT_ID = thisapp.variables.DAILYMOVEMENT_ID + 1;
					)
					}
				}
			}
			Unlik_Daily_Movement as "Unlik_Daily_Movement"
			{
				type =  functions
				form = Daily_Movement
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						input.Service = null;
										if(In_Cash_Flows == true)
										{
											// Paso 1: Obtener Office y tipo de movimiento
											office_id = input.Office;
											movement_type = input.Daily_Movement_Type;
											// Paso 2: Encontrar el Cash_Flow real desde el subformulario
											//affected_cash_flow = null;
											for each  payment in input.Payment_Information
											{
												if(payment.Payment_Method == "Cash" && payment.Cash_Flow != null)
												{
													affected_cash_flow = Cash_Flow[ID == payment.Cash_Flow];
												}
											}
											if(affected_cash_flow != null)
											{
												for each  affected in affected_cash_flow
												{
													affected_cash_flow_id = affected.ID;
													affected_datetime = affected.Created_Date_Time;
													total_to_subtract = 0;
													// Paso 3: Sumar valores a restar
													for each  payment in input.Payment_Information
													{
														if(payment.Payment_Method == "Cash" && payment.Cash_Flow == affected_cash_flow_id)
														{
															total_to_subtract = total_to_subtract + ifnull(payment.Amount,0);
														}
													}
													// Paso 4: Restar del Cash_Flow correspondiente
													if(movement_type == "Incoming")
													{
														affected.Total_Incoming=ifnull(affected.Total_Incoming,0) - total_to_subtract;
														input.In_Cash_Flows = false;
													}
													else if(movement_type == "Outgoing")
													{
														affected.Total_Outgoing=ifnull(affected.Total_Outgoing,0) - total_to_subtract;
														input.In_Cash_Flows = false;
													}
													// Paso 5: Limpiar la fila del DM en el subformulario Related_Daily_Movements
													oldDM = affected.Related_Daily_Movements;
													affected.Related_Daily_Movements.clear();
													for each  DM in oldDM
													{
														if(DM.Daily_Movement != input.ID)
														{
															row1 = Cash_Flow.Related_Daily_Movements();
															row1.Daily_Movement=DM.Daily_Movement;
															row1.Date_field=DM.Date_field;
															row1.Daily_Movement_Type=DM.Daily_Movement_Type;
															row1.Total_to_Pay=DM.Total_to_Pay;
															affected.Related_Daily_Movements.insert(row1);
														}
													}
													// Paso 6: tomar los Cash_Flows que son creados posterior al actual
													later_flows = Cash_Flow[Office == office_id && Created_Date_Time > affected_datetime];
													// Paso 7: Actualizar los Opening_Balance en cada uno
													for each  Old in later_flows
													{
														if(movement_type == "Incoming")
														{
															Old.Opening_Balance=ifnull(Old.Opening_Balance,0) - total_to_subtract;
														}
														else if(movement_type == "Outgoing")
														{
															Old.Opening_Balance=ifnull(Old.Opening_Balance,0) + total_to_subtract;
														}
													}
												}
											}
											else
											{
												openUrl("#Page:Error_Message?mensaje=No associated Cash Flow was found in the subform rows.","popup window","height=143,width=380");
												//info "No associated Cash Flow was found in the subform rows.";
											}
										}
										delete from Daily_Movement[ID == input.ID];
					)
					}
				}
			}
			Put_in_Cash_Flow as "Put_in_Cash_Flow"
			{
				type =  functions
				form = Daily_Movement
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						// Suponiendo que 'input' es el registro actual de Daily_Movements
										office_id = input.Office;
										movement_type = input.Daily_Movement_Type;
										// Buscar los Cash_Flow para la misma oficina y actulizarlos
										for each  cashf in input.Payment_Information
										{
											if(cashf.Payment_Method == "Cash")
											{
												matching_cash_flows = Cash_Flow[Status == "Pending" && Office == office_id && ID == cashf.Cash_Flow];
												if(matching_cash_flows.count() > 0)
												{
													if(movement_type == "Incoming")
													{
														matching_cash_flows.Total_Incoming=ifnull(matching_cash_flows.Total_Incoming,0) + ifnull(cashf.Amount,0);
														input.In_Cash_Flows = true;
														if(matching_cash_flows.Created_Date_Time < today)
														{
															all_affected_cash = Cash_Flow[Created_Date_Time > matching_cash_flows.Created_Date_Time && Office == office_id];
															for each  affected in all_affected_cash
															{
																affected.Opening_Balance=affected.Opening_Balance + ifnull(cashf.Amount,0);
															}
														}
													}
													else if(movement_type == "Outgoing")
													{
														matching_cash_flows.Total_Outgoing=ifnull(matching_cash_flows.Total_Outgoing,0) + ifnull(cashf.Amount,0);
														input.In_Cash_Flows = true;
														if(matching_cash_flows.Created_Date_Time < today)
														{
															all_affected_cash = Cash_Flow[Created_Date_Time > matching_cash_flows.Created_Date_Time && Office == office_id];
															for each  affected in all_affected_cash
															{
																affected.Opening_Balance=affected.Opening_Balance - ifnull(cashf.Amount,0);
															}
														}
													}
													// Agregar la fila al subformulario Related_Daily_Movements
													row1 = Cash_Flow.Related_Daily_Movements();
													row1.Daily_Movement=input.ID;
													row1.Date_field=today;
													row1.Daily_Movement_Type=input.Daily_Movement_Type;
													row1.Total_to_Pay=cashf.Total_To_Pay1;
													matching_cash_flows.Related_Daily_Movements.insert(row1);
													openUrl("#Page:Successful_Message?mensaje=Action completed successfully","popup window","height=143,width=380");
												}
												else
												{
													openUrl("#Page:Error_Message?mensaje=The associated Cash Flow was not found as unapproved and/or related to this office.","popup window","height=143,width=380");
													//info "The associated Cash Flow was not found as unapproved and/or related to this office.";
												}
											}
										}
					)
					}
				}
			}
