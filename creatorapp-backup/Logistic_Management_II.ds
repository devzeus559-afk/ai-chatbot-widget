			Create_Updates_CRM_Contac as "Create_Updates_CRM_Contacts"
			{
				type =  form
				form = Contacts

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Obtener el número desde el formulario actual
										mobile_number = input.Mobile;
										// Buscar en Zoho CRM el contacto que tenga ese número en el campo Mobile
										search_result = zoho.crm.searchRecords("Contacts","(Mobile:equals:" + mobile_number + ")");
										if(search_result.size() <= 0)
										{
											search_result = zoho.crm.searchRecords("Contacts","(Mobile:equals:" + mobile_number.getsuffix("+") + ")");
											if(search_result.size() <= 0)
											{
												search_result = zoho.crm.searchRecords("Contacts","(Mobile:equals:" + mobile_number.getsuffix("+1") + ")");
											}
										}
										// Si se encuentra al menos un contacto con ese número
										if(search_result.size() > 0 && search_result.get(0) != null)
										{
											// Asignar el ID del contacto al campo 'CRM_Contact_ID' en Zoho Creator, como string
											input.CRM_Contact_ID = search_result.get(0).get("id").toString();
											// También actualizar los datos en el CRM
											up_contact_map = Map();
											up_contact_map.put("First_Name",input.First_Name.first_name);
											up_contact_map.put("Last_Name",input.First_Name.last_name);
											up_contact_map.put("Sender_Receiver_ID",input.ID.toString());
											up_contact_map.put("Email",input.Email);
											up_contact_map.put("Mailing_Street",input.Address.address_line_1);
											up_contact_map.put("Mailing_City",input.Address.district_city);
											up_contact_map.put("Mailing_State",input.Address.state_province);
											up_contact_map.put("Mailing_Country",input.Address.country);
											up_contact_map.put("Creator_Type",input.Type_field);
											up_contact_map.put("DNI",input.DNI);
											update_response = zoho.crm.updateRecord("Contacts",search_result.get(0).get("id").toLong(),up_contact_map);
											openUrl("#Page:Successful_Message?mensaje=Updated contact information on the CRM","popup window","height=143,width=380");
											//info "Contact Information Updated";
											// Mensaje de confirmación en logs
										}
										else
										{
											// Si no se encontró contacto, se procede a crear uno nuevo en Zoho CRM
											// Crear un mapa con los campos requeridos por CRM
											new_contact_map = Map();
											new_contact_map.put("First_Name",input.First_Name.first_name);
											new_contact_map.put("Last_Name",input.First_Name.last_name);
											new_contact_map.put("Email",input.Email);
											new_contact_map.put("Mobile",input.Mobile);
											new_contact_map.put("Mailing_Street",input.Address.address_line_1);
											new_contact_map.put("Mailing_City",input.Address.district_city);
											new_contact_map.put("Mailing_State",input.Address.state_province);
											new_contact_map.put("Mailing_Country",input.Address.country);
											new_contact_map.put("Sender_Receiver_ID",input.ID.toString());
											new_contact_map.put("Creator_Type",input.Type_field);
											new_contact_map.put("DNI",input.DNI);
											// Crear el nuevo contacto en el módulo Contacts de Zoho CRM
											create_response = zoho.crm.createRecord("Contacts",new_contact_map);
											// Guardar el ID del nuevo contacto en el campo 'Sender_field'
											if(create_response.get("id") != null)
											{
												input.CRM_Contact_ID = create_response.get("id").toString();
												//info create_response;
												openUrl("#Page:Successful_Message?mensaje=New Contact Created","popup window","height=143,width=380");
												//info "New Contact Created";
												// Mensaje de confirmación en logs
											}
											else if(create_response.get("code") == "DUPLICATE_DATA" && create_response.get("details").get("api_name") == "Mobile")
											{
												openUrl("#Page:Error_Message?mensaje=A new contact could not be created because there is already a record with the same mobile number.","popup window","height=143,width=380");
												cancel submit;
											}
										}
						)
					}
				}

			}
			Create_CRMSender_Contact2 as "Create_CRMSender_Contact"
			{
				type =  form
				form = Package

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Solo ejecuta si la variable de control Sender_Not_Found es verdadera y Sender_Mobile tiene valor
										if(Sender_Not_Found == true && Sender_Mobile != null && Sender_field == null)
										{
											// Obtener el número desde el formulario actual
											mobile_number = input.Sender_Mobile;
											// Buscar en Zoho CRM el contacto que tenga ese número en el campo Mobile
											search_result = Contacts[Mobile == mobile_number];
											if(search_result.ID == null)
											{
												search_result = Contacts[Mobile == mobile_number.getsuffix("+")];
											}
											// Si se encuentra al menos un contacto con ese número
											if(search_result.ID != null)
											{
												// Asignar el ID del contacto al campo 'Sender_Contact' en Zoho Creator, como string
												input.Sender_field = search_result.ID;
												input.Sender_Not_Found = false;
												// Mensaje de confirmación en logs
												// Actualizar los datos del contacto encontrado con los datos del formulario
												search_result.DNI=input.Sender_DNI;
												search_result.Address.address_line_1=input.Sender_Address.address_line_1;
												search_result.Address.district_city=input.Sender_Address.district_city;
												search_result.Address.state_province=input.Sender_Address.state_province;
												search_result.Address.country=input.Sender_Address.country;
												search_result.Email=input.Sender_Email;
												search_result.First_Name.first_name=input.Sender_Full_Name.first_name;
												search_result.First_Name.last_name=input.Sender_Full_Name.last_name;
												if(search_result.Type_field == "Receiver" || search_result.Type_field == "Sender & Receiver")
												{
													search_result.Type_field="Sender & Receiver";
												}
												else
												{
													search_result.Type_field="Sender";
												}
												crm_result = zoho.crm.searchRecords("Contacts","(Mobile:equals:" + mobile_number + ")");
												if(crm_result.size() > 0)
												{
													//info crm_result;
													up_contact_map = Map();
													up_contact_map.put("First_Name",input.Sender_Full_Name.first_name);
													up_contact_map.put("Last_Name",input.Sender_Full_Name.last_name);
													mobile = input.Sender_Mobile;
													up_contact_map.put("Mailing_Street",input.Sender_Address.address_line_1);
													up_contact_map.put("Mailing_City",input.Sender_Address.district_city);
													up_contact_map.put("Mailing_State",input.Sender_Address.state_province);
													up_contact_map.put("Mailing_Country",input.Sender_Address.country);
													up_contact_map.put("Email",input.Sender_Email);
													up_contact_map.put("Sender_Receiver_ID",search_result.ID.toString());
													up_contact_map.put("DNI",input.Sender_DNI);
													if(search_result.Type_field == "Receiver" || search_result.Type_field == "Sender & Receiver")
													{
														up_contact_map.put("Creator_Type","Sender & Receiver");
													}
													else
													{
														up_contact_map.put("Creator_Type","Sender");
													}
													update_response = zoho.crm.updateRecord("Contacts",crm_result.get(0).get("id").toLong(),up_contact_map);
												}
												search_result.CRM_Contact_ID=crm_result.get(0).get("id").toLong();
												input.Update_Sender_Information = false;
												openUrl("#Page:Successful_Message?mensaje=Sender Assigned to a Contact with this Mobile and Sender Information Updated","popup window","height=143,width=380");
												alert "Sender Assigned to a Contact with this Mobile and Sender Information Updated";
												//info "Sender Assigned to a Contact with this Mobile and Sender Information Updated";
												// Mensaje de confirmación en logs
											}
											else
											{
												// Si no se encontró contacto, se procede a crear uno nuevo en Zoho CRM
												// Crear un mapa con los campos requeridos por CRM
												creator_contact = insert into Contacts
												[
													Added_User=zoho.loginuser
													Address.address_line_1=input.Sender_Address.address_line_1
													Address.district_city=input.Sender_Address.district_city
													Address.state_province=input.Sender_Address.state_province
													Address.country=input.Sender_Address.country
													DNI=input.Sender_DNI
													Active=true
													First_Name.first_name=input.Sender_Full_Name.first_name
													First_Name.last_name=input.Sender_Full_Name.last_name
													Mobile=input.Sender_Mobile
													Email=input.Sender_Email
													Type_field="Sender"
												];
												input.Sender_field = creator_contact;
												input.Sender_Not_Found = false;
												search_result = Contacts[ID == creator_contact];
												new_contact_map = Map();
												new_contact_map.put("First_Name",input.Sender_Full_Name.first_name);
												new_contact_map.put("Last_Name",input.Sender_Full_Name.last_name);
												new_contact_map.put("DNI",input.Sender_DNI);
												new_contact_map.put("Mobile",input.Sender_Mobile);
												new_contact_map.put("Mailing_Street",input.Sender_Address.address_line_1);
												new_contact_map.put("Mailing_City",input.Sender_Address.district_city);
												new_contact_map.put("Mailing_State",input.Sender_Address.state_province);
												new_contact_map.put("Mailing_Country",input.Sender_Address.country);
												new_contact_map.put("Email",input.Sender_Email);
												new_contact_map.put("Sender_Receiver_ID",creator_contact.toString());
												new_contact_map.put("Creator_Type","Sender");
												// Crear el nuevo contacto en el módulo Contacts de Zoho CRM
												create_response = zoho.crm.createRecord("Contacts",new_contact_map);
												// Guardar el ID del nuevo contacto en el campo 'Sender_Contact'
												//info create_response;
												if(create_response.get("id") == null && create_response.get("code") != "DUPLICATE_DATA" && create_response.get("details").get("api_name") != "Mobile")
												{
													crm_result = zoho.crm.searchRecords("Contacts","(Mobile:equals:" + mobile_number + ")");
													if(crm_result.size() <= 0)
													{
														crm_result = zoho.crm.searchRecords("Contacts","(Mobile:equals:" + mobile_number.getsuffix("+") + ")");
													}
													if(crm_result.size() > 0)
													{
														up_contact_map = Map();
														up_contact_map.put("First_Name",input.Sender_Full_Name.first_name);
														up_contact_map.put("Last_Name",input.Sender_Full_Name.last_name);
														mobile = input.Sender_Mobile;
														up_contact_map.put("Mailing_Street",input.Sender_Address.address_line_1);
														up_contact_map.put("Mailing_City",input.Sender_Address.district_city);
														up_contact_map.put("Mailing_State",input.Sender_Address.state_province);
														up_contact_map.put("Mailing_Country",input.Sender_Address.country);
														up_contact_map.put("Email",input.Sender_Email);
														up_contact_map.put("Sender_Receiver_ID",creator_contact.toString());
														up_contact_map.put("DNI",input.Sender_DNI);
														up_contact_map.put("Creator_Type","Sender");
														update_response = zoho.crm.updateRecord("Contacts",crm_result.get(0).get("id").toLong(),up_contact_map);
														search_result.CRM_Contact_ID=update_response.get("id").toLong();
													}
													else if(create_response.get("code") == "DUPLICATE_DATA" && create_response.get("details").get("api_name") == "Mobile")
													{
														openUrl("#Page:Error_Message?mensaje=A new contact could not be created on CRM because there is already a record with the same mobile number.","popup window","height=143,width=380");
														alert "A new contact could not be created on CRM because there is already a record with the same mobile number.";
														cancel submit;
													}
												}
												else if(create_response.get("code") == "DUPLICATE_DATA" && create_response.get("details").get("api_name") == "Mobile")
												{
													openUrl("#Page:Error_Message?mensaje=A new contact could not be created on CRM because there is already a record with the same mobile number.","popup window","height=143,width=380");
													alert "A new contact could not be created on CRM because there is already a record with the same mobile number.";
													cancel submit;
												}
												else
												{
													search_result.CRM_Contact_ID=create_response.get("id").toLong();
													openUrl("#Page:Successful_Message?mensaje=New Contact Created and Assigned like Sender","popup window","height=143,width=380");
													alert "New Contact Created and Assigned like Sender";
													//info "New Contact Created and Assigned like Sender";
													// Mensaje de confirmación en logs
												}
											}
										}
						)
					}
				}

			}
			Create_CRMReceiver_Contac2 as "Create_CRMReceiver_Contact"
