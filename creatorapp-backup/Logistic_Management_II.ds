			Update_AutocompleteField as "Update_AutocompleteField"
			{
				type =  form
				form = Daily_Movement

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(Payment_Information != null)
										{
											for each  r in input.Payment_Information
											{
												if(r.Amount > 0)
												{
													fit = ifnull(r.Fit,0);
													fitByCreditCard = r.Amount * fit / 100;
													r.Fit_Credit_Card=fitByCreditCard;
													r.Total_To_Pay1=r.Amount + fitByCreditCard;
												}
											}
										}
						)
					}
				}

			}
