			Filter_Vendor_Field1 as "Filter_Vendor_Field"
			{
				type =  form
				form = Shipment

				record event = on add or edit

				on user input of Shipping_Type
				{
					actions 
					{
						custom deluge script
						(
											// Limpiar selección previa del campo Vendor
										input.Vendor = null;
										if(input.Shipping_Type != null && input.Type_of_Merchandise != null && input.Coverage_Locations != null && input.Coverage_Locations.size() > 0)
										{
											// Valores del formulario actual
											selected_shipping_type = input.Shipping_Type;
											selected_type_of_merchandise = input.Type_of_Merchandise;
											selected_coverage_locations = input.Coverage_Locations;
											// Lista para guardar Vendors que cumplen la condición
											matching_vendors = list();
											// Obtener todos los Vendors
											all_vendors = Vendor[ID != 0 && Vendor_Type.contains("Freight Forwarder") && Active == true];
											for each  vendor in all_vendors
											{
												shipping_details_list = vendor.Shipping_Details;
												matched = false;
												for each  shipping_detail in shipping_details_list
												{
													shipping_types_list = shipping_detail.Shipping_Types;
													types_of_goods_list = shipping_detail.Types_of_Goods;
													coverage_locations_list = shipping_detail.Coverage_Locations;
													all_covered = true;
													if(shipping_types_list.contains(selected_shipping_type) && types_of_goods_list.contains(selected_type_of_merchandise))
													{
														// Verificar si coverage_locations_list contiene todos los selected_coverage_locations
														for each  loc_id in selected_coverage_locations
														{
															if(!coverage_locations_list.contains(loc_id))
															{
																all_covered = false;
																break;
															}
														}
													}
													else
													{
														all_covered = false;
													}
													if(all_covered == true)
													{
														matched = true;
														break;
													}
												}
												if(matched == true)
												{
													matching_vendors.add(vendor);
												}
											}
											// Actualizar opciones del campo Vendor
											input.Vendor:ui.add(matching_vendors);
										}
										else
										{
											// Si no hay condiciones válidas, limpiar opciones
											input.Vendor:ui.add(list());
										}
						)
					}
				}

			}
