			Complete_AutoFields as "Complete_AutoFields"
			{
				type =  form
				form = Service

				record event = on add or edit

				on user input of Packages.Package_Name
				{
					actions 
					{
						custom deluge script
						(
											boxes_number = 0;
										suma_weight = 0;
										if(Employee != null && Employee[ID == input.Employee].Full_Name.contains("VAN"))
										{
											suma_price = ifnull(input.Pickup_Service,0);
										}
										else
										{
											suma_price = 0;
										}
										suma_duty = 0;
										suma_package = 0;
										for each  fila in input.Packages
										{
											RealBox = Package[ID == fila.Package_Name];
											if(fila.Package_Name != null)
											{
												boxes_number = boxes_number + 1;
											}
											if(RealBox.Total_Weight != null)
											{
												suma_weight = suma_weight + RealBox.Total_Weight;
											}
											if(RealBox.Total_Price != null)
											{
												suma_price = suma_price + RealBox.Total_Price;
											}
											if(RealBox.Customs_Duty != null || RealBox.Packaging_Price != null)
											{
												duty = ifnull(RealBox.Customs_Duty,0);
												package = ifnull(RealBox.Packaging_Price,0);
												suma_duty = suma_duty + duty;
												suma_package = suma_package + package;
											}
										}
										input.Number_of_Packages = boxes_number;
										input.Total_Weight = suma_weight;
										input.Price = suma_price + suma_duty + suma_package;
										input.Total_Custom_Duty = suma_duty;
										input.Total_Packaging_Price = suma_package;
						)
					}
				}

			}
