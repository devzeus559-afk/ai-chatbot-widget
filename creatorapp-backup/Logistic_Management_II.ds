			Clean_Fill_ServiceFilter as "Clean&Fill_ServiceFilter"
			{
				type =  form
				form = Release

				record event = on add or edit

				on user input of Add_Packages_Option
				{
					actions 
					{
						custom deluge script
						(
											if(input.Add_Packages_Option == "Add")
										{
											clear Service_Filter;
											// Transform subform to list<map> for calculate totals and subtotals
											subform1 = List();
											if(input.Shipment_Details != null)
											{
												for each  r in input.Shipment_Details
												{
													// Populate packages list<map>
													Row1 = Map();
													// Assign lookup (Pass the record var, not the field)
													Row1.put("Package_ID",r.Package_ID);
													Row1.put("Status",r.Status);
													Row1.put("Location",r.Location);
													Row1.put("Service",r.Service);
													// Insert new subform row
													subform1.add(Row1);
												}
											}
											service_ids = list:int();
											service_ids = thisapp.filterServicesForAddPkgs(subform1,input.Office,input.Destination_Country);
											input.Service_Filter:ui.add(List());
											input.Service_Filter:ui.add(service_ids);
										}
										else if(input.Add_Packages_Option == "Remove")
										{
											clear Service_Filter;
											if(input.Shipment_Details != null)
											{
												// Transform subform to list<map> for calculate totals and subtotals
												subform1 = List();
												for each  r in input.Shipment_Details
												{
													// Populate packages list<map>
													Row1 = Map();
													// Assign lookup (Pass the record var, not the field)
													Row1.put("Package_ID",r.Package_ID);
													Row1.put("Status",r.Status);
													Row1.put("Location",r.Location);
													Row1.put("Service",r.Service);
													// Insert new subform row
													subform1.add(Row1);
												}
												service_ids = list:int();
												service_ids = thisapp.filterServicesForRemovePkgs(subform1,input.Office,input.Destination_Country);
												input.Service_Filter:ui.add(List());
												input.Service_Filter:ui.add(service_ids);
											}
											else if(input.Shipment_Details == null)
											{
												input.Service_Filter:ui.add(List());
											}
										}
						)
					}
				}

			}
