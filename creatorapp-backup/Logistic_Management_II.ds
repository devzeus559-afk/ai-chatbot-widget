		page System_Help
		{
			displayname = "System Help"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet6' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet6()\ncontent\n&lt;%{\n\t%&gt;\n&lt;!DOCTYPE html&gt;\n&lt;html lang=&quot;es&quot;&gt;\n&lt;head&gt;\n&lt;meta charset=&quot;UTF-8&quot;&gt;\n&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;\n&lt;title&gt;Glosario de T\u00E9rminos en Logistic Management&lt;/title&gt;\n&lt;style&gt;\n    body { font-family: &apos;Segoe UI&apos;, Arial, sans-serif; background-color: #ffffff; color: #222; line-height: 1.6; margin: 0; padding: 0; }\n    header { background-color: #003366; color: white; text-align: center; padding: 40px 20px; font-size: 2em; font-weight: bold; letter-spacing: 1px; }\n    section { max-width: 1200px; margin: 40px auto; padding: 0 20px; }\n    h2 { color: #003366; border-bottom: 3px solid #003366; padding-bottom: 6px; }\n    ul { list-style-type: disc; margin-left: 40px; }\n    li { margin-bottom: 8px; }\n    footer { text-align: center; background-color: #f4f4f4; color: #555; padding: 20px; font-size: 0.9em; border-top: 1px solid #ccc; }\n&lt;/style&gt;\n&lt;/head&gt;\n&lt;body&gt;\n&lt;header&gt;Glosario de T\u00E9rminos en Logistic Management&lt;/header&gt;\n\n&lt;section&gt;\n  &lt;h2&gt;M\u00F3dulo Service&lt;/h2&gt;\n  &lt;p&gt;M\u00F3dulo para crear los diferentes servicios en el sistema&lt;/p&gt;\n  &lt;ul&gt;\n    &lt;li&gt;&lt;strong&gt;Service Type:&lt;/strong&gt; Tipo de servicio que solicita el cliente: Recepci\u00F3n de paquetes (Package Receipt), Remesa (Remittance), Recargas (Recharge), Compras (Purchase), Casillero (Locker)&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Employee:&lt;/strong&gt; Empleado que realiza el servicio&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Sender:&lt;/strong&gt; Cliente que realiza el servicio&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Sender Not Found:&lt;/strong&gt; Bandera temporal que indica cuando el cliente no se encuentra registrado en el CRM, permitiendo crearlo como un registro&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Package:&lt;/strong&gt; Listado de los paquetes asociados al servicio; los campos visibles son: N\u00FAmero (Package ID), Nombre (Package Name), Tipo (Package Type), Estado (Status), Fecha recibo (Receipt Date), Total de Libras (Weight), N\u00FAmero de seguimiento externo (External Tracking Number), Destinatario (Receipt), Direcci\u00F3n destinatario (Destination Street), Localidad (Location), Ancho (Width), Largo (Length), Altura (Height), Volumen, Material (Package Material), Tipo de env\u00EDo (Shipment Type), Precio (Package Price)&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Payment Information:&lt;/strong&gt; Listado de los m\u00E9todos de pago a realizar por el cliente; los campos son: M\u00E9todo de pago (Payment Method), Cantidad (Amount), Flujo de Caja (Cash Flow Reference), % de comisi\u00F3n (Commission %), Cobro por tarjeta de cr\u00E9dito (Credit Card Fee), Total a pagar (Total to Pay)&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Number of Packages:&lt;/strong&gt; N\u00FAmero de paquetes que tiene el servicio de paqueter\u00EDa&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Total Weight:&lt;/strong&gt; Total de libras de todos los paquetes del servicio de paqueter\u00EDa&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Total Packaging Price:&lt;/strong&gt; Precio total del servicio de paqueter\u00EDa&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Total Custom Duty:&lt;/strong&gt; Total de aranceles del servicio de paqueter\u00EDa&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Total Price:&lt;/strong&gt; Precio total del servicio&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Notes:&lt;/strong&gt; Notas&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Daily Movement:&lt;/strong&gt; Movimiento diario del servicio&lt;/li&gt;\n  &lt;/ul&gt;\n&lt;/section&gt;\n\n&lt;section&gt;\n  &lt;h2&gt;M\u00F3dulo Package&lt;/h2&gt;\n  &lt;p&gt;M\u00F3dulo para visualizar los paquetes creados en el sistema&lt;/p&gt;\n  &lt;ul&gt;\n    &lt;li&gt;&lt;strong&gt;Package Name:&lt;/strong&gt; Nombre del paquete que se construye en la creaci\u00F3n del registro&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Package Type:&lt;/strong&gt; Tipo de paquete: Caja (Box), Bolsa (Bag), Documents (Documento)&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Receipt Date:&lt;/strong&gt; Fecha de recibo&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;External Tracking Number:&lt;/strong&gt; N\u00FAmero de seguimiento externo&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Employee:&lt;/strong&gt; Empleado que recibe el paquete&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Status:&lt;/strong&gt; Estado del paquete: Recibido (Received), Despachado (Dispatched), Entregado (Delivered), Retornado (Returned), Facturado (Invoiced), Etiquetado (Labeled)&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Departure Date:&lt;/strong&gt; Fecha de salida&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Contacts Information:&lt;/strong&gt; Secci\u00F3n para la informaci\u00F3n del cliente y destinatario&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Sender:&lt;/strong&gt; Cliente que env\u00EDa el paquete, se busca en el CRM&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Sender Not Found:&lt;/strong&gt; Bandera temporal que indica cuando el remitente no se encuentra en el CRM y permite crearlo como un nuevo registro&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Same Origin Address:&lt;/strong&gt; Indica si la direcci\u00F3n de recogida del paquete es la misma que la direcci\u00F3n registrada del remitente en el sistema&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Receiver:&lt;/strong&gt; Destinatario&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Receiver Not Found:&lt;/strong&gt; Bandera temporal que indica cuando el destinatario no se encuentra en el CRM y permite crearlo como un nuevo registro&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Payer:&lt;/strong&gt; Quien paga&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Products Details:&lt;/strong&gt; Secci\u00F3n para detallar los productos del paquete: Nombre, Categor\u00EDa, Cantidad, Peso en libras, Total de libras, Aranceles, N\u00FAmero de seguimiento externo&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Weight Limit:&lt;/strong&gt; L\u00EDmite de peso&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Package Details:&lt;/strong&gt; Detalles del paquete&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Total Weight:&lt;/strong&gt; Total de libras de todos los productos&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Width in inches:&lt;/strong&gt; Ancho en pulgadas&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Length in inches:&lt;/strong&gt; Largo en pulgadas&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Height in inches:&lt;/strong&gt; Altura en pulgadas&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Volume:&lt;/strong&gt; Volumen del paquete calculado a partir de las medidas&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Volumetric weight:&lt;/strong&gt; Peso volum\u00E9trico calculado a partir de las medidas&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Package Material:&lt;/strong&gt; Material del paquete&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Shipment Type:&lt;/strong&gt; Tipo de env\u00EDo asociado a la oficina del empleado y localidad del destinatario&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Shipment Price:&lt;/strong&gt; Precio del env\u00EDo calculado seg\u00FAn Total Weight o Volumetric weight&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Protection Price:&lt;/strong&gt; Precio de las protecciones asociadas&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Extended Address Charge:&lt;/strong&gt; Cargo adicional por direcci\u00F3n extendida&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Customs Duty:&lt;/strong&gt; Suma de los aranceles de los productos del paquete&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Packaging:&lt;/strong&gt; El paquete lleva empaquetado&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Packaging Price:&lt;/strong&gt; Precio del empaquetado&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Total Price:&lt;/strong&gt; Precio total del paquete (Shipment Price + Protection Price + Extended Address Charge)&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Supplier Tag:&lt;/strong&gt; Etiqueta del proveedor recibida v\u00EDa API&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Tag in HTML:&lt;/strong&gt; Etiqueta en c\u00F3digo HTML para imprimir recibida v\u00EDa API&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;HBL:&lt;/strong&gt; Campo HBL recibido v\u00EDa API&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Protections:&lt;/strong&gt; Protecciones asociadas al env\u00EDo seleccionado&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Notes:&lt;/strong&gt; Notas del paquete&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Relations:&lt;/strong&gt; Secci\u00F3n de relaciones del paquete&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Service:&lt;/strong&gt; Servicio asociado al paquete&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Release:&lt;/strong&gt; Despacho del paquete al proveedor&lt;/li&gt;\n  &lt;/ul&gt;\n&lt;/section&gt;\n\n&lt;section&gt;\n  &lt;h2&gt;M\u00F3dulo Daily Movement&lt;/h2&gt;\n  &lt;p&gt;M\u00F3dulo para trabajar los movimientos diarios de ingresos y gastos en el sistema&lt;/p&gt;\n  &lt;ul&gt;\n    &lt;li&gt;&lt;strong&gt;Daily Movement Type:&lt;/strong&gt; Tipo de movimiento: ingreso (Incoming) o gasto (Outing)&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Employee:&lt;/strong&gt; Empleado que registra el movimiento&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Payment Information:&lt;/strong&gt; M\u00E9todos de pago: Payment Method, Amount, Cash Flow, Fit %, Fit Credit Card, Total to Pay&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Subtotal by Shipment:&lt;/strong&gt; Listado de tipos de env\u00EDos para servicios de paqueter\u00EDa: Shipment Type, Quantity, Unit Price, Total Price&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Other Book Items:&lt;/strong&gt; \u00CDtems del Books asociados seg\u00FAn tipo de servicio y valores&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Total Customs Duty:&lt;/strong&gt; Suma de aranceles de los productos en los servicios de paqueter\u00EDa&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Total Packaging Price:&lt;/strong&gt; Precio total de empaquetado&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Relations:&lt;/strong&gt; Secci\u00F3n de relaciones del paquete&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Invoiced Id:&lt;/strong&gt; Identificador de la factura asociada en Books&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Invoice URL:&lt;/strong&gt; URL de la factura en Books&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Customer in Books:&lt;/strong&gt; Identificador del cliente en Books&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;In Cash Flow:&lt;/strong&gt; Indica si est\u00E1 asociado al flujo de caja correspondiente&lt;/li&gt;\n  &lt;/ul&gt;\n&lt;/section&gt;\n\n&lt;section&gt;\n  &lt;h2&gt;M\u00F3dulo Cash Flow&lt;/h2&gt;\n  &lt;p&gt;M\u00F3dulo para visualizar los flujos de caja con entrada y salida de efectivos&lt;/p&gt;\n  &lt;ul&gt;\n    &lt;li&gt;&lt;strong&gt;Cash Flow ID:&lt;/strong&gt; Identificador del flujo de caja (3 primeras letras de la oficina + fecha)&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Created Date Time:&lt;/strong&gt; Fecha y hora de creaci\u00F3n&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Office:&lt;/strong&gt; Oficina correspondiente&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Status:&lt;/strong&gt; Estado: Pendiente (Pending) o Aprobado (Approved)&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Opening Balance:&lt;/strong&gt; Saldo inicial (igual al Total Petty Cash del d\u00EDa anterior)&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Sections:&lt;/strong&gt; Desglose de billetes en caja&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Total Amount in bills:&lt;/strong&gt; Importe total en billetes&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Difference:&lt;/strong&gt; Diferencia entre Total Amount in Bill y Total Petty Cash&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Total Incoming:&lt;/strong&gt; Total de ingresos en efectivo&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Total Outgoing:&lt;/strong&gt; Total de gastos en efectivo&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Total Petty Cash:&lt;/strong&gt; Total de caja chica (Opening Balance + Incoming - Outgoing)&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Related Daily Movements:&lt;/strong&gt; Relaci\u00F3n de movimientos de ingresos o gastos realizados en efectivo&lt;/li&gt;\n  &lt;/ul&gt;\n&lt;/section&gt;\n\n&lt;section&gt;\n  &lt;h2&gt;M\u00F3dulo Release&lt;/h2&gt;\n  &lt;p&gt;M\u00F3dulo para crear el despacho de los paquetes al transportador&lt;/p&gt;\n  &lt;ul&gt;\n    &lt;li&gt;&lt;strong&gt;Employee:&lt;/strong&gt; Empleado que realiza el despacho&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Office:&lt;/strong&gt; Oficina del empleado&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Dispatch Date:&lt;/strong&gt; Fecha de despacho&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Destination Country:&lt;/strong&gt; Pa\u00EDs destino de las cajas&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Freight Forwarder:&lt;/strong&gt; Proveedor que lleva los paquetes&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Transporter:&lt;/strong&gt; Transportista que entrega los paquetes al proveedor&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Shipment Details:&lt;/strong&gt; Listado de paquetes: Package ID, Package Name, Package Type, Sender, Receiver, Total Weight, Shipping Type, Package Price, Service&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Add Multiple Packages:&lt;/strong&gt; Permite agregar paquetes por servicios seleccionados&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Service Filter:&lt;/strong&gt; Listado de servicios de la oficina con paquetes al pa\u00EDs destino&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Choose Option:&lt;/strong&gt; Opci\u00F3n para adicionar (Add) o eliminar (Remove) paquetes del servicio&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Subtotals By Shipping Type:&lt;/strong&gt; Listado de tipos de env\u00EDos (A\u00E9reo o Mar\u00EDtimo) con total de paquetes y libras&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Shipment Totals:&lt;/strong&gt; Totales de los paquetes&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Total Boxes:&lt;/strong&gt; Total de cajas&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Total Full Packages:&lt;/strong&gt; Total de cajas completas (By Package)&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Total Bags:&lt;/strong&gt; Total de bolsas&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Total Docs:&lt;/strong&gt; Total de documentos&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Total Pounds:&lt;/strong&gt; Total de libras&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Subtotal by Shipment:&lt;/strong&gt; Listado de tipos de env\u00EDos para servicios de paqueter\u00EDa: Shipment Type, Quantity, Unit Price, Total Price&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Other Book Items:&lt;/strong&gt; \u00CDtems del Books asociados seg\u00FAn tipo de servicio&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Total Customs Duty:&lt;/strong&gt; Total de aranceles de productos&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Relations:&lt;/strong&gt; Relaciones del despacho&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Bill Id:&lt;/strong&gt; Identificador del Bill en Books asociado&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Invoice URL:&lt;/strong&gt; URL del Bill en Books asociado&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Vendor in Books:&lt;/strong&gt; Identificador del proveedor en Books&lt;/li&gt;\n  &lt;/ul&gt;\n&lt;/section&gt;\n\n&lt;section&gt;\n  &lt;h2&gt;M\u00F3dulo Commercial Office&lt;/h2&gt;\n  &lt;p&gt;M\u00F3dulo para configurar las oficinas en el sistema&lt;/p&gt;\n  &lt;ul&gt;\n    &lt;li&gt;&lt;strong&gt;Office Name:&lt;/strong&gt; Nombre de la oficina&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Address:&lt;/strong&gt; Direcci\u00F3n de la oficina&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Active:&lt;/strong&gt; Estado de la oficina; si est\u00E1 desmarcado no estar\u00E1 disponible en los listados&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Book Location:&lt;/strong&gt; Localidad correspondiente en el Books&lt;/li&gt;\n  &lt;/ul&gt;\n&lt;/section&gt;\n\n&lt;section&gt;\n  &lt;h2&gt;M\u00F3dulo Employee&lt;/h2&gt;\n  &lt;p&gt;M\u00F3dulo para configurar los empleados en el sistema&lt;/p&gt;\n  &lt;ul&gt;\n    &lt;li&gt;&lt;strong&gt;Full Name:&lt;/strong&gt; Nombre completo del empleado&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Email:&lt;/strong&gt; Correo electr\u00F3nico del empleado&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Phone:&lt;/strong&gt; Tel\u00E9fono completo del empleado&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Office:&lt;/strong&gt; Oficina a la cual corresponde el empleado&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;User:&lt;/strong&gt; Usuario con el que se autentica el empleado&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Active:&lt;/strong&gt; Estado activo del empleado; si est\u00E1 desmarcado no estar\u00E1 disponible en los listados&lt;/li&gt;\n  &lt;/ul&gt;\n&lt;/section&gt;\n\n&lt;section&gt;\n  &lt;h2&gt;M\u00F3dulo Coverage Location&lt;/h2&gt;\n  &lt;p&gt;M\u00F3dulo para configurar las localidades en el sistema&lt;/p&gt;\n  &lt;ul&gt;\n    &lt;li&gt;&lt;strong&gt;Address Information:&lt;/strong&gt; Estado o Provincia y Pa\u00EDs&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Location Name:&lt;/strong&gt; Nombre de la localidad&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Active:&lt;/strong&gt; Estado activo de la localidad; si est\u00E1 desmarcado no estar\u00E1 disponible en los listados&lt;/li&gt;\n  &lt;/ul&gt;\n&lt;/section&gt;\n\n&lt;section&gt;\n  &lt;h2&gt;M\u00F3dulo Protection&lt;/h2&gt;\n  &lt;p&gt;M\u00F3dulo para configurar las protecciones en el sistema&lt;/p&gt;\n  &lt;ul&gt;\n    &lt;li&gt;&lt;strong&gt;Insurance Name:&lt;/strong&gt; Nombre de la protecci\u00F3n&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Price Form:&lt;/strong&gt; Forma de precio&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;By Package:&lt;/strong&gt; Precio por paquete&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;By Percent:&lt;/strong&gt; Precio por porcentaje&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;By Range:&lt;/strong&gt; Precio por rango&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Price by Package:&lt;/strong&gt; Precio por paquete&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Percentage of price:&lt;/strong&gt; Porcentaje de precio&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Price Range:&lt;/strong&gt; Rangos de precios&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Active:&lt;/strong&gt; Estado activo de la protecci\u00F3n; si est\u00E1 desmarcado no estar\u00E1 disponible en los listados&lt;/li&gt;\n  &lt;/ul&gt;\n&lt;/section&gt;\n\n&lt;section&gt;\n  &lt;h2&gt;M\u00F3dulo Vendor&lt;/h2&gt;\n  &lt;p&gt;M\u00F3dulo para configurar los proveedores en el sistema&lt;/p&gt;\n  &lt;ul&gt;\n    &lt;li&gt;&lt;strong&gt;Vendor Name:&lt;/strong&gt; Nombre del proveedor&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Phone:&lt;/strong&gt; Tel\u00E9fono del proveedor&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Website:&lt;/strong&gt; Sitio web del proveedor&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Vendor Type:&lt;/strong&gt; Tipo: Transportista (Transporter) y/o Transportista de carga (Freight Forwarder)&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Active:&lt;/strong&gt; Estado activo del proveedor; si est\u00E1 desmarcado no estar\u00E1 disponible en los listados&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Shipping Details:&lt;/strong&gt; Detalles de env\u00EDos: Shipping Type, Types of Goods, Coverage&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Protections:&lt;/strong&gt; Protecciones que asegura el proveedor por pa\u00EDses&lt;/li&gt;\n  &lt;/ul&gt;\n&lt;/section&gt;\n\n&lt;section&gt;\n  &lt;h2&gt;M\u00F3dulo Shipment&lt;/h2&gt;\n  &lt;p&gt;M\u00F3dulo para configurar los env\u00EDos en el sistema&lt;/p&gt;\n  &lt;ul&gt;\n    &lt;li&gt;&lt;strong&gt;Name:&lt;/strong&gt; Nombre del env\u00EDo: combinaci\u00F3n de Shipping Type, Type of Merchandise, Country, Vendor, primera letra de la oficina&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Office:&lt;/strong&gt; Oficina que establece el env\u00EDo&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Shipment Information:&lt;/strong&gt; Informaci\u00F3n del env\u00EDo: Shipping Type, Types of Goods, Coverage&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Price Details:&lt;/strong&gt; Detalles de precio: Our Commission, Basic Price, Price Form, Total Price&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Protections:&lt;/strong&gt; Protecciones que asegura el env\u00EDo&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Relations:&lt;/strong&gt; Relaciones del env\u00EDo para Book Item ID y creaci\u00F3n de facturas&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Active:&lt;/strong&gt; Estado activo del env\u00EDo; si est\u00E1 desmarcado no estar\u00E1 disponible en los listados&lt;/li&gt;\n  &lt;/ul&gt;\n&lt;/section&gt;\n\n&lt;section&gt;\n  &lt;h2&gt;M\u00F3dulo Books Items&lt;/h2&gt;\n  &lt;p&gt;M\u00F3dulo para relacionar los servicios del sistema con los \u00EDtems en Zoho Books para crear facturas&lt;/p&gt;\n  &lt;ul&gt;\n    &lt;li&gt;&lt;strong&gt;Service Type:&lt;/strong&gt; Tipo de servicio: Package Receipt, Remittance, Recharge, Purchase, Locker&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Subitem:&lt;/strong&gt; Sub-elemento para Package Receipt: Packaging, Custom Duty, Fit Credit Card&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Book Item Id:&lt;/strong&gt; Listado de Items del Books correspondientes al servicio&lt;/li&gt;\n  &lt;/ul&gt;\n&lt;/section&gt;\n\n&lt;section&gt;\n  &lt;h2&gt;M\u00F3dulo Payment Concept&lt;/h2&gt;\n  &lt;p&gt;M\u00F3dulo para establecer los conceptos de pagos menores usados en Daily Movement tipo Outgoing&lt;/p&gt;\n  &lt;ul&gt;\n    &lt;li&gt;&lt;strong&gt;Name:&lt;/strong&gt; Nombre del concepto&lt;/li&gt;\n    &lt;li&gt;&lt;strong&gt;Active:&lt;/strong&gt; Estado activo del concepto; si est\u00E1 desmarcado no estar\u00E1 disponible en los listados&lt;/li&gt;\n  &lt;/ul&gt;\n&lt;/section&gt;\n\n&lt;footer&gt;\u00A9 2025 Logistic Management | Documento de referencia interna&lt;/footer&gt;\n&lt;/body&gt;\n&lt;/html&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row>\n</layout>\n</zml>"
		}
