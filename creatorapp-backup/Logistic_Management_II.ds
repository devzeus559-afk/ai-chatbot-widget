				 map chat_tools.track_package(map params)
                 {
                 	/**
                 	 * tool_track_package.deluge
                 	 *
                 	 * Busca el estado de un paquete por número de seguimiento en el módulo Package.
                 	 * Recibe: {"trackingNumber": "..."}
                 	 * Devuelve: {"ok": true, "data": {...}} | {"ok": false, "message": "..."}
                 	 *
                 	 * Acceso nativo vía data_access.fetch_packages (0 llamadas de API de Creator).
                 	 */
                 	config = thisapp.chat_config.chat_config();
                 	fields = config.get("packageFields");
                 	trackingNumber = params.get("trackingNumber");
                 	if(trackingNumber == null || trackingNumber == "")
                 	{
                 		return {"ok":false,"message":"Falta el número de seguimiento."};
                 	}
                 	records = thisapp.chat_data_access.fetch_packages_by_tracking(trackingNumber);
                 	if(records == null || records.size() == 0)
                 	{
                 		return {"ok":false,"message":"No se encontró un paquete con ese número de seguimiento."};
                 	}
                 	// .get(0) = más reciente (fetch_packages_by_tracking ordena por Created_Time desc)
                 	pkg = records.get(0);
                 	data = Map();
                 	data.put("trackingNumber",pkg.get(fields.get("trackingNumber")));
                 	data.put("status",pkg.get(fields.get("status")));
                 	// Origen: Package.Sender_Address (address compuesto) -> leer subcampo country
                 	senderAddr = pkg.get(fields.get("origin"));
                 	originValue = "";
                 	if(senderAddr != null)
                 	{
                 		originValue = senderAddr.get("country");
                 	}
                 	data.put("origin",originValue);
                 	data.put("destination",pkg.get(fields.get("destination")));
                 	return {"ok":true,"data":data};
                 }
				 list solvedc.checkMissedKeys(map map_obj, list required_keys)
                 {
                 	missed_keys = {};
                 	if(map_obj != null)
                 	{
                 		for each  k in required_keys
                 		{
                 			if(!map_obj.keys().contains(k))
                 			{
                 				missed_keys.add(k);
                 			}
                 		}
                 	}
                 	if(!missed_keys.isEmpty())
                 	{
                 		info "Are keys missing in object : " + missed_keys;
                 	}
                 	return missed_keys;
                 }
				 void solvedc.createAPILog(string endpoint, string method, string req_payload, map resp_body)
                 {
                 	resp_code = resp_body.get("responseCode");
                 	resp_text = resp_body.get("responseText");
                 	error_message = "NA";
                 	// utility code to validate a list data type
                 	isRespTextList = false;
                 	try 
                 	{
                 		tmp = resp_text.toList();
                 		isRespTextList = true;
                 	}	catch (e)
                 	{
                 	}
                 	if(resp_code == 200 && !isRespTextList && resp_text.containKey("error"))
                 	{
                 		error_message = resp_text.get("error");
                 		error_type = "DATA";
                 	}
                 	else if(resp_code != 200)
                 	{
                 		error_message = resp_text.toString();
                 		error_type = "HTTP";
                 	}
                 	// Make a log record
                 	new_solved_log = insert into SolvedCargo_API_Log1
                 	[
                 		Added_User=zoho.loginuser
                 		Log_Date=zoho.currentdate
                 		Log_Time=zoho.currenttime
                 		API_Endpoint=endpoint
                 		Request_Method=method
                 		Request_Payload=req_payload
                 		Response_Status=resp_code
                 		Response_Body=resp_text.toString()
                 		Error_Message=error_message
                 	];
                 	// Create email notification
                 	if(error_message != "NA")
                 	{
                 		thisapp.solvedc.notifyAPIError(error_type,error_message,new_solved_log);
                 	}
                 }
				 map solvedc.createRequestData(int package_id, string user)
                 {
                 	response = Map();
                 	// Getting real record of package
                 	PkgRec = Package[ID == package_id];
                 	// Validate if record exists
                 	if(PkgRec != null && PkgRec.Products_Details != null)
                 	{
                 		// Initialize data JSON
                 		data = Map();
                 		// Set default values for 'enterprise'
                 		enterprise = if(user.contains("demo"),"dayreadytest","dayready");
                 		// Add 'enterprise' element
                 		data.put("enterprise",enterprise);
                 		// Add 'print' element
                 		data.put("print",{"label":true,"labelbag":true,"awbhbl":true,"billing":true});
                 		// == Create 'reserve' element ==
                 		reserve = Map();
                 		// Determine agency name, 'createdby' is mandatory 
                 		//.. pending how to set 'user' value 
                 		OfficeRec = Commercial_Office[SolvedCargo_User == user];
                 		agency = OfficeRec.SolvedCargo_Agency;
                 		reserve.put("createdby",agency);
                 		// Determine 'shipping type' from type of merchandise and shipping type in Package Shipment Type
                 		ShipmentRec = Shipment[ID == PkgRec.Shipment_Type];
                 		if(ShipmentRec.Shipping_Type.contains("Air") && ShipmentRec.Type_of_Merchandise != "Durables")
                 		{
                 			shipping_type = "air";
                 		}
                 		else if(ShipmentRec.Shipping_Type.contains("Air") && ShipmentRec.Type_of_Merchandise == "Durables")
                 		{
                 			shipping_type = "fbc";
                 		}
                 		else if(ShipmentRec.Shipping_Type == "Maritime" || ShipmentRec.Shipping_Type.contains("Caja"))
                 		{
                 			shipping_type = "mail";
                 		}
                 		reserve.put("typecorrespond",shipping_type);
                 		// optional
                 		reserve.put("vesselguide","");
                 		// optional
                 		reserve.put("manifest","");
                 		// optional
                 		pkg_id = ifNull(PkgRec.Package_ID,"");
                 		reserve.put("noorder",pkg_id);
                 		// optional
                 		reserve.put("bagnumber","");
                 		// default: "ENVIO"
                 		reserve.put("clasification","ENVIO");
                 		// Finish 'RESERVE' setup ...
                 		data.put("reserve",reserve);
                 		// ----------
                 		// == Create 'shipper' element from Package Sender ==
                 		shipper = Map();
                 		shipper.put("name",PkgRec.Sender_Full_Name.first_name.replaceAll("\t","") + " " + PkgRec.Sender_Full_Name.last_name.replaceAll("\t",""));
                 		// Set shipper address
                 		//sender_address = ifNull(PkgRec.Sender_Address.address_line_1,"14335 SW 120th ST, Miami");
                 		// default: "14335 SW 120th ST, Miami" (Miami Office Address)
                 		sender_address = "14335 SW 120th ST, Miami";
                 		shipper.put("address",sender_address);
                 		// Set shipper state
                 		//sender_state = ifNull(PkgRec.Sender_Address.state_province,"FL");
                 		// default: "FL" (Florida)
                 		sender_state = "FL";
                 		shipper.put("state",sender_state);
                 		// Determine dockind = {"Id", "Pasaporte", "Licencia"}, is mandatory (default: "Id")
                 		shipper.put("dockind","Id");
                 		// use 'passport' key to set 'Id' value, it's mandatory (use a dummy value if it not found)
                 		sender_dni = if(isNull(PkgRec.Sender_DNI),"D12345671234567",PkgRec.Sender_DNI.replaceAll("\t",""));
                 		shipper.put("passport",sender_dni.toString());
                 		// default: "7862754393" (Miami Office Phone)
                 		//sender_mobile = PkgRec.Sender_Mobile;
                 		sender_mobile = "7862754393";
                 		shipper.put("phone",sender_mobile.remove("+"));
                 		// 'nationality' is a mandatory field for maritime shipping (default: USA)
                 		shipper.put("nacionality","USA");
                 		// optional
                 		shipper.put("birthday","");
                 		// optional
                 		shipper.put("email","");
                 		// Finish 'SHIPPER' setup ...
                 		data.put("shipper",shipper);
                 		// -----------
                 		// == Create 'consignee' element from Package Receiver ==
                 		consignee = Map();
                 		firstname = PkgRec.Receiver_Full_Name.first_name.replaceAll("\t","");
                 		consignee.put("firstname",firstname);
                 		// Getting first and second surnames from 'Last Name' 
                 		surname = PkgRec.Receiver_Full_Name.last_name.trim().replaceAll("\t","");
                 		surname_list = surname.toList(" ");
                 		first_surname = surname_list.get(0);
                 		snd_surname = surname_list.get(surname_list.size() - 1);
                 		// assing first surname
                 		consignee.put("surname",first_surname);
                 		// second surname is mandatory, if suffix not found use 2nd substring of 'Last Name'
                 		second_surname = if(isNull(PkgRec.Receiver_Full_Name.suffix),snd_surname,PkgRec.Receiver_Full_Name.suffix);
                 		consignee.put("sndsurname",second_surname);
                 		// consignee identity is mandatory (as integer) and use a dummy value if not found
                 		receiver_dni = if(isNull(PkgRec.Receiver_DNI),"unknown",PkgRec.Receiver_DNI.replaceAll("\t",""));
                 		consignee.put("identity",receiver_dni);
                 		// (default nationality: CUB)
                 		consignee.put("nacionality","CUB");
                 		receiver_mobile = PkgRec.Receiver_Mobile;
                 		consignee.put("telephone",receiver_mobile.remove("+"));
                 		// optional
                 		consignee.put("email","");
                 		// optional
                 		consignee.put("mobile","");
                 		// mandatory
                 		consignee.put("street",PkgRec.Street.trim());
                 		consignee.put("building","");
                 		consignee.put("between1","");
                 		consignee.put("between2","");
                 		consignee.put("apartment","");
                 		// Determine Receiver location (revisar que coincidan con Solve, se eliminan tildes y se convierten a mayusculas)
                 		LocationRec = Coverage_Location[ID == PkgRec.Location];
                 		consignee_province = thisapp.removeWordAccent(LocationRec.Address_Information1.state_province.trim());
                 		consignee.put("province",toUpperCase(consignee_province));
                 		consignee_municipality = thisapp.removeWordAccent(PkgRec.City.trim());
                 		consignee.put("municipality",toUpperCase(consignee_municipality));
                 		// Finish 'CONSIGNEE' setup ...
                 		data.put("consignee",consignee);
                 		// ---------
                 		// == Create 'goods' element from Package Products ==
                 		goods = Map();
                 		// Determine 'delivery_kind' from SolveDCargo user param
                 		delivery_kind = if(user.contains("demo"),"PROVINCIA PUERTA CASA","ENTREGA PUERTA");
                 		// Determine 'custom charge' from Payer field on Package 
                 		customs_charge = if(PkgRec.Duty_Payer == "Receiver","DESTINO","ORIGEN");
                 		// Determine 'Cajas Completas' from Shipment type
                 		category = "";
                 		if(ShipmentRec.Shipping_Type.contains("Caja") && ShipmentRec.Shipping_Type.contains("15"))
                 		{
                 			category = "Caja Completa 15";
                 		}
                 		else if(ShipmentRec.Shipping_Type.contains("Caja") && ShipmentRec.Shipping_Type.contains("12"))
                 		{
                 			category = "Caja Completa 12";
                 		}
                 		// Determine 'shipping kind' from Shipment 'Type of Merchandise' (used in maritime)
                 		shipping_kind = if(ShipmentRec.Type_of_Merchandise == "Miscellaneous","M","D");
                 		// == Fill goods(products) elements from Products List of Package ==
                 		// initialize good vars
                 		good = Map();
                 		good_price = ifNull(PkgRec.Declared_Value,0);
                 		good_name = "";
                 		good_weight = PkgRec.Total_Weight;
                 		good_width = ifNull(PkgRec.Width_in,0);
                 		good_height = ifNull(PkgRec.Height_in,0);
                 		good_length = ifNull(PkgRec.Length_in,0);
                 		good_volume = ifNull(PkgRec.Volume,0);
                 		good_weight_volume = ifNull(PkgRec.Volumetric_weight,0);
                 		good_total_price = ifNull(PkgRec.Total_Price,0);
                 		good_customs_duty = ifNull(PkgRec.Customs_Duty,0);
                 		good_obs = ifNull(PkgRec.Notes,"");
                 		// Determine names
                 		category_ids = {};
                 		for each  p in PkgRec.Products_Details
                 		{
                 			// check that count just one category (that hide product quantities in box label) 
                 			if(!category_ids.contains(p.Product_Category))
                 			{
                 				// Add new category Id to list
                 				category_ids.add(p.Product_Category);
                 				// Get product name from SolvedCargo Category, mandatory
                 				//.. concat all product names
                 				SolvedCategoryRec = SolvedCargo_Categories[ID == p.Product_Category];
                 				pname = ifNull(ltrim(SolvedCategoryRec.Category_Name),"Unknown");
                 				// Get product quantity to concat with name
                 				// 				pqty = if(p.Qty > 1,concat(toString(p.Qty)," ").concat(pname),pname);
                 				// concat names
                 				good_name = if(!isNull(good_name),good_name.concat(", ").concat(pname),pname);
                 			}
                 		}
                 		// optional
                 		good.put("reference","");
                 		// optional
                 		good.put("barcode","");
                 		good.put("namegood",good_name.rtrim());
                 		good.put("namegoodc",category);
                 		// optional
                 		good.put("category","");
                 		// default: 1 (one box or bag)
                 		good.put("quantity","1");
                 		// 'weight' is mandatory and greater than zero		
                 		good.put("weight",toString(good_weight));
                 		// 'value' is customs value (for billing only) 
                 		good.put("value",toString(good_customs_duty));
                 		good.put("width",toString(good_width));
                 		good.put("length",toString(good_length));
                 		good.put("height",toString(good_height));
                 		good.put("volume",toString(good_volume));
                 		good.put("weightvolume",toString(good_weight_volume));
                 		// 'cost' is for billing only (it is total_price + customs_duty)
                 		billing_value = good_total_price + good_customs_duty;
                 		good.put("cost",toString(billing_value));
                 		// 'priceshipping' is for billing only
                 		shipping_value = ifNull(PkgRec.Shipment_Price,0);
                 		good.put("priceshipping",toString(shipping_value));
                 		// 'productprice' is mandatory and greater than zero (valor comercial)
                 		good.put("priceproduct",toString(good_price));
                 		good.put("deliverykind",delivery_kind);
                 		good.put("customcharge",customs_charge);
                 		good.put("shippingkind",shipping_kind);
                 		// optional
                 		good.put("observation",good_obs);
                 		goods.put("0",good);
                 		// number of products, default: 1
                 		goods.put("length","1");
                 		// Finish 'GOODS' setup ...
                 		data.put("goods",goods);
                 		// ---------
                 		// Validate data_json format
                 		validation_msg = thisapp.solvedc.validateCreateRequestJson(data);
                 		// If validation fail then send wrong data and error message
                 		if(validation_msg != "")
                 		{
                 			response.put("type","error");
                 			response.put("message",validation_msg);
                 			response.put("data",data);
                 		}
                 		else
                 		{
                 			// Update response
                 			response.put("type","success");
                 			response.put("data",data);
                 		}
                 	}
                 	// Validate if package not found
                 	else if(PkgRec == null)
                 	{
                 		response.put("type","error");
                 		response.put("message","Package " + package_id + " Not Found");
                 	}
                 	// Validate if products list not found
                 	else if(PkgRec.Products_Details == null)
                 	{
                 		response.put("type","error");
                 		response.put("message","Not Found Products In Package " + package_id);
                 	}
                 	return response;
                 }
				 list solvedc.createSolvedRecord(list package_ids, string user)
                 {
                 	// Response var
                 	res = list();
                 	// Initialize API params
                 	SOLVEDC_ENDPOINT = "https://www.solvedc.com/api/dayready/pronto/v1";
                 	CREATE_RESOURCE = "/shipping/create/";
                 	APIKEY = thisapp.variables.SolvedCargo.APIKEY;
                 	// 	package_id = 4132617000003294184;    (test)
                 	// == Create all SolvedC labels of package in list 'package_ids' ==
                 	// Create all data json for API requests
                 	//'data_list' is a list that contains data json (map types) used as path params
                 	data_list = List();
                 	//'error_list' contains error messages to debug (if its needed)
                 	error_list = List();
                 	// Processing all 'packages ids' passed as param (for a Package only one 'id' is processed, and for a Service one or more 'ids')
                 	// 	info "Let's processing this package: " + package_ids;
                 	for each  id in package_ids
                 	{
                 		// == Create JSON data to SolvedCargo request
                 		data_resp = thisapp.solvedc.createRequestData(id,user);
                 		// == Validate data format ==
                 		if(data_resp.get("type") == "error")
                 		{
                 			error_msg = data_resp.get("message");
                 			error_list.add(error_msg);
                 		}
                 		else if(data_resp.get("type") == "success")
                 		{
                 			json_data = data_resp.get("data");
                 			data_list.add(json_data);
                 		}
                 	}
                 	// Print errors if exist and break the processing
                 	if(!error_list.isEmpty())
                 	{
                 		info "'data' JSON format error: " + error_list;
                 		return List();
                 	}
                 	// == Run SolvedCargo API requests ==
                 	// 'data_list' can have one or more element (in case of processing packages from a service)
                 	for each index dataIdx in data_list
                 	{
                 		// Query params
                 		dataParam = data_list.get(dataIdx).toString();
                 		// Body params (test: set iduser to 'Westny')
                 		bodyReq = Map();
                 		bodyReq.put("token","123456789");
                 		// iduser: 883 (Westny) | iduser: 1 (demo)
                 		bodyReq.put("iduser",1);
                 		// == Valitate API request ==
                 		api_errors = List();
                 		// Make API call
                 		try 
                 		{
                 			// Create Api request
                 			url = SOLVEDC_ENDPOINT + CREATE_RESOURCE + "?apikey=" + APIKEY + "&data=" + dataParam;
                 			// Getting Api response
                 			//solved_resp = invokeUrl(url,REQ_METHOD,bodyReq,headers);
                 			solved_resp = invokeurl
                 			[
                 				url :url
                 				type :POST
                 				detailed:true
                 			];
                 			// Save an API call log
                 			thisapp.solvedc.createAPILog(CREATE_RESOURCE,"POST",dataParam,solved_resp);
                 			// Processing response (validate if exist any HBL code); save record if it was created
                 			if(solved_resp.get("responseText").get("code").size() > 0)
                 			{
                 				// Create an empty element
                 				pack = Map();
                 				pack.put("code","");
                 				pack.put("label","");
                 				pack.put("labelbag","");
                 				pack.put("awbhbl","");
                 				pack.put("manifest","");
                 				pack.put("invoice","");
                 				// Update with new values
                 				pack.put("code",solved_resp.get("responseText").get("code").get(dataIdx));
                 				// getting box 'label' in HTML
                 				if(solved_resp.get("responseText").get("label").size() > 0 && solved_resp.get("responseText").get("label").get(dataIdx) != null)
                 				{
                 					pack.put("label",solved_resp.get("responseText").get("label").get(dataIdx));
                 				}
                 				// getting bag 'label'
                 				if(solved_resp.get("responseText").get("labelbag").size() > 0 && solved_resp.get("responseText").get("labelbag").get(dataIdx) != null)
                 				{
                 					pack.put("labelbag",solved_resp.get("responseText").get("labelbag").get(dataIdx));
                 				}
                 				// getting AWB/HBL document in HTML
                 				if(solved_resp.get("responseText").get("awbhbl").size() > 0 && solved_resp.get("responseText").get("awbhbl").get(dataIdx) != null)
                 				{
                 					pack.put("awbhbl",solved_resp.get("responseText").get("awbhbl").get(dataIdx));
                 				}
                 				// getting manifest
                 				if(solved_resp.get("responseText").get("manifest").size() > 0 && solved_resp.get("responseText").get("manifest").get(dataIdx) != null)
                 				{
                 					pack.put("manifest",solved_resp.get("responseText").get("manifest").get(dataIdx));
                 				}
                 				// getting invoice in HTML
                 				if(solved_resp.get("responseText").get("billing").size() > 0 && solved_resp.get("responseText").get("billing").get(dataIdx) != null)
                 				{
                 					pack.put("invoice",solved_resp.get("responseText").get("billing").get(dataIdx));
                 				}
                 				// update pack representation map
                 				res.add(pack);
                 				info "SolvedC record created: " + solved_resp.get("responseText").get("code").get(dataIdx);
                 			}
                 		}		catch (e)
                 		{
                 			info "SolvedC API Error: " + e;
                 			api_errors.add(data_list.get(dataIdx).get("reserve").get("noorder"));
                 		}
                 	}
                 	// Print package ids with API error if exist
                 	if(!api_errors.isEmpty())
                 	{
                 		info "Some SolvedCargo records are fails: " + api_errors;
                 		openUrl("#Page:Error_Message?mensaje=Some records could not be saved. Please try on the SolveDCargo (https://www.solvedc.com/cargo/dayready/v1/)","popup window","height=143,width=380");
                 	}
                 	return res;
                 }
				 collection solvedc.getTrackingData(string hbl)
                 {
                 	// Response var
                 	res = Collection("data":"","error":"");
                 	init_t = zoho.currenttime;
                 	// Initialize API params
                 	SOLVEDC_ENDPOINT = "https://www.solvedc.com/api/dayready/pronto/v1";
                 	TRACKING_RESOURCE = "/tracking/";
                 	APIKEY = thisapp.variables.SolvedCargo.APIKEY;
                 	// Initialize data JSON param with enterprise element
                 	dataParam = {"enterprise":"dayready"};
                 	// Set HBL values
                 	dataParam.put("number",{hbl});
                 	// Create request body
                 	queryParams = {"apikey":APIKEY};
                 	queryParams.put("data",dataParam);
                 	// Create request header
                 	headerParam = {"Content-Type":"application/json"};
                 	// Make API call
                 	// Create Api request
                 	trackingUrl = SOLVEDC_ENDPOINT + TRACKING_RESOURCE;
                 	// Retry 3 times before if some error is catched
                 	for each  t in {1,2,3}
                 	{
                 		try 
                 		{
                 			solved_resp = invokeurl
                 			[
                 				url :trackingUrl
                 				type :GET
                 				parameters:queryParams
                 				detailed:true
                 			];
                 			break;
                 		}		catch (e)
                 		{
                 			if(t == 3)
                 			{
                 				res.update("error","API failed after 3 attempts");
                 				// ===
                 				// Save an API call log
                 				thisapp.solvedc.createAPILog(TRACKING_RESOURCE,"GET",dataParam.toString(),solved_resp);
                 				// ===				
                 				return res;
                 			}
                 			continue;
                 		}
                 	}
                 	if(solved_resp == null || solved_resp.get("responseCode") != 200)
                 	{
                 		api_error = "HTTP " + solved_resp.get("responseCode") + ": " + solved_resp.get("responseText");
                 		res.update("error",api_error);
                 		return res;
                 	}
                 	// sanitize result; identify errors if 'responseText' hasn't Solved pkg values
                 	if(solved_resp.get("responseText") == {"error":"Not found"})
                 	{
                 		res.update("error",hbl);
                 		return res;
                 	}
                 	// get package info from Solved if 'responseText' has pkg values 
                 	resp_body = solved_resp.get("responseText");
                 	if(resp_body != null && resp_body.size() > 0)
                 	{
                 		track_rec = resp_body.get(0);
                 		if(track_rec.get("hbl") != null)
                 		{
                 			guide = track_rec.get("guide");
                 			dateshipped = track_rec.get("dateshipped");
                 			scanned = track_rec.get("scanned");
                 			status_history = track_rec.get("status");
                 			res.update("data",{"guide":guide,"dateshipped":dateshipped,"scanned":scanned,"status":status_history});
                 		}
                 		else
                 		{
                 			// save pkg if it not found
                 			res.update("error",hbl);
                 		}
                 	}
                 	// calculate exec time
                 	dt = init_t.timeBetween(zoho.currenttime);
                 	info "getSolvedPkgsTrackingInfo exec_time: " + dt;
                 	return res;
                 }
				 void solvedc.notifyAPIError(string type, string msg, int log_id)
                 {
                 	//resp = zoho.pushNotification(<emailID>, <title>, <message>, <reportLinkName>, <recordID>);
                 	resp = zoho.pushNotification({"prontoenviosnewjersey@outlook.com"},"SolveDCargo API " + type + " Error",msg + " Click to view the record.","All_Solvedcargo_Api_Logs",log_id);
                 	if(resp.get("status") != "success")
                 	{
                 		info "Review API Logs, Notifications Has Problems: " + resp.get("status");
                 	}
                 }
				 string solvedc.validateCreateRequestJson(map data_json)
                 {
                 	msg = "";
                 	data_required_keys = {"enterprise","print","reserve","shipper","consignee","goods"};
                 	missed_key = thisapp.solvedc.checkMissedKeys(data_json,data_required_keys);
                 	if(!missed_key.isEmpty())
                 	{
                 		msg = "'data' object has missed keys: " + missed_key;
                 		info msg;
                 		return msg;
                 	}
                 	// === Validate if all data keys exists ===
                 	if(missed_key.isEmpty())
                 	{
                 		for each  data_key in data_json.keys()
                 		{
                 			if(!data_required_keys.contains(data_key))
                 			{
                 				msg = "Not valid key of 'data' object is found: " + data_json.get(data_key);
                 				info msg;
                 				return msg;
                 			}
                 			// Validate enterprise key
                 			else if(data_key == "enterprise")
                 			{
                 				if(isNull(data_json.get("enterprise")) || !isText(data_json.get("enterprise")))
                 				{
                 					// Handle validation error for 'enterprise'
                 					msg = "'enterprise' key is empty or not a string.";
                 					info msg;
                 					return msg;
                 				}
                 			}
                 			// Validate print obj
                 			else if(data_key == "print")
                 			{
                 				// === Validate 'print' object ===
                 				// utility to validate map type
                 				isPrintMap = false;
                 				try 
                 				{
                 					tmp = data_json.get("print").toMap();
                 					isPrintMap = true;
                 				}				catch (e)
                 				{
                 				}
                 				// validate print obj
                 				if(isEmpty(data_json.get("print")) || !isPrintMap)
                 				{
                 					// Handle validation error for 'print'
                 					msg = "'print' key is empty or not a map.";
                 					info msg;
                 					return msg;
                 				}
                 				else if(!isEmpty(data_json.get("print")))
                 				{
                 					// Handle validation error for 'print' keys
                 					print_obj = data_json.get("print");
                 					print_required_keys = {"label","labelbag","awbhbl","billing"};
                 					// check required keys in print obj
                 					print_missed_key = thisapp.solvedc.checkMissedKeys(data_json.get("print"),print_required_keys);
                 					if(!print_missed_key.isEmpty())
                 					{
                 						msg = "'print' object has missed keys: " + print_missed_key;
                 						info msg;
                 						return msg;
                 					}
                 					else if(print_missed_key.isEmpty())
                 					{
                 						if(data_json.get("print").get("label") != true && data_json.get("print").get("label") != false)
                 						{
                 							msg = "'label' key on 'print' object is empty or not a boolean.";
                 							info msg;
                 							return msg;
                 						}
                 						if(data_json.get("print").get("labelbag") != true && data_json.get("print").get("labelbag") != false)
                 						{
                 							msg = "'labelbag' key on 'print' object is empty or not a boolean.";
                 							info msg;
                 							return msg;
                 						}
                 						if(data_json.get("print").get("awbhbl") != true && data_json.get("print").get("awbhbl") != false)
                 						{
                 							msg = "'awbhbl' key on 'print' object is empty or not a boolean.";
                 							info msg;
                 							return msg;
                 						}
                 						if(data_json.get("print").get("billing") != true && data_json.get("print").get("billing") != false)
                 						{
                 							msg = "'billing' key on 'print' object is empty or not a boolean.";
                 							info msg;
                 							return msg;
                 						}
                 					}
                 				}
                 			}
                 			// Validate reserve obj
                 			else if(data_key == "reserve")
                 			{
                 				// === Validate 'print' object ===
                 				// utility to validate map type
                 				isReserveMap = false;
                 				try 
                 				{
                 					tmp = data_json.get("reserve").toMap();
                 					isReserveMap = true;
                 				}				catch (e)
                 				{
                 				}
                 				// validate reserve obj
                 				if(isEmpty(data_json.get("reserve")) || !isReserveMap)
                 				{
                 					// Handle validation error for 'reserve'
                 					msg = "'reserve' key is empty or not a map.";
                 					info msg;
                 					return msg;
                 				}
                 				else if(!isEmpty(data_json.get("reserve")))
                 				{
                 					// Handle validation error for 'print' keys
                 					reserve_required_keys = {"createdby","typecorrespond","noorder","clasification"};
                 					// check required keys in reserve obj
                 					reserve_missed_key = thisapp.solvedc.checkMissedKeys(data_json.get("reserve"),reserve_required_keys);
                 					if(!reserve_missed_key.isEmpty())
                 					{
                 						msg = "'reserve' object has missed keys: " + reserve_missed_key;
                 						info msg;
                 						return msg;
                 					}
                 					else if(reserve_missed_key.isEmpty())
                 					{
                 						if(!isText(data_json.get("reserve").get("createdby")) || isEmpty(data_json.get("reserve").get("createdby")))
                 						{
                 							msg = "'createdby' key on 'reserve object' is empty or not a string.";
                 							info msg;
                 							return msg;
                 						}
                 						if(!isText(data_json.get("reserve").get("typecorrespond")) || isEmpty(data_json.get("reserve").get("typecorrespond")))
                 						{
                 							msg = "'typecorrespond' key on 'reserve' object is empty or not a string.";
                 							info msg;
                 							return msg;
                 						}
                 						else if(!isEmpty(data_json.get("reserve").get("typecorrespond")))
                 						{
                 							typecorrespond_values = {"air","fbc","mail"};
                 							if(!typecorrespond_values.contains(data_json.get("reserve").get("typecorrespond")))
                 							{
                 								msg = "'typecorrespond' key has a wrong value, right values: 'air','fbc','mail'.";
                 								info msg;
                 								return msg;
                 							}
                 						}
                 						if(!isText(data_json.get("reserve").get("noorder")) || isEmpty(data_json.get("reserve").get("noorder")))
                 						{
                 							msg = "'noorder' key on 'reserve' object is empty or not a string.";
                 							info msg;
                 							return msg;
                 						}
                 						if(!isText(data_json.get("reserve").get("clasification")) || isEmpty(data_json.get("reserve").get("clasification")))
                 						{
                 							msg = "'clasification' key on 'reserve' object is empty or not a string.";
                 							info msg;
                 							return msg;
                 						}
                 					}
                 				}
                 			}
                 			else if(data_key == "shipper")
                 			{
                 				// === Validate 'print' object ===
                 				// utility to validate map type
                 				isShipperMap = false;
                 				try 
                 				{
                 					tmp = data_json.get("shipper").toMap();
                 					isShipperMap = true;
                 				}				catch (e)
                 				{
                 				}
                 				// validate shipper obj
                 				if(isEmpty(data_json.get("shipper")) || !isShipperMap)
                 				{
                 					// Handle validation error for 'shipper'
                 					msg = "'shipper' key is empty or not a map.";
                 					info msg;
                 					return msg;
                 				}
                 				else if(!isEmpty(data_json.get("shipper")))
                 				{
                 					shipper_required_keys = {"name","address","state","dockind","passport","phone","nacionality"};
                 					// check required keys in reserve obj
                 					shipper_missed_key = thisapp.solvedc.checkMissedKeys(data_json.get("shipper"),shipper_required_keys);
                 					if(!shipper_missed_key.isEmpty())
                 					{
                 						msg = "'shipper' object has missed keys: " + shipper_missed_key;
                 						info msg;
                 						return msg;
                 					}
                 					else if(shipper_missed_key.isEmpty())
                 					{
                 						// -- validate 'name' --
                 						if(!isText(data_json.get("shipper").get("name")) || isEmpty(data_json.get("shipper").get("name")))
                 						{
                 							msg = "'name' key on 'shipper object' is empty or not a string.";
                 							info msg;
                 							return msg;
                 						}
                 						// -- validate 'address' --
                 						if(!isText(data_json.get("shipper").get("address")) || isEmpty(data_json.get("shipper").get("address")))
                 						{
                 							msg = "'address' key on 'shipper object' is empty or not a string.";
                 							info msg;
                 							return msg;
                 						}
                 						// -- validate 'state' --
                 						if(!isText(data_json.get("shipper").get("state")) || isEmpty(data_json.get("shipper").get("state")))
                 						{
                 							msg = "'state' key on 'shipper object' is empty or not a string.";
                 							info msg;
                 							return msg;
                 						}
                 						// -- validate 'dockind' --
                 						dockind_values = {"Id","Pasaporte","Licencia"};
                 						if(!isText(data_json.get("shipper").get("dockind")) || isEmpty(data_json.get("shipper").get("dockind")))
                 						{
                 							msg = "'dockind' key on 'shipper object' is empty or not a string.";
                 							info msg;
                 							return msg;
                 						}
                 						else if(!dockind_values.contains(data_json.get("shipper").get("dockind")))
                 						{
                 							msg = "'dockind' has a wrong value, valid values:'Id','Pasaporte','Licencia'.";
                 							info msg;
                 							return msg;
                 						}
                 						// -- validate 'passport' --
                 						if(isEmpty(data_json.get("shipper").get("passport")))
                 						{
                 							msg = "'passport' key on 'shipper' object is empty.";
                 							info msg;
                 							return msg;
                 						}
                 						// -- validate 'passport' --
                 						if(!isText(data_json.get("shipper").get("passport")) && !isNumber(data_json.get("shipper").get("passport")))
                 						{
                 							msg = "'passport' key on 'shipper'' object is not a valid type.";
                 							info msg;
                 							return msg;
                 						}
                 						// -- validate 'phone' --
                 						if(!isNumber(data_json.get("shipper").get("phone")) || isEmpty(data_json.get("shipper").get("phone")))
                 						{
                 							msg = "'phone' key on 'shipper object' is empty or not a number.";
                 							info msg;
                 							return msg;
                 						}
                 						// -- validate 'nacionality' --
                 						if(!isText(data_json.get("shipper").get("nacionality")) || isEmpty(data_json.get("shipper").get("nacionality")))
                 						{
                 							msg = "'nacionality' key on 'shipper object' is empty or not a string.";
                 							info msg;
                 							return msg;
                 						}
                 					}
                 				}
                 			}
                 			else if(data_key == "consignee")
                 			{
                 				// === Validate 'consignee' object ===
                 				// utility to validate map type
                 				isConsigneeMap = false;
                 				try 
                 				{
                 					tmp = data_json.get("consignee").toMap();
                 					isConsigneeMap = true;
                 				}				catch (e)
                 				{
                 				}
                 				// validate consignee obj
                 				if(isEmpty(data_json.get("consignee")) || !isConsigneeMap)
                 				{
                 					// Handle validation error for 'reserve'
                 					msg = "'consignee' key is empty or not a map.";
                 					info msg;
                 					return msg;
                 				}
                 				else if(!isEmpty(data_json.get("consignee")))
                 				{
                 					consignee_required_keys = {"firstname","surname","sndsurname","identity","nacionality","telephone","street","province","municipality"};
                 					// check required keys in reserve obj
                 					consignee_missed_key = thisapp.solvedc.checkMissedKeys(data_json.get("consignee"),consignee_required_keys);
                 					if(!consignee_missed_key.isEmpty())
                 					{
                 						msg = "'consignee' object has missed keys: " + consignee_missed_key;
                 						info msg;
                 						return msg;
                 					}
                 					else if(consignee_missed_key.isEmpty())
                 					{
                 						if(!isText(data_json.get("consignee").get("firstname")) || isEmpty(data_json.get("consignee").get("firstname")))
                 						{
                 							msg = "'firstname' key on 'consignee object' is empty or not a string.";
                 							info msg;
                 							return msg;
                 						}
                 						if(!isText(data_json.get("consignee").get("surname")) || isEmpty(data_json.get("consignee").get("surname")))
                 						{
                 							msg = "'surname' key on 'consignee object' is empty or not a string.";
                 							info msg;
                 							return msg;
                 						}
                 						if(!isText(data_json.get("consignee").get("sndsurname")) || isEmpty(data_json.get("consignee").get("sndsurname")))
                 						{
                 							msg = "'sndsurname' key on 'consignee object' is empty or not a string.";
                 							info msg;
                 							return msg;
                 						}
                 						if(isEmpty(data_json.get("consignee").get("identity")))
                 						{
                 							msg = "'identity' key on 'consignee object' is empty.";
                 							info msg;
                 							return msg;
                 						}
                 						if(!isText(data_json.get("consignee").get("nacionality")) || isEmpty(data_json.get("consignee").get("nacionality")))
                 						{
                 							msg = "'nacionality' key on 'consignee object' is empty or not a string.";
                 							info msg;
                 							return msg;
                 						}
                 						if(!isNumber(data_json.get("consignee").get("telephone")) || isEmpty(data_json.get("consignee").get("telephone")))
                 						{
                 							msg = "'telephone' key on 'consignee object' is empty or not a number.";
                 							info msg;
                 							return msg;
                 						}
                 						if(!isText(data_json.get("consignee").get("street")) || isEmpty(data_json.get("consignee").get("street")))
                 						{
                 							msg = "'street' key on 'consignee object' is empty or not a string.";
                 							info msg;
                 							return msg;
                 						}
                 						if(!isText(data_json.get("consignee").get("province")) || isEmpty(data_json.get("consignee").get("province")))
                 						{
                 							msg = "'province' key on 'consignee object' is empty or not a string.";
                 							info msg;
                 							return msg;
                 						}
                 						if(!isText(data_json.get("consignee").get("municipality")) || isEmpty(data_json.get("consignee").get("municipality")))
                 						{
                 							msg = "'municipality' key on 'consignee object' is empty or not a string.";
                 							info msg;
                 							return msg;
                 						}
                 					}
                 				}
                 			}
                 			else if(data_key == "goods")
                 			{
                 				// Validate 'goods' object
                 				// utility
                 				isGoodsMap = false;
                 				try 
                 				{
                 					tmp = data_json.get("goods").toMap();
                 					isGoodsMap = true;
                 				}				catch (e)
                 				{
                 				}
                 				// validate goods
                 				if(isEmpty(data_json.get("goods")) || !isGoodsMap)
                 				{
                 					// Handle validation error for 'goods'
                 					msg = "'goods' key is empty or not a map.";
                 					info msg;
                 					return msg;
                 				}
                 				else if(!isEmpty(data_json.get("goods")))
                 				{
                 					if(!data_json.get("goods").containKey("length") || isEmpty(data_json.get("goods").get("length")) || !isNumber(data_json.get("goods").get("length")))
                 					{
                 						msg = "'length' key on 'goods object' is missing, or empty, or not a number.";
                 						info msg;
                 						return msg;
                 					}
                 					if(!data_json.get("goods").containKey("0") || isEmpty(data_json.get("goods").get("0")))
                 					{
                 						// Handle validation error for 'goods'
                 						msg = "'0' key on 'goods object' is missing or empty.";
                 						info msg;
                 						return msg;
                 					}
                 					else if(!isEmpty(data_json.get("goods").get("0")))
                 					{
                 						// utility
                 						isProductsMap = false;
                 						try 
                 						{
                 							tmp = data_json.get("goods").get("0").toMap();
                 							isProductsMap = true;
                 						}						catch (e)
                 						{
                 						}
                 						if(!isProductsMap)
                 						{
                 							msg = "'0' key (product info) is not a map.";
                 							info msg;
                 							return msg;
                 						}
                 						else if(isProductsMap)
                 						{
                 							goods = data_json.get("goods");
                 							product_required_keys = {"namegood","namegoodc","quantity","weight","value","width","length","height","volume","weightvolume","priceshipping","priceproduct","deliverykind","customcharge","shippingkind"};
                 							// check required keys in '0' obj (a product)
                 							product_missed_key = thisapp.solvedc.checkMissedKeys(data_json.get("goods").get("0"),product_required_keys);
                 							if(!product_missed_key.isEmpty())
                 							{
                 								msg = "'0' object (product) has missed keys: " + product_missed_key;
                 								info msg;
                 								return msg;
                 							}
                 							else if(product_missed_key.isEmpty())
                 							{
                 								if(!isText(goods.get("0").get("namegood")) || isEmpty(goods.get("0").get("namegood")))
                 								{
                 									msg = "'namegood' key on '0' object (product) is empty or not a string.";
                 									info msg;
                 									return msg;
                 								}
                 								if(!isText(goods.get("0").get("namegoodc")))
                 								{
                 									msg = "'namegoodc' key on '0' object (product) is not a string.";
                 									info msg;
                 									return msg;
                 								}
                 								if(!isNumber(goods.get("0").get("quantity")) || isEmpty(goods.get("0").get("quantity")))
                 								{
                 									msg = "'quantity' key on '0' object (product) is empty or not a number.";
                 									info msg;
                 									return msg;
                 								}
                 								if(!isNumber(goods.get("0").get("weight")) || isEmpty(goods.get("0").get("weight")))
                 								{
                 									msg = "'weight' key on '0' object (product) is empty or not a string.";
                 									info msg;
                 									return msg;
                 								}
                 								if(!isNumber(goods.get("0").get("value")) || isEmpty(goods.get("0").get("value")))
                 								{
                 									msg = "'value' key on '0' object (product) is empty or not a number.";
                 									info msg;
                 									return msg;
                 								}
                 								if(!isNumber(goods.get("0").get("width")) || isEmpty(goods.get("0").get("width")))
                 								{
                 									msg = "'width' key on '0' object (product) is empty or not a number.";
                 									info msg;
                 									return msg;
                 								}
                 								if(!isNumber(goods.get("0").get("length")) || isEmpty(goods.get("0").get("length")))
                 								{
                 									msg = "'length' key on '0' object (product) is empty or not a number.";
                 									info msg;
                 									return msg;
                 								}
                 								if(!isNumber(goods.get("0").get("height")) || isEmpty(goods.get("0").get("height")))
                 								{
                 									msg = "'height' key on '0' object (product) is empty or not a number.";
                 									info msg;
                 									return msg;
                 								}
                 								if(!isNumber(goods.get("0").get("volume")) || isEmpty(goods.get("0").get("volume")))
                 								{
                 									msg = "'volume' key on '0' object (product) is empty or not a number.";
                 									info msg;
                 									return msg;
                 								}
                 								if(!isNumber(goods.get("0").get("weightvolume")) || isEmpty(goods.get("0").get("weightvolume")))
                 								{
                 									msg = "'weightvolume' key on '0' object (product) is empty or not a number.";
                 									info msg;
                 									return msg;
                 								}
                 								if(!isNumber(goods.get("0").get("priceshipping")) || isEmpty(goods.get("0").get("priceshipping")))
                 								{
                 									msg = "'priceshipping' key on '0' object (product) is empty or not a number.";
                 									info msg;
                 									return msg;
                 								}
                 								if(!isNumber(goods.get("0").get("priceproduct")) || isEmpty(goods.get("0").get("priceproduct")))
                 								{
                 									msg = "'priceproduct' key on '0' object (product) is empty or not a number.";
                 									info msg;
                 									return msg;
                 								}
                 								if(!isText(goods.get("0").get("deliverykind")) || isEmpty(goods.get("0").get("deliverykind")))
                 								{
                 									msg = "'deliverykind' key on '0' object (product) is empty or not a string.";
                 									info msg;
                 									return msg;
                 								}
                 								// Validate 'customcharge'
                 								if(!isText(goods.get("0").get("customcharge")) || isEmpty(goods.get("0").get("customcharge")))
                 								{
                 									msg = "'customcharge' key on '0' object (product) is empty or not a string.";
                 									info msg;
                 									return msg;
                 								}
                 								else if(!isEmpty(goods.get("0").get("customcharge")))
                 								{
                 									if(goods.get("0").get("customcharge") != "ORIGEN" && goods.get("0").get("customcharge") != "DESTINO")
                 									{
                 										msg = "'customcharge' key has a wrong value.";
                 										info msg;
                 										return msg;
                 									}
                 								}
                 								// Validate 'shippingkind'
                 								if(!isText(goods.get("0").get("shippingkind")) || isEmpty(goods.get("0").get("shippingkind")))
                 								{
                 									msg = "'shippingkind' key on '0' object (product) is empty or not a string.";
                 									info msg;
                 									return msg;
                 								}
                 								else if(!isEmpty(goods.get("0").get("shippingkind")))
                 								{
                 									if(goods.get("0").get("shippingkind") != "M" && goods.get("0").get("shippingkind") != "D")
                 									{
                 										msg = "'shippingkind' key has a wrong value, right values: 'M','D'.";
                 										info msg;
                 										return msg;
                 									}
                 								}
                 							}
                 						}
                 					}
                 				}
                 			}
                 		}
                 	}
                 	return msg;
                 }
			 }
		 }


		workflow
		{
		form
		{
			Set_Options_Book_Location as "Set_Options_Book_Locations"
			{
				type =  form
				form = Commercial_Office

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											org_id = "920092165";
										url_locations = "https://www.zohoapis.com/books/v3/locations?organization_id=" + org_id;
										//info "Usando URL: " + url_locations;
										response = invokeurl
										[
											url :url_locations
											type :GET
											connection:"zc_books"
										];
										if(response != null && response.get("locations") != null)
										{
											locations_list = response.get("locations");
											if(locations_list.size() > 0)
											{
												options_list = List();
												for each  loc in locations_list
												{
													name = loc.get("location_name");
													id = loc.get("location_id");
													if(name != null && id != null)
													{
														visible_and_saved = name + " - " + id;
														options_list.add(visible_and_saved);
														// Se ve y se guarda tal cual
													}
												}
												if(options_list.size() > 0)
												{
													input.Book_Location:ui.add(options_list);
													if(input.Book_Location != null)
													{
														input.Book_Location = input.Book_Location;
													}
												}
												else
												{
													openUrl("#Page:Error_Message?mensaje=There are no valid locations to upload.","popup window","height=143,width=380");
													//info "There are no valid locations to upload.";			}
												}
											}
											else
											{
												openUrl("#Page:Error_Message?mensaje=The list of locations is empty.","popup window","height=143,width=380");
												//info "The list of locations is empty.";
											}
										}
										else
										{
											openUrl("#Page:Error_Message?mensaje=The response does not contain 'locations' or is null.","popup window","height=143,width=380");
											//info "La respuesta no contiene 'locations' o es nula.";
										}
						)
					}
				}

			}
			Hide_Street_Field as "Hide_Street_Field"
			{
				type =  form
				form = Coverage_Location

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											hide Address_Information1.address_line_1;
										hide Address_Information1.district_city;
						)
					}
				}

			}
			Establish_Service_ID as "Establish_Service_ID"
			{
				type =  form
				form = Service

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Read system ID var
										currentID = thisapp.variables.SERVICE_ID;
										// Create new ID with zero-left-padding style
										serviceid = thisapp.zeroLeftPad(5,currentID);
										// Create the Service_Name
										input.Service_ID = "S " + serviceid;
										// Update ID var
										thisapp.variables.SERVICE_ID = thisapp.variables.SERVICE_ID + 1;
						)
					}
				}

			}
			Hide_Fields_Create_Edit as "Hide_Fields_Create&Edit"
			{
				type =  form
				form = Service

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											hide Service_ID;
										hide Office;
										hide Driver;
										hide NotCanBePackageDelete;
										hide Receiver_Contact;
										hide Created_by_Form;
										hide Ended_Packages;
										hide Temporal_Payment_Information;
										hide Signature_Image_by_Form;
										hide Transaction_Number;
										if(Service_Type != "Remittance" && Service_Type != "Recharge")
										{
											hide Commission;
											hide Transaction_Amount;
										}
										if(Insurance_Rejected == true)
										{
											show Signature;
											if(Created_by_Form == true)
											{
												show Signature_Image_by_Form;
											}
											else
											{
												hide Signature_Image_by_Form;
											}
										}
										else
										{
											hide Signature;
											if(Created_by_Form == true)
											{
												hide Signature_Image_by_Form;
											}
											else
											{
												hide Signature_Image_by_Form;
											}
										}
						)
					}
				}

			}
			Manage_SenderInformation as "Manage_SenderInformation"
			{
				type =  form
				form = Service

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Sender_Not_Found == false)
										{
											disable Sender_Full_Name;
											disable Sender_Mobile;
											enable Sender_field;
											disable Sender_DNI;
										}
										else if(input.Sender_Not_Found == true)
										{
											enable Sender_Full_Name;
											enable Sender_Mobile;
											disable Sender_field;
											enable Sender_DNI;
										}
						)
					}
				}

			}
			Set_Update_Office_Field as "Set&Update_Office_Field"
			{
				type =  form
				form = Service

				record event = on add or edit

				on user input of Employee
				{
					actions 
					{
						custom deluge script
						(
											RealOffice = Employee[ID == input.Employee].Office;
										input.Office = RealOffice;
						)
					}
				}

			}
			Show_SenderInformation_Fi as "Show_SenderInformation_Fields&Clear_Sender"
			{
				type =  form
				form = Service

				record event = on add or edit

				on user input of Sender_Not_Found
				{
					actions 
					{
						custom deluge script
						(
											if(input.Sender_Not_Found == true)
										{
											input.Sender_field = null;
											disable Sender_field;
											enable Sender_Full_Name;
											enable Sender_Mobile;
											hide Update_Sender;
											enable Sender_DNI;
										}
										else if(input.Sender_Not_Found == false)
										{
											enable Sender_field;
											disable Sender_Full_Name;
											disable Sender_Mobile;
											disable Sender_DNI;
											// las siguientes lineas pueden quitarse si a futuro no se puede filtrar por el campo integración al Contact del CRM
											input.Sender_Full_Name.first_name = null;
											input.Sender_Full_Name.last_name = null;
											input.Sender_Mobile = null;
											show Update_Sender;
										}
						)
					}
				}

			}
			Set_PackageFields1 as "Set_PackageFields"
			{
				type =  form
				form = Service

				record event = on add or edit

				on user input of Packages.Package_Name
				{
					actions 
					{
						custom deluge script
						(
											// Este script se ejecuta en la fila específica del subformulario donde se cambió Box_Name
										if(row.Package_Name != null)
										{
											show row.Package_ID;
											show row.Package_Type;
											show row.Status;
											show row.Receipt_Date;
											show row.Weight_in_pounds;
											show row.External_Tracking_Number;
											show row.Receiver;
											show row.Destination_Street;
											show row.Location;
											show row.Width_in_cm;
											show row.Length_in_cm;
											show row.Height_in_cm;
											show row.Volume;
											show row.Package_Material;
											show row.Shipment_Type;
											show row.Package_Price;
											RealPkg = Package[ID == row.Package_Name];
											row.Package_ID=RealPkg.Package_ID;
											row.Package_Type=RealPkg.Package_Type;
											row.Status=RealPkg.Status;
											row.Receipt_Date=RealPkg.Receipt_Date;
											row.External_Tracking_Number=RealPkg.Tracking_Number;
											if(RealPkg.Receiver_Contact != null)
											{
												row.Receiver=Contacts[ID == RealPkg.Receiver_Contact].CRM_Contact_ID.toLong();
											}
											else
											{
												row.Receiver=Contacts[ID == RealPkg.Receiver_Contact].CRM_Contact_ID;
											}
											row.Destination_Street=RealPkg.Street;
											row.Location=RealPkg.Location;
											row.Width_in_cm=RealPkg.Width_in;
											row.Length_in_cm=RealPkg.Length_in;
											row.Height_in_cm=RealPkg.Height_in;
											row.Weight_in_pounds=RealPkg.Total_Weight;
											row.Volume=RealPkg.Volume;
											row.Package_Material=RealPkg.Package_Material;
											row.Shipment_Type=RealPkg.Shipment_Type;
											row.Package_Price=RealPkg.Total_Price;
										}
						)
					}
				}

			}
