			Validate_Different_Countr as "Validate_Different_Countries"
			{
				type =  form
				form = Shipment

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Crear una lista para almacenar los países de cada RealLocation
										country_list = list();
										// Iterar por cada Location en el input
										for each  Location in input.Coverage_Locations
										{
											// Obtener el registro RealLocation según el ID
											RealLocation = Coverage_Location[ID == Location];
											// Agregar el país a la lista, si no es nulo
											if(RealLocation.Address_Information1.country != null)
											{
												country_list.add(RealLocation.Address_Information1.country);
											}
										}
										// Ahora verificar si hay más de un país distinto en la lista
										unique_countries = list();
										for each  c in country_list
										{
											if(!unique_countries.contains(c))
											{
												unique_countries.add(c);
											}
										}
										// Si la cantidad de países únicos es mayor a 1, hay diferencia
										if(unique_countries.size() > 1)
										{
											openUrl("#Page:Error_Message?mensaje=There cannot be Covered Locations with different Countries in the same Shipment record.","popup window","height=143,width=380");
											alert "There cannot be Covered Locations with different Countries in the same Shipment record.";
											cancel submit;
										}
						)
					}
				}

			}
