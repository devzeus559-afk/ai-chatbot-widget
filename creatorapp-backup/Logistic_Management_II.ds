			Update_PkgStatus_Departur as "Update_PkgStatus&DepartureDate"
			{
				type =  form
				form = Release

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Recorre cada fila del subformulario 'Shipment Details' del release actual
										for each  r in input.Shipment_Details
										{
											if(r.Package_ID != null)
											{
												// Obtiene el registro real del formulario 'Package'
												RealPkg = Package[ID == r.Package_ID];
												// Verifica que el registro fue encontrado (seguridad)
												if(RealPkg != null)
												{
													// Actualiza los campos directamente (los cambios se guardan automáticamente)
													RealPkg.Departure_Date=now;
													RealPkg.Status="Dispatched";
													RealPkg.Release=input.ID;
												}
											}
										}
						)
					}
				}

			}
