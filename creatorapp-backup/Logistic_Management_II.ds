			Set_ReceiverInformation as "Set_ReceiverInformation"
			{
				type =  form
				form = Package

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Service != null)
										{
											RealService = Service[ID == input.Service];
											for each  reci in RealService.Packages
											{
												recibe = reci.Receiver;
											}
											RealRecibe = Contacts[ID == recibe.toLong()];
											input.Receiver2:ui.add(RealRecibe.get("First_Name").get(0).get("first_name") + " " + RealRecibe.get(0).get("First_Name").get("last_name") + " - " + RealRecibe.get("Mobile"));
											input.Receiver2 = RealRecibe.get("First_Name").get(0).get("first_name") + " " + RealRecibe.get(0).get("First_Name").get("last_name") + " - " + RealRecibe.get("Mobile");
											//info RealRecibe.get("First_Name") + " " + RealRecibe.get("Last_Name") + " - " + RealRecibe.get("Mobile");
											input.Receiver_Contact = Contacts[CRM_Contact_ID == recibe].ID;
											input.Receipt_Date = RealService.Date_field1;
											input.Employee = RealService.Employee;
											input.Office = RealService.Office;
											input.Sender_field = RealService.Sender_field;
											input.Sender_Full_Name = RealService.Sender_Full_Name;
											input.Sender_Mobile = RealService.Sender_Mobile;
											input.Sender_Email = RealService.Sender_Email;
											input.Sender_Address = RealService.Sender_Address;
											input.Sender_DNI = RealService.Sender_DNI;
										}
										else if(input.Receiver_Contact != null)
										{
											search_result = Contacts[ID == input.Receiver_Contact];
											if(search_result != null)
											{
												// Completar los campos de nombre en el formulario usando los datos del contacto encontrado
												recivers_list = List();
												RealSender = Contacts[ID == input.Sender_field.toLong()];
												CRelations = Relations[Sender_field == input.Sender_field];
												Receivers = CRelations.Receivers;
												for each  Reco in Receivers
												{
													Rec = Contacts[ID == Reco];
													if(input.Receiver2 != Rec.First_Name.first_name + " " + Rec.First_Name.last_name + " - " + Rec.Mobile && Rec.Active == true)
													{
														recivers_list.add(Rec.First_Name.first_name + " " + Rec.First_Name.last_name + " - " + Rec.Mobile);
													}
												}
												recivers_list.add(RealSender.First_Name.first_name + " " + RealSender.First_Name.last_name + " - " + RealSender.Mobile);
												input.Receiver2:ui.add(recivers_list);
												input.Receiver2 = search_result.First_Name.first_name + " " + search_result.First_Name.last_name + " - " + search_result.Mobile;
												input.Receiver_Full_Name.first_name = search_result.First_Name.first_name;
												input.Receiver_Full_Name.last_name = search_result.First_Name.last_name;
												input.Receiver_Full_Name.suffix = search_result.First_Name.suffix;
												input.Receiver_DNI = search_result.ID;
												input.Receiver_Mobile = search_result.Mobile;
												RealLocation = Coverage_Location[Address_Information1.state_province == search_result.Address.state_province && Address_Information1.country == search_result.Address.country];
												input.Street = search_result.Address.address_line_1;
												input.City = search_result.Address.district_city;
												if(RealLocation.ID != null)
												{
													input.Location = RealLocation.ID;
												}
												else
												{
													newLocation = insert into Coverage_Location
													[
														Location_Name=search_result.Address.state_province + " - " + search_result.Address.country
														Address_Information1.state_province=search_result.Address.state_province
														Address_Information1.country=search_result.Address.country
														Added_User=zoho.loginuser
													];
													RealLocation = newLocation;
													input.Location = RealLocation;
												}
												//info "Receiver Assigned to a Contact with this Mobile";
												// Mensaje de confirmación en logs
											}
										}
										else if(input.Sender_field != null)
										{
											recivers_list = List();
											RealSender = Contacts[ID == input.Sender_field.toLong()];
											CRelations = Relations[Sender_field == input.Sender_field];
											Receivers = CRelations.Receivers;
											for each  Reco in Receivers
											{
												Rec = Contacts[ID == Reco];
												if(input.Receiver2 != Rec.First_Name.first_name + " " + Rec.First_Name.last_name + " - " + Rec.Mobile && Rec.Active == true)
												{
													recivers_list.add(Rec.First_Name.first_name + " " + Rec.First_Name.last_name + " - " + Rec.Mobile);
												}
											}
											recivers_list.add(RealSender.First_Name.first_name + " " + RealSender.First_Name.last_name + " - " + RealSender.Mobile);
											input.Receiver2:ui.add(recivers_list);
										}
						)
					}
				}

			}
			Update_CashFlows2 as "Update_CashFlows"
			{
				type =  form
				form = Service

				record event = on edit

				on user input of Office
				{
					actions 
					{
						custom deluge script
						(
											//Solo los no Approved
										/*if(input.Office != null)
																				{
																					RealCashFlows = Cash_Flow[Status == "Pending" && Office == input.Office];
																					clear Payment_Information.Cash_Flow;
																					for each  cflow in RealCashFlows
																					{
																						Payment_Information.Cash_Flow:ui.add(cflow.ID);
																					}
																				}
																				else
																				{
																					clear Payment_Information.Cash_Flow;
																				}*/
										//Solo los no Approved que tampoco exista uno con fecha posterior con valor Approved
										if(input.Office != null)
										{
											RealCashFlows = List();
											CandidateFlows = Cash_Flow[Status == "Pending" && Office == input.Office];
											clear Payment_Information.Cash_Flow;
											for each  cflow in CandidateFlows
											{
												// Buscar si existe algún CashFlow posterior que esté Approved
												LaterApproved = Cash_Flow[Office == input.Office && Status == "Approved" && Created_Date_Time > cflow.Created_Date_Time];
												// Si NO hay ninguno posterior aprobado, lo agregamos
												if(LaterApproved.Created_Date_Time == null)
												{
													RealCashFlows.add(cflow);
													Payment_Information.Cash_Flow:ui.add(cflow.ID);
												}
											}
										}
										else
										{
											clear Payment_Information.Cash_Flow;
										}
						)
					}
				}

			}
