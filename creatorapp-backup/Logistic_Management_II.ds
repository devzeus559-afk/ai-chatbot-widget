				 string removeWordAccent(string word)
                 {
                 	res = word.toLowerCase();
                 	if(res.contains("á"))
                 	{
                 		res = res.replaceAll("á","a");
                 		return res;
                 	}
                 	else if(res.contains("é"))
                 	{
                 		res = res.replaceAll("é","e");
                 		return res;
                 	}
                 	else if(res.contains("í"))
                 	{
                 		res = res.replaceAll("í","i");
                 		return res;
                 	}
                 	else if(res.contains("ó"))
                 	{
                 		res = res.replaceAll("ó","o");
                 		return res;
                 	}
                 	else if(word.contains("ú"))
                 	{
                 		res = res.replaceAll("ú","u");
                 		return res;
                 	}
                 	else
                 	{
                 		return word;
                 	}
                 }
				 collection syncPkgsTrackingInfo(int office_id, collection batch_idxs, string min_date)
                 {
                 	// params
                 	start_idx = batch_idxs.get("start");
                 	end_idx = batch_idxs.get("end");
                 	// fix min receipt date to limit the search
                 	min_receipt_date = if(min_date != null && min_date != "",min_date,"2026-01-01");
                 	// initialize response var
                 	updated = 0;
                 	unchanged = 0;
                 	error_msg = "";
                 	res = Collection("upd":updated,"unchg":unchanged,"error":error_msg);
                 	// review all dispatched packages, shipped to Cuba
                 	// ... get cuban loctions ids
                 	cuban_location_ids = Coverage_Location[Active == true && Address_Information1.country == "Cuba"].distinct(ID);
                 	// ... get selected dispatched boxes to cuban destination and not sync yet...
                 	selected_pkgs = Package[Package_Type == "Box" && Status == "Dispatched" && Office == office_id && Location in cuban_location_ids && Departure_Date != null && HBL != "" && Receipt_Date > min_receipt_date && Sync_Solved <= zoho.currentdate.subDay(1)] sort by ID range from start_idx to end_idx;
                 	// counter for logs
                 	counter = 1;
                 	for each  p in selected_pkgs
                 	{
                 		// Call Solved API to get tracking info
                 		hbl = "x" + p.HBL;
                 		if(!hbl.isBlank())
                 		{
                 			// 			info counter;
                 			api_solved_resp = thisapp.solvedc.getTrackingData(hbl.subString(1));
                 			solved_data = api_solved_resp.get("data");
                 			solved_error = api_solved_resp.get("error");
                 			// Update tracking stats
                 			if(!solved_data.isEmpty())
                 			{
                 				// apply update to tracking info and get stats
                 				upd_resp = thisapp.updatePkgTrackingInfo_2(hbl,solved_data);
                 				updated = updated + upd_resp.get("upd");
                 				unchanged = unchanged + upd_resp.get("unchg");
                 			}
                 			if(!solved_error.isBlank())
                 			{
                 				PkgRec = Package[HBL == solved_error.toString()];
                 				if(PkgRec != null)
                 				{
                 					PkgRec.Not_Found_in_Solved=true;
                 				}
                 				// error message for logs
                 				error_msg = error_msg + solved_error + ",";
                 				res.update("error",error_msg);
                 			}
                 			counter = counter + 1;
                 		}
                 	}
                 	// return result
                 	res.update("upd",updated);
                 	res.update("unchg",unchanged);
                 	return res;
                 }
				 void unlinkPackageFromRelease(int package_id, int release_id)
                 {
                 	// Getting release record
                 	RealRelease = Release[ID == release_id];
                 	// Transform subform to list<map> for calculate totals and subtotals
                 	subform = List();
                 	packages = Collection();
                 	if(RealRelease.Shipment_Details != null)
                 	{
                 		for each  r in RealRelease.Shipment_Details
                 		{
                 			// Remove package from release
                 			if(r.Package_ID != package_id)
                 			{
                 				new_pack = Release.Shipment_Details();
                 				new_pack = r;
                 				packages.insert(new_pack);
                 				// Populate packages list<map>
                 				Row1 = Map();
                 				// Assign lookup (Pass the record var, not the field)
                 				Row1.put("Package_ID",r.Package_ID.toLong());
                 				Row1.put("Package_Name",r.Package_Name);
                 				Row1.put("Package_Type",r.Package_Type);
                 				Row1.put("Sender_field",r.Sender1);
                 				Row1.put("Receiver",r.Receiver1);
                 				Row1.put("Status",r.Status);
                 				Row1.put("Location",r.Location);
                 				Row1.put("Receipt_Date",r.Receipt_Date);
                 				Row1.put("External_Tracking_Number",r.External_Tracking_Number);
                 				Row1.put("Destination_Street",r.Destination_Street);
                 				Row1.put("Total_Weight",r.Total_Weight);
                 				Row1.put("Shipping_Type",r.Shipping_Type);
                 				Row1.put("Package_Price",r.Package_Price);
                 				Row1.put("Customs_Duty",r.Customs_Duty);
                 				Row1.put("Service",r.Service.toLong());
                 				// Insert new subform row
                 				subform.add(Row1);
                 			}
                 		}
                 	}
                 	// ===================================================	
                 	if(!subform.isEmpty())
                 	{
                 		// === Update shipment details subform ===
                 		RealRelease.Shipment_Details.clear();
                 		RealRelease.Shipment_Details.insert(packages);
                 		// === Calculate totals by shipment details ===
                 		totals = Map();
                 		// Call function that calculate totals values from shipment details 
                 		totals = thisapp.getShipmentDetailsTotalsBySubform(subform);
                 		// Update totals fields
                 		RealRelease.Total_Boxes=totals.get("Total_Boxes");
                 		RealRelease.Total_Bags=totals.get("Total_Bags");
                 		RealRelease.Total_Docs=totals.get("Total_Docs");
                 		RealRelease.Total_Full_Packages=totals.get("Total_Full_Packages");
                 		RealRelease.Total_Pounds=totals.get("Total_Pounds");
                 		RealRelease.Total_Customs_Duty=totals.get("Total_Customs_Duty");
                 		// === Calculate subtotal rows by shipping types ===
                 		shipping_type_subs = Map();
                 		// Call function that generate subform values from shipment details 
                 		shipping_type_subs = thisapp.getShipmentTypesSubsBySubform(subform);
                 		// Clear subform records
                 		RealRelease.Subtotals_By_Shipping_Type.clear();
                 		// Populate subform
                 		shipping_types = List();
                 		shipping_types = shipping_type_subs.get("Shipping_Type");
                 		if(!shipping_types.isEmpty())
                 		{
                 			for each  r in shipping_types
                 			{
                 				SubtotalRow = Release.Subtotals_By_Shipping_Type();
                 				SubtotalRow.Shipping_Type=r.toString();
                 				SubtotalRow.Total_Packages=shipping_type_subs.get("Total_Packages").get(r);
                 				SubtotalRow.Total_Pounds=shipping_type_subs.get("Total_Pounds").get(r);
                 				RealRelease.Subtotals_By_Shipping_Type.insert(SubtotalRow);
                 			}
                 		}
                 		// === Calculate subtotal by shipments ===
                 		shipment_subs = Map();
                 		// Call function that generate subform values from shipment details 
                 		shipment_subs = thisapp.getShipmentSubsBySubform(subform);
                 		// Clear Subform
                 		RealRelease.Subtotal_by_Shipment.clear();
                 		// Populate subform
                 		shipment_types = Map();
                 		shipment_types = shipment_subs.get("Shipment_Type");
                 		if(shipment_types != null)
                 		{
                 			for each  s in shipment_types.keys()
                 			{
                 				subtotal_row = Release.Subtotal_by_Shipment();
                 				subtotal_row.Shipment_Type_ID=s;
                 				subtotal_row.Shipment_Type=shipment_types.get(s);
                 				subtotal_row.Quantity=shipment_subs.get("Quantity").get(s);
                 				subtotal_row.Unit_Price=shipment_subs.get("Unit_Price").get(s);
                 				subtotal_row.Total_Price=shipment_subs.get("Total_Price").get(s);
                 				RealRelease.Subtotal_by_Shipment.insert(subtotal_row);
                 			}
                 		}
                 	}
                 	else if(subform.isEmpty())
                 	{
                 		RealRelease.Shipment_Details.clear();
                 		RealRelease.Subtotals_By_Shipping_Type.clear();
                 		RealRelease.Subtotal_by_Shipment.clear();
                 	}
                 	// === Remove release reference ===
                 	RealPackage = Package[ID == package_id];
                 	if(RealPackage != null)
                 	{
                 		RealPackage.Status="Received";
                 		RealPackage.Release=null;
                 	}
                 }
				 collection updatePkgTrackingInfo_2(string hbl, collection solved_data)
                 {
                 	// 	init_t = zoho.currenttime;
                 	// get only HBL substring and cut "x" character used as a trick
                 	hbl = hbl.subString(1);
                 	upd = 0;
                 	unchg = 0;
                 	res = Collection("upd":upd,"unchg":unchg);
                 	latest_sync_status = "";
                 	last_sync_update = null;
                 	status_subform = Collection();
                 	// this Fx update tracking info in Package and Tracking_Info Forms
                 	// .. get solved data values
                 	if(solved_data != null)
                 	{
                 		// get guide value
                 		solved_guide = solved_data.get("guide");
                 		// get scan date value
                 		solved_scan_date = solved_data.get("dateshipped");
                 		// get scanned status value
                 		solved_scanned = solved_data.get("scanned");
                 		// get status history in Solved
                 		solved_status_list = solved_data.get("status");
                 		if(!solved_status_list.isEmpty())
                 		{
                 			// get last status and last update in Solved
                 			last_sync_update = solved_status_list.get(0).get("date").toDate();
                 			latest_sync_status = solved_status_list.get(0).get("status");
                 			// get status history collection
                 			for each  s in solved_status_list
                 			{
                 				new_row = Pkg_Tracking.Status_History();
                 				new_row.Status_Date=s.get("date");
                 				new_row.Status=s.get("status");
                 				status_subform.insert(new_row);
                 			}
                 		}
                 	}
                 	else
                 	{
                 		info "Solved data is empty!!!";
                 	}
                 	// Get current pack record
                 	PkgRec = Package[HBL == hbl];
                 	if(PkgRec != null)
                 	{
                 		// === Update Tracking Info Form ===
                 		// update guide field value
                 		guide = "";
                 		if(!solved_guide.isEmpty())
                 		{
                 			guide = solved_guide;
                 		}
                 		// update scanned status and scan date field values
                 		scan_date = null;
                 		if(!solved_scan_date.isEmpty())
                 		{
                 			scan_date = solved_scan_date.toDate();
                 		}
                 		scanned = false;
                 		if(solved_scanned == "1" || !solved_scan_date.isEmpty())
                 		{
                 			scanned = true;
                 		}
                 		// Get or create Tracking Info record
                 		TrackRecQty = Pkg_Tracking[HBL == hbl].count(HBL);
                 		// Set temporary status while is being updated in Solved
                 		tmp_dispatched_status = "En Proceso de Distribución";
                 		departure_date = PkgRec.Departure_Date;
                 		// if not found Solved status history
                 		if(status_subform.isempty())
                 		{
                 			// create a temp subform
                 			new_row1 = Pkg_Tracking.Status_History();
                 			new_row1.Status_Date=departure_date;
                 			new_row1.Status=tmp_dispatched_status;
                 			status_subform.insert(new_row1);
                 			// use temp status values
                 			last_sync_update = departure_date;
                 			latest_sync_status = tmp_dispatched_status;
                 		}
                 		// create a new record if not found
                 		if(TrackRecQty == 0)
                 		{
                 			// Get description of products
                 			description = thisapp.generateProductsDescByPkgId(PkgRec.ID);
                 			// create a new tracking info record
                 			new_track_pkg = insert into Pkg_Tracking
                 			[
                 				Package_ID=PkgRec.ID
                 				HBL=hbl
                 				Description=description
                 				Total_Price=PkgRec.Total_Price
                 				Office=PkgRec.Office
                 				Shipping_Type=PkgRec.Shipment_Type
                 				Scanned=scanned
                 				Scan_Date=scan_date
                 				Guide=guide
                 				Latest_Status=latest_sync_status
                 				Last_Updated=last_sync_update
                 				Last_Sync=zoho.currenttime
                 				Status_History=status_subform
                 				Added_User=zoho.loginuser
                 			];
                 			PkgRec.Sync_Solved=zoho.currentdate;
                 			PkgRec.Last_Solved_Update=null;
                 			PkgRec.Latest_Solved_Status="";
                 			PkgRec.Not_Found_in_Solved=false;
                 			upd = upd + 1;
                 			res.update("upd",upd);
                 		}
                 		// update the record if it was founded and it was updated ..
                 		else if(TrackRecQty > 0)
                 		{
                 			TrackRec = Pkg_Tracking[HBL == hbl];
                 			// get previous date value in LM2
                 			lm2_receipt_date = PkgRec.Receipt_Date;
                 			// set last update date if exist and set receipt date if not exist
                 			lm2_last_date = if(TrackRec.Last_Updated != null,TrackRec.Last_Updated.toString(),lm2_receipt_date.toString());
                 			// compare LM2 vs Solved status updates 
                 			elapsed_days = daysBetween(lm2_last_date.toDate(),last_sync_update.toDate());
                 			if(elapsed_days > 0)
                 			{
                 				// update guide
                 				if(guide != "")
                 				{
                 					TrackRec.Guide=guide;
                 				}
                 				// update scanned status and scan date
                 				if(scan_date != null)
                 				{
                 					TrackRec.Scan_Date=scan_date.toDate();
                 				}
                 				if(scanned == true)
                 				{
                 					TrackRec.Scanned=scanned;
                 				}
                 				// update latest status and last status update fields
                 				PkgRec.Last_Solved_Update=last_sync_update;
                 				PkgRec.Latest_Solved_Status=latest_sync_status;
                 				TrackRec.Last_Updated=last_sync_update.toDate();
                 				TrackRec.Latest_Status=latest_sync_status;
                 				// clean tracking subform
                 				TrackRec.Status_History.clear();
                 				// populate status tracking subform collection
                 				TrackRec.Status_History.insert(status_subform);
                 				// update stats
                 				upd = upd + 1;
                 				res.update("upd",upd);
                 			}
                 			else if(elapsed_days == 0)
                 			{
                 				// update stats
                 				unchg = unchg + 1;
                 				res.update("unchg",unchg);
                 			}
                 			// set syncronization date
                 			TrackRec.Last_Sync=zoho.currenttime;
                 			PkgRec.Sync_Solved=zoho.currentdate;
                 			PkgRec.Not_Found_in_Solved=false;
                 		}
                 		// Change package status if found the end status
                 		if(latest_sync_status == "Entregado al Cliente")
                 		{
                 			PkgRec.Status="Delivered";
                 		}
                 	}
                 	else
                 	{
                 		info "Package Not Found!!!";
                 	}
                 	// =====
                 	// 	dt = init_t.timeBetween(zoho.currenttime);
                 	// 	info "updatePkgTrackingInfo_2 exec_time: " + dt;
                 	// result
                 	return res;
                 }
				 string zeroLeftPad(int size, int number)
                 {
                 	// a zeros string with lenght = 'size' 
                 	zeros = " ".leftPad(size).replaceAll(" ","0");
                 	// a string with param 'number' padded with leading zeros 
                 	res = number.text(zeros);
                 	return res;
                 }
				 map chat_common.build_empty_report(date startDate, date endDate, string serviceType)
                 {
                 	// Reporte vacío (ventana sin datos o intersección vacía): customers: []
                 	// para que format_top_customers responda con el mensaje de "no encontré".	
                 	data = Map();
                 	data.put("reportType","top_customers");
                 	data.put("periodStart",startDate);
                 	data.put("periodEnd",endDate);
                 	data.put("serviceType",serviceType);
                 	data.put("totalServices",0);
                 	data.put("totalCustomers",0);
                 	data.put("truncated",false);
                 	data.put("customers",List());
                 	return {"ok":true,"data":data};
                 }
				 map chat_common.build_viz(String type, String title, List labels, List series)
                 {
                 	// --------------------------------------------------------------------------
                 	// Motor de visualización: construye el envelope JSON para el widget.
                 	// type: "bar" | "table" | "none" (decisión determinista, no-Zia).
                 	// labels: categorías para el eje X (e.g. ["Juan", "María", "Pedro"]).
                 	// series: [{name, values}] — una o más series de datos.
                 	// title: texto descriptivo del gráfico.
                 	// El widget recibe {text, visualization} y renderiza sin dependencias.
                 	// --------------------------------------------------------------------------	
                 	if(type == null || type == "")
                 	{
                 		type = "none";
                 	}
                 	viz = Map();
                 	viz.put("type",type);
                 	viz.put("title",title);
                 	viz.put("labels",labels);
                 	viz.put("series",series);
                 	return viz;
                 }
				 map chat_common.compose_reply(map toolResult, map intent)
                 {
                 	/**
                 	 * chat_common.deluge
                 	 *
                 	 * Helpers compartidos por el backend del chatbot.
                 	 * Funciones: append_criteria, parse_json_strict, compose_reply,
                 	 *            format_tracking, format_services, format_offices,
                 	 *            format_coverage, format_contacts, format_top_customers
                 	 */
                 	// --------------------------------------------------------------------------
                 	// Composición de respuestas por plantilla (default, sin segunda llamada Zia)
                 	// --------------------------------------------------------------------------	
                 	if(!toolResult.get("ok"))
                 	{
                 		return {"text":"No pude completar la búsqueda. " + toolResult.get("message"),"visualization":null};
                 	}
                 	toolName = intent.get("tool");
                 	data = toolResult.get("data");
                 	viz = toolResult.get("visualization");
                 	if(toolName == "track_package")
                 	{
                 		return {"text":thisapp.chat_common.format_tracking(data),"visualization":viz};
                 	}
                 	if(toolName == "search_services")
                 	{
                 		return {"text":thisapp.chat_common.format_services(data),"visualization":viz};
                 	}
                 	if(toolName == "find_offices")
                 	{
                 		return {"text":thisapp.chat_common.format_offices(data),"visualization":viz};
                 	}
                 	if(toolName == "check_coverage")
                 	{
                 		return {"text":thisapp.chat_common.format_coverage(data),"visualization":viz};
                 	}
                 	if(toolName == "find_contacts")
                 	{
                 		return {"text":thisapp.chat_common.format_contacts(data),"visualization":viz};
                 	}
                 	if(toolName == "report_top_customers")
                 	{
                 		return {"text":thisapp.chat_common.format_top_customers(data),"visualization":viz};
                 	}
                 	return {"text":"Datos obtenidos: " + data.toString(),"visualization":viz};
                 }
				 string chat_common.decidirVisualizacion(List labels, Bool esSerieTiempo)
                 {
                 	// Decide el tipo de visualización de forma determinista (sin Zia):
                 	// - breakdown vacío o 1 categoría → "none" (solo texto)
                 	// - ≤8 categorías, no serie temporal → "bar"
                 	// - ≥9 categorías → "table" (fallback seguro)	
                 	if(labels == null || labels.size() <= 1)
                 	{
                 		return "none";
                 	}
                 	if(esSerieTiempo != null && esSerieTiempo == true)
                 	{
                 		return "line";
                 		// fase 2; por ahora devuelve "line" y el widget ignora
                 	}
                 	if(labels.size() <= 8)
                 	{
                 		return "bar";
                 	}
                 	return "table";
                 }
				 string chat_common.envelope_to_json(string text, map viz)
                 {
                 	return "{\"text\":" + thisapp.chat_common.escape_json_str(text) + ",\"visualization\":" + thisapp.chat_common.viz_to_json(viz) + "}";
                 }
				 string chat_common.escape_json_str(string s)
                 {
                 	// --------------------------------------------------------------------------
                 	// Serialización JSON manual — Deluge Map.toString() NO produce JSON válido
                 	// (genera {key=value} en vez de {"key":"value"}). Esta función serializa
                 	// el envelope {text, visualization} a JSON válido para el widget.
                 	// --------------------------------------------------------------------------	
                 	if(s == null)
                 	{
                 		return "null";
                 	}
                 	result = "" + s;
                 	// 	result = result.replaceAll("\\","\\\\");
                 	result = result.replaceAll("\"","\\\"");
                 	result = result.replaceAll("\n","\\n");
                 	result = result.replaceAll("\r","\\r");
                 	result = result.replaceAll("\t","\\t");
                 	return '\"' + result + '\"';
                 }
				 string chat_common.format_contacts(list contacts)
                 {
                 	/**
                 	 * chat_common.deluge
                 	 *
                 	 * Helpers compartidos por el backend del chatbot.
                 	 * Funciones: append_criteria, parse_json_strict, compose_reply,
                 	 *            format_tracking, format_services, format_offices,
                 	 *            format_coverage, format_contacts
                 	 */
                 	if(contacts == null || contacts.size() == 0)
                 	{
                 		return "No encontré contactos con esos datos.";
                 	}
                 	text = "Contactos encontrados:\n";
                 	for each  c in contacts
                 	{
                 		line = "- " + c.get("fullName");
                 		if(c.get("role") != null)
                 		{
                 			line = line + " (" + c.get("role") + ")";
                 		}
                 		if(c.get("phone") != null)
                 		{
                 			line = line + ". Tel: " + c.get("phone");
                 		}
                 		if(c.get("email") != null)
                 		{
                 			line = line + ". Email: " + c.get("email");
                 		}
                 		text = text + line + "\n";
                 	}
                 	return text;
                 }
				 string chat_common.format_coverage(list coverage)
                 {
                 	if(coverage == null || coverage.size() == 0)
                 	{
                 		return "No encontré cobertura para esa búsqueda.";
                 	}
                 	text = "Cobertura disponible:\n";
                 	for each  c in coverage
                 	{
                 		line = "- " + c.get("country");
                 		if(c.get("serviceType") != null)
                 		{
                 			line = line + " (" + c.get("serviceType") + ")";
                 		}
                 		if(c.get("vendor") != null)
                 		{
                 			line = line + " - proveedor: " + c.get("vendor");
                 		}
                 		if(c.get("details") != null)
                 		{
                 			line = line + " - " + c.get("details");
                 		}
                 		text = text + line + "\n";
                 	}
                 	return text;
                 }
				 string chat_common.format_offices(list offices)
                 {
                 	/**
                 	 * chat_common.deluge
                 	 *
                 	 * Helpers compartidos por el backend del chatbot.
                 	 * Funciones: append_criteria, parse_json_strict, compose_reply,
                 	 *            format_tracking, format_services, format_offices,
                 	 *            format_coverage, format_contacts
                 	 */
                 	if(offices == null || offices.size() == 0)
                 	{
                 		return "No encontré oficinas que coincidan con la búsqueda.";
                 	}
                 	text = "Oficinas:\n";
                 	for each  o in offices
                 	{
                 		line = "- " + o.get("name");
                 		if(o.get("address") != null)
                 		{
                 			line = line + ", " + o.get("address");
                 		}
                 		if(o.get("city") != null)
                 		{
                 			line = line + ", " + o.get("city");
                 		}
                 		if(o.get("country") != null)
                 		{
                 			line = line + ", " + o.get("country");
                 		}
                 		if(o.get("phone") != null)
                 		{
                 			line = line + ". Tel: " + o.get("phone");
                 		}
                 		if(o.get("hours") != null)
                 		{
                 			line = line + ". Horario: " + o.get("hours");
                 		}
                 		text = text + line + "\n";
                 	}
                 	return text;
                 }
				 string chat_common.format_services(list services)
                 {
                 	/**
                 	 * chat_common.deluge
                 	 *
                 	 * Helpers compartidos por el backend del chatbot.
                 	 * Funciones: append_criteria, parse_json_strict, compose_reply,
                 	 *            format_tracking, format_services, format_offices,
                 	 *            format_coverage, format_contacts
                 	 */
                 	if(services == null || services.size() == 0)
                 	{
                 		return "No encontré servicios que coincidan con la búsqueda.";
                 	}
                 	text = "Servicios disponibles:\n";
                 	index = 1;
                 	for each  s in services
                 	{
                 		line = index + ". " + s.get("name") + " (" + s.get("type") + ")";
                 		if(s.get("price") != null && s.get("currency") != null)
                 		{
                 			line = line + " - " + s.get("price") + " " + s.get("currency");
                 		}
                 		if(s.get("estimatedTime") != null && s.get("estimatedTime") != "")
                 		{
                 			line = line + " - " + s.get("estimatedTime");
                 		}
                 		text = text + line + "\n";
                 		index = index + 1;
                 	}
                 	return text;
                 }
				 string chat_common.format_top_customers(map data)
                 {
                 	// --------------------------------------------------------------------------
                 	// Plantilla del reporte top customers (composeWithAI=false: los nombres y
                 	// conteos NUNCA se envían al LLM). El breakdown por tipo se omite cuando la
                 	// tool no emitió ninguno; con truncated: true se añade el aviso de ranking
                 	// aproximado (ventana > 200 servicios, se analizaron los primeros 200).
                 	// --------------------------------------------------------------------------	
                 	if(data == null)
                 	{
                 		return "No encontré servicios en los últimos 30 días.";
                 	}
                 	customers = data.get("customers");
                 	if(customers == null || customers.size() == 0)
                 	{
                 		return "No encontré servicios en los últimos 30 días.";
                 	}
                 	text = "Clientes más frecuentes (últimos 30 días):\n";
                 	for each  c in customers
                 	{
                 		line = c.get("rank") + ". " + c.get("customerName") + " — " + c.get("totalServices") + " servicios";
                 		breakdown = c.get("serviceBreakdown");
                 		if(breakdown != null && breakdown != "")
                 		{
                 			line = line + " (" + breakdown + ")";
                 		}
                 		text = text + line + "\n";
                 	}
                 	if(data.get("truncated") == true)
                 	{
                 		text = text + "Nota: el ranking es aproximado (se analizaron los primeros 200 servicios).\n";
                 	}
                 	return text;
                 }
				 string chat_common.format_tracking(map pkg)
                 {
                 	/**
                 	 * chat_common.deluge
                 	 *
                 	 * Helpers compartidos por el backend del chatbot.
                 	 * Funciones: append_criteria, parse_json_strict, compose_reply,
                 	 *            format_tracking, format_services, format_offices,
                 	 *            format_coverage, format_contacts
                 	 */
                 	if(pkg == null)
                 	{
                 		return "No encontré el paquete.";
                 	}
                 	text = "Paquete " + pkg.get("trackingNumber") + "\n";
                 	text = text + "Estado: " + pkg.get("status") + "\n";
                 	if(pkg.get("currentLocation") != null && pkg.get("currentLocation") != "")
                 	{
                 		text = text + "Ubicación actual: " + pkg.get("currentLocation") + "\n";
                 	}
                 	text = text + "Origen: " + pkg.get("origin") + "\n";
                 	text = text + "Destino: " + pkg.get("destination") + "\n";
                 	if(pkg.get("estimatedDelivery") != null && pkg.get("estimatedDelivery") != "")
                 	{
                 		text = text + "Entrega estimada: " + pkg.get("estimatedDelivery");
                 	}
                 	return text;
                 }
				 list chat_common.insert_ranked_entry(list list_param, int index_param, map entry)
                 {
                 	// Inserción indexada por shift-copy: List.add() solo appendea, así que se
                 	// reconstruye la lista con operaciones garantizadas (size/get/add). El
                 	// editor de Creator no expone add(index, value); si un día lo hiciera, este
                 	// helper puede reemplazarse por la llamada directa (ver smoke 6.1b).	
                 	result = List();
                 	if(index_param == null || index_param < 0)
                 	{
                 		index_param = 0;
                 	}
                 	if(index_param > list_param.size())
                 	{
                 		index_param = list_param.size();
                 	}
                 	for each index i in list_param
                 	{
                 		if(i == index_param)
                 		{
                 			result.add(entry);
                 		}
                 		result.add(list_param.get(i));
                 	}
                 	if(index_param >= list_param.size())
                 	{
                 		result.add(entry);
                 	}
                 	return result;
                 }
				 string chat_common.join_list(List items, String sep)
                 {
                 	// Join manual: concatena una List<String> con un separador
                 	result = "";
                 	for each  i in items
                 	{
                 		if(result == "")
                 		{
                 			result = "" + i;
                 		}
                 		else
                 		{
                 			result = result + sep + i;
                 		}
                 	}
                 	return result;
                 }
				 map chat_common.parse_json_strict(string text)
                 {
                 	/**
                 	 * chat_common.deluge
                 	 *
                 	 * Helpers compartidos por el backend del chatbot.
                 	 * Funciones: append_criteria, parse_json_strict, compose_reply,
                 	 *            format_tracking, format_services, format_offices,
                 	 *            format_coverage, format_contacts, format_top_customers
                 	 */
                 	try 
                 	{
                 		result = text.toMap();
                 	}	catch (e)
                 	{
                 		// text == null: toMap() lanza y no se puede operar sobre null
                 		if(text == null)
                 		{
                 			return {"parse_error":""};
                 		}
                 		startIndex = text.indexOf("{");
                 		endIndex = text.lastIndexOf("}");
                 		if(startIndex >= 0 && endIndex > startIndex)
                 		{
                 			candidate = text.subString(startIndex,endIndex + 1);
                 			try 
                 			{
                 				result = candidate.toMap();
                 			}			catch (e2)
                 			{
                 				result = {"parse_error":text};
                 			}
                 		}
                 	}
                 	return result;
                 }
				 string chat_common.series_to_json(map s)
                 {
                 	namePart = "\"name\":" + thisapp.chat_common.escape_json_str(s.get("name"));
                 	vals = List();
                 	v = s.get("values");
                 	if(v != null)
                 	{
                 		for each  item in v
                 		{
                 			vals.add("" + item.toString());
                 		}
                 	}
                 	return "{" + namePart + ",\"values\":[" + thisapp.chat_common.join_list(vals,",") + "]}";
                 }
				 string chat_common.viz_to_json(map viz)
                 {
                 	if(viz == null)
                 	{
                 		return "null";
                 	}
                 	result = "{";
                 	result = result + "\"type\":" + thisapp.chat_common.escape_json_str(viz.get("type"));
                 	result = result + ",\"title\":" + thisapp.chat_common.escape_json_str(viz.get("title"));
                 	// labels
                 	labels = viz.get("labels");
                 	labelParts = List();
                 	if(labels != null)
                 	{
                 		for each  l in labels
                 		{
                 			labelParts.add(thisapp.chat_common.escape_json_str("" + l));
                 		}
                 	}
                 	result = result + ",\"labels\":[" + thisapp.chat_common.join_list(labelParts,",") + "]";
                 	// series
                 	series = viz.get("series");
                 	seriesParts = List();
                 	if(series != null)
                 	{
                 		for each  s in series
                 		{
                 			seriesParts.add(thisapp.chat_common.series_to_json(s));
                 		}
                 	}
                 	result = result + ",\"series\":[" + thisapp.chat_common.join_list(seriesParts,",") + "]";
                 	result = result + "}";
                 	return result;
                 }
				 map chat_config.chat_config()
                 {
                 	/**
                  	* chat_config()
                  	*
                  	* Configuración central del backend del chatbot (paquetería internacional,
                  	* remesas y recargas telefónicas).
                  	*
                  	*/
                 	config = Map();
                 	// --- Módulos de persistencia del chat ---
                 	config.put("chatSessions","ChatSessions");
                 	config.put("chatMessages","ChatMessages");
                 	config.put("chatRequests","ChatRequests");
                 	// --- Composición de respuestas ---
                 	// false = plantillas deterministas (barato, rápido, recomendado).
                 	// true  = segunda llamada Zia para redactar respuestas naturales (más costo/latencia).
                 	config.put("composeWithAI",false);
                 	// --- Catálogo de herramientas para Zia ---
                 	tools = List();
                 	tool = Map();
                 	tool.put("name","track_package");
                 	tool.put("description","Busca el estado de un paquete por su número de seguimiento.");
                 	tool.put("params",{"trackingNumber":"string: número de seguimiento del paquete"});
                 	tools.add(tool);
                 	tool = Map();
                 	tool.put("name","search_services");
                 	tool.put("description","Lista los servicios disponibles. Filtros opcionales: tipo de servicio (Paquetería, Locker, Store, Remesa, Recarga, Online Store, Other Services), ciudad destino.  Si el usuario no especifica tipo, llama con params vacíos {} — NO pidas aclaración.");
                 	tool.put("params",{"serviceType":"string opcional","destination":"string opcional"});
                 	tools.add(tool);
                 	tool = Map();
                 	tool.put("name","find_offices");
                 	tool.put("description","Busca oficinas comerciales. Filtros opcionales: ciudad, país.  Si el usuario no especifica tipo, llama con params vacíos {} — NO pidas aclaración.");
                 	tool.put("params",{"city":"string opcional","country":"string opcional"});
                 	tools.add(tool);
                 	tool = Map();
                 	tool.put("name","check_coverage");
                 	tool.put("description","Consulta zonas cubiertas (Coverage_Location) por país y proveedores activos (Vendor) por tipo de servicio o nombre. Coverage_Location no modela vendor/service_type; los proveedores vienen del módulo Vendor (Vendor_Type coincide con Service.Service_Type).  Si el usuario no especifica tipo, llama con params vacíos {} — NO pidas aclaración.");
                 	tool.put("params",{"country":"string opcional","serviceType":"string opcional","vendor":"string opcional"});
                 	tools.add(tool);
                 	tool = Map();
                 	tool.put("name","find_contacts");
                 	tool.put("description","Busca contactos (remitente o receptor) por nombre, teléfono o documento.  Si el usuario no especifica tipo, llama con params vacíos {} — NO pidas aclaración.");
                 	tool.put("params",{"name":"string opcional","phone":"string opcional","document":"string opcional"});
                 	tools.add(tool);
                 	config.put("tools",tools);
                 	tool = Map();
                 	tool.put("name","report_top_customers");
                 	tool.put("description","Reporte de los clientes más frecuentes (top N) por cantidad de servicios en los últimos 30 días. Filtro opcional de tipo de servicio (valores exactos, sensibles a mayúsculas): Package Receipt, Locker, Store, Remittance, Recharge, Online Store, Other Services. Si el usuario no especifica tipo, llama con params vacíos {} — NO pidas aclaración, rankea TODOS los tipos.");
                 	tool.put("params",{"serviceType":"string opcional","limit":"string opcional"});
                 	tools.add(tool);
                 	// --- Catálogo de herramientas en texto legible (para el prompt de Zia) ---
                 	// Texto plano en vez de json.toJson (no reconocido por el editor de Creator).
                 	toolsText = "";
                 	for each  t in tools
                 	{
                 		toolsText = toolsText + "- " + t.get("name") + ": " + t.get("description");
                 		p = t.get("params");
                 		if(p != null && p.size() > 0)
                 		{
                 			toolsText = toolsText + " Params: " + p.toString();
                 		}
                 		toolsText = toolsText + "\n";
                 	}
                 	config.put("toolsText",toolsText);
                 	return config;
                 }
				 list chat_data_access.fetch_chat_messages_by_session(int sessionId)
                 {
                 	session_record = ChatSessions[ID == sessionId];
                 	sessionIdField = session_record.Session_ID;
                 	records_selected = ChatMessages[Session == sessionId] sort by Created_Time desc range from 0 to 9;
                 	records2 = Collection();
                 	for each  r in records_selected
                 	{
                 		// Access real field values instead of references
                 		recordData = {"ID":r.ID,"Role":r.Role,"Content":r.Content,"Created_Time":r.Created_Time,"Session":sessionIdField};
                 		records2.insert(recordData);
                 	}
                 	return records2;
                 }
				 list chat_data_access.fetch_chat_requests_by_id(int requestId)
                 {
                 	records_selected = ChatRequests[ID == requestId] sort by ID;
                 	records2 = Collection();
                 	for each  r in records_selected
