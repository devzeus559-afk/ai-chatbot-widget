					)
					}
				}
			}
		}



		batchworkflow
		{
			Upd_Tracking_Status_WNY_1
			{
    			display name = "Upd_Tracking_Status_WNY_11pm"
    			type = batchworkflow
    			form = Package[Status == "Dispatched" && Package_Type == "Box" && Office.Office_Name == "West New York" && Location.Location_Name.endsWith("Cuba") && HBL is not null && Receipt_Date > '02-Jan-2026']
    			event = "On Schedule"
    			start = "01-Jan-2026 23:00:00"
    			frequency = daily
    			batch size = 10
    			status = active
    			on execute 
    			{
					actions 
					{
						custom deluge script
						(
											hbl_text = "x" + input.HBL;
										// isValidHBL = matches(hbl_text,"CM[0-9]{9}[A-Z]{2}");
										// isValidAWB = matches(hbl_text,"[0-9]{10}");
										// Determine day of week
										current_day = zoho.currentdate.weekday();
										// Index of week days Monday, Wednesday & Friday
										mon_wed_fri_idx = {2,4,6};
										tue_thu_sat_idx = {3,5,7};
										// Get shipment type as criteria
										shipment_id = input.Shipment_Type;
										shipment_rec = Shipment[ID == shipment_id];
										// == Filter packages by shipment type and manage the execution by week days == //
										// .. Select Maritime Pkg to sync on Monday, Wednesday and Friday
