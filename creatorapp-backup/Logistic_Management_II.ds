													up_contact_map.put("Mailing_City",input.City);
													up_contact_map.put("Mailing_State",input.Location.Address_Information1.state_province);
													up_contact_map.put("Mailing_Country",input.Location.Address_Information1.country);
													up_contact_map.put("DNI",input.Receiver_DNI);
													if(search_result.Type_field == "Sender" || search_result.Type_field == "Sender & Receiver")
													{
														up_contact_map.put("Creator_Type","Sender & Receiver");
													}
													else
													{
														up_contact_map.put("Creator_Type","Receiver");
