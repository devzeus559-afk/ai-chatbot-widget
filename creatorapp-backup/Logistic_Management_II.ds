				displayname = "CRM Contact ID"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Location
			(
    			type = formula
				value =  input.Address.state_province + ", " + input.Address.country
				visibility = false
				display type = text
				format = plaintext
	 			row = 2
	 			column = 1   
				width = medium
			)
	
