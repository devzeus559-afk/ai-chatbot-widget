t><\/i><\/b><\/span><br /><\/td>\n     <\/tr>\n     <tr>\n      <td\n              style=\"border-right: 1px solid rgb(51, 51, 51)\"><br />\n        &nbsp;&nbsp;<span><font\n                style=\"font-size: 18px\"><b><i>NAME/NOMBRE:<\/i><\/b>&nbsp;<span>${Sender_Full_Name}<\/span><span\n                style=\"color: rgb(34, 35, 38); font-size: 18px; font-weight: 400; font-style: normal; text-decoration: none\">&nbsp;<\/span><br /><\/font><span><font\n                  style=\"font-size: 18px\"><span\n            style=\"color: rgb(34, 35, 38); font-family: &quot;Open Sans&quot;, sans-serif; font-size: 18px; font-weight: 400; font-style: normal; text-decoration: none\">&nbsp;<\/span><\/font><span><br /><\/span><br /><\/span><\/span><\/td>\n      <td>\n       <div\n              style=\"text-align: center\">\n        <span\n              style=\"font-size: inherit; background-color: transparent\">&nbsp;<\/span>\n       <\/div><span>\n        <div\n                style=\"text-align: left\">\n         <span\n                style=\"font-size: 18px; background-color: transparent\">&nbsp;<\/span><b\n                style=\"font-size: 18px; background-color: transparent\"><i>NAME/NOMBRE:<\/i><\/b><span\n                style=\"font-size: 18px; background-color: transparent\">&nbsp;<\/span><span\n                style=\"font-size: 18px; background-color: transparent\">${Receiver_Full_Name}<\/span><span\n              style=\"font-size: 18px; background-color: transparent\">&nbsp;<\/span>\n        <\/div><font\n                  style=\"font-size: 18px\"><br /><span>&nbsp; <b><i>ADDRESS/DIRECCIÓN:<\/i><\/b><br /><br />\n           &nbsp;&nbsp;<span\n                  style=\"color: rgb(34, 35, 38); font-weight: 400; font-style: normal; text-decoration: none\">${Street}<\/span><span\n                    style=\"color: rgb(34, 35, 38); font-weight: 400; font-style: normal; text-decoration: none\">&nbsp;,&nbsp;<span>${City}<\/span><span\n                      style=\"color: rgb(34, 35, 38); font-weight: 400; font-style: normal; text-decoration: none\">&nbsp;,&nbsp;<span>${Receiver_Contact.Location}<\/span><span\n                style=\"color: rgb(34, 35, 38); font-weight: 400; font-style: normal; text-decoration: none\">&nbsp;<\/span><\/span><\/span><br /><\/span><br />\n          &nbsp;&nbsp;<\/font><span><font\n                  style=\"font-size: 18px\"><b><i>PHONE/TELÉFONO:<\/i><\/b>&nbsp;<span>${Receiver_Mobile}<\/span><span style=\"color: rgb(34, 35, 38); font-weight: 400; font-style: normal; text-decoration: none\">&nbsp;<\/span><\/font><span><br /><br /><\/span><\/span><\/span><\/td>\n     <\/tr>\n    <\/tbody>\n   <\/table>\n   <br />\n  <\/div>"}},{"type":"spacer","element":{"id":"u_elem_2787246100000024","height":"20"}}]},{"colElements":[{"type":"spacer","element":{"id":"u_elem_958936","height":"87"}}]}]}},{"type":"columns","element":{"split":"3,94,3","id":"u_elem_2930405300000012","elemStyle":"","collayouts":[{"colElements":[{"type":"spacer","element":{"id":"u_elem_2935183600000024","height":"52"}}]},{"colElements":[{"id":"u_elem_153428396014394002","type":"lookupfields","element":{"valueStyle":"width: 50%; padding-left: 0px; text-align: center; border-width: 1px; border-style: solid; border-color: rgb(124, 124, 124)","valueTextStyle":"font-size: 18px","fieldLayoutType":"1","related_Form":"ZC_SUBFORM_45","labelText":"Products Details","wrapperStyle":"","labelStyle":"width: 50%; display: none","Label_Name":"Products_Details","refFields":[{"valueStyle":"text-align: center; background-color: rgba(0, 0, 0, 0)","fieldLayoutType":"2","labelText":"Qty","labelStyle":"color: rgb(255, 255, 255); font-weight: bold; font-style: italic; text-align: center; background-color: rgb(239, 130, 22)","Label_Name":"Qty"},{"valueStyle":"   text-align: center   ","fieldLayoutType":"2","labelText":"Product Name","labelStyle":"color: rgb(255, 255, 255); font-weight: bold; font-style: italic; text-align: center; background-color: rgb(239, 130, 22)","Label_Name":"Product_Name"},{"valueStyle":"   text-align: center   ","fieldLayoutType":"2","labelText":"Product Category","labelStyle":"color: rgb(255, 255, 255); font-weight: bold; font-style: italic; text-align: center; background-color: rgb(239, 130, 22)","Label_Name":"Product_Category"},{"valueStyle":"   text-align: center   ","fieldLayoutType":"2","labelText":"Product Price","labelStyle":"color: rgb(255, 255, 255); font-weight: bold; font-style: italic; text-align: center; background-color: rgb(239, 130, 22)","Label_Name":"Product_Price"}],"labelTextStyle":""}}]},{"colElements":[{"type":"spacer","element":{"id":"u_elem_2961359800000012","height":"52"}}]}]}},{"type":"columns","element":{"split":"100","id":"u_elem_3482089400000006","elemStyle":"","collayouts":[{"colElements":[{"type":"spacer","element":{"id":"u_elem_3482088900000006","height":"25"}}]}]}},{"type":"columns","element":{"split":"6,88,6","id":"u_elem_34868285","elemStyle":"","collayouts":[{"colElements":[{"type":"spacer","element":{"id":"u_elem_3491505900000006","height":"25"}}]},{"colElements":[{"type":"text","element":{"id":"u_elem_3486828100000024","fields":[],"content":"<div style=\"background: rgba(0, 0, 0, 0); padding: 0px\">\n   <p\n      style=\"text-align: left\"><font style=\"\" color=\"#7c7c7c\"><font\n        style=\"font-weight: 400; font-style: normal; font-size: 14px\">\u200b<\/font><font\n          style=\"font-size: 12px\"><i style=\"\"><b\n    style=\"\">DECLARACIÓN DE REMITENTE: YO/NOSOTROS, CERTIFICAMOS QUE HE/HEMOS CUMPLIDO CON TODAS LAS LEYES Y REGULACIONES APLICABLES A LA EXPORTACIÓN Y DEMÁS, DE LOS PAÍSES DONDE Y A TRAVÉS DE LOS CUALES PUEDAN PASAR LA(S) MERCANCÍA(S) ARRIBA CITADA(S), YO/NOSOTROS AUTORIZO/AUTORIZAMOS A LA EMPRESA TRANSPORTADORA PARA COMPLETAR EN MI/NUESTRO NOMBRE CUALQUIER DOCUMENTO REQUERIDO PARA CUMPLIR CON LAS LEYES Y REGULACIONES. POR LO TANTO, YO/NOSOTROS DESIGNAMOS A LA EMPRESA TRANSPORTADORA, O A SU REPRESENTANTE COMO CONSIGNATARIO ÚNICAMENTE EN EL PROPÓSITO DE DESIGNAR A UN AGENTE DE ADUANAS PARA EJECUTAR LOS TRAMITES DE ADUANA Y ENTRADA AL PAÍS DESTINO DE LA(S) MERCANCÍA(S) DESCRITAS EN ESTA DECLARACIÓN.&nbsp;<\/b><\/i><\/font><\/font><\/p>\n   <p\n      style=\"text-align: left\"><font style=\"font-size: 12px\"\n        color=\"#7c7c7c\"><i style=\"\"><b style=\"\">YO/NOSOTROS, CERTIFICAMOS QUE LA INFORMACIÓN PROPORCIONADA A LA EMPRESA TRANSPORTADORA, DE FORMA ORAL O EN ESTA DECLARACIÓN PRECISA, COMPLETA Y VERAZ. POR LO ANTERIOR YO/NOSOTROS ACUERDO/ACORDAMOS INDEMNIZAR Y ABSOLVER A LA EMPRESA TRANSPORTADORA POR CUALQUIER RECLAMACIÓN, OBLIGACIÓN O COSTO DEBIDO A MI/NUESTRO INCUMPLIMIENTO DE CUALQUIER LEY O REGULACIÓN APLICABLE EN EL PAÍS ORIGEN O DESTINO DE LA(S) MERCANCÍA(S) AMPARADAS CON LA GUÍA QUE SE INDICA EN ESTE DOCUMENTO.<\/b><\/i><\/font><\/p>\n  <\/div>"}}]},{"colElements":[{"type":"spacer","element":{"id":"u_elem_3507903900000006","height":"25"}}]}]}},{"type":"columns","element":{"split":"100","id":"u_elem_3662244900000006","elemStyle":"","collayouts":[{"colElements":[{"type":"spacer","element":{"id":"u_elem_3662244700000018","height":"25"}}]}]}},{"type":"columns","element":{"split":"2,96,2","id":"u_elem_3658504900000006","elemStyle":"","collayouts":[{"colElements":[{"type":"spacer","element":{"id":"u_elem_3669132","height":"25"}}]},{"colElements":[{"type":"text","element":{"Fields":[{"Label_Name":"Receipt_Date"}],"content":"<div style=\"background: rgba(0, 0, 0, 0); padding: 0px\">\n   <p\n      style=\"text-align: center; color: rgb(0, 0, 0); font-style: normal\"><font\n        style=\"\"><font style=\"font-size: 18px\"><b> <font\n      style=\"font-size: 18px\">\u200b<\/font>Date/Fecha:&nbsp;<\/b><\/font><\/font><span\n      style=\"background-color: rgba(0, 0, 0, 0); font-size: 18px\"><u>${Receipt_Date}<\/u><\/span><span style=\"background-color: rgba(0, 0, 0, 0); font-size: 18px; font-weight: 700\">&nbsp;<\/span><\/p>\n  <\/div>"}}]},{"colElements":[{"type":"spacer","element":{"id":"u_elem_3674182","height":"25"}}]}]}},{"type":"columns","element":{"split":"100","id":"u_elem_1884166800000012","elemStyle":"","collayouts":[{"colElements":[{"type":"spacer","element":{"id":"u_elem_1884166199999988","height":"40"}}]}]}}],"id":1}],"resize":"a4","themeFont":"opensans","isHeaderEnabled":false}
