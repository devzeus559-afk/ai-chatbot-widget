						)
					}
				}

			}
			on_submit_chatrequests as "on_submit_chatrequests"
			{
				type =  form
				form = ChatRequests

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											/**
										 * on_submit_chatrequests.deluge
										 *
										 * Script del workflow "On Submit" del módulo ChatRequests.
										 * El registro ya existe cuando corre el workflow; `input` trae el registro.
										 *
										 * chat_invoke() ya marca Status = answered si todo sale bien; este script
										 * atrapa fallos para no dejar solicitudes colgadas en "pending".
										 *
										 * Fallo = mutación en memoria de `input` (0 llamadas de API de Creator): el
										 * registro del workflow persiste automáticamente los cambios.
										 */
										requestId = input.ID;
										try 
										{
											result = thisapp.chat_invoke.chat_invoke(requestId);
											if(result.get("status") != "answered")
											{
												input.Status = "failed";
												input.Error = result.get("message");
											}
										}catch (e)
										{
											input.Status = "failed";
											input.Error = e.message;
										}
						)
					}
				}

			}
			EmailNotificationChangedS as "EmailNotificationChangedStatus"
			{
				type =  form
				form = Pkg_Tracking

				record event = on edit

				on update of Latest_Status
				{
					actions 
					{
						custom deluge script
						(
											newline = "<br> <br>";
										RealOffice = Commercial_Office[ID == input.Office];
										RealPkg = Package[ID == input.Package_ID];
										if(RealOffice.Office_Name == "Elizabeth" || RealOffice.Office_Name == "West New York" || RealOffice.Office_Name == "VAN")
										{
											telefono = "+1 (201) 502-3200";
										}
										else if(RealOffice.Office_Name == "New York")
										{
											telefono = "+1 (646) 530-6003";
										}
										else if(RealOffice.Office_Name == "MIAMI")
										{
											telefono = "+1 (786) 275-4393";
										}
										msg = "Estimado(a) " + RealPkg.Sender_Full_Name + ", " + newline;
										msg = msg + "Esperamos que se encuentre bien. " + newline;
										msg = msg + "Mediante este correo le notificamos que su paquete con el código " + RealPkg.Package_ID + " a presentado una actualización de estado. El estado actual de su paquete es \"" + input.Latest_Status + "\"." + newline;
										msg = msg + "Para su mayor comodidad, se pone a su disposición el sistema de Seguimiento de envíos, donde podrá consultar el estado de cada paquete utilizando el código correspondiente." + newline;
										msg = msg + "https://www.prontoenvios.us/tracking " + newline;
										msg = msg + "En caso de cualquier duda o si requiere alguna aclaración, será un placer poder asistirle. " + newline;
										msg = msg + "Con Pronto Envíos lo bueno llega Pronto y llega bien... " + newline;
										msg = msg + "Cordialmente, " + newline;
										msg = msg + "Agencia Pronto Envíos " + newline;
										msg = msg + "https://www.prontoenvios.us " + newline;
										msg = msg + telefono + newline;
										sendmail
										[
											from :"Pronto Envios <" + zoho.loginuserid + ">"
											to :RealPkg.Sender_Email
											subject :"Actualización de su envío – Pronto Envíos"
											message :msg
										]
						)
					}
				}

			}
		}

		schedule
		{
			Create_Daily_Cash_Flows as "Create_Daily_Cash_Flows"
			{
				type =  schedule
				start = "2025-08-25 00:01:10"
				frequency = daily
				time zone = "America/New_York"
				on start
				{
					actions 
					{
					on load
					(
						// Nombre sugerido: create_cash_flows_for_all_offices
										for each  office_record in Commercial_Office[Active == true]
										{
											// Obtener valores del registro de Commercial_Office
											office_id = office_record.ID;
											office_name = office_record.Office_Name;
											office_code = office_name.toUpperCase().substring(0,3);
											currentDateTime = zoho.currenttime;
											currentDate = zoho.currentdate;
											// Formar el Cash_Flow_ID con el formato requerido
											cash_flow_id = office_code + " - " + currentDateTime.toString("dd-MM-yyyy");
											// Buscar el Cash_Flow del día anterior para esta oficina
											yesterday = currentDate.addDay(-1);
											opening_balance = 0;
											matching_cash_flows = Cash_Flow[Office == office_id && Created_Date_Time == yesterday];
											if(matching_cash_flows.count() > 0)
											{
												// Si hay múltiples, tomar el último
												latest_flow = null;
												latest_datetime = null;
												for each  cf in matching_cash_flows
												{
													if(latest_flow == null || cf.Created_Date_Time >= latest_datetime)
													{
														latest_flow = cf;
														latest_datetime = cf.Created_Date_Time;
													}
												}
												opening_balance = latest_flow.Total_Petty_Cash;
											}
											// Crear el nuevo registro de Cash_Flows
											new_flow = insert into Cash_Flow
											[
												Cash_Flow_ID=cash_flow_id
												Office=office_id
												Status="Pending"
												Created_Date_Time=currentDateTime
												Opening_Balance=opening_balance
												Added_User=zoho.loginuser
											];
										}
					)
					}
				}
			}
			Check_Nulls_Senders_Recei as "Check_Nulls_Senders&Receivers_1PM"
			{
				type =  schedule
				start = "2026-01-29 13:00:00"
				frequency = daily
				time zone = "America/New_York"
				on start
				{
					actions 
					{
					on load
					(
						// get packs without Sender_field and Receiver_Contact lookups value
										invalid_pkgs = Package[ID != 0 && Status == "Received" && Sender_field == null || Receiver_Contact == null];
										// review this packs and update missing values
										senders_updated = 0;
										receivers_updated = 0;
										for each  pkg in invalid_pkgs
										{
											// update invalid senders
											if(pkg.Sender_field == null && pkg.Sender_Mobile != null)
											{
												pkg.Sender_field=Contacts[Mobile == pkg.Sender_Mobile].ID;
												senders_updated = senders_updated + 1;
											}
											// update invalid receivars
											if(pkg.Receiver_Contact == null && pkg.Receiver_Mobile != null)
											{
												pkg.Receiver_Contact=Contacts[Mobile == pkg.Receiver_Mobile].ID;
												receivers_updated = receivers_updated + 1;
											}
										}
										// logs
										info "Updated pack fields - Senders: " + senders_updated + " & Receivers: " + receivers_updated;
					)
					}
				}
			}
			Ckeck_Nulls_Senders_Recei as "Ckeck_Nulls_Senders&Receivers_6AM"
			{
				type =  schedule
				start = "2026-02-04 06:00:00"
				frequency = daily
				time zone = "America/New_York"
				on start
				{
					actions 
					{
					on load
					(
						// get packs without Sender_field and Receiver_Contact lookups value
										invalid_pkgs = Package[ID != 0 && Status == "Received" && Sender_field == null || Receiver_Contact == null];
										// review this packs and update missing values
										senders_updated = 0;
										receivers_updated = 0;
										for each  pkg in invalid_pkgs
										{
											// update invalid senders
											if(pkg.Sender_field == null && pkg.Sender_Mobile != null)
											{
												pkg.Sender_field=Contacts[Mobile == pkg.Sender_Mobile].ID;
												senders_updated = senders_updated + 1;
											}
											// update invalid receivars
											if(pkg.Receiver_Contact == null && pkg.Receiver_Mobile != null)
											{
												pkg.Receiver_Contact=Contacts[Mobile == pkg.Receiver_Mobile].ID;
												receivers_updated = receivers_updated + 1;
											}
										}
										// logs
										info "Updated pack fields - Senders: " + senders_updated + " & Receivers: " + receivers_updated;
					)
					}
				}
			}
			Upd_Pkgs_Status_Tracking_ as "Upd_Pkgs_Status_Tracking_NY_9PM"
			{
				type =  schedule
				start = "2026-01-01 21:00:00"
				frequency = daily
				time zone = "America/New_York"
				on start
				{
					actions 
					{
					on load
					(
						// === Execute task daily at 9:00pm ===
										init_t = zoho.currenttime;
										// get New York office ID
										ny_office_id = Commercial_Office[Office_Name == "New York"].ID sort by ID;
										// review all dispatched packages, shipped to Cuba
										// ... get cuban loctions ids
										cuban_location_ids = Coverage_Location[Active == true && Address_Information1.country == "Cuba"].distinct(ID);
										// ... get dispatched pkg ids list to cuban destination and not sync yet... 
										// fix min date to search
										MIN_DATE = "2026-01-02";
										pkgs_ids = Package[Package_Type == "Box" && Status == "Dispatched" && Office == ny_office_id && Location in cuban_location_ids && Departure_Date != null && HBL != "" && Receipt_Date > MIN_DATE && Sync_Solved <= zoho.currentdate.subDay(1)].distinct(ID);
										// ... get dispatched pkgs qty
										pkgs_qty = pkgs_ids.size();
										// ==== Batch processing ====
										// ... get batch params
										// define number of records by batch
										batch_size = 50;
										// initialize start index and batch iteration number 
										start_idx = 0;
										batch_number = 1;
										// create a aux structure (collection) to save start and end indexs by batch iteration
										batch_idxs = Collection();
										// populate aux structure
										for each index pkg_idx in pkgs_ids
										{
											// if it's last iteration
											if(pkgs_qty < batch_size || pkgs_qty - start_idx <= batch_size)
											{
												// end index is the last element
												end_idx = pkgs_qty;
												// determine start and end indexs
												idxs = Collection("start":start_idx,"end":end_idx);
												// asociates indexs to batch iteration
												batch_idxs.insert(batch_number.toString():idxs);
												// break loop
												break;
											}
											// if not the last iteration
											else if(pkgs_qty >= batch_size && pkg_idx % batch_size == 0)
											{
												// end index is the last element
												end_idx = start_idx + batch_size;
												// determine start and end indexs
												idxs = Collection("start":start_idx,"end":end_idx);
												// asociates indexs to batch iteration
												batch_idxs.insert(batch_number.toString():idxs);
												// increment start index
												start_idx = end_idx + 1;
												// increment batch number
												batch_number = batch_number + 1;
											}
										}
										// ... sync record by batches
										if(!batch_idxs.isEmpty())
										{
											upd = 0;
											unchg = 0;
											error = "";
											// sync New York office by batch (batch_size = 50)
											for each  x in batch_idxs.keys()
											{
												info x + "/";
												resp = thisapp.syncPkgsTrackingInfo(ny_office_id,batch_idxs.get(x),MIN_DATE);
												upd = upd + resp.get("upd").toNumber();
												unchg = unchg + resp.get("unchg").toNumber();
												if(resp.get("error") != null)
												{
													error = error + resp.get("error");
												}
											}
										}
										dt = timeBetween(init_t,zoho.currenttime);
										// ==== Batch processing ====
										info "== NY Stats == Time: " + dt + ", Upd: " + upd + ", Unchg: " + unchg + ", Error: " + error;
										// notify "SUCCESS", params: office_name, shipping_type_tag, errors_flag
										thisapp.createPkgsTrackingSyncNotification("New York","ALL",true);
					)
					}
				}
			}
