		form Relations
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Sender_field
			(
				type = picklist	
				displayname = "Sender"
				values  = Contacts[Type_field == "Sender" || Type_field == "Sender & Receiver"].ID
    			displayformat = [Mobile + " - " + First_Name.first_name + " " + First_Name.last_name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Receivers
			(
				type = list	
				values  = Contacts[Type_field == "Receiver" || (Type_field == "Sender & Receiver" && Active == true)].ID
    			displayformat = [Mobile + " - " + First_Name.first_name + " " + First_Name.last_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
