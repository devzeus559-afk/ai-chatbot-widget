										{
											api_solved_resp = thisapp.solvedc.getTrackingData(hbl_text.subString(1));
											solved_data = api_solved_resp.get("data");
											solved_error = api_solved_resp.get("error");
											// Update tracking stats
											if(!solved_data.isEmpty())
											{
												// apply update to tracking section and get stats
												upd_resp = thisapp.updatePkgTrackingInfo_2(hbl_text,solved_data);
											}
											// Mark pkgs if it not found by Solved
											if(!solved_error.isBlank())
											{
												info solved_error + ",";
												Pkg = Package[HBL == solved_error.toString()];
												if(Pkg != null)
												{
													Pkg.Not_Found_in_Solved=true;
												}
											}
										}
										// .. Select Air Pkg to sync on Tuesday, Thursday and Saturday
										else if(input.Departure_Date != null && shipment_rec.Short_Name.contains("Air") && current_day in tue_thu_sat_idx)
										{
											api_solved_resp = thisapp.solvedc.getTrackingData(hbl_text.subString(1));
											solved_data = api_solved_resp.get("data");
											solved_error = api_solved_resp.get("error");
											// Update tracking stats
											if(!solved_data.isEmpty())
											{
												// apply update to tracking section and get stats
												upd_resp = thisapp.updatePkgTrackingInfo_2(hbl_text,solved_data);
											}
											// Mark pkgs if it not found by Solved
											if(!solved_error.isBlank())
											{
												info solved_error + ",";
												Pkg = Package[HBL == solved_error.toString()];
												if(Pkg != null)
												{
													Pkg.Not_Found_in_Solved=true;
												}
											}
										}
						)
					}
    			}
    			on success 
    			{
					actions 
					{
						custom deluge script
						(
											info "SUCCESS";
										current_day = zoho.currentdate.weekday();
										// Index of week days Monday, Wednesday & Friday
										mon_wed_fri_idx = {2,4,6};
										// Index of week days Tuesday, Thursday & Saturday
										tue_thu_sat_idx = {3,5,7};
										if(current_day in mon_wed_fri_idx)
										{
											// notify
											thisapp.createPkgsTrackingSyncNotification("West New York","SEA",true);
										}
										else if(current_day in tue_thu_sat_idx)
										{
											// notify
											thisapp.createPkgsTrackingSyncNotification("West New York","AIR",true);
										}
						)
					}
    			}
    			on failure 
    			{
					actions 
					{
						custom deluge script
						(
											info "FAILURE";
										current_day = zoho.currentdate.weekday();
										// Index of week days Monday, Wednesday & Friday
										mon_wed_fri_idx = {2,4,6};
										// Index of week days Tuesday, Thursday & Saturday
										tue_thu_sat_idx = {3,5,7};
										// Filter by week days
										if(current_day in mon_wed_fri_idx)
										{
											// notify
											thisapp.createPkgsTrackingSyncNotification("West New York","SEA",false);
										}
										else if(current_day in tue_thu_sat_idx)
										{
											// notify
