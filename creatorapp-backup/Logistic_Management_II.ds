			must have Employee
			(
				type = picklist	
				values  = Employee[Active == true].ID
    			displayformat = [" " + Full_Name.prefix + " " + Full_Name.first_name + " " + Full_Name.last_name + " " + Full_Name.suffix]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Office
			(
				type = picklist	
				values  = Commercial_Office[Active == true].ID
    			displayformat = [Office_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Dispatch_Date
			(
    			type = date
				displayname = "Dispatch Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Destination_Country
			(
				type = picklist
				displayname = "Destination Country"
				maxchar = 100
				values = {"Choice 1"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Freight_Forwarder
			(
				type = picklist	
				displayname = "Freight Forwarder"
				values  = Vendor[Vendor_Type == "Freight Forwarder"].ID
    			displayformat = [Vendor_Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Transporter
			(
				type = picklist	
				values  = Vendor[Vendor_Type == "Transporter"].ID
    			displayformat = [Vendor_Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Was_Dispatched
			(
    			type = checkbox
				displayname = "Dispatched"
				initial value = false
	 			row = 1
	 			column = 2   
				width = medium
			)
			Section2
			(
				type = section
				displayname = "Add Multiple Items"
	 			row = 2
	 			column = 0   
				width = medium
			)
			Add_Multiple_Packages
			(
    			type = checkbox
				displayname = "Add Multiple Packages"
				initial value = false
	 			row = 2
	 			column = 1   
				width = medium
			)
			Service_Filter
			(
				type = picklist	
				displayname = "Service Filter"
				values  = Service[Office.ID == input.Office && Service_Type == "Package Receipt"].ID
    			displayformat = [Service_ID]
				sortorder = ascending
	 			row = 2
	 			column = 2   
				width = medium
			)
			Add_Packages_Option
			(
				type = radiobuttons
				displayname = "Choose Option"
				maxchar = 100
				values = {"Add","Remove"}
	 			row = 2
	 			column = 2   
				width = medium
			)
			Shipment_Details
			(
				type = grid
				displayname = "Shipment Details"
				auto width = false
				must have Package_ID
				(
					type = picklist	
					displayname = "Package ID"
					values  = Package.ID
    				displayformat = [Package_ID]
					sortorder = ascending
					width = 130px
				)
				must have Package_Name
				(
    				type = text
					displayname = "Package Name"
					width = 190px
				)
				Package_Type
				(
    				type = text
					displayname = "Package Type"
					width = medium
				)
				must have Status
				(
    				type = text
					width = 100px
				)
				Location
				(
					type = picklist	
					values  = Coverage_Location[Active == true].ID
    				displayformat = [Location_Name]
					sortorder = ascending
					width = 100px
				)
				Receipt_Date
				(
    				type = date
					displayname = "Receipt Date"
					alloweddays = 0,1,2,3,4,5,6
					width = 100px
				)
				External_Tracking_Number
				(
    				type = text
					displayname = "External Tracking Number"
					width = 100px
				)
				must have Sender1
				(
					type = picklist	
					displayname = "Sender"
					values  = Contacts[Type_field == "Sender"].ID
    				displayformat = [" " + First_Name.first_name + " " + First_Name.last_name + " - " + Mobile]
					sortorder = ascending
					width = medium
				)
				must have Receiver1
				(
					type = picklist	
					displayname = "Receiver"
					values  = Contacts[Type_field == "Receiver"].ID
    				displayformat = [" " + First_Name.first_name + " " + First_Name.last_name + " - " + Mobile]
					sortorder = ascending
					width = medium
				)
				Destination_Street
				(
    				type = text
					displayname = "Destination Street"
					width = 190px
				)
				Width_in_cm
				(
					type = decimal
					displayname = "Width in cm"
