			Validate_Different_Countr2 as "Validate_Different_Countries"
			{
				type =  form
				form = Vendor

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Recorrer todas las filas del subformulario
										//NOTA: Se deja solo para País y se comenta la validación de provincias
										for each  detail in input.Shipping_Details
										{
											locations = detail.Coverage_Locations;
											// Inicializar país y estado de referencia como vacíos
											ref_country = "";
											//ref_state = "";
											mismatch_found = false;
											for each  loc_id in locations
											{
												loc = Coverage_Location[ID == loc_id];
												// Tomar el país y estado del primer elemento como referencia
												if(ref_country == "")
												{
													ref_country = loc.Address_Information1.country;
													//ref_state = loc.Address_Information1.state_province;
												}
												else
												{
													// Comparar con los valores de referencia
													if(loc.Address_Information1.country != ref_country)
													{
														mismatch_found = true;
														break;
													}
												}
											}
											if(mismatch_found)
											{
												// Puedes usar alert, throw, info o error según contexto (por ejemplo en un on success)
												openUrl("#Page:Error_Message?mensaje=All Coverage Locations in a Shipping Detail row must belong to the same Country.","popup window","height=143,width=380");
												alert "All Coverage Locations in a Shipping Detail row must belong to the same Country.";
												cancel submit;
											}
										}
						)
					}
				}

			}
