			Set_Options_Book_Items_ID as "Set_Options_Book_Items_ID"
			{
				type =  form
				form = Book_Item

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											org_id = "920092165";
										per_page = 200;
										options_list = List();
										response = invokeurl
										[
											url :"https://www.zohoapis.com/books/v3/items?organization_id=" + org_id
											type :GET
											connection:"zc_books"
										];
										if(response != null && response.get("items") != null)
										{
											items_list = response.get("items");
											if(items_list.size() > 0)
											{
												for each  loc in items_list
												{
													name = loc.get("item_name");
													id = loc.get("item_id");
													status = loc.get("status");
													type = loc.get("item_type");
													p_type = loc.get("product_type");
													c_service = loc.get("cf_service");
													account_name = loc.get("account_name");
													/*if(name != null && !name.contains("Recogida") && !name.contains("Travel") && id != null && type == "sales_and_purchases" && c_service != "Tienda Virtual" && !c_service.contains("Viaje") && !c_service.contains("Cruceros") && !account_name.contains("Myenvio") && !account_name.contains("Travel") && !account_name.contains("Tramites") && !account_name.contains("Notaria") && !account_name.contains("Renta") && !account_name.contains("Seguro") && status != "inactive")*/
													if(name != null && id != null && type == "sales_and_purchases" && c_service != "Tienda Virtual" && !c_service.contains("Cruceros") && !account_name.contains("Myenvio") && status != "inactive")
													{
														//&& p_type == "service"
														visible_and_saved = name + " - " + id;
														options_list.add(visible_and_saved);
														//info loc;
														// Se ve y se guarda tal cual
													}
												}
											}
										}
										if(options_list.size() > 0)
										{
											//info options_list;
											input.Book_Item_ID:ui.add(options_list);
											if(input.Book_Item_ID != null)
											{
												input.Book_Item_ID = input.Book_Item_ID;
											}
										}
										else
										{
											openUrl("#Page:Error_Message?mensaje=There are no valid locations to upload.","popup window","height=143,width=380");
											//info "There are no valid locations to upload.";			}
										}
						)
					}
				}

			}
