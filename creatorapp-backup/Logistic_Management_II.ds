			Set_Options_Book_Vendors as "Set_Options_Book_Vendors"
			{
				type =  form
				form = Vendor

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											org_id = "920092165";
										per_page = 200;
										options_list = List();
										response = invokeurl
										[
											url :"https://www.zohoapis.com/books/v3/vendors?organization_id=" + org_id
											type :GET
											connection:"zc_books"
										];
										//info response;
										if(response != null && response.get("contacts") != null)
										{
											items_list = response.get("contacts");
											if(items_list.size() > 0)
											{
												for each  loc in items_list
												{
													name = loc.get("vendor_name");
													id = loc.get("contact_id");
													status = loc.get("status");
													type = loc.get("contact_type");
													if(name != null && id != null && type == "vendor" && status != "inactive")
													{
														//&& p_type == "service"
														visible_and_saved = name + " - " + id;
														options_list.add(visible_and_saved);
														//info loc;
														// Se ve y se guarda tal cual
													}
												}
											}
										}
										if(options_list.size() > 0)
										{
											//info options_list;
											input.Book_Vendor:ui.add(options_list);
											if(input.Book_Vendor != null)
											{
												input.Book_Vendor = input.Book_Vendor;
											}
										}
										else
										{
											openUrl("#Page:Error_Message?mensaje=There are no valid vendors to upload.","popup window","height=143,width=380");
											//info "There are no valid locations to upload.";
										}
						)
					}
				}

			}
