 application "Logistic Management II"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/New_York"
 	time format = "24-hr"

 	forms
	{
		form Book_Item
		{
			displayname = "Book Item"
			success message = "Book Item Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Service_Type
			(
				type = picklist
				displayname = "Service Type"
				maxchar = 100
				values = {"Package Receipt","Locker","Store","Remittance","Recharge","Online Store","Other Services"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			SubItem
			(
				type = picklist
				maxchar = 100
				values = {"Packaging","Custom Duty","Fit Credit Card","Insurance","Promotional Discount","Service Insurance","Pickup"}
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Book_Item_ID
			(
				type = picklist
				displayname = "Book Item ID"
				maxchar = 100
				values = {"None"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Book_Item_Name
			(
    			type = text
				displayname = "Book Item Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Enviar"
					)
					reset
					(
   						type = reset
   						displayname = "Restablecer"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Actualizar"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancelar"
					)
				}
			}
		}
		form Cash_Flow
		{
			displayname = "Cash Flow"
			success message = "Cash Flow Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Cash_Flow_ID
			(
    			type = text
				displayname = "Cash Flow ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Created_Date_Time
			(
    			type = datetime
				displayname = "Created Date-Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Opening_Balance
			(
				displayname = "Opening Balance"
				type = USD
				format = commadotwestern
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Office
			(
				type = picklist	
				values  = Commercial_Office.ID
    			displayformat = [Office_Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Pending","Approved"}
				initial value = "Pending"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Total_Informations
			(
				type = section
				displayname = "Total Informations"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Total_Incoming
			(
				displayname = "Total Incoming"
				type = USD
				format = commadotwestern
				initial value = 0
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Total_Outgoing
			(
				displayname = "Total Outgoing"
				type = USD
				format = commadotwestern
				initial value = 0
	 			row = 2
	 			column = 1   
				width = medium
			)
			Total_Petty_Cash
			(
    			type = formula
				displayname = "Total Petty Cash"
				value =  input.Opening_Balance + input.Total_Incoming - input.Total_Outgoing
				visibility = true
	 			row = 2
	 			column = 1   
				width = medium
			)
			Counting
			(
				type = section
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			must have Number_of_100_bills
			(
				type = number
				displayname = "Number of 100 bills"
				initial value = 0
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Number_of_50_bills
			(
				type = number
				displayname = "Number of 50 bills"
				initial value = 0
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Number_of_20_bills
			(
				type = number
				displayname = "Number of 20 bills"
				initial value = 0
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Number_of_10_bills
			(
				type = number
				displayname = "Number of 10 bills"
				initial value = 0
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Number_of_5_bills
			(
				type = number
				displayname = "Number of 5 bills"
				initial value = 0
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Number_of_1_bills
			(
				type = number
				displayname = "Number of 1 bills"
				initial value = 0
	 			row = 3
	 			column = 1   
				width = medium
			)
			Total_Amount_in_bills
			(
    			type = formula
				displayname = "Total Amount in bills"
				value =  if(Number_of_100_bills == null || Number_of_50_bills == null || Number_of_20_bills == null || Number_of_10_bills == null || Number_of_5_bills == null || Number_of_1_bills == null,"Number of bills fields cannot be empty",input.Number_of_100_bills * 100 + input.Number_of_50_bills * 50 + input.Number_of_20_bills * 20 + input.Number_of_10_bills * 10 + input.Number_of_5_bills * 5 + input.Number_of_1_bills * 1)
				visibility = true
				display type = text
				format = plaintext
	 			row = 3
	 			column = 1   
				width = medium
			)
			Difference
			(
    			type = formula
				value =  if(Number_of_100_bills == null || Number_of_50_bills == null || Number_of_20_bills == null || Number_of_10_bills == null || Number_of_5_bills == null || Number_of_1_bills == null,"Number of bills fields cannot be empty",input.Number_of_100_bills * 100 + input.Number_of_50_bills * 50 + input.Number_of_20_bills * 20 + input.Number_of_10_bills * 10 + input.Number_of_5_bills * 5 + input.Number_of_1_bills * 1) - (input.Opening_Balance + input.Total_Incoming - input.Total_Outgoing)
				visibility = true
				display type = text
				format = plaintext
	 			row = 3
	 			column = 1   
				width = medium
			)
			Related_Daily_Movements
			(
				type = grid
				displayname = "Related Daily Movements"
				Daily_Movement
				(
					type = picklist	
					displayname = "Daily Movement"
					values  = Daily_Movement.ID
    				displayformat = [Daily_Movement_ID]
					sortorder = ascending
					width = medium
				)
				Date_field
				(
    				type = date
					displayname = "Date"
					alloweddays = 0,1,2,3,4,5,6
					width = medium
				)
				Daily_Movement_Type
				(
					type = picklist
					displayname = "Daily Movement Type"
					maxchar = 100
					values = {"Incoming","Outgoing"}
					width = medium
				)
				Total_to_Pay
				(
					displayname = "Total to Pay"
					type = USD
					format = commadotwestern
					width = medium
				)
	 			row = 4
	 			column = 1   
				width = medium
			)
			Section1
			(
				type = section
				displayname = "Section"
	 			row = 5
	 			column = 0   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 100px
	 			row = 5
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Enviar"
					)
					reset
					(
   						type = reset
   						displayname = "Restablecer"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Actualizar"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancelar"
					)
				}
			}
		}
