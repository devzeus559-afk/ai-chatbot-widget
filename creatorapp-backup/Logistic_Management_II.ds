belStyle":"width: 50%; display: none","Label_Name":"Subtotals_By_Shipment","refFields":[{"fieldLayoutType":"2","labelText":"Shipment","labelStyle":"color: rgb(255, 255, 255); text-align: center; background-color: rgb(239, 130, 22)","Label_Name":"Shipment"},{"valueStyle":"text-align: center","fieldLayoutType":"2","labelText":"Total Packages","labelStyle":"color: rgb(255, 255, 255); text-align: center; background-color: rgb(239, 130, 22)","Label_Name":"Total_Packages"},{"fieldLayoutType":"2","labelText":"Total Pounds","labelStyle":"color: rgb(255, 255, 255); text-align: center; background-color: rgb(239, 130, 22)","Label_Name":"Total_Pounds"}],"labelTextStyle":""}}]},{"colElements":[{"type":"spacer","element":{"id":"u_elem_7981119400000006","height":"90"}}]}]}},{"type":"columns","element":{"split":"96,4","id":"u_elem_7447083799999997","elemStyle":"","collayouts":[{"colElements":[{"type":"spacer","element":{"id":"u_elem_5305829599999994","height":"15"}}]},{"colElements":[{"type":"spacer","element":{"id":"u_elem_4884235","height":"136"}}]}]}},{"type":"columns","element":{"split":"3,87,10","id":"u_elem_7451787200000003","elemStyle":"","collayouts":[{"colElements":[{"type":"spacer","element":{"id":"u_elem_9008778099999994","height":"123"}}]},{"colElements":[{"type":"columns","element":{"split":"100","id":"u_elem_8756615599999994","elemStyle":"","collayouts":[{"colElements":[{"type":"columns","element":{"split":"100","id":"u_elem_8991550099999994","elemStyle":"","collayouts":[{"colElements":[{"type":"spacer","element":{"id":"u_elem_8991549900000006","height":"40"}}]}]}}]}]}},{"type":"spacer","element":{"id":"u_elem_8741356400000006","height":"25"}},{"type":"columns","element":{"split":"47,53","id":"u_elem_7339636000000089","elemStyle":"","collayouts":[{"colElements":[{"type":"text","element":{"id":"u_elem_9561205","fields":[],"content":"<div style=\"background: rgba(0, 0, 0, 0); padding: 0px\">\n   <p\n      style=\"text-align: center; color: rgb(0, 0, 0); font-weight: 400; font-style: normal\"><font style=\"font-size: 14px\">Dispatched by (Employee):<\/font><\/p>\n  <\/div>"}},{"id":"u_elem_150821089525039179","type":"lookupfields","element":{"valueStyle":"width: 50%","valueTextStyle":"","fieldLayoutType":"1","related_Form":"Employee","labelText":"Employee","wrapperStyle":"","labelStyle":"width: 50%; text-align: center; display: none","Label_Name":"Employee","refFields":[{"valueStyle":"text-align: center; padding: 1.5em 2em","fieldLayoutType":"2","labelText":"Full Name","labelStyle":"text-align: center; display: none","Label_Name":"Full_Name"}],"labelTextStyle":""}}]},{"colElements":[{"type":"text","element":{"id":"u_elem_1014098200000003","fields":[],"content":"<div style=\"background: rgba(0, 0, 0, 0); padding: 0px\">\n   <p\n      style=\"text-align: center; color: rgb(0, 0, 0); font-weight: 400; font-style: normal\"><font style=\"font-size: 14px\">Received by (Transporter):<\/font><\/p>\n  <\/div>"}},{"id":"u_elem_150821089525048466","type":"lookupfields","element":{"valueStyle":"width: 50%; text-align: center","valueTextStyle":"","fieldLayoutType":"1","related_Form":"Vendor","labelText":"Transporter","wrapperStyle":"","labelStyle":"width: 50%; text-align: center; display: none","Label_Name":"Transporter","refFields":[{"valueStyle":"text-align: center; padding: 1.5em 2em","fieldLayoutType":"2","labelText":"Vendor Name","labelStyle":"text-align: center; display: none","Label_Name":"Vendor_Name"}],"labelTextStyle":""}}]}]}},{"type":"spacer","element":{"id":"u_elem_6626573000000119","height":"35"}},{"type":"text","element":{"id":"u_elem_7451786900000006","fields":[],"content":"<div style=\"background: rgba(0, 0, 0, 0); padding: 0px\">\n   <p\n      style=\"text-align: center; color: rgb(0, 0, 0); font-weight: 400; font-style: normal\"><font style=\"font-size: 16px\"><span> <span>Thank you for your business.<\/span> <\/span><\/font><\/p>\n  <\/div>"}}]},{"colElements":[{"type":"spacer","element":{"id":"u_elem_88272135","height":"87"}}]}]}},{"type":"columns","element":{"split":"100","id":"u_elem_7471269099999994","elemStyle":"","collayouts":[{"colElements":[{"type":"spacer","element":{"id":"u_elem_7471269","height":"25"}}]}]}}],"id":1}],"resize":"a4","themeFont":"opensans","isHeaderEnabled":false}
				}
			}
		}
		form Remittance
		{
			success message = "Remittance Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Name
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Destination_Country
			(
				type = picklist	
				displayname = "Destination Country"
				values  = Coverage_Location.ID
    			displayformat = [" " + Address_Information1.country]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Remittance_ID
			(
    			type = text
				displayname = "Remittance ID"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Profit
			(
				type = decimal
				initial value = 1.1
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Destination_Currency
			(
				type = picklist
				displayname = "Destination Currency"
				maxchar = 100
				values = {"USD","MLC","CUP","COP"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Currency_Exchange_Rate
			(
				type = decimal
				displayname = "Currency Exchange Rate"
				maxchar = 4
				initial value = 1
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Service
		{
			success message = "Service Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Service_Type
			(
				type = picklist
				displayname = "Service Type"
				maxchar = 100
				values = {"Package Receipt","Locker","Store","Remittance","Recharge","Online Store","Other Services"}
				initial value = "Package Receipt"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Service_Subtype
			(
				type = picklist	
				displayname = "Service Subtype"
				values  = Book_Item[Service_Type == input.Service_Type].ID
    			displayformat = [Book_Item_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Vendor
			(
				type = picklist	
				values  = Vendor[Vendor_Type == input.Service_Type && Active == true].ID
    			displayformat = [Vendor_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Created_by_Form
			(
    			type = checkbox
				displayname = "Created by Form"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Service_ID
			(
    			type = text
				displayname = "Service ID"
	 			row = 1
	 			column = 2   
				width = small
			)
			Employee
			(
				type = picklist	
				values  = Employee[Active == true && Office.Active == true].ID
    			displayformat = [" " + Full_Name.first_name + " " + Full_Name.last_name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = small
			)
			Driver
			(
    			type = text
	 			row = 1
	 			column = 2   
				width = medium
			)
			Office
			(
				type = picklist	
				values  = Commercial_Office.ID
    			displayformat = [Office_Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = small
			)
			must have Date_field1
			(
    			type = date
				displayname = "Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Contacts_Information
			(
				type = section
				displayname = "Contacts Information"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Sender_field
			(
				type = picklist	
				displayname = "Sender"
				values  = Contacts[Type_field == "Sender" || Type_field == "Sender & Receiver" && Active == true].ID
    			displayformat = [Mobile + "- " + First_Name.first_name + " " + First_Name.last_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Sender_Not_Found
			(
    			type = checkbox
				displayname = "Sender Not Found"
				initial value = false
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Sender_Full_Name
			(
    			type = name
				displayname = "Sender Full Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Sender_DNI
			(
    			type = text
				displayname = "Sender DNI"
	 			row = 2
	 			column = 1   
				width = 334px
			)
			must have Sender_Mobile
			(
    			type = phonenumber
				displayname = "Sender Mobile"
	 			row = 2
	 			column = 1   
				width = 334px
				personal data = true
			)
			Sender_Email
			(
    			type = email
				displayname = "Sender Email"
				maxchar = 80
	 			row = 2
	 			column = 1   
				width = 334px
				personal data = true
			)
			Sender_Address
			(
    			type = address
				displayname = "Sender Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Update_Sender
			(
    			type = checkbox
				displayname = "Update Sender Information"
				initial value = false
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Payer
			(
				type = radiobuttons
				maxchar = 100
				values = {"Sender","Receiver"}
				initial value = "Sender"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Receiver2
			(
				type = picklist
				displayname = "Receiver"
				maxchar = 100
				values = {"Select Option"}
	 			row = 2
	 			column = 2   
				width = medium
			)
			Receiver_Contact
			(
				type = picklist	
				displayname = "Receiver Contact"
				values  = Contacts.ID
    			displayformat = [Mobile + " - " + First_Name.first_name + " " + First_Name.last_name]
				sortorder = ascending
	 			row = 2
	 			column = 2   
				width = medium
			)
			Receiver_Not_Found
			(
    			type = checkbox
				displayname = "Receiver Not Found"
				initial value = false
	 			row = 2
	 			column = 2   
				width = medium
			)
			Receiver_Full_Name
			(
    			type = name
				displayname = "Receiver Full Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="First Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Second Last Name"
     			) 
	 			row = 2
	 			column = 2   
				width = medium
				personal data = true
			)
			Receiver_DNI
			(
    			type = text
				displayname = "Receiver DNI"
	 			row = 2
	 			column = 2   
				width = medium
			)
			Receiver_Mobile
			(
    			type = phonenumber
				displayname = "Receiver Mobile"
    			defaultcountry="cu"
	 			row = 2
	 			column = 2   
				width = medium
				personal data = true
			)
			Street
			(
    			type = text
	 			row = 2
	 			column = 2   
				width = medium
			)
			City
			(
    			type = text
	 			row = 2
	 			column = 2   
				width = medium
			)
			Location
			(
				type = picklist	
				displayname = "Province (State) - Country"
				values  = Coverage_Location[Active == true].ID
    			displayformat = [Address_Information1.state_province + " , " + Address_Information1.country]
				allow new entries
				[
					displayname = "Agregar nuevo"
				]
				sortorder = ascending
	 			row = 2
	 			column = 2   
				width = medium
			)
			Update_Receiver_Information
			(
    			type = checkbox
				initial value = false
	 			row = 2
	 			column = 2   
				width = medium
			)
			Section2
			(
				type = section
				displayname = "Section"
	 			row = 3
	 			column = 0   
				width = medium
			)
			Ended_Packages
			(
    			type = checkbox
				displayname = "Ended Packages"
				initial value = false
	 			row = 3
	 			column = 1   
				width = medium
			)
			Packages
			(
				type = grid
				auto width = false
				Package_Name
				(
					type = picklist	
					displayname = "Package Name"
					values  = Package.ID
    				displayformat = [Package_Name]
					allow new entries
					[
						displayname = "Agregar nuevo"
						set values
						(
							Receipt_Date = input.Receipt_Date
							Employee = input.Service_Employee
							Office = input.Service_Office
							Sender_field = input.Service_Sender
							Sender_Full_Name = input.Sender_Full_Name
							Sender_DNI = input.Sender_DNI
							Sender_Mobile = input.Sender_Mobile
							Sender_Email = input.Sender_Email
							Sender_Address = input.Sender_Address
						)
					]
					sortorder = ascending
					width = 220px
				)
				Package_ID
				(
    				type = text
					displayname = "Package ID"
					width = 110px
				)
				Package_Type
				(
					type = picklist
					displayname = "Package Type"
					maxchar = 100
					values = {"Box","Bag","Documents"}
					width = 200px
				)
				Status
				(
					type = picklist
					maxchar = 100
					values = {"Received","Dispatched","Delivered","Returned"}
					width = 150px
				)
				Receipt_Date
				(
    				type = date
					displayname = "Receipt Date"
					alloweddays = 0,1,2,3,4,5,6
					width = 110px
				)
				Weight_in_pounds
				(
					type = decimal
					displayname = "Weight in pounds"
					width = 75px
				)
				External_Tracking_Number
				(
    				type = text
					displayname = "External Tracking Number"
					width = 110px
				)
				Receiver
				(
					type = picklist	
					datasource = zohocrm_contacts
    				displayformat = [first_name + " " + last_name + " - " + mobile]
					width = 200px
				)
				Destination_Street
				(
    				type = text
					displayname = "Destination Street"
					width = 310px
				)
				Location
				(
					type = picklist	
					values  = Coverage_Location.ID
    				displayformat = [" " + Address_Information1.district_city + ",  " + Address_Information1.state_province + ",  " + Address_Information1.country]
					sortorder = ascending
					width = 280px
				)
				Width_in_cm
				(
					type = decimal
					displayname = "Width in cm"
					width = 75px
				)
				Length_in_cm
				(
					type = decimal
					displayname = "Length in cm"
					width = 75px
				)
				Height_in_cm
				(
					type = decimal
					displayname = "Height in cm"
					width = 75px
				)
				Volume
				(
					type = decimal
					width = 90px
				)
				Package_Material
				(
					type = picklist
					displayname = "Package Material"
					maxchar = 100
					values = {"Wood","Bag","Pallet","Crate","Envelope","Document"}
					width = 100px
				)
				Shipment_Type
				(
					type = picklist	
					displayname = "Shipment Type"
					values  = Shipment.ID
    				displayformat = [Short_Name]
					sortorder = ascending
					width = 250px
				)
				Package_Price
				(
					displayname = "Package Price"
					type = USD
					format = commadotwestern
					width = 90px
				)
				Service_Employee
				(
    				type = text
					displayname = "Service Employee"
					private = true
					width = 100px
				)
				Service_Office
				(
    				type = text
					displayname = "Service Office"
					private = true
					width = 110px
				)
				Service_Sender
				(
    				type = text
					displayname = "Service Sender"
					private = true
					width = 130px
				)
				Sender_Full_Name
				(
    				type = name
     				prefix
     				(
	     				 type = prefix
	     				 displayname ="Prefix"
	     				 visibility = false
	     				 value = {"Mr.","Mrs.","Ms."}
     				) 
     				first_name
     				(
	     				 type = first_name
	     				 displayname ="First Name"
     				) 
     				last_name
     				(
	     				 type = last_name
	     				 displayname ="Last Name"
     				) 
     				suffix
     				(
	     				 type = suffix
	     				 displayname ="Suffix"
	     				 visibility = false
     				) 
					private = true
					width = medium
					personal data = true
				)
				Sender_Mobile
				(
    				type = phonenumber
					displayname = "Sender Mobile"
					private = true
					width = 170px
					personal data = true
				)
				Sender_Email
				(
    				type = email
					displayname = "Sender Email"
					maxchar = 80
					private = true
					width = 200px
					personal data = true
				)
				Sender_Address
				(
    				type = address
					displayname = "Sender Address"
     				capture_coordinates = true
     				adjust_using_map = false
     				address_line_1
     				(
	     				  type = address_line_1
	     				  displayname = "Address Line 1"
     				) 
     				address_line_2
     				(
	     				  type = address_line_2
	     				  displayname = "Address Line 2"
     				) 
