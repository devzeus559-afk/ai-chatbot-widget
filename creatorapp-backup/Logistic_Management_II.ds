			Complete_SubtotalShipment1 as "Complete_SubtotalShipments"
			{
				type =  form
				form = Release

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// === Create auxiliar vars to populate subform ===
										shipment_types = Map();
										subtotal_quantity = Map();
										subtotal_unit_price = Map();
										subtotal_price = Map();
										// Calculate subtotals for packages
										if(input.Shipment_Details != null)
										{
											for each  r in input.Shipment_Details
											{
												RealPkg = Package[ID == r.Package_ID];
												// Getting real props of shipment
												RealShipment = Shipment[ID == RealPkg.Shipment_Type];
												shipment_id = RealShipment.ID.toString();
												shipment_name = RealShipment.Name;
												shipment_unit_price = ifnull(RealShipment.Total_Price,0.0);
												// Populate subtotal vars
												if(!shipment_types.containKey(shipment_id))
												{
													// Add shipment if not found in shipments collection
													shipment_types.put(shipment_id,shipment_name);
												}
												// Get increment value by weight 
												if(RealShipment.Price_Form == "By Weight")
												{
													quantity = ifnull(RealPkg.Total_Weight,0.0);
												}
												// Get increment value by volumetric weight
												else if(RealShipment.Price_Form == "By Volumetric weight")
												{
													quantity = ifnull(RealPkg.Volumetric_weight,0.0);
												}
												else if(RealShipment.Price_Form == "By Greater weight")
												{
													if(RealPkg.Total_Weight >= RealPkg.Volumetric_weight)
													{
														quantity = ifnull(RealPkg.Total_Weight,0.0);
													}
													else
													{
														quantity = ifnull(RealPkg.Volumetric_weight,0.0);
													}
												}
												// Get increment value by unit
												else if(RealShipment.Price_Form == "By Package")
												{
													quantity = 1;
												}
												// Accumulate quantity and total price
												accum_quantity = ifnull(subtotal_quantity.get(shipment_id),0.0) + quantity;
												total_price = accum_quantity * ifnull(RealShipment.Total_Price,0.0);
												// Update subtotals
												subtotal_quantity.put(shipment_id,accum_quantity);
												subtotal_unit_price.put(shipment_id,shipment_unit_price);
												subtotal_price.put(shipment_id,total_price);
											}
										}
										// Calculate subtotal by packages
										// Clear Subform
										input.Subtotal_by_Shipment.clear();
										// Populate subform
										if(shipment_types != null)
										{
											for each  s in shipment_types.keys()
											{
												subtotal_row = Release.Subtotal_by_Shipment();
												subtotal_row.Shipment_Type_ID=s;
												subtotal_row.Shipment_Type=shipment_types.get(s);
												subtotal_row.Quantity=subtotal_quantity.get(s);
												subtotal_row.Unit_Price=subtotal_unit_price.get(s);
												subtotal_row.Total_Price=subtotal_price.get(s);
												input.Subtotal_by_Shipment.insert(subtotal_row);
											}
										}
						)
					}
				}

			}
			Set_Update_SubtotalShipme1 as "Set&Update_SubtotalShipments"
			{
				type =  form
				form = Release

				record event = on add or edit

				on user input of Shipment_Details.Package_ID
				{
					actions 
					{
						custom deluge script
						(
											// === Create auxiliar vars to populate subform ===
										shipment_types = Map();
										subtotal_quantity = Map();
										subtotal_unit_price = Map();
										subtotal_price = Map();
										// Calculate subtotals for packages
										if(input.Shipment_Details != null && row.Package_ID != null)
										{
											for each  r in input.Shipment_Details
											{
												RealPkg = Package[ID == r.Package_ID];
												// Getting real props of shipment
												RealShipment = Shipment[ID == RealPkg.Shipment_Type];
												shipment_id = RealShipment.ID.toString();
												shipment_name = RealShipment.Name;
												shipment_unit_price = ifnull(RealShipment.Total_Price,0.0);
												// Populate subtotal vars
												if(!shipment_types.containKey(shipment_id))
												{
													// Add shipment if not found in shipments collection
													shipment_types.put(shipment_id,shipment_name);
												}
												// Get weight component by standard weight 
												if(RealShipment.Price_Form == "By Weight")
												{
													weight = ifnull(RealPkg.Total_Weight,0.0);
												}
												// Get weight component by volumetric weight
												else if(RealShipment.Price_Form == "By Volumetric weight")
												{
													weight = ifnull(RealPkg.Volumetric_weight,0.0);
												}
												else if(RealShipment.Price_Form == "By Greater weight")
												{
													if(RealPkg.Total_Weight >= RealPkg.Volumetric_weight)
													{
														weight = ifnull(RealPkg.Total_Weight,0.0);
													}
													else
													{
														weight = ifnull(RealPkg.Volumetric_weight,0.0);
													}
												}
												// Get weight component per unit
												else if(RealShipment.Price_Form == "By Package")
												{
													weight = 1;
												}
												// Accumulate quantity and total price
												accum = ifnull(subtotal_quantity.get(shipment_id),0.0) + weight;
												total_price = accum * shipment_unit_price;
												// Update subtotals
												subtotal_quantity.put(shipment_id,accum);
												subtotal_unit_price.put(shipment_id,shipment_unit_price);
												subtotal_price.put(shipment_id,total_price);
											}
										}
										// Clear subform
										input.Subtotal_by_Shipment.clear();
										// Populate subform
										if(shipment_types != null)
										{
											for each  s in shipment_types.keys()
											{
												subtotal_row = Release.Subtotal_by_Shipment();
												subtotal_row.Shipment_Type_ID=s;
												RealShip = Shipment[ID == s];
												subtotal_row.Shipment_ID=RealShip.Shipment_ID;
												subtotal_row.Shipment_Type=shipment_types.get(s);
												subtotal_row.Quantity=subtotal_quantity.get(s);
												subtotal_row.Unit_Price=subtotal_unit_price.get(s);
												subtotal_row.Total_Price=subtotal_price.get(s);
												input.Subtotal_by_Shipment.insert(subtotal_row);
											}
										}
						)
					}
				}

			}
