			Diactive_Employees_by_Off as "Diactive_Employees_by_Office"
			{
				type =  form
				form = Commercial_Office

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(Active == false)
										{
											AllEmployess = Employee[Office == input.ID];
											//info AllEmployess.count();
											if(AllEmployess.count() > 0)
											{
												for each  Worked in AllEmployess
												{
													Worked.Active=false;
												}
											}
										}
										else if(Active == true)
										{
											AllEmployess = Employee[Office == input.ID];
											//info AllEmployess.count();
											if(AllEmployess.count() > 0)
											{
												for each  Worked in AllEmployess
												{
													Worked.Active=true;
												}
											}
										}
						)
					}
				}

			}
