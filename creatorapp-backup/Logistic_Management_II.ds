												{
													shipping_types_list = shipping_detail.Shipping_Types;
													types_of_goods_list = shipping_detail.Types_of_Goods;
													coverage_locations_list = shipping_detail.Coverage_Locations;
													all_covered = true;
													if(shipping_types_list.contains(selected_shipping_type) && types_of_goods_list.contains(selected_type_of_merchandise))
													{
														// Verificar si coverage_locations_list contiene todos los selected_coverage_locations
														for each  loc_id in selected_coverage_locations
														{
															if(!coverage_locations_list.contains(loc_id))
															{
																all_covered = false;
																break;
															}
														}
													}
													else
													{
														all_covered = false;
													}
													if(all_covered == true)
													{
														matched = true;
														break;
													}
												}
												if(matched == true)
												{
													matching_vendors.add(vendor);
												}
											}
											// Actualizar opciones del campo Vendor
											input.Vendor:ui.add(matching_vendors);
											if(matching_vendors.contains(input.Vendor))
											{
												input.Vendor = actualvendor;
											}
										}
										else
										{
											// Si no hay condiciones válidas, limpiar opciones
											input.Vendor:ui.add(list());
										}
						)
					}
				}

			}
			Filter_Vendor_Field3 as "Filter_Vendor_Field"
			{
				type =  form
				form = Shipment

				record event = on edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Limpiar selección previa del campo Vendor
										actualvendor = input.Vendor;
										input.Vendor = null;
										if(input.Shipping_Type != null && input.Type_of_Merchandise != null && input.Coverage_Locations != null && input.Coverage_Locations.size() > 0)
										{
											// Valores del formulario actual
											selected_shipping_type = input.Shipping_Type;
											selected_type_of_merchandise = input.Type_of_Merchandise;
											selected_coverage_locations = input.Coverage_Locations;
											// Lista para guardar Vendors que cumplen la condición
											matching_vendors = list();
											// Obtener todos los Vendors
											all_vendors = Vendor[ID != 0 && Vendor_Type.contains("Freight Forwarder") && Active == true];
											for each  vendor in all_vendors
											{
												shipping_details_list = vendor.Shipping_Details;
												matched = false;
												for each  shipping_detail in shipping_details_list
												{
													shipping_types_list = shipping_detail.Shipping_Types;
													types_of_goods_list = shipping_detail.Types_of_Goods;
													coverage_locations_list = shipping_detail.Coverage_Locations;
													all_covered = true;
													if(shipping_types_list.contains(selected_shipping_type) && types_of_goods_list.contains(selected_type_of_merchandise))
													{
														// Verificar si coverage_locations_list contiene todos los selected_coverage_locations
														for each  loc_id in selected_coverage_locations
														{
															if(!coverage_locations_list.contains(loc_id))
															{
																all_covered = false;
																break;
															}
														}
													}
													else
													{
														all_covered = false;
													}
													if(all_covered == true)
													{
														matched = true;
														break;
													}
												}
												if(matched == true)
												{
													matching_vendors.add(vendor);
												}
											}
											// Actualizar opciones del campo Vendor
											input.Vendor:ui.add(matching_vendors);
										}
										else
										{
											// Si no hay condiciones válidas, limpiar opciones
											input.Vendor:ui.add(list());
										}
										input.Vendor = actualvendor;
						)
					}
				}

			}
			Complete_SubtotalShipment as "Complete_SubtotalShipmentTypes"
			{
				type =  form
				form = Release

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Clear subform registries
										input.Subtotals_By_Shipping_Type.clear();
										// Calculate types list and subtotals by 'Shipment Details' subform
										shipping_types = list();
										subtotal_of_pkgs = Map();
										subtotal_of_pounds = Map();
										if(input.Shipment_Details != null)
										{
											for each  r in input.Shipment_Details
											{
												// Getting value of new package
												if(r.Package_ID != null)
												{
													RealPkg = Package[ID == r.Package_ID];
													RealShipment = Shipment[ID == RealPkg.Shipment_Type];
													type = RealShipment.Shipping_Type;
													pkg_weight = ifnull(RealPkg.Total_Weight,0.0);
													// Add new shipping type to subtotals summary
													if(!shipping_types.contains(type))
													{
														shipping_types.add(type);
													}
													// Update subtotals values
													pkgs_qty = ifnull(subtotal_of_pkgs.get(type),0) + 1;
													pkg_weight = ifnull(subtotal_of_pounds.get(type),0.0) + pkg_weight;
													subtotal_of_pkgs.put(type,pkgs_qty);
													subtotal_of_pounds.put(type,pkg_weight);
												}
											}
										}
										// Create rows by types
										if(shipping_types != null)
										{
											for each  t in shipping_types
											{
												SubtotalRow = Release.Subtotals_By_Shipping_Type();
												SubtotalRow.Shipping_Type=t;
												SubtotalRow.Total_Packages=subtotal_of_pkgs.get(t);
												SubtotalRow.Total_Pounds=subtotal_of_pounds.get(t);
												input.Subtotals_By_Shipping_Type.insert(SubtotalRow);
											}
										}
						)
					}
				}

			}
