			)
			must have Book_Vendor
			(
				type = picklist
				displayname = "Book Vendor"
				maxchar = 100
				values = {"None"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Vendor_Name
			(
    			type = text
				displayname = "Vendor Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Phone
			(
    			type = phonenumber
	 			row = 1
	 			column = 1   
				width = medium
