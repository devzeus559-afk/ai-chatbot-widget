		reports
		{
			report All_Services
			{
				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Service_ID as "Service ID"
								Service_Type as "Service Type"
								Date_field1 as "Date"
								Employee
								Office
								Sender_Full_Name as "Sender Full Name"
								Receiver_Full_Name as "Receiver Full Name"
								Total_Weight as "Total Weight"
								Insurance_Rejected as "Insurance Rejected"
								Daily_Movement as "Daily Movement"
								"Complete"
								"Create Daily Movement"
								"Print Insurance Rejected"
								Added_Time as "Hora agregado"
								"Send Email"
								Transaction_Number as "Transaction Number "
								"Print Transation"
								Transaction_Amount as "Transaction Amount"
								Commission
								Price as "Total Price"
								Amount
								Sender_Mobile as "Sender Mobile"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Delete 
							)
						record
						(
							Edit   	   
							Delete   	   
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							Edit   	   
							Delete   	   
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
		 				type = 2
						datablock1
						(
		     				title = "Overview"
							fields
							(
								Service_ID as "Service ID"
								Service_Type as "Service Type"
								Employee
								Office
								Notes1 as "Notes"
								Daily_Movement as "Daily Movement"
								Amount
								Insurance_Rejected as "Insurance Rejected"
								Signature
								Transaction_Amount as "Transaction Amount"
								Commission
							)
						)
						datablock3
						(
							layout type = -1
		     				title = "Packages"
		     				related field = Package.Service[Service.Service_Type == "Package Receipt"]
							fields
							(
								Package_ID as "Package ID"
								Package_Name as "Package Name"
								Receipt_Date as "Receipt Date"
								Departure_Date as "Departure Date"
								Tracking_Number as "External Tracking Number"
								Total_Weight as "Total Weight"
								Volume
								Volumetric_weight as "Volumetric weight"
								Total_Price as "Total Price"
								Declared_Value as "Declared Value"
								Shipment_Type as "Shipment Type"
							)
						)
						datablock4
						(
		     				title = "Receipt Details"
							fields
							(
								Number_of_Packages as "Number of Packages"
								Total_Weight as "Total Weight"
								Total_Packaging_Price as "Total Packaging Price"
								Total_Custom_Duty as "Total Custom Duty"
								Price as "Total Price"
							)
						)
						datablock5
						(
							layout type = -1
		     				title = "Payment Information"
		     				related field = Payment_Information
							fields
							(
								Payment_Method as "Payment Method"
								Amount
								Fit as "Fit %"
								Fit_Credit_Card as "Fit Credit Card"
								Total_To_Pay as "Total to Pay"
								Cash_Flow as "Cash Flow"
							)
						)
