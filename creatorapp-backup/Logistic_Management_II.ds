			Filter_Services4 as "Filter_Services"
			{
				type =  form
				form = Release

				record event = on add or edit

				on user input of Add_Multiple_Packages
				{
					actions 
					{
						custom deluge script
						(
											if(input.Add_Multiple_Packages == true)
										{
											input.Add_Packages_Option = "Add";
											// Create service ids list 
											service_ids = List:int();
											// Search received packages of this office and with a service associated
											for each  p in Package[Office == input.Office && Status == "Received" && Service != null]
											{
												// Get service and coverage location records
												RealService = Service[ID == p.Service];
												RealLocation = Coverage_Location[ID == p.Location];
												// Filter packages that match with criterias: 
												// - Service_Type --> "Package Receipt"
												// - Destination_Country --> Pkg Destination Address (Country)  
												if(RealService.Service_Type == "Package Receipt" && RealLocation.Address_Information1.country == input.Destination_Country)
												{
													// If subform has some records and if the service associated is not in service_ids list
													if(input.Shipment_Details != null && !service_ids.contains(p.Service))
													{
														// Save service ID if the package isn't included in the list and package isn't in Shipment Details subform
														for each  r in input.Shipment_Details
														{
															// Check if pkg ID is in subform 
															if(r.Package_ID != p.ID)
															{
																service_ids.add(p.Service);
															}
														}
													}
													// Save service ID if subform is empty and the id isn't included on service_ids list 
													else if(input.Shipment_Details == null && !service_ids.contains(p.Service))
													{
														service_ids.add(p.Service);
													}
												}
											}
											// Clear dropdown
											clear Service_Filter;
											// Populate with updated services list
											input.Service_Filter:ui.add(List());
											input.Service_Filter:ui.add(service_ids.distinct());
										}
						)
					}
				}

			}
