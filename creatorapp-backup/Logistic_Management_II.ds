			Validate_Insurance_Reject as "Validate_Insurance_Rejected"
			{
				type =  form
				form = Service

				record event = on add or edit
					status = inactive

				on validate
				{
					actions 
					{
						custom deluge script
						(
											whitoutinsurance = false;
										for each  Pkg in input.Packages
										{
											RealPackage = Package[ID == Pkg.Package_Name];
											if(RealPackage.ID != null)
											{
												if(RealPackage.Insured_value == null || RealPackage.Insured_value == 0)
												{
													whitoutinsurance = true;
												}
											}
										}
										if(whitoutinsurance == true && input.Insurance_Rejected == false)
										{
											openUrl("#Page:Error_Message?mensaje=The Insurance Rejected field must be checked and the Signature must be registered because this Service contains at least one Package without Insurance Value.","popup window","height=143,width=380");
											alert "The Insurance Rejected field must be checked and the Signature must be registered because this Service contains at least one Package without Insurance Value.";
											cancel submit;
										}
						)
					}
				}

			}
