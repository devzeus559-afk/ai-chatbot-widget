			Update_Payment_AutoFields as "Update_Payment_AutoFields"
			{
				type =  form
				form = Service

				record event = on edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(Payment_Information != null)
										{
											for each  r in input.Payment_Information
											{
												if(r.Amount > 0 && r.Total_To_Pay == null)
												{
													fitByCreditCard = 0;
													if(r.Payment_Method == "Credit Card")
													{
														fit = ifnull(r.Fit,0);
														fitByCreditCard = r.Amount * fit / 100;
													}
													r.Fit_Credit_Card=fitByCreditCard;
													r.Total_To_Pay=r.Amount + fitByCreditCard;
												}
											}
										}
						)
					}
				}

			}
			Update_Payment_AutoFields1 as "Update_Payment_AutoFields"
			{
				type =  form
				form = Service

				record event = on add or edit

				on user input of Payment_Information.Amount
				{
					actions 
					{
						custom deluge script
						(
											if(row.Amount > 0)
										{
											fit = 0;
											fit_by_credit_card = 0;
											// Apply fit by credit card if match with that payment method
											if(row.Payment_Method == "Credit Card")
											{
												// Fit is 4% by default in credit card payment method
												fit = 4;
												fit_by_credit_card = row.Amount * fit / 100;
											}
											row.Fit=fit;
											row.Fit_Credit_Card=fit_by_credit_card;
											row.Total_To_Pay=row.Amount + fit_by_credit_card;
										}
						)
					}
				}

			}
