		form Paid_Purchase_Received
		{
			displayname = "Paid Purchase Received"
			success message = "¡Datos añadidos correctamente!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Nombre_Completo
			(
    			type = name
				displayname = "Nombre Completo"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="Nombre"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Primer Apellido"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Segundo Apellido"
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Tel_fono
			(
    			type = phonenumber
				displayname = "Teléfono"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Servicio
			(
				type = picklist
				maxchar = 100
				values = {"Paid Purchase Management"}
				initial value = "Paid Purchase Management"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Tienda
			(
				type = picklist
				maxchar = 100
				values = {"Shein","Temu","Amazon"}
				others option = true
	 			row = 1
	 			column = 2   
				width = medium
			)
			Fecha_de_Compra
			(
    			type = date
				displayname = "Fecha de Compra"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Oficina_del_Casillero
			(
				type = picklist	
				displayname = "Oficina del Casillero"
				values  = Commercial_Office.ID
    			displayformat = [Office_Name]
				sortorder = ascending
	 			row = 1
	 			column = 3   
				width = medium
			)
			N_mero_de_Casilla
			(
    			type = text
				displayname = "Número de Casilla"
	 			row = 1
	 			column = 3   
				width = medium
			)
			Tracking_Number
			(
    			type = text
				displayname = "Tracking Number"
	 			row = 1
	 			column = 3   
				width = medium
			)
			Detalles_de_la_compra
			(
				type = grid
				displayname = "Detalles de la compra"
				must have N_mero
				(
    				type = text
					displayname = "Número"
					width = medium
				)
				Descipci_n
				(
    				type = textarea
					displayname = "Descripción"
					height = 100px
					width = medium
				)
				Url
				(
    				type = url
					enable  linkname
					width = medium
				)
	 			row = 2
	 			column = 1   
				width = medium
			)
			Section1
			(
				type = section
				displayname = "Section"
	 			row = 3
	 			column = 0   
				width = medium
			)
			Archivo_con_detalles_de_la_compra
			(
    			type = upload file
				displayname = "Archivo con detalles de la compra"
    			file count = 10
				browse = local_drive
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Enviar
					(
   						type = submit
   						displayname = "Enviar"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
