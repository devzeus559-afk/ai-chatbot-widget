										{
											disable Declared_Value;
										}
										else
										{
											enable Declared_Value;
										}
						)
					}
				}

			}
			Set_Hide_ServiceFields as "Set&Hide_ServiceFields"
			{
				type =  form
				form = Service

				record event = on add or edit

				on add row of Packages
				{
					actions 
					{
						custom deluge script
						(
											row.Receipt_Date=input.Date_field1;
										row.Service_Employee=input.Employee;
										row.Service_Office=input.Office;
										if(input.Sender_field == null)
										{
											for each  var in input.Packages
											{
												valor = Package[Package_ID == var.Package_ID];
												break;
											}
											if(valor.ID != null)
											{
												row.Service_Sender=valor.Sender_field.ID;
											}
										}
										else
										{
											row.Service_Sender=input.Sender_field.ID;
										}
										valor2 = null;
										for each  var2 in input.Packages
										{
											if(var2.Package_ID != null)
											{
												valor2 = Package[Package_ID == var2.Package_ID];
											}
										}
										if(valor2 != null)
										{
											if(valor2.Receiver_Contact != null)
											{
												row.Receiver=Contacts[ID == valor2.Receiver_Contact].CRM_Contact_ID.toLong();
											}
											else
											{
												row.Receiver=Contacts[ID == valor2.Receiver_Contact].CRM_Contact_ID;
											}
										}
										row.Sender_Full_Name=input.Sender_Full_Name;
										row.Sender_Mobile=input.Sender_Mobile;
										row.Sender_DNI=input.Sender_DNI;
										row.Sender_Email=input.Sender_Email;
										row.Sender_Address.address_line_1=input.Sender_Address.address_line_1;
										row.Sender_Address.district_city=input.Sender_Address.district_city;
										row.Sender_Address.state_province=input.Sender_Address.state_province;
										row.Sender_Address.country=input.Sender_Address.country;
										hide row.Service_Employee;
										hide row.Service_Office;
										hide row.Service_Sender;
										hide row.Sender_Full_Name;
										hide row.Sender_Mobile;
										hide row.Sender_DNI;
										hide row.Sender_Address;
										hide row.Sender_Email;
						)
					}
				}

			}
			Show_SenderInformation_Fi1 as "Show_SenderInformation_Fields&Clear_Sender"
			{
