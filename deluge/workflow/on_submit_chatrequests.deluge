/**
 * on_submit_chatrequests.deluge
 *
 * Script del workflow "On Submit" del módulo ChatRequests.
 * El registro ya existe cuando corre el workflow; `input` trae el registro.
 *
 * chat_invoke() ya marca Status = answered si todo sale bien; este script
 * atrapa fallos para no dejar solicitudes colgadas en "pending".
 *
 * Fallo = mutación en memoria de `input` (0 llamadas de API de Creator): el
 * registro del workflow persiste automáticamente los cambios.
 *
 * Si el proceso genera un error de límite de sentencias,
 * el registro se marca como "failed" incluso si el estado anterior era "answered".
 * Esto previene que el frontend siga poll-eando eternamente.
 */
requestId = input.ID;

try {
    result = chat_invoke(requestId);
    
    // Si el resultado no es "answered", marcamos como failed inmediatamente.
    if (result.get("status") != "answered") {
        input.Status = "failed";
        input.Error = result.get("message");
    }
} catch (e) {
    // Si ocurre una excepción, marcamos como failed inmediatamente.
    input.Status = "failed";
    input.Error = e.message;
} finally {
    // Siempre al final revisamos si el mensaje de error contiene el patrón crítico.
    // Esto detecta el error de límite de sentencias incluso si el On Success script
    // falla pero chat_invoke termina "answered".
    if (input.Error != null && 
        input.Error.toString().indexOf("Number of statement execution limit exceed") != -1) {
        input.Status = "failed";
    }
}
