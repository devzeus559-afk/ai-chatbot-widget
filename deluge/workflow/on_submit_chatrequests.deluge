/**
 * on_submit_chatrequests.deluge
 *
 * Script del workflow "On Submit" del módulo ChatRequests.
 * El registro ya existe cuando corre el workflow; `input` trae el registro.
 *
 * chat_invoke() ya marca Status = answered si todo sale bien; este script
 * atrapa fallos para no dejar solicitudes colgadas en "pending".
 *
 * Fallo = mutación en memoria de `input` (0 llamadas de API de Creator): el
 * registro del workflow persiste automáticamente los cambios.
 */

requestId = input.ID;

try {
    result = chat_invoke(requestId);
    
    // Si el resultado viene con status != answered, marcamos como failed inmediatamente.
    if (result.get("status") != "answered") {
        input.Status = "failed";
        input.Error = result.get("message");
    }
    
    // **Nueva capa de seguridad:** aunque el On Success termine con status "answered",
    // puede contener en su message el error de límite de sentencias.
    // Si el mensaje contiene ese patrón, forzamos el Failed aunque el status sea "answered".
    if (result.get("error") != null && 
        result.get("error").contains("Number of statement execution limit exceed")) {
        input.Status = "failed";
        input.Error = result.get("message");
    }
    
    // Si el resultado no es exitoso (no answered) lo marcamos como failed de todas formas.
    if (result.get("status") != "answered") {
        input.Status = "failed";
        input.Error = result.get("message");
    }
} catch (e) {
    input.Status = "failed";
    input.Error = e.message;
} finally {
    // Si llegamos aquí (tanto en try como en catch) y no hemos marcado failed aún,
    // marcamos el registro como "failed" si el error contiene el patrón crítico.
    if (input.Status != "failed" && input.Error != null && 
        input.Error.contains("Number of statement execution limit exceed")) {
        input.Status = "failed";
    }
}

// Si el error capturado contiene el patron de lmites de lances de Deluge,
// aseguramos que el estatus sea "failed" aunque el status venga como "answereded"
// (esto ocurre cuando el On Success script falla pero chat_invoke termina "answered")
if (input.Error != null && input.Error.contains("Number of statement execution limit exceed")) {
    input.Status = "failed";
}

