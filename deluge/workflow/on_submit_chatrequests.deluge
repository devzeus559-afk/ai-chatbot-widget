/**
 * on_submit_chatrequests.deluge
 *
 * Script del workflow "On Submit" del módulo ChatRequests.
 * El registro ya existe cuando corre el workflow; `input` trae el registro.
 *
 * chat_invoke() ya marca Status = answered si todo sale bien; este script
 * atrapa fallos para no dejar solicitudes colgadas en "pending".
 *
 * Fallo = mutación en memoria de `input` (0 llamadas de API de Creator): el
 * registro del workflow persiste automáticamente los cambios.
 */
requestId = input.ID;

input.Status = "failed";

try {
    result = thisapp.chat_invoke.chat_invoke(requestId);
    
    // Si el resultado es "answered", no lo marcamos como failed
    if (result != null && result.get("status") == "answered") {
        input.Status = "answered";
        input.Error = null;
    } else {
        input.Status = "failed";
        if (result != null) {
            input.Error = result.get("message");
        }
    }
} catch (e) {
    // Si ocurre una excepción, marcamos como failed inmediatamente.
    input.Status = "failed";
    input.Error = e.toString();
}

if (input.Error != null) {
    errStr = input.Error.toString();
    if (errStr.indexOf("statement execution limit") != -1 || 
        errStr.indexOf("Number of statement execution limit") != -1) {
        input.Status = "failed";
    }
}
