/**
* chat_config()
*
* Configuración central del backend del chatbot (paquetería internacional,
* remesas y recargas telefónicas).
*
* IMPORTANTE:
* 1. Reemplaza los link names por los reales de tu app de Creator.
* 2. Deluge no comparte estado global entre funciones: cada función DEBE
*    empezar con:   config = chat_config();
* 3. Los link names se obtienen de la URL de cada módulo dentro de Creator.
*/

map chat_config.chat_config()
{
  /**
  * chat_config()
  *
  * Configuración central del backend del chatbot (paquetería internacional,
  * remesas y recargas telefónicas).
  *
  */
  config = Map();
  // --- Módulos de persistencia del chat ---
  config.put("chatSessions","ChatSessions");
  config.put("chatMessages","ChatMessages");
  config.put("chatRequests","ChatRequests");
  // --- Composición de respuestas ---
  // false = plantillas deterministas (barato, rápido, recomendado).
  // true  = segunda llamada Zia para redactar respuestas naturales (más costo/latencia).
  config.put("composeWithAI",false);
  // -- currency var
	config.put("currency","USD");
  // --- Catálogo de herramientas para Zia ---
  tools = List();
  tool = Map();
  tool.put("name","track_package");
  tool.put("description","Busca el estado de un paquete por su número de seguimiento.");
  tool.put("params",{"trackingNumber":"string: número de seguimiento del paquete"});
  tools.add(tool);
  tool = Map();
  tool.put("name","search_services");
  tool.put("description","Lista los servicios disponibles. Filtros opcionales: tipo de servicio (Paquetería, Locker, Store, Remesa, Recarga, Online Store, Other Services), ciudad destino.  Si el usuario no especifica tipo, llama con params vacíos {} — NO pidas aclaración.");
  tool.put("params",{"serviceType":"string opcional","destination":"string opcional"});
  tools.add(tool);
  tool = Map();
  tool.put("name","find_offices");
  tool.put("description","Busca oficinas comerciales. Filtros opcionales: ciudad, país.  Si el usuario no especifica tipo, llama con params vacíos {} — NO pidas aclaración.");
  tool.put("params",{"city":"string opcional","country":"string opcional"});
  tools.add(tool);
  tool = Map();
  tool.put("name","check_coverage");
  tool.put("description","Consulta zonas cubiertas (Coverage_Location) por país y proveedores activos (Vendor) por tipo de servicio o nombre. Coverage_Location no modela vendor/service_type; los proveedores vienen del módulo Vendor (Vendor_Type coincide con Service.Service_Type).  Si el usuario no especifica tipo, llama con params vacíos {} — NO pidas aclaración.");
  tool.put("params",{"country":"string opcional","serviceType":"string opcional","vendor":"string opcional"});
  tools.add(tool);
  tool = Map();
  tool.put("name","find_contacts");
  tool.put("description","Busca contactos (remitente o receptor) por nombre, teléfono o documento.  Si el usuario no especifica tipo, llama con params vacíos {} — NO pidas aclaración.");
  tool.put("params",{"name":"string opcional","phone":"string opcional","document":"string opcional"});
  tools.add(tool);
  config.put("tools",tools);
  tool = Map();
  tool.put("name","report_top_customers");
  tool.put("description","Reporte de los clientes más frecuentes (top N) por cantidad de servicios en los últimos 30 días. Filtro opcional de tipo de servicio (valores exactos, sensibles a mayúsculas): Package Receipt, Locker, Store, Remittance, Recharge, Online Store, Other Services. Si el usuario no especifica tipo, llama con params vacíos {} — NO pidas aclaración, rankea TODOS los tipos.");
  tool.put("params",{"serviceType":"string opcional","limit":"string opcional"});
  tools.add(tool);
  tool = Map();
  tool.put("name","report_top_package_customers");
  tool.put("description","Reporte de los clientes más frecuentes de paquetería (top N) por cantidad de servicios de paquetería o por libras totales, en los últimos 30 días. Params opcionales: measure (packages o pounds, default packages), limit, serviceType (un tipo exacto, o 'all' para todos los tipos; si no se especifica, se filtra solo 'Package Receipt'). NO pidas aclaración si el usuario no indica medida.");
  tool.put("params",{"measure":"string opcional (packages|pounds)","limit":"string opcional","serviceType":"string opcional"});
  tools.add(tool);
  tool = Map();
  tool.put("name","report_top_remittance_customers");
  tool.put("description","Reporte de los clientes que más remesas envían (top N) por monto total en USD, en los últimos 30 días, considerando servicios de tipo Remittance. Params opcionales: limit. NO pidas aclaración.");
  tool.put("params",{"limit":"string opcional"});
  tools.add(tool);
  tool = Map();
  tool.put("name","report_shipping_type_frequency");
  tool.put("description","Reporte de la frecuencia de paquetes por tipo de envío (aéreo vs marítimo) en los últimos 30 días, con su porcentaje. Params opcionales: limit, office (nombre de oficina). NO pidas aclaración.");
  tool.put("params",{"limit":"string opcional","office":"string opcional"});
  tools.add(tool);
  tool = Map();
  tool.put("name","report_merchandise_type");
  tool.put("description","Reporte de la distribución de paquetes por tipo de mercancía en los últimos 30 días (Miscellaneous, Durables, Documents, Toilet Food Medicine, Courier, Other), con su porcentaje. Params opcionales: limit, office (nombre de oficina). NO pidas aclaración.");
  tool.put("params",{"limit":"string opcional","office":"string opcional"});
  tools.add(tool);
  tool = Map();
  tool.put("name","report_pounds_shipped");
  tool.put("description","Reporte de libras totales enviadas en un período (Package.Total_Weight), desglosado por oficina, por tipo de carga (Box/Bag/Documents) y por clase de envío (aéreo/marítimo). Params opcionales: startDate, endDate (default últimos 30 días), office (nombre de oficina).");
  tool.put("params",{"startDate":"date opcional","endDate":"date opcional","office":"string opcional"});
  tools.add(tool);
  tool = Map();
  tool.put("name","report_daily_average");
  tool.put("description","Reporte del promedio diario de libras enviadas en un período. Params opcionales: startDate, endDate (default últimos 30 días), office (nombre de oficina).");
  tool.put("params",{"startDate":"date opcional","endDate":"date opcional","office":"string opcional"});
  tools.add(tool);
  tool = Map();
  tool.put("name","report_monthly_comparison");
  tool.put("description","Reporte de comparación de promedios mensuales de libras a lo largo de los últimos N meses (default 3), con variación (%) vs el mes anterior. Params opcionales: months, startDate, endDate, office (nombre de oficina).");
  tool.put("params",{"months":"string opcional","startDate":"date opcional","endDate":"date opcional","office":"string opcional"});
  tools.add(tool);
  tool = Map();
  tool.put("name","report_delayed_packages");
  tool.put("description","Informe de cajas demoradas (atrasadas). Una caja está demorada cuando los días desde su escaneo superan el umbral: aéreo >20 días, marítimo/caja (incl. caja pronto) >45 días. Params opcionales: destCountry (default Cuba).");
  tool.put("params",{"destCountry":"string opcional (default Cuba)"});
  tools.add(tool);
  tool = Map();
  tool.put("name","report_unscanned_packages");
  tool.put("description","Informe de cajas que no han sido escaneadas (Pkg_Tracking.Scanned == false), con su último estado, fecha de escaneo y oficina. Params opcionales: limit, office (nombre de oficina).");
  tool.put("params",{"limit":"string opcional","office":"string opcional"});
  tools.add(tool);
  // --- Catálogo de sugerencias UI ---
  suggestions = [
    {
        "label"   : "Top clientes (paquetes)",
        "payload" : {"tool":"report_top_customers","params":{}},
        "order"   : 1,
        "enabled" : true
    },
    {
        "label"   : "Top clientes (libras)",
        "payload" : {"tool":"report_top_package_customers","params":{"measure":"pounds"}},
        "order"   : 2,
        "enabled" : true
    },
    {
        "label"   : "Paquetes demorados",
        "payload" : {"tool":"report_delayed_packages","params":{}},
        "order"   : 3,
        "enabled" : true
    }
  ];
  config.put("suggestions", suggestions);
  // --- Catálogo de herramientas en texto legible (para el prompt de Zia) ---
  // Texto plano en vez de json.toJson (no reconocido por el editor de Creator).
  toolsText = "";
  for each  t in tools
  {
    toolsText = toolsText + "- " + t.get("name") + ": " + t.get("description");
    p = t.get("params");
    if(p != null && p.size() > 0)
    {
      toolsText = toolsText + " Params: " + p.toString();
    }
    toolsText = toolsText + "\n";
  }
  config.put("toolsText",toolsText);
  return config;

}