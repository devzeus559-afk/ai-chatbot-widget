/**
* chat_config()
*
* Configuración central del backend del chatbot (paquetería internacional,
* remesas y recargas telefónicas).
*
* Exposes:
* - tools: flat tool catalog (15 tools, for compat/fallback)
* - toolsText: formatted Zia prompt fragment (all tools)
* - taxonomy: Map(category → List of tool names) — 5 categories
* - toolsByCategory: Map(tool name → category name) — reverse lookup
* - toolsTextByCategory: Map(category → formatted Zia prompt fragment)
* - paramSchema: Map(tool name → schema text with required/optional params)
*
* IMPORTANTE:
* 1. Reemplaza los link names por los reales de tu app de Creator.
* 2. Deluge no comparte estado global entre funciones: cada función DEBE
*    empezar con:   config = chat_config();
* 3. Los link names se obtienen de la URL de cada módulo dentro de Creator.
*/

map chat_config.chat_config()
{
  /**
  * chat_config()
  *
  * Configuración central del backend del chatbot (paquetería internacional,
  * remesas y recargas telefónicas).
  *
  */
  config = Map();
  // --- Módulos de persistencia del chat ---
  config.put("chatSessions","ChatSessions");
  config.put("chatMessages","ChatMessages");
  config.put("chatRequests","ChatRequests");
  // --- Composición de respuestas ---
  // false = plantillas deterministas (barato, rápido, recomendado).
  // true  = segunda llamada Zia para redactar respuestas naturales (más costo/latencia).
  config.put("composeWithAI",false);
  // -- currency var
	config.put("currency","USD");
  // --- Catálogo de herramientas para Zia ---
  tools = List();
  tool = Map();
  tool.put("name","track_package");
  tool.put("description","Busca el estado de un paquete por su número de seguimiento.");
  tool.put("params",{"trackingNumber":"string: número de seguimiento del paquete"});
  tools.add(tool);
  tool = Map();
  tool.put("name","search_services");
  tool.put("description","Lista los servicios disponibles. Filtros opcionales: tipo de servicio (Paquetería, Locker, Store, Remesa, Recarga, Online Store, Other Services), ciudad destino.  Si el usuario no especifica tipo, llama con params vacíos {} — NO pidas aclaración.");
  tool.put("params",{"serviceType":"string opcional","destination":"string opcional"});
  tools.add(tool);
  tool = Map();
  tool.put("name","find_offices");
  tool.put("description","Busca oficinas comerciales. Filtros opcionales: ciudad, país.  Si el usuario no especifica tipo, llama con params vacíos {} — NO pidas aclaración.");
  tool.put("params",{"city":"string opcional","country":"string opcional"});
  tools.add(tool);
  tool = Map();
  tool.put("name","check_coverage");
  tool.put("description","Consulta zonas cubiertas (Coverage_Location) por país y proveedores activos (Vendor) por tipo de servicio o nombre. Coverage_Location no modela vendor/service_type; los proveedores vienen del módulo Vendor (Vendor_Type coincide con Service.Service_Type).  Si el usuario no especifica tipo, llama con params vacíos {} — NO pidas aclaración.");
  tool.put("params",{"country":"string opcional","serviceType":"string opcional","vendor":"string opcional"});
  tools.add(tool);
  tool = Map();
  tool.put("name","find_contacts");
  tool.put("description","Busca contactos (remitente o receptor) por nombre, teléfono o documento.  Si el usuario no especifica tipo, llama con params vacíos {} — NO pidas aclaración.");
  tool.put("params",{"name":"string opcional","phone":"string opcional","document":"string opcional"});
  tools.add(tool);
  config.put("tools",tools);
  tool = Map();
  tool.put("name","report_top_customers");
  tool.put("description","Reporte de los clientes más frecuentes (top N) por cantidad de servicios. serviceType es una LISTA obligatoria (≥1 elemento; Locker, Store, Recharge, Online Store, Other Services). Filtros opcionales: office (nombre de oficina), city (ciudad destino), period (enum: ultimo_mes|mes_anterior|este_mes|ultimos_7_dias, default ultimo_mes) o startDate/endDate explícitos. NO lo uses para paquetería (usa report_top_package_customers) ni para remesas (usa report_top_remittance_customers).");
  tool.put("params",{"serviceType":"List<string> obligatorio (≥1 elemento; Locker, Store, Recharge, Online Store, Other Services)","limit":"string opcional","office":"string opcional","city":"string opcional","period":"string opcional (enum: ultimo_mes|mes_anterior|este_mes|ultimos_7_dias)","startDate":"date opcional","endDate":"date opcional"});
  tools.add(tool);
  tool = Map();
  tool.put("name","report_top_package_customers");
  tool.put("description","Reporte de los clientes más frecuentes de paquetería (top N) por cantidad de paquetes (measure=packages) o libras totales (measure=pounds). Filtros opcionales: office (nombre de oficina), city (ciudad destino), period (enum: ultimo_mes|mes_anterior|este_mes|ultimos_7_dias, default ultimo_mes) o startDate/endDate explícitos. serviceType opcional: un tipo exacto, 'all' para todos, o vacío para filtro por defecto 'Package Receipt'. ÚSALO cuando el usuario hable de clientes más frecuentes y el contexto sea de paquetería. NO lo uses para remesas (usa report_top_remittance_customers).");
  tool.put("params",{"measure":"string opcional (packages|pounds)","limit":"string opcional","serviceType":"string opcional","office":"string opcional","city":"string opcional","period":"string opcional (enum: ultimo_mes|mes_anterior|este_mes|ultimos_7_dias)","startDate":"date opcional","endDate":"date opcional"});
  tools.add(tool);
  tool = Map();
  tool.put("name","report_top_remittance_customers");
  tool.put("description","Reporte de los clientes que más remesas envían (top N) por monto total en USD, considerando servicios de tipo Remittance. Filtros opcionales: office (nombre de oficina), city (ciudad destino), period (enum: ultimo_mes|mes_anterior|este_mes|ultimos_7_dias, default ultimo_mes) o startDate/endDate explícitos. ÚSALO cuando el usuario hable de clientes más frecuentes y el contexto sea de remesas. NO lo uses para otros tipos de servicio (usa report_top_customers para los demás) ni para paquetería (usa report_top_package_customers).");
  tool.put("params",{"limit":"string opcional","office":"string opcional","city":"string opcional","period":"string opcional (enum: ultimo_mes|mes_anterior|este_mes|ultimos_7_dias)","startDate":"date opcional","endDate":"date opcional"});
  tools.add(tool);
  tool = Map();
  tool.put("name","report_shipping_type_frequency");
  tool.put("description","Reporte de la frecuencia de paquetes por tipo de envío (aéreo vs marítimo) en los últimos 30 días, con su porcentaje. Params opcionales: limit, office (nombre de oficina). NO pidas aclaración.");
  tool.put("params",{"limit":"string opcional","office":"string opcional"});
  tools.add(tool);
  tool = Map();
  tool.put("name","report_merchandise_type");
  tool.put("description","Reporte de la distribución de paquetes por tipo de mercancía en los últimos 30 días (Miscellaneous, Durables, Documents, Toilet Food Medicine, Courier, Other), con su porcentaje. Params opcionales: limit, office (nombre de oficina). NO pidas aclaración.");
  tool.put("params",{"limit":"string opcional","office":"string opcional"});
  tools.add(tool);
  tool = Map();
  tool.put("name","report_pounds_shipped");
   tool.put("description","Reporte de libras totales enviadas en un período (Package.Total_Weight), desglosado por oficina, por tipo de carga (Box/Bag/Documents) y por clase de envío (aéreo/marítimo). Params opcionales: startDate, endDate (default últimos 30 días), office (nombre de oficina), full (boolean) – Si true devuelve el total completo, si false usa la vía rápida de 200 registros.");
  tool.put("params",{"startDate":"date opcional","endDate":"date opcional","office":"string opcional"});
  tools.add(tool);
  tool = Map();
  tool.put("name","report_daily_average");
   tool.put("description","Reporte del promedio diario de libras enviadas en un período. Params opcionales: startDate, endDate (default últimos 30 días), office (nombre de oficina), full (boolean) – Si true devuelve el total completo, si false usa la vía rápida de 200 registros.");
  tool.put("params",{"startDate":"date opcional","endDate":"date opcional","office":"string opcional"});
  tools.add(tool);
  tool = Map();
  tool.put("name","report_monthly_comparison");
   tool.put("description","Reporte de comparación de promedios mensuales de libras a lo largo de los últimos N meses (default 2), con variación (%) vs el mes anterior. Params opcionales: months, startDate, endDate, office (nombre de oficina), full (boolean) – Si true devuelve el total completo, si false usa la vía rápida de 200 registros.");
  tool.put("params",{"months":"string opcional","startDate":"date opcional","endDate":"date opcional","office":"string opcional"});
  tools.add(tool);
  tool = Map();
  tool.put("name","report_delayed_packages");
  tool.put("description","Informe de cajas demoradas (atrasadas). Una caja está demorada cuando los días desde su escaneo superan el umbral: aéreo >20 días, marítimo/caja (incl. caja pronto) >45 días. Params opcionales: destCountry (default Cuba).");
  tool.put("params",{"destCountry":"string opcional (default Cuba)"});
  tools.add(tool);
  tool = Map();
  tool.put("name","report_unscanned_packages");
  tool.put("description","Informe de cajas que no han sido escaneadas (Pkg_Tracking.Scanned == false), con su último estado, fecha de escaneo y oficina. Params opcionales: limit, office (nombre de oficina).");
  tool.put("params",{"limit":"string opcional","office":"string opcional"});
  tools.add(tool);
  tool = Map();
  tool.put("name","list_service_types");
  tool.put("description","Lista los TIPOS de servicio que ofrece la agencia (catálogo: Paquetería, Locker, Store, Remesa, Recarga, Tienda Online, Otros Servicios). SIN parámetros. Úsalo cuando el usuario pregunte qué servicios ofrecen, qué servicios tienen, tipos de servicio o servicios disponibles. NO es para buscar servicios puntuales con tipo/destino (eso es search_services). Si el usuario no menciona tipo ni destino, usa este tool — NO pidas aclaración.");
  tool.put("params",{});
  tools.add(tool);
  /**
  * SUGERENCIAS UI — NO viven en el backend.
  * El Widget SDK v1 NO expone ZOHO.CREATOR.API.invoke, así que el widget no
  * puede leer config.suggestions por API (la vía invoke da TypeError: ...invoke
  * is not a function). La fuente ÚNICA de verdad para los botones de sugerencias
  * es CONFIG.suggestions en LM2Chatbot/app/widget.html (array estático con
  * label/prompt/payload/order/enabled). NO mantener una copia aquí: esto quedó
  * como código muerto y las dos listas divergieron. Editar el widget, no esto.
  */
  // Texto plano en vez de json.toJson (no reconocido por el editor de Creator).
  toolsText = "";
  for each  t in tools
  {
    toolsText = toolsText + "- " + t.get("name") + ": " + t.get("description");
    p = t.get("params");
    if(p != null && p.size() > 0)
    {
      toolsText = toolsText + " Params: " + p.toString();
    }
    toolsText = toolsText + "\n";
  }
  config.put("toolsText",toolsText);
  // --- Hierarchical intent routing: taxonomy + param schemas ---
  taxonomy = Map();
  taxonomy.put("SEARCH",{"search_services","list_service_types","find_offices","check_coverage","find_contacts"});
  taxonomy.put("TRACKING",{"track_package"});
  taxonomy.put("TOP_CUSTOMERS",{"report_top_customers","report_top_package_customers","report_top_remittance_customers"});
  taxonomy.put("PACKAGE_ANALYSIS",{"report_pounds_shipped","report_daily_average","report_monthly_comparison"});
  taxonomy.put("OTHER_ANALYSIS",{"report_shipping_type_frequency","report_merchandise_type","report_delayed_packages","report_unscanned_packages"});
  config.put("taxonomy",taxonomy);
  toolsByCategory = Map();
  toolsByCategory.put("search_services","SEARCH");
  toolsByCategory.put("list_service_types","SEARCH");
  toolsByCategory.put("find_offices","SEARCH");
  toolsByCategory.put("check_coverage","SEARCH");
  toolsByCategory.put("find_contacts","SEARCH");
  toolsByCategory.put("track_package","TRACKING");
  toolsByCategory.put("report_top_customers","TOP_CUSTOMERS");
  toolsByCategory.put("report_top_package_customers","TOP_CUSTOMERS");
  toolsByCategory.put("report_top_remittance_customers","TOP_CUSTOMERS");
  toolsByCategory.put("report_pounds_shipped","PACKAGE_ANALYSIS");
  toolsByCategory.put("report_daily_average","PACKAGE_ANALYSIS");
  toolsByCategory.put("report_monthly_comparison","PACKAGE_ANALYSIS");
  toolsByCategory.put("report_shipping_type_frequency","OTHER_ANALYSIS");
  toolsByCategory.put("report_merchandise_type","OTHER_ANALYSIS");
  toolsByCategory.put("report_delayed_packages","OTHER_ANALYSIS");
  toolsByCategory.put("report_unscanned_packages","OTHER_ANALYSIS");
  config.put("toolsByCategory",toolsByCategory);
  toolsTextByCategory = Map();
  for each  cat in taxonomy.keys()
  {
    catTools = taxonomy.get(cat);
    catText = "";
    for each  t in tools
    {
      isMatch = false;
      for each  ct in catTools
      {
        if(ct == t.get("name"))
        {
          isMatch = true;
        }
      }
      if(isMatch)
      {
        catText = catText + "- " + t.get("name") + ": " + t.get("description");
        p = t.get("params");
        if(p != null && p.size() > 0)
        {
          catText = catText + " Params: " + p.toString();
        }
        catText = catText + "\n";
      }
    }
    toolsTextByCategory.put(cat,catText);
  }
  config.put("toolsTextByCategory",toolsTextByCategory);
  paramSchema = Map();
  paramSchema.put("track_package","REQUIRED: trackingNumber (string — número de seguimiento del paquete)");
  paramSchema.put("search_services","OPTIONAL: serviceType (string), destination (string)");
  paramSchema.put("list_service_types","OPTIONAL: (ninguno — catálogo estático, sin parámetros)");
  paramSchema.put("find_offices","OPTIONAL: city (string), country (string), phone (string), document (string)");
  paramSchema.put("check_coverage","OPTIONAL: country (string), city (string), vendor (string)");
  paramSchema.put("find_contacts","OPTIONAL: name (string), phone (string), document (string)");
  paramSchema.put("report_top_customers","REQUIRED: serviceType (List<string> ≥1 elemento: Locker, Store, Recharge, Online Store, Other Services). OPTIONAL: limit (string), office (string), city (string), period (enum: ultimo_mes|mes_anterior|este_mes|ultimos_7_dias), startDate (date), endDate (date)");
  paramSchema.put("report_top_package_customers","OPTIONAL: measure (string: packages|pounds), limit (string), serviceType (string), office (string), city (string), period (enum: ultimo_mes|mes_anterior|este_mes|ultimos_7_dias), startDate (date), endDate (date)");
  paramSchema.put("report_top_remittance_customers","OPTIONAL: limit (string), office (string), city (string), period (enum: ultimo_mes|mes_anterior|este_mes|ultimos_7_dias), startDate (date), endDate (date)");
  paramSchema.put("report_pounds_shipped","OPTIONAL: period (enum: ultimo_mes|mes_anterior|este_mes|ultimos_7_dias — NUNCA calcules fechas; devuelve el enum string), office (string), country (string), measure (string)");
  paramSchema.put("report_daily_average","OPTIONAL: period (enum: ultimo_mes|mes_anterior|este_mes|ultimos_7_dias — NUNCA calcules fechas; devuelve el enum string), office (string), country (string)");
  paramSchema.put("report_monthly_comparison","OPTIONAL: period (enum: ultimo_mes|mes_anterior|este_mes|ultimos_7_dias — NUNCA calcules fechas; devuelve el enum string), months (string), office (string)");
  paramSchema.put("report_shipping_type_frequency","OPTIONAL: limit (string), office (string)");
  paramSchema.put("report_merchandise_type","OPTIONAL: limit (string), office (string)");
  paramSchema.put("report_delayed_packages","OPTIONAL: destCountry (string)");
  paramSchema.put("report_unscanned_packages","OPTIONAL: limit (string), office (string)");
  config.put("paramSchema",paramSchema);
  return config;

}