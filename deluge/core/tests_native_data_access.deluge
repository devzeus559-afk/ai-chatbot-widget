// ==========================================================================
// (c) Type match ChatRequests[ID == requestId] — Number coercion
// ==========================================================================
map tests_native_data_access.test_chat_requests_id_type_match(map counters)
{
  // Buscar un chat request real
  requests = ChatRequests[ID != 0] sort by ID range from 0 to 0;
  if(requests == null || requests.count() == 0)
  {
    info "[INFO] chat_requests_id_type: sin chat requests (data prereq)";
    return counters;
  }
  realRec = requests;
  realId = realRec.ID;
  info "chat_requests_id_type: ID real=" + realId + " (ID de Creator es Number; primero se pasa como tal, luego como String→toNumber)";

  // Pasar como Number (tipo explícito del helper)
  result = thisapp.chat_data_access.fetch_chat_requests_by_id(realId);
  counters = thisapp.tests_common.assert_true("chat_requests_id_type: Number match",result != null && result.size() > 0,counters,"ID=" + realId + " result=" + if(result != null,result.size(),0));

  // Pasar como String (coerción String→Number)
  resultStr = thisapp.chat_data_access.fetch_chat_requests_by_id(toNumber("" + realId));
  counters = thisapp.tests_common.assert_true("chat_requests_id_type: String→Number coercion",resultStr != null && resultStr.size() > 0,counters,"ID=" + realId + " result=" + if(resultStr != null,resultStr.size(),0));
  return counters;
}

// ==========================================================================
// (d) Zia no-comma syntax — el editor acepta la sintaxis
// La suite corriendo ya implica que el editor de Creator aceptó las llamadas
// a Zia en chat_intent/chat_invoke. No se puede assert en runtime.
// ==========================================================================
map tests_native_data_access.test_zia_no_comma_syntax(map counters)
{
  info "[INFO] zia_no_comma: la sintaxis Zia sin coma entre parámetros se verifica por aceptación del editor de Creator. Esta suite corriendo ya implica que el editor aceptó todas las funciones (incluidas las llamadas a Zia en chat_intent/chat_invoke).";
  return counters;
}

// ==========================================================================
// Inserts — NUNCA se insertan registros en el suite
// Los inserts se ejercitan en el E2E widget turn, no aquí.
// ==========================================================================
map tests_native_data_access.test_inserts_note(map counters)
{
  info "[INFO] inserts: insert_chat_session / insert_chat_message NO se llaman en este suite (no hay delete API — dejaría basura en live). Insert se ejercita en el E2E widget turn, no en suite.";
  return counters;
}

// ==========================================================================
// Tools — 0/1/2+ params + empty intersection
// ==========================================================================

// --- track_package ---
map tests_native_data_access.test_track_package_empty(map counters)
{
	empty_map = Map();
	result = thisapp.chat_tools.track_package(empty_map);
  counters = thisapp.tests_common.assert_true("track_package empty: ok=false",result.get("ok") == false,counters,"result=" + result.toString());
  return counters;
}
map tests_native_data_access.test_track_package_not_found(map counters)
{
  result = thisapp.chat_tools.track_package({"trackingNumber":"FAKE-TRACKING-999999"});
  counters = thisapp.tests_common.assert_true("track_package fake: ok=false",result.get("ok") == false,counters,"result=" + result.toString());
  return counters;
}
map tests_native_data_access.test_track_package_real(map counters)
{
  // Buscar un tracking real del módulo Package
  pkgs = Package[Package_ID != null && Package_ID != "" && Latest_Solved_Status != ""] sort by Receipt_Date desc range from 0 to 0;
  if(pkgs == null || pkgs.count() == 0)
  {
    info "[INFO] track_package real: sin paquetes con tracking (data prereq)";
    return counters;
  }
  realTracking = "" + pkgs.Package_ID;
  info "track_package real: tracking=" + realTracking;
  result = thisapp.chat_tools.track_package({"trackingNumber":realTracking});
  counters = thisapp.tests_common.assert_true("track_package real: ok=true",result.get("ok") == true,counters,"result=" + result.toString());
  return counters;
}

// --- search_services ---
map tests_native_data_access.test_services_no_filter(map counters)
{
	empty_map = Map();
	result = thisapp.chat_tools.search_services(empty_map);
  counters = thisapp.tests_common.assert_true("services no-filter: ok=true",result.get("ok") == true,counters,"result=" + result.toString());
  data = result.get("data");
  if(data == null || data.size() == 0)
  {
    info "[INFO] services no-filter: data vacía (data prereq)";
  }
  else
  {
    info "services no-filter: " + data.size() + " registros";
  }
  return counters;
}
map tests_native_data_access.test_services_by_type_real(map counters)
{
  // Derivar tipo real de un servicio existente
  allServices = thisapp.chat_data_access.fetch_services_all();
  if(allServices == null || allServices.size() == 0)
  {
    info "[INFO] services by type real: sin servicios (data prereq)";
    return counters;
  }
  realType = allServices.get(0).get("serviceType");
  if(realType == null || realType == "")
  {
    info "[INFO] services by type real: serviceType null en primer registro (data prereq)";
    return counters;
  }
  info "services by type real: tipo=" + realType;
  result = thisapp.chat_tools.search_services({"serviceType":realType});
  counters = thisapp.tests_common.assert_true("services type real: ok=true con data",result.get("ok") == true && result.get("data") != null && result.get("data").size() > 0,counters,"result=" + result.toString());
  return counters;
}
map tests_native_data_access.test_services_type_not_found(map counters)
{
  result = thisapp.chat_tools.search_services({"serviceType":"__TipoInexistente__"});
  counters = thisapp.tests_common.assert_true("services type miss: ok=true data=[]",result.get("ok") == true && result.get("data") != null && result.get("data").size() == 0,counters,"result=" + result.toString());
  return counters;
}
map tests_native_data_access.test_services_type_and_destination(map counters)
{
  // Derivar tipo + destination real de un servicio existente
  allServices = thisapp.chat_data_access.fetch_services_all();
  if(allServices == null || allServices.size() == 0)
  {
    info "[INFO] services type+dest: sin servicios (data prereq)";
    return counters;
  }
  realType = allServices.get(0).get("serviceType");
  // Buscar destination: usar un destino derivado del módulo Coverage_Location
  coverage = thisapp.chat_data_access.fetch_coverage_all();
  realDest = null;
  if(coverage != null && coverage.size() > 0)
  {
    // country del primer coverage como destino genérico
    realDest = coverage.get(0).get("country");
  }
  if(realType == null || realType == "" || realDest == null || realDest == "")
  {
    info "[INFO] services type+dest: datos insuficientes (data prereq)";
    return counters;
  }
  info "services type+dest: tipo=" + realType + " dest=" + realDest;
  result = thisapp.chat_tools.search_services({"serviceType":realType,"destination":realDest});
  counters = thisapp.tests_common.assert_true("services type+dest: ok=true",result.get("ok") == true,counters,"result=" + result.toString());
  // La intersección puede ser vacía (no hay servicio de ese tipo en ese destino)
  data = result.get("data");
  if(data == null || data.size() == 0)
  {
    info "[INFO] services type+dest: intersección vacía (data prereq)";
  }
  else
  {
    info "services type+dest: " + data.size() + " registros";
  }
  return counters;
}
map tests_native_data_access.test_list_service_types(map counters)
{
  result = thisapp.chat_tools.list_service_types(Map());
  counters = thisapp.tests_common.assert_true("list_service_types: ok=true",result.get("ok") == true,counters,"result=" + result.toString());
  data = result.get("data");
  counters = thisapp.tests_common.assert_true("list_service_types: 7 tipos",data != null && data.size() == 7,counters,"data=" + if(data == null,"null",data.size().toString()));
  counters = thisapp.tests_common.assert_true("list_service_types: primero Package Receipt",data != null && data.size() > 0 && data.get(0).get("type") == "Package Receipt",counters,"data=" + if(data == null,"null",data.toString()));
  return counters;
}

