/**
 * tests_native_data_access.deluge
 *
 * Suite SMOKE para el gate 5.1 del cambio native-data-access.
 * Verifica las 4 asunciones del gate + los 5 tools migrados (0/1/2+ params,
 * empty intersection) + history order, usando helpers tipados de data_access.
 *
 * NO llama a Zia ni usa la Client API (addRecord/deleteRecord): solo acceso
 * nativo vía chat_data_access + chat_tools — 100% ejecutable en el editor
 * de Deluge.
 *
 * NO inserta registros (no hay delete API — dejaría basura en live).
 * Los asserts usan tests_common.* (helpers compartidos).
 *
 * Ejecución: pegar como funciones tests_native_data_access.* en Creator
 * (junto con tests_common.*) y llamar los runners por grupo (un run()
 * monolítico excede el límite de sentencias de Deluge):
 *   run_fetch_all(), run_fetch_ids(), run_tools_track(),
 *   run_tools_services(), run_tools_offices(), run_tools_coverage(),
 *   run_tools_contacts(), run_history()
 * Revisar logs `info`. No usa Form[criteriaVar] ni API de Creator.
 */

// ==========================================================================
// (a) Fetch-all por form — Form[ID != 0]
// Cada fetch_*_all() debe devolver lista no-null.
// INFO si 0 registros (posible data vacía, no es fallo).
// ==========================================================================
map tests_native_data_access.test_fetch_all_services(map counters)
{
  records = thisapp.chat_data_access.fetch_services_all();
  counters = thisapp.tests_common.assert_true("fetch_all_services: no-null",records != null,counters,"records=null");
  if(records != null)
  {
    info "fetch_all_services: " + records.size() + " registros";
    if(records.size() == 0)
    {
      info "[INFO] fetch_all_services: 0 registros (data prereq)";
    }
  }
  return counters;
}
