  return counters;
}
map tests_native_data_access.test_coverage_country_and_service_type(map counters)
{
  // Derivar country + serviceType de datos reales
  allCoverage = thisapp.chat_data_access.fetch_coverage_all();
  allVendors = thisapp.chat_data_access.fetch_vendors_all();
  realCountry = null;
  realType = null;
  if(allCoverage != null && allCoverage.size() > 0)
  {
    realCountry = allCoverage.get(0).get("country");
  }
  if(allVendors != null && allVendors.size() > 0)
  {
    realType = allVendors.get(0).get("vendorType");
  }
  if(realCountry == null || realCountry == "" || realType == null || realType == "")
  {
    info "[INFO] coverage country+type: datos insuficientes (data prereq)";
    return counters;
  }
  info "coverage country+type: country=" + realCountry + " type=" + realType;
  result = thisapp.chat_tools.check_coverage({"country":realCountry,"serviceType":realType});
  counters = thisapp.tests_common.assert_true("coverage country+type: ok=true",result.get("ok") == true,counters,"result=" + result.toString());
  // Las locations se filtran por country; los vendors por serviceType (independientes)
  return counters;
}

// --- find_contacts ---
map tests_native_data_access.test_contacts_no_filter(map counters)
{
  result = thisapp.chat_tools.find_contacts(Map());
  counters = thisapp.tests_common.assert_true("contacts no-filter: ok=true",result.get("ok") == true,counters,"result=" + result.toString());
