map tests_native_data_access.test_contacts_by_name_real(map counters)
{
  allContacts = thisapp.chat_data_access.fetch_contacts_all();
  if(allContacts == null || allContacts.size() == 0)
  {
    info "[INFO] contacts name real: sin contactos (data prereq)";
    return counters;
  }
  // fullName viene de fetch_contacts_all (first + last + suffix concatenado)
  realName = allContacts.get(0).get("fullName");
  if(realName == null || realName == "")
  {
    info "[INFO] contacts name real: fullName null (data prereq)";
    return counters;
  }
