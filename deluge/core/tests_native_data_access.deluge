// ==========================================================================
// (b) Fetch por IDs — Form[ID in ids] + empty guard
// Tomar IDs reales de fetch_*_all(), llamar fetch_*_by_ids(ids), assert
// size() == ids.size(). Empty guard: tool con filtro que no matchea → data:[]
// ==========================================================================
map tests_native_data_access.test_fetch_services_by_ids(map counters)
{
  allRecords = thisapp.chat_data_access.fetch_services_all();
  if(allRecords == null || allRecords.size() == 0)
  {
    info "[INFO] fetch_services_by_ids: sin registros para extraer IDs (data prereq)";
    return counters;
  }
  // Tomar IDs reales (máx 3) — for each + contador (Deluge no soporta while)
  ids = List();
  limit = allRecords.size();
  if(limit > 3)
  {
    limit = 3;
  }
  i = 0;
  for each rec in allRecords
  {
    if(i < limit)
    {
      recId = rec.get("zid");
      if(recId != null)
      {
        ids.add(recId);
      }
    }
    i = i + 1;
  }
  if(ids.size() == 0)
  {
    info "[INFO] fetch_services_by_ids: no se pudieron extraer IDs (data prereq)";
    return counters;
  }
  fetched = thisapp.chat_data_access.fetch_services_by_ids(ids);
  counters = thisapp.tests_common.assert_true("fetch_services_by_ids: count coincide",fetched != null && fetched.size() == ids.size(),counters,"ids=" + ids.size() + " fetched=" + if(fetched != null,fetched.size(),0));
  return counters;
}
map tests_native_data_access.test_fetch_offices_by_ids(map counters)
{
  allRecords = thisapp.chat_data_access.fetch_offices_all();
  if(allRecords == null || allRecords.size() == 0)
  {
    info "[INFO] fetch_offices_by_ids: sin registros (data prereq)";
    return counters;
  }
  // fetch_offices_all no retorna zid directamente; usar ID del registro nativo
  records = Commercial_Office[Active == true] sort by Office_Name range from 0 to 2;
  ids = List();
  for each  r in records
  {
    ids.add(r.ID);
  }
  if(ids.size() == 0)
  {
    info "[INFO] fetch_offices_by_ids: no se pudieron extraer IDs (data prereq)";
    return counters;
  }
  fetched = thisapp.chat_data_access.fetch_offices_by_ids(ids);
  counters = thisapp.tests_common.assert_true("fetch_offices_by_ids: count coincide",fetched != null && fetched.size() == ids.size(),counters,"ids=" + ids.size() + " fetched=" + if(fetched != null,fetched.size(),0));
