  result = thisapp.chat_tools.find_contacts({"name":realName});
  counters = thisapp.tests_common.assert_true("contacts name real: ok=true",result.get("ok") == true,counters,"result=" + result.toString());
  data = result.get("data");
  if(data == null || data.size() == 0)
  {
    info "[INFO] contacts name real: 0 resultados (data prereq; nombre puede no matchear por composición)";
  }
  else
  {
    info "contacts name real: " + data.size() + " resultados";
  }
  return counters;
}
map tests_native_data_access.test_contacts_not_found(map counters)
{
  result = thisapp.chat_tools.find_contacts({"name":"NombreInexistenteXYZ123"});
  counters = thisapp.tests_common.assert_true("contacts name miss: ok=true data=[]",result.get("ok") == true && result.get("data") != null && result.get("data").size() == 0,counters,"result=" + result.toString());
  return counters;
}

// ==========================================================================
// History order — desc por Created_Time
// Si hay ≥2 mensajes de una sesión real, assert desc order.
// ==========================================================================
map tests_native_data_access.test_history_order(map counters)
{
  // Buscar una sesión con ≥2 mensajes
  sessions = ChatSessions[ID != 0] sort by ID range from 0 to 0;
  if(sessions == null || sessions.count() == 0)
  {
    info "[INFO] history order: sin sesiones (data prereq)";
    return counters;
  }
  sessionId = sessions.ID;
  messages = thisapp.chat_data_access.fetch_chat_messages_by_session(sessionId);
  if(messages == null || messages.size() < 2)
  {
    info "[INFO] history order: sesión " + sessionId + " tiene " + if(messages != null,messages.size(),0) + " mensajes (se necesitan ≥2, data prereq)";
    return counters;
  }
  info "history order: sesión " + sessionId + " tiene " + messages.size() + " mensajes";
  // Verificar desc order por Created_Time
  orderOk = true;
  prevTime = null;
  for each  m in messages
  {
    t = m.get("Created_Time");
    if(prevTime != null && t != null)
    {
      if(t > prevTime)
      {
        orderOk = false;
        info "[FAILED] history order: Created_Time subió — " + t + " > " + prevTime;
      }
    }
    if(t != null)
    {
      prevTime = t;
    }
  }
  counters = thisapp.tests_common.assert_true("history order: Created_Time desc",orderOk == true,counters,"orden violado (Created_Time subió entre mensajes consecutivos)");
  return counters;
}

// ==========================================================================
// Orquestadores — divididos por grupo: run() monolítico excede el límite de
// sentencias de Deluge. Ejecutar cada runner por separado en Creator:
//   tests_native_data_access.run_fetch_all()
//   tests_native_data_access.run_fetch_ids()
//   tests_native_data_access.run_tools_track()
//   tests_native_data_access.run_tools_services()
//   tests_native_data_access.run_tools_offices()
//   tests_native_data_access.run_tools_coverage()
//   tests_native_data_access.run_tools_contacts()
//   tests_native_data_access.run_history()
// Cada runner reporta su propio resumen passed/failed.
// ==========================================================================
map tests_native_data_access.run_fetch_all()
{
  counters = Map();
  counters.put("passed",0);
  counters.put("failed",0);
  info "=== SMOKE native_data_access: (a) Fetch-all por form ===";
  counters = thisapp.tests_native_data_access.test_fetch_all_services(counters);
  counters = thisapp.tests_native_data_access.test_fetch_all_offices(counters);
  counters = thisapp.tests_native_data_access.test_fetch_all_coverage(counters);
  counters = thisapp.tests_native_data_access.test_fetch_all_vendors(counters);
  counters = thisapp.tests_native_data_access.test_fetch_all_contacts(counters);
  counters = thisapp.tests_native_data_access.test_fetch_all_chat_sessions(counters);
  counters = thisapp.tests_native_data_access.test_fetch_all_chat_messages(counters);
  counters = thisapp.tests_native_data_access.test_fetch_all_chat_requests(counters);
  info "=== run_fetch_all done — passed: " + counters.get("passed") + " failed: " + counters.get("failed");
  return counters;
}
