/**
 * chat_intent.deluge
 *
 * Router de intención: llama a la tarea Zia de Deluge y normaliza la salida
 * a UNO de estos contratos:
 *
 *   {"tool": "<nombre>", "params": {...}}   → necesita datos de la app
 *   {"answer": "<texto>"}                    → respuesta directa sin tools
 *   {"clarify": "<pregunta>"}                → falta información
 *
 * La salida de Zia es TEXTO; se pide JSON estricto con temperature 0 y se
 * valida con parse_json_strict (chat_common.deluge). La llamada Zia usa la
 * sintaxis oficial SIN comas (cada parámetro nombrado en su propia línea).
 */

Map chat_intent(String userPrompt, List history)
{
    config = chat_config();
    catalogText = config.get("toolsText");

    context = "Eres un asistente virtual de una agencia internacional de paquetería, "
            + "remesas y recargas telefónicas. Ayudas a clientes y agentes a consultar "
            + "datos de la aplicación. Debes responder ÚNICAMENTE con JSON válido, "
            + "sin texto adicional ni markdown.";

    message = build_intent_prompt(userPrompt, history, catalogText);

    response = Zia[
        message : message
        context : context
        parameters : {"temperature": 0.0}
    ];

    // Zia puede devolver null al fallar (p. ej. IA no habilitada en la
    // organización). Nunca evaluar !null en Deluge: derivar a la rama de
    // error, no romper el turno.
    if (response == null) {
        return {"status": "error", "kind": "clarify",
                "text": "No pude interpretar tu solicitud. ¿Puedes reformularla?"};
    }

    // Formas de respuesta de Zia (observadas en gate 5.1):
    //  A) {"status": true, "data": "<json>"} → wrapper clásico
    //  B) {"answer": ...} (o {"tool": ...})   → JSON directo sin wrapper
    data = response.get("data");
    if (response.get("status") == true && data != null) {
        parsed = parse_json_strict(data.toString());
    } else {
        parsed = parse_json_strict(response.toString());
    }

    // Normalización del contrato (con try/catch por si el JSON no es un objeto)
    try {
        if (parsed.containsKey("parse_error")) {
            return {"status": "error", "kind": "clarify",
                    "text": "No pude interpretar tu solicitud. ¿Puedes reformularla?"};
        }
        if (parsed.containsKey("tool")) {
            params = parsed.get("params");
            if (params == null) {
                params = Map();
            }
            return {"status": "ok", "kind": "tool",
                    "tool": parsed.get("tool"), "params": params};
        }
        if (parsed.containsKey("answer")) {
            return {"status": "ok", "kind": "answer", "text": parsed.get("answer")};
        }
        if (parsed.containsKey("clarify")) {
            return {"status": "ok", "kind": "clarify", "text": parsed.get("clarify")};
        }
    } catch (e) {
        // JSON válido pero con otra forma: pedir reformulación
    }

    return {"status": "error", "kind": "clarify",
            "text": "No pude interpretar tu solicitud. ¿Puedes reformularla?"};
}

String build_intent_prompt(String userPrompt, List history, String catalogText)
{
    prompt = "CONTRATO DE SALIDA: Devuelve SOLO JSON válido con UNO de estos tres formatos:\n";
    prompt = prompt + "1) {\"tool\": \"<nombre_tool>\", \"params\": {<parámetros>}} cuando necesites datos de la app.\n";
    prompt = prompt + "2) {\"answer\": \"<texto>\"} cuando puedas responder sin consultar datos.\n";
    prompt = prompt + "3) {\"clarify\": \"<pregunta>\"} cuando falte información para elegir una herramienta.\n\n";

    prompt = prompt + "HERRAMIENTAS DISPONIBLES:\n" + catalogText + "\n\n";

    if (history != null && history.size() > 0) {
        prompt = prompt + "HISTORIAL RECIENTE:\n";
        for each m in history {
            prompt = prompt + m.get("role") + ": " + m.get("content") + "\n";
        }
        prompt = prompt + "\n";
    }

    prompt = prompt + "MENSAJE ACTUAL DEL USUARIO:\n" + userPrompt;
    return prompt;
}
