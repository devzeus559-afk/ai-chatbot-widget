/**
* chat_intent.deluge
*
* Router de intención: llama a la tarea Zia de Deluge y normaliza la salida
* a UNO de estos contratos:
*
*   {"tool": "<nombre>", "params": {...}}   → necesita datos de la app
*   {"answer": "<texto>"}                    → respuesta directa sin tools
*   {"clarify": "<pregunta>"}                → falta información
*
* La tarea Zia retorna un objeto con atributos .status, .data, .error.
* .data es el TEXTO del LLM (se parsea con parse_json_strict de
* chat_common.deluge). La llamada Zia usa la sintaxis oficial SIN comas
* (cada parámetro nombrado en su propia línea).
*/

string chat_intent.build_intent_prompt(string userPrompt, list history, string catalogText)
{
  prompt = "CONTRATO DE SALIDA: Devuelve SOLO JSON válido con UNO de estos tres formatos:\n";
  prompt = prompt + "1) {\"tool\": \"<nombre_tool>\", \"params\": {<parámetros>}} cuando necesites datos de la app.\n";
  prompt = prompt + "2) {\"answer\": \"<texto>\"} cuando puedas responder sin consultar datos.\n";
  prompt = prompt + "3) {\"clarify\": \"<pregunta>\"} cuando falte información para elegir una herramienta.\n\n";
  prompt = prompt + "HERRAMIENTAS DISPONIBLES:\n" + catalogText + "\n\n";
  prompt = prompt + "EJEMPLOS DE PARÁMETROS POR HERRAMIENTA:\n";
  prompt = prompt + "- track_package: usuario dice 'rastrear P-123456' → {\"trackingNumber\": \"P-123456\"}\n";
  prompt = prompt + "- search_services: 'servicios a Madrid' → {\"destination\": \"Madrid\"}; 'paquetería' → {\"serviceType\": \"Package Receipt\"}\n";
  prompt = prompt + "- find_offices: 'oficinas en Estados Unidos' → {\"country\": \"Estados Unidos\"}; 'oficina New York' → {\"city\": \"New York\"}\n";
  prompt = prompt + "- check_coverage: 'cobertura Cuba' → {\"country\": \"Cuba\"}; 'proveedores paquetería' → {\"serviceType\": \"Package Receipt\"}\n";
  prompt = prompt + "- find_contacts: 'contacto Juan Pérez' → {\"name\": \"Juan Pérez\"}; 'tel 555-1234' → {\"phone\": \"555-1234\"}\n";
  prompt = prompt + "- report_*: 'reporte top 5 de clientes Locker' → {\"serviceType\": [\"Locker\"], \"limit\": \"5\"}; 'oficina New York' → {\"office\": \"New York\"}\n";
  prompt = prompt + "- REGLA report_top_customers: serviceType es OBLIGATORIO como lista (ej. [\"Locker\"]); si el usuario no indica tipo de servicio, devuelve {\"clarify\": \"...\"}. Paquetería → report_top_package_customers; remesas → report_top_remittance_customers.\n\n";
  prompt = prompt + "REGLA CRÍTICA: Si el usuario NO especifica un parámetro opcional, OMÍTELO del JSON (no pases null ni string vacío). Si FALTA uno requerido (ej. trackingNumber), devuelve {\"clarify\": \"...\"}.\n\n";
  if(history != null && history.size() > 0)
  {
    prompt = prompt + "HISTORIAL RECIENTE:\n";
    for each  m in history
    {
      prompt = prompt + m.get("role") + ": " + m.get("content") + "\n";
    }
    prompt = prompt + "\n";
  }
  prompt = prompt + "MENSAJE ACTUAL DEL USUARIO:\n" + userPrompt;
  return prompt;
}
map chat_intent.normalize_zia_response(map response)
{
  // Normaliza la respuesta cruda de Zia al contrato {status,kind,tool/params/text}.
  // Extraído para testeo unitario sin llamar a Zia (ver tests_chat_intent.deluge).
  // Zia puede devolver null o un Map sin "status" al fallar (p. ej. IA no habilitada).
  if(response == null)
  {
    return {"status":"error","kind":"clarify","text":"No pude interpretar tu solicitud. ¿Puedes reformularla?"};
  }
  if(response.get("status") == true && response.get("data") != null)
  {
    dataValue = response.get("data");
    parsed = null;
    try
    {
      dataFormatted = dataValue.toMap();
      if(dataFormatted.containKey("tool") || dataFormatted.containKey("answer") || dataFormatted.containKey("clarify"))
      {
        parsed = dataFormatted;
      }
    } catch (e)
    {
      // toMap lanzó (fences/ruido) — cae a parse_json_strict
    }
    if(parsed == null)
    {
      parsed = thisapp.chat_common.parse_json_strict(dataValue);
    }
  }
  else
  {
    errorMsg = if(response.get("error") != null,response.get("error"),"Error desconocido");
    return {"status":"error","kind":"clarify","text":"No pude interpretar tu solicitud. " + errorMsg};
  }
  // Normalización del contrato (con try/catch por si el JSON no es un objeto)
  try
  {
    if(parsed.containKey("parse_error"))
    {
      return {"status":"error","kind":"clarify","text":"No pude interpretar tu solicitud. ¿Puedes reformularla?"};
    }
    if(parsed.containKey("tool"))
    {
      toolName = parsed.get("tool");
      params = parsed.get("params");
      if(params == null)
      {
        params = Map();
      }
      // Validación de campos requeridos (solo track_package tiene required)
      if(toolName == "track_package")
      {
        trackingNumber = params.get("trackingNumber");
        if(trackingNumber == null || trackingNumber == "")
        {
          // status "ok" + kind "clarify" para que resolve_reply lo maneje como clarify válido
          return {"status":"ok","kind":"clarify","text":"Necesito el número de seguimiento para rastrear tu paquete. ¿Puedes proporcionármelo?"};
        }
      }
      return {"status":"ok","kind":"tool","tool":toolName,"params":params};
    }
    if(parsed.containKey("answer"))
    {
      return {"status":"ok","kind":"answer","text":parsed.get("answer")};
    }
    if(parsed.containKey("clarify"))
    {
      return {"status":"ok","kind":"clarify","text":parsed.get("clarify")};
    }
  } catch (e)
  {
    // JSON válido pero con otra forma: pedir reformulación
  }
  return {"status":"error","kind":"clarify","text":"No pude interpretar tu solicitud. ¿Puedes reformularla?"};
}
map chat_intent.chat_intent(string userPrompt, list history)
{
  /**
   * chat_intent.dg
   *
   * Router de intención: llama a la tarea Zia de Deluge y normaliza la salida
   * a UNO de estos contratos:
   *
   *   {"tool": "<nombre>", "params": {...}}   → necesita datos de la app
   *   {"answer": "<texto>"}                    → respuesta directa sin tools
   *   {"clarify": "<pregunta>"}                → falta información
   *
   * La salida de Zia es TEXTO; se pide JSON estricto con temperature 0.1 y se
   * valida con parse_json_strict (chat_common.dg).
   */
  config = thisapp.chat_config.chat_config();
  catalogText = config.get("toolsText");
  context = "Eres un asistente virtual de una agencia internacional de paquetería, " + "remesas y recargas telefónicas. Ayudas a clientes y agentes a consultar " + "datos de la aplicación. Debes responder ÚNICAMENTE con JSON válido, " + "sin texto adicional ni markdown.";
  context = context + " Si el usuario pregunta sobre algo NO relacionado con " + "paquetería, rastreo de envíos, remesas, recargas telefónicas, cobertura, " + "oficinas o contactos de la empresa, responde SOLO con: " + "{\"clarify\": \"Lo siento, solo puedo ayudarte con temas de paquetería, " + "remesas y recargas. ¿En qué puedo asistirte?\"}";
  context = context + " Cuando el usuario pregunte por servicios, cobertura, oficinas " + "o contactos, DEBES usar la herramienta correspondiente. Nunca respondas " + "directamente.";
  context = context + " INFORMACIÓN COMERCIAL:\n" + "- Métodos de pago aceptados: transferencia bancaria, efectivo, tarjeta de crédito/débito\n" + "- Servicios: paquetería internacional, remesas, recargas telefónicas\n" + "- Cobertura: Latinoamérica, España, Estados Unidos";
  context = context + " Para consultas sobre métodos de pago, responde directamente " + "con la información comercial proporcionada. Ejemplo: si preguntan por Bitcoin, " + "responde que los métodos aceptados son transferencia bancaria, efectivo y tarjeta.";
  message = thisapp.chat_intent.build_intent_prompt(userPrompt,history,catalogText);
  zia_response = zia
  [
  message:message
  context:context
  parameters:{"temperature":0.1}
  ];
  if(zia_response == null)
  {
    return thisapp.chat_intent.normalize_zia_response(null);
  }
  // La respuesta de Zia task es un objeto con atributos accedidos por punto:
	//   response.status → boolean (éxito de la tarea)
	//   response.data   → String (texto del LLM, contiene JSON) o Map ya parseado
	//   response.error  → String/null (mensaje si falló)	
  response = Map();
	response.put("status",zia_response.status);
	response.put("data",zia_response.data);
	response.put("error",zia_response.error);
  return thisapp.chat_intent.normalize_zia_response(response);
}