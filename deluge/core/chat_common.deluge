/**
* chat_common.deluge
*
* Helpers compartidos por el backend del chatbot.
* Funciones: parse_json_strict, compose_reply, format_tracking,
*            format_services, format_offices, format_coverage,
*            format_contacts, format_top_customers,
*            format_top_package_customers, format_top_remittance_customers,
*            format_shipping_type_frequency, format_merchandise_type,
*            format_pounds_shipped, format_daily_average,
*            format_monthly_comparison, format_delayed_packages,
*            format_unscanned_packages,
*            build_empty_report, build_empty_package_customers_report,
*            build_empty_remittance_report, build_empty_shipping_report,
*            build_empty_merchandise_report, build_breakdown_list,
*            first_of_month, days_in_month_range
*
* Nota: el filtrado nativo NO usa builders de criterios (Form[criteriaVar]
* es inválido en Creator, gate 5.1). La combinación AND se hace en las tools
* con IDs por condición (addAll/intersect) — ver data_access.deluge.
*/

// --------------------------------------------------------------------------
// Parseo robusto de JSON devuelto por Zia
// --------------------------------------------------------------------------
// Zia devuelve TEXTO. Si toMap() falla (markdown fences, ruido), se intenta
// extraer el bloque entre el primer "{" y el último "}".
map chat_common.build_empty_report(date startDate, date endDate, string serviceType)
{
  // Reporte vacío (ventana sin datos o intersección vacía): customers: []
  // para que format_top_customers responda con el mensaje de "no encontré".
  data = Map();
  data.put("reportType","top_customers");
  data.put("periodStart",startDate);
  data.put("periodEnd",endDate);
  data.put("serviceType",serviceType);
  data.put("totalServices",0);
  data.put("totalCustomers",0);
  data.put("truncated",false);
  data.put("customers",List());
  return {"ok":true,"data":data};
}
map chat_common.build_viz(String type, String title, List labels, List series)
{
  // --------------------------------------------------------------------------
  // Motor de visualización: construye el envelope JSON para el widget.
  // type: "bar" | "table" | "none" (decisión determinista, no-Zia).
  // labels: categorías para el eje X (e.g. ["Juan", "María", "Pedro"]).
  // series: [{name, values}] — una o más series de datos.
  // title: texto descriptivo del gráfico.
  // El widget recibe {text, visualization} y renderiza sin dependencias.
  // --------------------------------------------------------------------------
  if(type == null || type == "")
  {
    type = "none";
  }
  viz = Map();
  viz.put("type",type);
  viz.put("title",title);
  viz.put("labels",labels);
  viz.put("series",series);
  return viz;
}
map chat_common.compose_reply(map toolResult, map intent)
{
  // --------------------------------------------------------------------------
  // Composición de respuestas por plantilla (default, sin segunda llamada Zia)
  // --------------------------------------------------------------------------
  if(!toolResult.get("ok"))
  {
    return {"text":"No pude completar la búsqueda. " + toolResult.get("message"),"visualization":null};
  }
  toolName = intent.get("tool");
  data = toolResult.get("data");
  viz = toolResult.get("visualization");
  if(toolName == "track_package")
  {
    return {"text":thisapp.chat_common.format_tracking(data),"visualization":viz};
  }
  if(toolName == "search_services")
  {
    return {"text":thisapp.chat_common.format_services(data),"visualization":viz};
  }
  if(toolName == "find_offices")
  {
    return {"text":thisapp.chat_common.format_offices(data),"visualization":viz};
  }
  if(toolName == "check_coverage")
  {
    return {"text":thisapp.chat_common.format_coverage(data,toolResult.get("vendors")),"visualization":viz};
  }
  if(toolName == "find_contacts")
  {
    return {"text":thisapp.chat_common.format_contacts(data),"visualization":viz};
  }
  if(toolName == "report_top_customers")
  {
    return {"text":thisapp.chat_common.format_top_customers(data),"visualization":viz};
  }
  if(toolName == "report_top_package_customers")
  {
    return {"text":thisapp.chat_common.format_top_package_customers(data),"visualization":viz};
  }
  if(toolName == "report_top_remittance_customers")
  {
    return {"text":thisapp.chat_common.format_top_remittance_customers(data),"visualization":viz};
  }
  if(toolName == "report_shipping_type_frequency")
  {
    return {"text":thisapp.chat_common.format_shipping_type_frequency(data),"visualization":viz};
  }
  if(toolName == "report_merchandise_type")
  {
    return {"text":thisapp.chat_common.format_merchandise_type(data),"visualization":viz};
  }
  if(toolName == "report_pounds_shipped")
  {
    return {"text":thisapp.chat_common.format_pounds_shipped(data),"visualization":viz};
  }
  if(toolName == "report_daily_average")
  {
    return {"text":thisapp.chat_common.format_daily_average(data),"visualization":viz};
  }
  if(toolName == "report_monthly_comparison")
  {
    return {"text":thisapp.chat_common.format_monthly_comparison(data),"visualization":viz};
  }
  if(toolName == "report_delayed_packages")
  {
    return {"text":thisapp.chat_common.format_delayed_packages(data),"visualization":viz};
  }
  if(toolName == "report_unscanned_packages")
  {
    return {"text":thisapp.chat_common.format_unscanned_packages(data),"visualization":viz};
  }
  return {"text":"Datos obtenidos: " + data.toString(),"visualization":viz};
}
string chat_common.decidirVisualizacion(List labels, Bool esSerieTiempo)
{
  // Decide el tipo de visualización de forma determinista (sin Zia):
  // - breakdown vacío o 1 categoría → "none" (solo texto)
  // - ≤8 categorías, no serie temporal → "bar"
  // - ≥9 categorías → "table" (fallback seguro)
  if(labels == null || labels.size() <= 1)
  {
    return "none";
  }
  if(esSerieTiempo != null && esSerieTiempo == true)
  {
    return "line";
    // fase 2; por ahora devuelve "line" y el widget ignora
  }
  if(labels.size() <= 8)
  {
    return "bar";
  }
  return "table";
}
string chat_common.envelope_to_json(string text, map viz)
{
  return "{\"text\":" + thisapp.chat_common.escape_json_str(text) + ",\"visualization\":" + thisapp.chat_common.viz_to_json(viz) + "}";
}
string chat_common.escape_json_str(string s)
{
  // --------------------------------------------------------------------------
  // Serialización JSON manual — Deluge Map.toString() NO produce JSON válido
  // (genera {key=value} en vez de {"key":"value"}). Esta función serializa
  // el envelope {text, visualization} a JSON válido para el widget.
  // --------------------------------------------------------------------------
  if(s == null)
  {
    return "null";
  }
  result = "" + s;
  // 	result = result.replaceAll("\\","\\\\");
  result = result.replaceAll("\"","\\\"");
  result = result.replaceAll("\n","\\n");
  result = result.replaceAll("\r","\\r");
  result = result.replaceAll("\t","\\t");
  return '\"' + result + '\"';
}
string chat_common.format_contacts(list contacts)
{
  if(contacts == null || contacts.size() == 0)
  {
    return "No encontré contactos con esos datos.";
  }
  text = "Contactos encontrados:\n";
  for each  c in contacts
  {
    line = "- " + c.get("fullName");
    if(c.get("role") != null)
    {
      line = line + " (" + c.get("role") + ")";
    }
    if(c.get("phone") != null)
    {
      line = line + ". Tel: " + c.get("phone");
    }
    if(c.get("email") != null)
    {
      line = line + ". Email: " + c.get("email");
    }
    text = text + line + "\n";
  }
  return text;
}
string chat_common.format_coverage(list coverage, list vendors)
{
  hasLocations = coverage != null && coverage.size() > 0;
  hasVendors = vendors != null && vendors.size() > 0;
  if(!hasLocations && !hasVendors)
  {
    return "No encontré cobertura para esa búsqueda.";
  }
  text = "";
  if(hasLocations)
  {
    text = "Cobertura disponible:\n";
    for each  c in coverage
    {
      line = "- " + c.get("name");
      if(c.get("state") != null && c.get("state") != "")
      {
        line = line + ", " + c.get("state");
      }
      if(c.get("country") != null && c.get("country") != "")
      {
        line = line + " (" + c.get("country") + ")";
      }
      text = text + line + "\n";
    }
  }
  if(hasVendors)
  {
    text = text + "Proveedores:\n";
    for each  v in vendors
    {
      line = "- " + v.get("name");
      if(v.get("type") != null && v.get("type") != "")
      {
        line = line + " (" + v.get("type") + ")";
      }
      text = text + line + "\n";
    }
  }
  return text;
}
string chat_common.format_offices(list offices)
{
  if(offices == null || offices.size() == 0)
  {
    return "No encontré oficinas que coincidan con la búsqueda.";
  }
  text = "Oficinas:\n";
  for each  o in offices
  {
    line = "- " + o.get("name");
    if(o.get("address") != null)
    {
      line = line + ", " + o.get("address");
    }
    if(o.get("city") != null)
    {
      line = line + ", " + o.get("city");
    }
    if(o.get("country") != null)
    {
      line = line + ", " + o.get("country");
    }
    if(o.get("phone") != null)
    {
      line = line + ". Tel: " + o.get("phone");
    }
    if(o.get("hours") != null)
    {
      line = line + ". Horario: " + o.get("hours");
    }
    text = text + line + "\n";
  }
  return text;
}
string chat_common.format_services(list services)
{
	currency = thisapp.chat_config.chat_config().get("currency");
	if(services == null || services.size() == 0)
	{
		return "No encontré servicios que coincidan con la búsqueda.";
	}
	text = "Servicios disponibles:\n";
	index = 1;
	for each  s in services
	{
		line = index + ". " + s.get("serviceId") + " (" + s.get("serviceType") + ")";
		if(s.get("price") != null)
		{
			line = line + " - " + s.get("price") + " " + currency;
		}
		if(s.get("estimatedTime") != null && s.get("estimatedTime") != "")
		{
			line = line + " - " + s.get("estimatedTime");
		}
		text = text + line + "\n";
		index = index + 1;
	}
	return text;
}
string chat_common.format_top_customers(map data)
{
  // --------------------------------------------------------------------------
  // Plantilla del reporte top customers (composeWithAI=false: los nombres y
  // conteos NUNCA se envían al LLM). El breakdown por tipo se omite cuando la
  // tool no emitió ninguno; con truncated: true se añade el aviso de ranking
  // aproximado (ventana > 200 servicios, se analizaron los primeros 200).
  // --------------------------------------------------------------------------
  if(data == null)
  {
    return "No encontré servicios en los últimos 30 días.";
  }
  customers = data.get("customers");
  if(customers == null || customers.size() == 0)
  {
    return "No encontré servicios en los últimos 30 días.";
  }
  text = "Clientes más frecuentes (últimos 30 días):\n";
  for each  c in customers
  {
    line = c.get("rank") + ". " + c.get("customerName") + " — " + c.get("totalServices") + " servicios";
    breakdown = c.get("serviceBreakdown");
    if(breakdown != null && breakdown != "")
    {
      line = line + " (" + breakdown + ")";
    }
    text = text + line + "\n";
  }
  if(data.get("truncated") == true)
  {
    text = text + "Nota: el ranking es aproximado (se analizaron los primeros 200 servicios).\n";
  }
  return text;
}
string chat_common.format_top_package_customers(map data)
{
  if(data == null)
  {
    return "No encontré servicios de paquetería en los últimos 30 días.";
  }
  customers = data.get("customers");
  if(customers == null || customers.size() == 0)
  {
    return "No encontré servicios de paquetería en los últimos 30 días.";
  }
  measure = data.get("measure");
  unitLabel = "paquetes";
  if(measure == "pounds")
  {
    unitLabel = "libras";
  }
  text = "Clientes más frecuentes de paquetería (últimos 30 días):\n";
  for each  c in customers
  {
    line = c.get("rank") + ". " + c.get("customerName") + " — ";
    if(measure == "pounds")
    {
      line = line + c.get("totalPounds") + " libras";
    }
    else
    {
      line = line + c.get("totalPackages") + " paquetes";
    }
    text = text + line + "\n";
  }
  if(data.get("truncated") == true)
  {
    text = text + "Nota: el ranking es aproximado (se analizaron los primeros 200 servicios).\n";
  }
  return text;
}
string chat_common.format_top_remittance_customers(map data)
{
  if(data == null)
  {
    return "No encontré remesas en los últimos 30 días.";
  }
  customers = data.get("customers");
  if(customers == null || customers.size() == 0)
  {
    return "No encontré remesas en los últimos 30 días.";
  }
  text = "Clientes que más remesas envían (últimos 30 días):\n";
  for each  c in customers
  {
    text = text + c.get("rank") + ". " + c.get("customerName") + " — " + c.get("totalAmount") + " USD\n";
  }
  if(data.get("truncated") == true)
  {
    text = text + "Nota: el ranking es aproximado (se analizaron los primeros 200 servicios).\n";
  }
  return text;
}
string chat_common.format_shipping_type_frequency(map data)
{
  if(data == null || data.get("totalPackages") == 0)
  {
    return "No encontré paquetes en los últimos 30 días.";
  }
  text = "Frecuencia por tipo de envío (últimos 30 días):\n";
  text = text + "Total de paquetes: " + data.get("totalPackages") + "\n";
  text = text + "Aéreas: " + data.get("airCount") + " | Marítimas: " + data.get("seaCount") + "\n";
  shipments = data.get("shipments");
  if(shipments != null)
  {
    for each  s in shipments
    {
      text = text + "- " + s.get("className") + " " + s.get("name") + ": " + s.get("packageCount") + " paquetes (" + s.get("sharePct") + "%)\n";
    }
  }
  return text;
}
string chat_common.format_merchandise_type(map data)
{
  if(data == null || data.get("totalPackages") == 0)
  {
    return "No encontré paquetes en los últimos 30 días.";
  }
  text = "Paquetes por tipo de mercancía (últimos 30 días):\n";
  merch = data.get("merchandise");
  if(merch != null)
  {
    for each  m in merch
    {
      text = text + "- " + m.get("name") + ": " + m.get("packageCount") + " paquetes (" + m.get("sharePct") + "%)\n";
    }
  }
  return text;
}
string chat_common.format_pounds_shipped(map data)
{
  if(data == null || data.get("empty") == true)
  {
    if(data != null && data.get("message") != null)
    {
      return data.get("message");
    }
    return "No fue posible calcular las libras enviadas.";
  }
  if(data.get("totalPackages") == 0)
  {
    return "No encontré paquetes en el período indicado.";
  }
  text = "Libras enviadas en el período: " + data.get("totalPounds") + " lbs\n";
  text = text + "Por oficina:\n";
  byOffice = data.get("byOffice");
  if(byOffice != null)
  {
    for each  b in byOffice
    {
      text = text + "- " + b.get("name") + ": " + b.get("pounds") + " lbs (" + b.get("count") + " paquetes)\n";
    }
  }
  text = text + "Por tipo de carga:\n";
  byType = data.get("byPackageType");
  if(byType != null)
  {
    for each  t in byType
    {
      text = text + "- " + t.get("name") + ": " + t.get("pounds") + " lbs\n";
    }
  }
  text = text + "Por clase de envío:\n";
  byClass = data.get("byClass");
  if(byClass != null)
  {
    for each  c in byClass
    {
      text = text + "- " + c.get("name") + ": " + c.get("pounds") + " lbs\n";
    }
  }
  return text;
}
string chat_common.format_daily_average(map data)
{
  if(data == null || data.get("empty") == true)
  {
    return "No fue posible calcular el promedio diario.";
  }
  text = "Promedio diario de libras enviadas: " + data.get("dailyAverage") + " lbs/día (" + data.get("totalPounds") + " lbs en " + data.get("daysInPeriod") + " días).\n";
  return text;
}
string chat_common.format_monthly_comparison(map data)
{
  if(data == null || data.get("empty") == true)
  {
    return "No fue posible generar la comparación mensual.";
  }
  months = data.get("months");
  if(months == null || months.size() == 0)
  {
    return "No hay datos mensuales para comparar.";
  }
  text = "Comparación mensual de libras:\n";
  for each  m in months
  {
    line = m.get("monthLabel") + ": " + m.get("monthlyAverage") + " lbs/día (" + m.get("totalPounds") + " lbs total)";
    delta = m.get("deltaPct");
    if(delta != null)
    {
      line = line + " — " + delta + "% vs mes anterior";
    }
    text = text + "- " + line + "\n";
  }
  return text;
}
string chat_common.format_delayed_packages(map data)
{
  if(data == null || data.get("totalDelayed") == 0)
  {
    return "No encontré cajas demoradas para el destino indicado.";
  }
  text = "Cajas demoradas: " + data.get("totalDelayed") + "\n";
  byClass = data.get("byClass");
  if(byClass != null)
  {
    text = text + "Aéreas: " + byClass.get("air") + " | Marítimas: " + byClass.get("maritime") + "\n";
  }
  delayed = data.get("delayed");
  if(delayed != null)
  {
    for each  d in delayed
    {
      text = text + "- " + d.get("packageId") + " (" + d.get("shippingTypeName") + ", " + d.get("class") + "): " + d.get("daysSinceScan") + " días desde el scan (umbral " + d.get("threshold") + ")";
      if(d.get("status") != null && d.get("status") != "")
      {
        text = text + " — estado: " + d.get("status");
      }
      text = text + "\n";
    }
  }
  return text;
}
string chat_common.format_unscanned_packages(map data)
{
  if(data == null || data.get("empty") == true)
  {
    if(data != null && data.get("message") != null)
    {
      return data.get("message");
    }
    return "No fue posible calcular las cajas sin escanear.";
  }
  if(data.get("totalUnscanned") == 0)
  {
    return "No encontré cajas sin escanear.";
  }
  text = "Cajas sin escanear: " + data.get("totalUnscanned") + "\n";
  packages = data.get("packages");
  if(packages != null)
  {
    for each  p in packages
    {
      text = text + "- " + p.get("packageId") + " (" + p.get("latestStatus") + ")";
      if(p.get("officeName") != null && p.get("officeName") != "")
      {
        text = text + " — " + p.get("officeName");
      }
      text = text + "\n";
    }
  }
  return text;
}
string chat_common.format_tracking(map pkg)
{
  if(pkg == null)
  {
    return "No encontré el paquete.";
  }
  text = "Paquete " + pkg.get("trackingNumber") + "\n";
  text = text + "Estado: " + pkg.get("status") + "\n";
  if(pkg.get("lastUpdate") != null && pkg.get("lastUpdate") != "")
  {
    text = text + "Fecha actualización: " + pkg.get("lastUpdate") + "\n";
  }
  if(pkg.get("currentLocation") != null && pkg.get("currentLocation") != "")
  {
    text = text + "Ubicación actual: " + pkg.get("currentLocation") + "\n";
  }
  text = text + "Origen: " + pkg.get("origin") + "\n";
  text = text + "Destino: " + pkg.get("destination") + "\n";
  if(pkg.get("estimatedDelivery") != null && pkg.get("estimatedDelivery") != "")
  {
    text = text + "Entrega estimada: " + pkg.get("estimatedDelivery");
  }
  return text;
}
list chat_common.insert_ranked_entry(list list_param, int index_param, map entry)
{
  // Inserción indexada por shift-copy: List.add() solo appendea, así que se
  // reconstruye la lista con operaciones garantizadas (size/get/add). El
  // editor de Creator no expone add(index, value); si un día lo hiciera, este
  // helper puede reemplazarse por la llamada directa (ver smoke 6.1b).
  result = List();
  if(index_param == null || index_param < 0)
  {
    index_param = 0;
  }
  if(index_param > list_param.size())
  {
    index_param = list_param.size();
  }
  for each index i in list_param
  {
    if(i == index_param)
    {
      result.add(entry);
    }
    result.add(list_param.get(i));
  }
  if(index_param >= list_param.size())
  {
    result.add(entry);
  }
  return result;
}
// --------------------------------------------------------------------------
// Helpers de REPORTES (métricas 2-11): builders de reporte vacío y análisis
// --------------------------------------------------------------------------
map chat_common.build_empty_package_customers_report(date startDate, date endDate, string measure, string serviceType)
{
  data = Map();
  data.put("reportType","top_package_customers");
  data.put("measure",measure);
  data.put("periodStart",startDate);
  data.put("periodEnd",endDate);
  data.put("serviceType",serviceType);
  data.put("totalPackages",0);
  data.put("totalPounds",0);
  data.put("totalCustomers",0);
  data.put("truncated",false);
  data.put("customers",List());
  return {"ok":true,"data":data};
}
map chat_common.build_empty_remittance_report(date startDate, date endDate)
{
  data = Map();
  data.put("reportType","top_remittance_customers");
  data.put("periodStart",startDate);
  data.put("periodEnd",endDate);
  data.put("totalServices",0);
  data.put("totalAmount",0);
  data.put("totalCustomers",0);
  data.put("truncated",false);
  data.put("customers",List());
  return {"ok":true,"data":data};
}
map chat_common.build_empty_shipping_report(date startDate, date endDate, string office)
{
  data = Map();
  data.put("reportType","shipping_type_frequency");
  data.put("periodStart",startDate);
  data.put("periodEnd",endDate);
  data.put("office",office);
  data.put("totalPackages",0);
  data.put("airCount",0);
  data.put("seaCount",0);
  data.put("truncated",false);
  data.put("shipments",List());
  return {"ok":true,"data":data};
}
map chat_common.build_empty_merchandise_report(date startDate, date endDate, string office)
{
  data = Map();
  data.put("reportType","merchandise_type");
  data.put("periodStart",startDate);
  data.put("periodEnd",endDate);
  data.put("office",office);
  data.put("totalPackages",0);
  data.put("truncated",false);
  data.put("merchandise",List());
  return {"ok":true,"data":data};
}
list chat_common.build_breakdown_list(map aggMap)
{
  // Convierte un Map<clave, {name, pounds, count}> a una List<Map> ordenada
  // desc por libras (operaciones garantizadas: size/get/add).
  ranking = List();
  if(aggMap == null)
  {
    return ranking;
  }
  for each  key in aggMap.keys()
  {
    entry = aggMap.get(key);
    pos = ranking.size();
    for each index i in ranking
    {
      cur = ranking.get(i);
      if(entry.get("pounds") > cur.get("pounds"))
      {
        pos = i;
        break;
      }
    }
    ranking = thisapp.chat_common.insert_ranked_entry(ranking,pos,entry);
  }
  return ranking;
}
date chat_common.first_of_month(date d)
{
  if(d == null)
  {
    return zoho.currentdate;
  }
  y = d.getYear();
  m = d.getMonth() + 1;
  return date(y,m,1);
}
int chat_common.days_in_month_range(int year, int month, date rangeStart, date rangeEnd)
{
  // Días del mes (año/mes) que caen dentro de [rangeStart, rangeEnd], inclusive.
  monthStart = date(year,month,1);
  monthEnd = monthStart.addMonth(1).subDay(1);
  oStart = monthStart;
  if(rangeStart != null && rangeStart > monthStart)
  {
    oStart = rangeStart;
  }
  oEnd = monthEnd;
  if(rangeEnd != null && rangeEnd < monthEnd)
  {
    oEnd = rangeEnd;
  }
  if(oEnd < oStart)
  {
    return 0;
  }
  days = oEnd.difference(oStart) + 1;
  if(days == null || days < 1)
  {
    return 1;
  }
  return days;
}
string chat_common.join_list(List items, String sep)
{
  // Join manual: concatena una List<String> con un separador
  result = "";
  for each  i in items
  {
    if(result == "")
    {
      result = "" + i;
    }
    else
    {
      result = result + sep + i;
    }
  }
  return result;
}
map chat_common.parse_json_strict(string text)
{
  try
  {
    result = text.toMap();
  }	catch (e)
  {
    // text == null: toMap() lanza y no se puede operar sobre null
    if(text == null)
    {
      return {"parse_error":""};
    }
    startIndex = text.indexOf("{");
    endIndex = text.lastIndexOf("}");
    if(startIndex >= 0 && endIndex > startIndex)
    {
      candidate = text.subString(startIndex,endIndex + 1);
      try
      {
        result = candidate.toMap();
      }			catch (e2)
      {
        result = {"parse_error":text};
      }
    }
  }
  return result;
}
string chat_common.series_to_json(map s)
{
  namePart = "\"name\":" + thisapp.chat_common.escape_json_str(s.get("name"));
  vals = List();
  v = s.get("values");
  if(v != null)
  {
    for each  item in v
    {
      vals.add("" + item.toString());
    }
  }
  return "{" + namePart + ",\"values\":[" + thisapp.chat_common.join_list(vals,",") + "]}";
}
string chat_common.viz_to_json(map viz)
{
  if(viz == null)
  {
    return "null";
  }
  result = "{";
  result = result + "\"type\":" + thisapp.chat_common.escape_json_str(viz.get("type"));
  result = result + ",\"title\":" + thisapp.chat_common.escape_json_str(viz.get("title"));
  // labels
  labels = viz.get("labels");
  labelParts = List();
  if(labels != null)
  {
    for each  l in labels
    {
      labelParts.add(thisapp.chat_common.escape_json_str("" + l));
    }
  }
  result = result + ",\"labels\":[" + thisapp.chat_common.join_list(labelParts,",") + "]";
  // series
  series = viz.get("series");
  seriesParts = List();
  if(series != null)
  {
    for each  s in series
    {
      seriesParts.add(thisapp.chat_common.series_to_json(s));
    }
  }
  result = result + ",\"series\":[" + thisapp.chat_common.join_list(seriesParts,",") + "]";
  result = result + "}";
  return result;
}