/**
 * chat_common.deluge
 *
 * Helpers compartidos por el backend del chatbot.
 * Funciones: parse_json_strict, compose_reply, format_tracking,
 *            format_services, format_offices, format_coverage,
 *            format_contacts, format_top_customers
 *
 * Nota: el filtrado nativo NO usa builders de criterios (Form[criteriaVar]
 * es inválido en Creator, gate 5.1). La combinación AND se hace en las tools
 * con IDs por condición (addAll/intersect) — ver data_access.deluge.
 */

// --------------------------------------------------------------------------
// Parseo robusto de JSON devuelto por Zia
// --------------------------------------------------------------------------
// Zia devuelve TEXTO. Si toMap() falla (markdown fences, ruido), se intenta
// extraer el bloque entre el primer "{" y el último "}".
Map parse_json_strict(String text)
{
    try {
        return text.toMap();
    } catch (e) {
        // text == null: toMap() lanza y no se puede operar sobre null
        if (text == null) {
            return {"parse_error": ""};
        }
        startIndex = text.indexOf("{");
        endIndex = text.lastIndexOf("}");
        if (startIndex >= 0 && endIndex > startIndex) {
            candidate = text.substring(startIndex, endIndex + 1);
            try {
                return candidate.toMap();
            } catch (e2) {
                return {"parse_error": text};
            }
        }
        return {"parse_error": text};
    }
}

// --------------------------------------------------------------------------
// Composición de respuestas por plantilla (default, sin segunda llamada Zia)
// --------------------------------------------------------------------------
Map compose_reply(Map toolResult, Map intent)
{
    if (!toolResult.get("ok")) {
        return {"text": "No pude completar la búsqueda. " + toolResult.get("message"), "visualization": null};
    }
    toolName = intent.get("tool");
    data = toolResult.get("data");
    viz = toolResult.get("visualization");

    if (toolName == "track_package") {
        return {"text": format_tracking(data), "visualization": viz};
    }
    if (toolName == "search_services") {
        return {"text": format_services(data), "visualization": viz};
    }
    if (toolName == "find_offices") {
        return {"text": format_offices(data), "visualization": viz};
    }
    if (toolName == "check_coverage") {
        return {"text": format_coverage(data, toolResult.get("vendors")), "visualization": viz};
    }
    if (toolName == "find_contacts") {
        return {"text": format_contacts(data), "visualization": viz};
    }
    if (toolName == "report_top_customers") {
        return {"text": format_top_customers(data), "visualization": viz};
    }

    return {"text": "Datos obtenidos: " + data.toString(), "visualization": viz};
}

String format_tracking(Map pkg)
{
    if (pkg == null) {
        return "No encontré el paquete.";
    }
    text = "Paquete " + pkg.get("trackingNumber") + "\n";
    text = text + "Estado: " + pkg.get("status") + "\n";
    // Sin currentLocation/estimatedDelivery: no existen en Package (dump);
    // tool_track_package solo emite trackingNumber/status/origin/destination.
    text = text + "Origen: " + pkg.get("origin") + "\n";
    text = text + "Destino: " + pkg.get("destination") + "\n";
    return text;
}

String format_services(List services)
{
    if (services == null || services.size() == 0) {
        return "No encontré servicios que coincidan con la búsqueda.";
    }
    text = "Servicios disponibles:\n";
    index = 1;
    for each s in services {
        // Sin price/currency/estimatedTime: Service.Price existe pero se omitió
        // del mapeo por decisión de producto; Currency/Estimated_Time no existen
        // en el dump; tool_services solo emite name/type.
        line = index + ". " + s.get("name") + " (" + s.get("type") + ")";
        text = text + line + "\n";
        index = index + 1;
    }
    return text;
}

String format_offices(List offices)
{
    if (offices == null || offices.size() == 0) {
        return "No encontré oficinas que coincidan con la búsqueda.";
    }
    text = "Oficinas:\n";
    for each o in offices {
        line = "- " + o.get("name");
        if (o.get("address") != null) {
            line = line + ", " + o.get("address");
        }
        if (o.get("city") != null) {
            line = line + ", " + o.get("city");
        }
        if (o.get("country") != null) {
            line = line + ", " + o.get("country");
        }
        // Sin phone/hours: no existen top-level en Commercial_Office (dump);
        // tool_offices solo emite name/address/city/country.
        text = text + line + "\n";
    }
    return text;
}

String format_coverage(List coverage, List vendors)
{
    hasLocations = (coverage != null && coverage.size() > 0);
    hasVendors = (vendors != null && vendors.size() > 0);
    if (!hasLocations && !hasVendors) {
        return "No encontré cobertura para esa búsqueda.";
    }
    text = "";
    if (hasLocations) {
        text = text + "Cobertura disponible:\n";
        for each c in coverage {
            line = "- " + c.get("country");
            if (c.get("state") != null && c.get("state") != "") {
                line = line + ", " + c.get("state");
            }
            text = text + line + "\n";
        }
    }
    if (hasVendors) {
        if (hasLocations) {
            text = text + "\n";
        }
        text = text + "Proveedores disponibles:\n";
        for each v in vendors {
            line = "- " + v.get("name");
            if (v.get("type") != null && v.get("type") != "") {
                line = line + " (" + v.get("type") + ")";
            }
            text = text + line + "\n";
        }
    }
    return text;
}

String format_contacts(List contacts)
{
    if (contacts == null || contacts.size() == 0) {
        return "No encontré contactos con esos datos.";
    }
    text = "Contactos encontrados:\n";
    for each c in contacts {
        line = "- " + c.get("fullName");
        if (c.get("role") != null) {
            line = line + " (" + c.get("role") + ")";
        }
        if (c.get("phone") != null) {
            line = line + ". Tel: " + c.get("phone");
        }
        if (c.get("email") != null) {
            line = line + ". Email: " + c.get("email");
        }
        text = text + line + "\n";
    }
    return text;
}

// --------------------------------------------------------------------------
// Motor de visualización: construye el envelope JSON para el widget.
// type: "bar" | "table" | "none" (decisión determinista, no-Zia).
// labels: categorías para el eje X (e.g. ["Juan", "María", "Pedro"]).
// series: [{name, values}] — una o más series de datos.
// title: texto descriptivo del gráfico.
// El widget recibe {text, visualization} y renderiza sin dependencias.
// --------------------------------------------------------------------------
Map build_viz(String type, String title, List labels, List series)
{
    if (type == null || type == "") {
        type = "none";
    }
    viz = Map();
    viz.put("type", type);
    viz.put("title", title);
    viz.put("labels", labels);
    viz.put("series", series);
    return viz;
}

// Decide el tipo de visualización de forma determinista (sin Zia):
// - breakdown vacío o 1 categoría → "none" (solo texto)
// - ≤8 categorías, no serie temporal → "bar"
// - ≥9 categorías → "table" (fallback seguro)
String decidirVisualizacion(List labels, Boolean esSerieTiempo)
{
    if (labels == null || labels.size() <= 1) {
        return "none";
    }
    if (esSerieTiempo != null && esSerieTiempo == true) {
        return "line"; // fase 2; por ahora devuelve "line" y el widget ignora
    }
    if (labels.size() <= 8) {
        return "bar";
    }
    return "table";
}

// --------------------------------------------------------------------------
// Serialización JSON manual — Deluge Map.toString() NO produce JSON válido
// (genera {key=value} en vez de {"key":"value"}). Esta función serializa
// el envelope {text, visualization} a JSON válido para el widget.
// --------------------------------------------------------------------------
// Escape manual: itera carácter por carácter para manejar \n, \t, \r, etc.
// (Deluge replace() puede no manejar correctamente secuencias de escape)
String escapeJsonStr(String s)
{
    if (s == null) { return "null"; }
    src = "" + s;
    result = "\"";
    len = src.length();
    i = 0;
    while (i < len) {
        ch = src.subString(i, i + 1);
        if (ch == "\\") {
            result = result + "\\\\";
        } else if (ch == "\"") {
            result = result + "\\\"";
        } else if (ch == "\n") {
            result = result + "\\n";
        } else if (ch == "\r") {
            result = result + "\\r";
        } else if (ch == "\t") {
            result = result + "\\t";
        } else {
            result = result + ch;
        }
        i = i + 1;
    }
    result = result + "\"";
    return result;
}

String numberToStr(Object n)
{
    if (n == null) { return "0"; }
    return "" + n;
}

// Join manual: concatena una List<String> con un separador
String joinList(List items, String sep)
{
    result = "";
    for each i in items {
        if (result == "") {
            result = "" + i;
        } else {
            result = result + sep + i;
        }
    }
    return result;
}

String seriesToJson(Map s)
{
    namePart = "\"name\":" + escapeJsonStr(s.get("name"));
    vals = List();
    v = s.get("values");
    if (v != null) {
        for each item in v {
            vals.add(numberToStr(item));
        }
    }
    return "{" + namePart + ",\"values\":[" + joinList(vals, ",") + "]}";
}

String vizToJson(Map viz)
{
    if (viz == null) { return "null"; }
    result = "{";
    result = result + "\"type\":" + escapeJsonStr(viz.get("type"));
    result = result + ",\"title\":" + escapeJsonStr(viz.get("title"));
    // labels
    labels = viz.get("labels");
    labelParts = List();
    if (labels != null) {
        for each l in labels {
            labelParts.add(escapeJsonStr("" + l));
        }
    }
    result = result + ",\"labels\":[" + joinList(labelParts, ",") + "]";
    // series
    series = viz.get("series");
    seriesParts = List();
    if (series != null) {
        for each s in series {
            seriesParts.add(seriesToJson(s));
        }
    }
    result = result + ",\"series\":[" + joinList(seriesParts, ",") + "]";
    result = result + "}";
    return result;
}

String envelopeToJson(String text, Map viz)
{
    return "{\"text\":" + escapeJsonStr(text) + ",\"visualization\":" + vizToJson(viz) + "}";
}

// --------------------------------------------------------------------------
// Plantilla del reporte top customers (composeWithAI=false: los nombres y
// conteos NUNCA se envían al LLM). El breakdown por tipo se omite cuando la
// tool no emitió ninguno; con truncated: true se añade el aviso de ranking
// aproximado (ventana > 200 servicios, se analizaron los primeros 200).
// --------------------------------------------------------------------------
String format_top_customers(Map data)
{
    if (data == null) {
        return "No encontré servicios en los últimos 30 días.";
    }
    customers = data.get("customers");
    if (customers == null || customers.size() == 0) {
        return "No encontré servicios en los últimos 30 días.";
    }
    text = "Clientes más frecuentes (últimos 30 días):\n";
    for each c in customers {
        line = c.get("rank") + ". " + c.get("customerName") + " — " + c.get("totalServices") + " servicios";
        breakdown = c.get("serviceBreakdown");
        if (breakdown != null && breakdown != "") {
            line = line + " (" + breakdown + ")";
        }
        text = text + line + "\n";
    }
    if (data.get("truncated") == true) {
        text = text + "Nota: el ranking es aproximado (se analizaron los primeros 200 servicios).\n";
    }
    return text;
}
