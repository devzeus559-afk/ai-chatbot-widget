map tests_chat_intent.test_normalize_markdown_fence(map counters)
{
  resp = Map();
  resp.put("status",true);
  resp.put("data","```json\n{\"tool\":\"search_services\",\"params\":{\"destination\":\"Madrid\"}}\n```");
  result = thisapp.chat_intent.normalize_zia_response(resp);
  counters = thisapp.tests_chat_intent.assert_equals("normalize_fence: kind",result.get("kind"),"tool",counters);
  counters = thisapp.tests_chat_intent.assert_equals("normalize_fence: tool",result.get("tool"),"search_services",counters);
  return counters;
}
