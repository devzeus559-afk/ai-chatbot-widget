/**
 * tests_chat_intent.deluge
 *
 * Suite de pruebas para chat_intent.deluge (router Zia).
 * Verifica:
 *  - build_intent_prompt (puro, sin Zia) — contrato de salida + historial
 *  - normalize_zia_response (puro, mock de Zia) — parsing + normalización
 *  - chat_intent live con Zia real — 10 casos first-turn + 6 multiturno (16 live)
 *
 * Ejecución: pegar como funciones tests_chat_intent.* en Creator y llamar
 *   tests_chat_intent.run_all()          // todo (unit + live)
 *   tests_chat_intent.run_unit()         // solo unit (sin consumo Zia)
 *   tests_chat_intent.run_live_first_turn()
 *   tests_chat_intent.run_live_multiturn()
 * Revisar logs `info` en Creator. Zia: temperature 0, max 40s por llamada.
 * No usa Form[criteriaVar] ni API Creator.
 */

// --------------------------------------------------------------------------
// Helpers de aserción
// --------------------------------------------------------------------------
map tests_chat_intent.assert_equals(string testName, string actual, string expected, map counters)
{
  passed = counters.get("passed");
  failed = counters.get("failed");
  if(actual == expected)
  {
    info "[PASSED] " + testName;
    counters.put("passed",passed + 1);
  }
  else
  {
    info "[FAILED] " + testName + " | expected: " + expected + " | actual: " + actual;
    counters.put("failed",failed + 1);
  }
  return counters;
}
map tests_chat_intent.assert_contains(string testName, string haystack, string needle, map counters)
{
  passed = counters.get("passed");
  failed = counters.get("failed");
  if(haystack != null && haystack.contains(needle))
  {
    info "[PASSED] " + testName;
    counters.put("passed",passed + 1);
  }
  else
  {
    info "[FAILED] " + testName + " | expected to contain: " + needle + " | haystack: " + haystack;
    counters.put("failed",failed + 1);
  }
  return counters;
}
map tests_chat_intent.assert_true(string testName, boolean condition, map counters, string detail)
{
  passed = counters.get("passed");
  failed = counters.get("failed");
  if(condition == true)
  {
    info "[PASSED] " + testName;
    counters.put("passed",passed + 1);
  }
  else
  {
    info "[FAILED] " + testName + " | " + detail;
    counters.put("failed",failed + 1);
  }
  return counters;
}
// Helper para construir historial tipo get_recent_history: List<{role,content}>
list tests_chat_intent.make_history_pair(string role1, string content1, string role2, string content2)
{
  h = List();
  m1 = Map();
  m1.put("role",role1);
  m1.put("content",content1);
  h.add(m1);
  if(role2 != null && role2 != "")
  {
    m2 = Map();
    m2.put("role",role2);
    m2.put("content",content2);
    h.add(m2);
  }
  return h;
}

// --------------------------------------------------------------------------
// UNIT — build_intent_prompt
// --------------------------------------------------------------------------
map tests_chat_intent.test_build_prompt_no_history(map counters)
{
  catalogText = "- track_package: Busca el estado\n";
  prompt = thisapp.chat_intent.build_intent_prompt("Hola",null,catalogText);
  counters = thisapp.tests_chat_intent.assert_contains("build_prompt_no_history: contrato",prompt,"CONTRATO DE SALIDA",counters);
  counters = thisapp.tests_chat_intent.assert_contains("build_prompt_no_history: catalog",prompt,catalogText,counters);
  counters = thisapp.tests_chat_intent.assert_contains("build_prompt_no_history: userPrompt",prompt,"MENSAJE ACTUAL DEL USUARIO:\nHola",counters);
  // no debe contener HISTORIAL
  hasHistory = prompt.contains("HISTORIAL RECIENTE");
  counters = thisapp.tests_chat_intent.assert_true("build_prompt_no_history: sin historial",hasHistory == false,counters,"no debe incluir HISTORIAL RECIENTE");
  return counters;
}
map tests_chat_intent.test_build_prompt_empty_history(map counters)
{
  catalogText = "- search_services: lista\n";
  emptyHist = List();
  prompt = thisapp.chat_intent.build_intent_prompt("test vacío",emptyHist,catalogText);
  hasHistory = prompt.contains("HISTORIAL RECIENTE");
  counters = thisapp.tests_chat_intent.assert_true("build_prompt_empty_history: sin bloque historial",hasHistory == false,counters,"lista vacía no debe generar bloque");
  return counters;
}
map tests_chat_intent.test_build_prompt_with_history(map counters)
{
  catalogText = "- find_offices: busca\n";
  hist = List();
  m1 = Map();
  m1.put("role","user");
  m1.put("content","Hola");
  hist.add(m1);
  m2 = Map();
  m2.put("role","ai");
  m2.put("content","¿En qué ayudo?");
  hist.add(m2);
  prompt = thisapp.chat_intent.build_intent_prompt("¿Tienen oficinas en Miami?",hist,catalogText);
  counters = thisapp.tests_chat_intent.assert_contains("build_prompt_with_history: header historial",prompt,"HISTORIAL RECIENTE:",counters);
  counters = thisapp.tests_chat_intent.assert_contains("build_prompt_with_history: user line",prompt,"user: Hola",counters);
  counters = thisapp.tests_chat_intent.assert_contains("build_prompt_with_history: ai line",prompt,"ai: ¿En qué ayudo?",counters);
  counters = thisapp.tests_chat_intent.assert_contains("build_prompt_with_history: prompt actual",prompt,"MENSAJE ACTUAL DEL USUARIO:\n¿Tienen oficinas en Miami?",counters);
  return counters;
}
map tests_chat_intent.test_build_prompt_catalog_in_prompt(map counters)
{
  // Verifica que message = prompt + catalogText + context: catalog debe aparecer íntegro
  config = thisapp.chat_config.chat_config();
  catalogText = config.get("toolsText");
  prompt = thisapp.chat_intent.build_intent_prompt("rastrea ABC",null,catalogText);
  counters = thisapp.tests_chat_intent.assert_contains("build_prompt_catalog: toolsText incluido",prompt,"track_package",counters);
  counters = thisapp.tests_chat_intent.assert_contains("build_prompt_catalog: search_services incluido",prompt,"search_services",counters);
  return counters;
}

// --------------------------------------------------------------------------
// UNIT — normalize_zia_response (mock sin llamar a Zia)
// --------------------------------------------------------------------------
map tests_chat_intent.test_normalize_null(map counters)
{
  result = thisapp.chat_intent.normalize_zia_response(null);
  counters = thisapp.tests_chat_intent.assert_equals("normalize_null: status",result.get("status"),"error",counters);
  counters = thisapp.tests_chat_intent.assert_equals("normalize_null: kind",result.get("kind"),"clarify",counters);
  return counters;
}
map tests_chat_intent.test_normalize_error_status(map counters)
{
  resp = Map();
  resp.put("status",false);
  resp.put("error","IA no habilitada");
  resp.put("data",null);
  result = thisapp.chat_intent.normalize_zia_response(resp);
  counters = thisapp.tests_chat_intent.assert_equals("normalize_error: status",result.get("status"),"error",counters);
  counters = thisapp.tests_chat_intent.assert_contains("normalize_error: text contiene error",result.get("text"),"IA no habilitada",counters);
  return counters;
}
map tests_chat_intent.test_normalize_tool_ok(map counters)
{
  resp = Map();
  resp.put("status",true);
  resp.put("data","{\"tool\":\"track_package\",\"params\":{\"trackingNumber\":\"ABC123\"}}");
  result = thisapp.chat_intent.normalize_zia_response(resp);
  counters = thisapp.tests_chat_intent.assert_equals("normalize_tool_ok: status",result.get("status"),"ok",counters);
  counters = thisapp.tests_chat_intent.assert_equals("normalize_tool_ok: kind",result.get("kind"),"tool",counters);
  counters = thisapp.tests_chat_intent.assert_equals("normalize_tool_ok: tool",result.get("tool"),"track_package",counters);
  params = result.get("params");
  hasKey = params.containKey("trackingNumber");
  counters = thisapp.tests_chat_intent.assert_true("normalize_tool_ok: params trackingNumber",hasKey == true,counters,"params debe contener trackingNumber");
  return counters;
}
map tests_chat_intent.test_normalize_tool_null_params(map counters)
{
  resp = Map();
  resp.put("status",true);
  resp.put("data","{\"tool\":\"find_offices\",\"params\":null}");
  result = thisapp.chat_intent.normalize_zia_response(resp);
  counters = thisapp.tests_chat_intent.assert_equals("normalize_null_params: kind",result.get("kind"),"tool",counters);
  params = result.get("params");
  isEmpty = params.size() == 0;
  counters = thisapp.tests_chat_intent.assert_true("normalize_null_params: params vacío",isEmpty == true,counters,"params null debe normalizar a Map vacío");
  return counters;
}
map tests_chat_intent.test_normalize_track_package_missing_number(map counters)
{
  // Regresión: track_package sin trackingNumber debe ser clarify, NO tool ni error genérico
  resp = Map();
  resp.put("status",true);
  resp.put("data","{\"tool\":\"track_package\",\"params\":{}}");
  result = thisapp.chat_intent.normalize_zia_response(resp);
  counters = thisapp.tests_chat_intent.assert_equals("normalize_track_missing: status ok",result.get("status"),"ok",counters);
  counters = thisapp.tests_chat_intent.assert_equals("normalize_track_missing: kind clarify",result.get("kind"),"clarify",counters);
  counters = thisapp.tests_chat_intent.assert_contains("normalize_track_missing: text pide número",result.get("text"),"número de seguimiento",counters);
  return counters;
}
