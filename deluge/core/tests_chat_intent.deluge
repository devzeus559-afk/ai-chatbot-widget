{
  resp = Map();
  resp.put("status",true);
  resp.put("data","texto antes {\"answer\":\"hola\"} texto después");
  result = thisapp.chat_intent.normalize_zia_response(resp);
  counters = thisapp.tests_chat_intent.assert_equals("normalize_noise: kind",result.get("kind"),"answer",counters);
  return counters;
}

// --------------------------------------------------------------------------
// LIVE — Zia real, first-turn (history = List vacía)
// Precisión de primera respuesta. Cada caso llama chat_intent(prompt, List())
// con temperature 0. Asserts laxos: kind/tool y presencia de param key.
// --------------------------------------------------------------------------
map tests_chat_intent.live_assert_tool(string caseId, string prompt, string expectedTool, string expectedParamKey, map counters)
{
  info "LIVE " + caseId + " prompt: " + prompt;
  hist = List();
  result = thisapp.chat_intent.chat_intent(prompt,hist);
  info "LIVE " + caseId + " result: " + result.toString();
  counters = thisapp.tests_chat_intent.assert_equals(caseId + ": kind",result.get("kind"),"tool",counters);
  counters = thisapp.tests_chat_intent.assert_equals(caseId + ": tool",result.get("tool"),expectedTool,counters);
  if(expectedParamKey != null && expectedParamKey != "")
  {
    params = result.get("params");
    hasKey = false;
    if(params != null)
    {
      try
      {
        hasKey = params.containKey(expectedParamKey);
      } catch (e)
      {
        hasKey = false;
      }
    }
    // Para los casos que esperan params vacíos (vago), se verifica que params exista pero se permite que Zia infiera algo
    // así que solo se informa, no se falla si falta la key cuando params está vacío por diseño
    if(expectedParamKey == "EMPTY_OK")
    {
      // no assert de key
    }
    else
    {
      counters = thisapp.tests_chat_intent.assert_true(caseId + ": params contiene " + expectedParamKey,hasKey == true,counters,"params=" + params.toString());
    }
  }
  return counters;
}
map tests_chat_intent.run_live_first_turn(map counters)
{
  info "=== LIVE FIRST-TURN (10 casos, sin historial) ===";
  // 1 — track_package
  counters = thisapp.tests_chat_intent.live_assert_tool("LIVE-01 track_package","Rastrea mi paquete ABC123456","track_package","trackingNumber",counters);
  // 2 — search_services con destino
  counters = thisapp.tests_chat_intent.live_assert_tool("LIVE-02 search_services Madrid","¿Qué servicios tienen para paquetería a Madrid?","search_services","destination",counters);
  // 3 — find_offices
  counters = thisapp.tests_chat_intent.live_assert_tool("LIVE-03 find_offices Miami","¿Tienen oficinas en Miami, USA?","find_offices","city",counters);
  // 4 — check_coverage
  counters = thisapp.tests_chat_intent.live_assert_tool("LIVE-04 check_coverage Colombia","¿Tienen cobertura en Colombia para remesas?","check_coverage","country",counters);
  // 5 — find_contacts
  counters = thisapp.tests_chat_intent.live_assert_tool("LIVE-05 find_contacts Juan","Busca el contacto Juan Pérez teléfono 5551234","find_contacts","name",counters);
  // 6 — report_top_customers
  counters = thisapp.tests_chat_intent.live_assert_tool("LIVE-06 report_top","¿Quiénes son los clientes más frecuentes del último mes?","report_top_customers","EMPTY_OK",counters);
  // 7 — answer (sin tool)
  info "LIVE-07 answer prompt: Hola, ¿qué hacen ustedes?";
  r7 = thisapp.chat_intent.chat_intent("Hola, ¿qué hacen ustedes?",List());
  info "LIVE-07 result: " + r7.toString();
  counters = thisapp.tests_chat_intent.assert_equals("LIVE-07: kind answer",r7.get("kind"),"answer",counters);
  // 8 — clarify ambiguo
  info "LIVE-08 clarify prompt: ayuda";
  r8 = thisapp.chat_intent.chat_intent("ayuda",List());
  info "LIVE-08 result: " + r8.toString();
  kind8 = r8.get("kind");
  isClarify8 = kind8 == "clarify" || kind8 == "answer";
  counters = thisapp.tests_chat_intent.assert_true("LIVE-08: clarify o answer para 'ayuda'",isClarify8 == true,counters,"kind=" + kind8);
  // 9 — vago sin destino/tipo: debe ser tool con params vacíos, NO clarify (config: Si no especifica, params vacíos)
  // Prompt ajustado a forma menos ambigua para estabilidad Zia; cubre still params {}
  info "LIVE-09 vago prompt: ¿Qué servicios tienen disponibles?";
  r9 = thisapp.chat_intent.chat_intent("¿Qué servicios tienen disponibles?",List());
  info "LIVE-09 result: " + r9.toString();
  counters = thisapp.tests_chat_intent.assert_equals("LIVE-09: kind tool (vago no es clarify)",r9.get("kind"),"tool",counters);
  // 10 — vacío/ruido (amplía a answer como graceful fallback de Zia)
  info "LIVE-10 vacío prompt: ABC";
  r10 = thisapp.chat_intent.chat_intent("ABC",List());
  info "LIVE-10 result: " + r10.toString();
  kind10 = r10.get("kind");
  isClarify10 = kind10 == "clarify" || kind10 == "answer" || r10.get("status") == "error";
  counters = thisapp.tests_chat_intent.assert_true("LIVE-10: clarify/answer/error para ABC",isClarify10 == true,counters,"kind=" + kind10);
  // 11 — off-topic clima (Zia puede devolver clarify o answer; el texto debe mencionar dominio)
  info "LIVE-11 off-topic prompt: ¿Cuál es el clima en Madrid?";
  r11 = thisapp.chat_intent.chat_intent("¿Cuál es el clima en Madrid?",List());
  info "LIVE-11 result: " + r11.toString();
  kind11 = r11.get("kind");
  isRelevant11 = kind11 == "clarify" || kind11 == "answer";
  counters = thisapp.tests_chat_intent.assert_true("LIVE-11: clarify/answer para off-topic clima",isRelevant11 == true,counters,"kind=" + kind11);
  text11 = r11.get("text");
  if(text11 == null) { text11 = ""; }
  counters = thisapp.tests_chat_intent.assert_contains("LIVE-11: respuesta menciona dominio",text11,"paquetería",counters);
  // 12 — off-topic fútbol
  info "LIVE-12 off-topic prompt: ¿Quién ganó el mundial?";
  r12 = thisapp.chat_intent.chat_intent("¿Quién ganó el mundial?",List());
  info "LIVE-12 result: " + r12.toString();
  kind12 = r12.get("kind");
  isRelevant12 = kind12 == "clarify" || kind12 == "answer";
  counters = thisapp.tests_chat_intent.assert_true("LIVE-12: clarify/answer para off-topic fútbol",isRelevant12 == true,counters,"kind=" + kind12);
  text12 = r12.get("text");
  if(text12 == null) { text12 = ""; }
  counters = thisapp.tests_chat_intent.assert_contains("LIVE-12: respuesta menciona dominio",text12,"paquetería",counters);
  // 13 — off-topic chiste
  info "LIVE-13 off-topic prompt: Cuéntame un chiste";
  r13 = thisapp.chat_intent.chat_intent("Cuéntame un chiste",List());
  info "LIVE-13 result: " + r13.toString();
  kind13 = r13.get("kind");
  isRelevant13 = kind13 == "clarify" || kind13 == "answer";
  counters = thisapp.tests_chat_intent.assert_true("LIVE-13: clarify/answer para off-topic chiste",isRelevant13 == true,counters,"kind=" + kind13);
  text13 = r13.get("text");
  if(text13 == null) { text13 = ""; }
  counters = thisapp.tests_chat_intent.assert_contains("LIVE-13: respuesta menciona dominio",text13,"paquetería",counters);
  // 14 — regression: parece off-topic pero es in-domain (Argentina → check_coverage)
  info "LIVE-14 regression in-domain prompt: ¿Tienen servicio en Argentina?";
  r14 = thisapp.chat_intent.chat_intent("¿Tienen servicio en Argentina?",List());
  info "LIVE-14 result: " + r14.toString();
  counters = thisapp.tests_chat_intent.assert_equals("LIVE-14: tool check_coverage para Argentina",r14.get("tool"),"check_coverage",counters);
  counters = thisapp.tests_chat_intent.assert_equals("LIVE-14: kind tool (Argentina es in-domain)",r14.get("kind"),"tool",counters);
  // 15 — regression: Bitcoin no aceptado, respuesta debe mencionar métodos reales
  info "LIVE-15 regression off-topic prompt: ¿Aceptan Bitcoin?";
  r15 = thisapp.chat_intent.chat_intent("¿Aceptan Bitcoin?",List());
  info "LIVE-15 result: " + r15.toString();
  kind15 = r15.get("kind");
  isClarify15 = kind15 == "clarify" || kind15 == "answer";
  counters = thisapp.tests_chat_intent.assert_true("LIVE-15: clarify/answer para Bitcoin (no es tool)",isClarify15 == true,counters,"kind=" + kind15);
  text15 = r15.get("text");
  if(text15 == null) { text15 = ""; }
  counters = thisapp.tests_chat_intent.assert_contains("LIVE-15: respuesta menciona transferencia",text15,"transferencia",counters);
  return counters;
}

// --------------------------------------------------------------------------
// LIVE — multiturno (con historial)
// --------------------------------------------------------------------------
map tests_chat_intent.run_live_multiturn(map counters)
{
  info "=== LIVE MULTITURNO (6 casos, con historial) ===";
  // M1 — completar tracking tras clarify
  histM1 = List();
  m = Map();
  m.put("role","user");
  m.put("content","rastrea mi paquete");
  histM1.add(m);
  m = Map();
  m.put("role","ai");
  m.put("content","¿Cuál es el número de seguimiento?");
  histM1.add(m);
  info "LIVE-M1 prompt: ABC123456 con historial clarify previo";
  rM1 = thisapp.chat_intent.chat_intent("ABC123456",histM1);
  info "LIVE-M1 result: " + rM1.toString();
  counters = thisapp.tests_chat_intent.assert_equals("LIVE-M1: kind",rM1.get("kind"),"tool",counters);
  counters = thisapp.tests_chat_intent.assert_equals("LIVE-M1: tool",rM1.get("tool"),"track_package",counters);
  // M2 — anáfora destino Barcelona tras Madrid
  histM2 = List();
  m = Map();
  m.put("role","user");
  m.put("content","qué servicios hay a Madrid");
  histM2.add(m);
  m = Map();
  m.put("role","ai");
  m.put("content","Servicios disponibles: ... Madrid ...");
  histM2.add(m);
  info "LIVE-M2 prompt: ¿y a Barcelona? con historial Madrid";
  rM2 = thisapp.chat_intent.chat_intent("¿y a Barcelona?",histM2);
  info "LIVE-M2 result: " + rM2.toString();
  counters = thisapp.tests_chat_intent.assert_equals("LIVE-M2: tool",rM2.get("tool"),"search_services",counters);
  // M3 — cambio de tool con referencia "allí"
  histM3 = List();
  m = Map();
  m.put("role","user");
  m.put("content","servicios de remesa a Colombia");
  histM3.add(m);
  m = Map();
  m.put("role","ai");
  m.put("content","Servicios de remesa disponibles para Colombia ...");
  histM3.add(m);
  info "LIVE-M3 prompt: ¿y qué oficinas tienen allí? con historial Colombia";
  rM3 = thisapp.chat_intent.chat_intent("¿y qué oficinas tienen allí?",histM3);
  info "LIVE-M3 result: " + rM3.toString();
  counters = thisapp.tests_chat_intent.assert_equals("LIVE-M3: tool",rM3.get("tool"),"find_offices",counters);
  // M4 — corrección segundo intento con teléfono
  histM4 = List();
  m = Map();
  m.put("role","user");
  m.put("content","busca contacto Juan Pérez");
  histM4.add(m);
  m = Map();
  m.put("role","ai");
  m.put("content","No encontré contactos con esos datos.");
  histM4.add(m);
  info "LIVE-M4 prompt: prueba con teléfono 5551234 con historial Juan Pérez";
  rM4 = thisapp.chat_intent.chat_intent("prueba con teléfono 5551234",histM4);
  info "LIVE-M4 result: " + rM4.toString();
  counters = thisapp.tests_chat_intent.assert_equals("LIVE-M4: tool",rM4.get("tool"),"find_contacts",counters);
  // M5 — historial irrelevante no contamina
  histM5 = List();
  m = Map();
  m.put("role","user");
  m.put("content","hola");
  histM5.add(m);
  m = Map();
  m.put("role","ai");
  m.put("content","¡Hola! ¿En qué puedo ayudarte?");
  histM5.add(m);
  info "LIVE-M5 prompt: rastrea paquete XYZ999 con historial saludo";
  rM5 = thisapp.chat_intent.chat_intent("rastrea paquete XYZ999",histM5);
  info "LIVE-M5 result: " + rM5.toString();
  counters = thisapp.tests_chat_intent.assert_equals("LIVE-M5: tool",rM5.get("tool"),"track_package",counters);
  // M6 — historial largo 4 turnos
  histM6 = List();
  m = Map();
  m.put("role","user");
  m.put("content","servicios a Madrid");
  histM6.add(m);
  m = Map();
  m.put("role","ai");
  m.put("content","Servicios a Madrid: ...");
  histM6.add(m);
  m = Map();
  m.put("role","user");
  m.put("content","oficinas en Miami");
  histM6.add(m);
  m = Map();
  m.put("role","ai");
  m.put("content","Oficinas en Miami: ...");
  histM6.add(m);
  info "LIVE-M6 prompt: ¿quiénes son top clientes remesa? con historial 4 turnos";
  rM6 = thisapp.chat_intent.chat_intent("¿quiénes son top clientes remesa?",histM6);
  info "LIVE-M6 result: " + rM6.toString();
  counters = thisapp.tests_chat_intent.assert_equals("LIVE-M6: tool",rM6.get("tool"),"report_top_customers",counters);
  return counters;
}

// --------------------------------------------------------------------------
// Orquestadores
// --------------------------------------------------------------------------
map tests_chat_intent.run_unit()
{
  counters = Map();
  counters.put("passed",0);
  counters.put("failed",0);
  info "=== UNIT: build_intent_prompt ===";
  counters = thisapp.tests_chat_intent.test_build_prompt_no_history(counters);
  counters = thisapp.tests_chat_intent.test_build_prompt_empty_history(counters);
  counters = thisapp.tests_chat_intent.test_build_prompt_with_history(counters);
  counters = thisapp.tests_chat_intent.test_build_prompt_catalog_in_prompt(counters);
  info "=== UNIT: normalize_zia_response ===";
  counters = thisapp.tests_chat_intent.test_normalize_null(counters);
  counters = thisapp.tests_chat_intent.test_normalize_error_status(counters);
  counters = thisapp.tests_chat_intent.test_normalize_tool_ok(counters);
  counters = thisapp.tests_chat_intent.test_normalize_tool_null_params(counters);
  counters = thisapp.tests_chat_intent.test_normalize_track_package_missing_number(counters);
  counters = thisapp.tests_chat_intent.test_normalize_answer(counters);
  counters = thisapp.tests_chat_intent.test_normalize_clarify(counters);
  counters = thisapp.tests_chat_intent.test_normalize_parse_error(counters);
  counters = thisapp.tests_chat_intent.test_normalize_unknown_key(counters);
  counters = thisapp.tests_chat_intent.test_normalize_markdown_fence(counters);
  counters = thisapp.tests_chat_intent.test_normalize_noise_wrapped(counters);
  info "UNIT done — passed: " + counters.get("passed") + " failed: " + counters.get("failed");
  return counters;
}
map tests_chat_intent.run_all()
{
  counters = thisapp.tests_chat_intent.run_unit();
  // Live requiere Zia habilitada; si falla, quedará como error/clarify y se verá en logs
  info "=== LIVE (requiere Zia habilitada) ===";
  counters = thisapp.tests_chat_intent.run_live_first_turn(counters);
  counters = thisapp.tests_chat_intent.run_live_multiturn(counters);
  info "=== RESUMEN TOTAL ===";
  info "passed: " + counters.get("passed") + " failed: " + counters.get("failed");
  if(counters.get("failed") == 0)
  {
    info "ALL TESTS PASSED";
  }
  else
  {
    info "SOME TESTS FAILED — revisar logs arriba";
  }
  return counters;
}
