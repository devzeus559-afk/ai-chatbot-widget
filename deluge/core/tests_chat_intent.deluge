/**
 * tests_chat_intent.deluge
 *
 * Suite de pruebas para chat_intent.deluge (router Zia).
 * Verifica:
 *  - build_intent_prompt (puro, sin Zia) — contrato de salida + historial
 *  - normalize_zia_response (puro, mock de Zia) — parsing + normalización
 *  - chat_intent live con Zia real — 10 casos first-turn + 6 multiturno (16 live)
 *
 * Ejecución: pegar como funciones tests_chat_intent.* en Creator (junto con
 * tests_common.*) y llamar:
 *   tests_chat_intent.run_all()          // todo (unit + live)
 *   tests_chat_intent.run_unit()         // solo unit (sin consumo Zia)
 *   tests_chat_intent.run_live_first_turn()
 *   tests_chat_intent.run_live_multiturn()
 * Revisar logs `info` en Creator. Zia: temperature 0, max 40s por llamada.
 * No usa Form[criteriaVar] ni API Creator. Los asserts usan tests_common.*
 * (helpers compartidos; ver tests_common.deluge).
 */

// Helper para construir historial tipo get_recent_history: List<{role,content}>
list tests_chat_intent.make_history_pair(string role1, string content1, string role2, string content2)
{
  h = List();
  m1 = Map();
  m1.put("role",role1);
  m1.put("content",content1);
  h.add(m1);
  if(role2 != null && role2 != "")
  {
    m2 = Map();
    m2.put("role",role2);
    m2.put("content",content2);
    h.add(m2);
  }
  return h;
}

// --------------------------------------------------------------------------
// UNIT — build_intent_prompt
// --------------------------------------------------------------------------
map tests_chat_intent.test_build_prompt_no_history(map counters)
{
  catalogText = "- track_package: Busca el estado\n";
  prompt = thisapp.chat_intent.build_intent_prompt("Hola",null,catalogText);
  counters = thisapp.tests_common.assert_contains("build_prompt_no_history: contrato",prompt,"CONTRATO DE SALIDA",counters);
  counters = thisapp.tests_common.assert_contains("build_prompt_no_history: catalog",prompt,catalogText,counters);
  counters = thisapp.tests_common.assert_contains("build_prompt_no_history: userPrompt",prompt,"MENSAJE ACTUAL DEL USUARIO:\nHola",counters);
  // no debe contener HISTORIAL
  hasHistory = prompt.contains("HISTORIAL RECIENTE");
  counters = thisapp.tests_common.assert_true("build_prompt_no_history: sin historial",hasHistory == false,counters,"no debe incluir HISTORIAL RECIENTE");
  return counters;
}
map tests_chat_intent.test_build_prompt_empty_history(map counters)
{
  catalogText = "- search_services: lista\n";
  emptyHist = List();
  prompt = thisapp.chat_intent.build_intent_prompt("test vacío",emptyHist,catalogText);
  hasHistory = prompt.contains("HISTORIAL RECIENTE");
  counters = thisapp.tests_common.assert_true("build_prompt_empty_history: sin bloque historial",hasHistory == false,counters,"lista vacía no debe generar bloque");
  return counters;
}
map tests_chat_intent.test_build_prompt_with_history(map counters)
{
  catalogText = "- find_offices: busca\n";
  hist = List();
  m1 = Map();
  m1.put("role","user");
  m1.put("content","Hola");
  hist.add(m1);
  m2 = Map();
  m2.put("role","ai");
  m2.put("content","¿En qué ayudo?");
  hist.add(m2);
  prompt = thisapp.chat_intent.build_intent_prompt("¿Tienen oficinas en Miami?",hist,catalogText);
  counters = thisapp.tests_common.assert_contains("build_prompt_with_history: header historial",prompt,"HISTORIAL RECIENTE:",counters);
  counters = thisapp.tests_common.assert_contains("build_prompt_with_history: user line",prompt,"user: Hola",counters);
  counters = thisapp.tests_common.assert_contains("build_prompt_with_history: ai line",prompt,"ai: ¿En qué ayudo?",counters);
  counters = thisapp.tests_common.assert_contains("build_prompt_with_history: prompt actual",prompt,"MENSAJE ACTUAL DEL USUARIO:\n¿Tienen oficinas en Miami?",counters);
  return counters;
}
map tests_chat_intent.test_build_prompt_catalog_in_prompt(map counters)
{
  // Verifica que message = prompt + catalogText + context: catalog debe aparecer íntegro
  config = thisapp.chat_config.chat_config();
  catalogText = config.get("toolsText");
  prompt = thisapp.chat_intent.build_intent_prompt("rastrea ABC",null,catalogText);
  counters = thisapp.tests_common.assert_contains("build_prompt_catalog: toolsText incluido",prompt,"track_package",counters);
  counters = thisapp.tests_common.assert_contains("build_prompt_catalog: search_services incluido",prompt,"search_services",counters);
  return counters;
}

// --------------------------------------------------------------------------
// UNIT — normalize_zia_response (mock sin llamar a Zia)
// --------------------------------------------------------------------------
map tests_chat_intent.test_normalize_null(map counters)
{
  result = thisapp.chat_intent.normalize_zia_response(null);
  counters = thisapp.tests_common.assert_equals("normalize_null: status",result.get("status"),"error",counters);
  counters = thisapp.tests_common.assert_equals("normalize_null: kind",result.get("kind"),"clarify",counters);
  return counters;
}
map tests_chat_intent.test_normalize_error_status(map counters)
{
  resp = Map();
  resp.put("status",false);
  resp.put("error","IA no habilitada");
  resp.put("data",null);
  result = thisapp.chat_intent.normalize_zia_response(resp);
  counters = thisapp.tests_common.assert_equals("normalize_error: status",result.get("status"),"error",counters);
  counters = thisapp.tests_common.assert_contains("normalize_error: text contiene error",result.get("text"),"IA no habilitada",counters);
  return counters;
}
map tests_chat_intent.test_normalize_tool_ok(map counters)
{
  resp = Map();
  resp.put("status",true);
  resp.put("data","{\"tool\":\"track_package\",\"params\":{\"trackingNumber\":\"ABC123\"}}");
  result = thisapp.chat_intent.normalize_zia_response(resp);
  counters = thisapp.tests_common.assert_equals("normalize_tool_ok: status",result.get("status"),"ok",counters);
  counters = thisapp.tests_common.assert_equals("normalize_tool_ok: kind",result.get("kind"),"tool",counters);
  counters = thisapp.tests_common.assert_equals("normalize_tool_ok: tool",result.get("tool"),"track_package",counters);
  params = result.get("params");
  hasKey = params.containKey("trackingNumber");
  counters = thisapp.tests_common.assert_true("normalize_tool_ok: params trackingNumber",hasKey == true,counters,"params debe contener trackingNumber");
  return counters;
}
map tests_chat_intent.test_normalize_tool_null_params(map counters)
{
  resp = Map();
  resp.put("status",true);
  resp.put("data","{\"tool\":\"find_offices\",\"params\":null}");
  result = thisapp.chat_intent.normalize_zia_response(resp);
  counters = thisapp.tests_common.assert_equals("normalize_null_params: kind",result.get("kind"),"tool",counters);
  params = result.get("params");
  isEmpty = params.size() == 0;
  counters = thisapp.tests_common.assert_true("normalize_null_params: params vacío",isEmpty == true,counters,"params null debe normalizar a Map vacío");
  return counters;
}
map tests_chat_intent.test_normalize_track_package_missing_number(map counters)
{
  // Regresión: track_package sin trackingNumber debe ser clarify, NO tool ni error genérico
  resp = Map();
  resp.put("status",true);
  resp.put("data","{\"tool\":\"track_package\",\"params\":{}}");
  result = thisapp.chat_intent.normalize_zia_response(resp);
  counters = thisapp.tests_common.assert_equals("normalize_track_missing: status ok",result.get("status"),"ok",counters);
  counters = thisapp.tests_common.assert_equals("normalize_track_missing: kind clarify",result.get("kind"),"clarify",counters);
  counters = thisapp.tests_common.assert_contains("normalize_track_missing: text pide número",result.get("text"),"número de seguimiento",counters);
  return counters;
}
map tests_chat_intent.test_normalize_answer(map counters)
{
  resp = Map();
  resp.put("status",true);
  resp.put("data","{\"answer\":\"Hola, somos agencia de paquetería\"}");
  result = thisapp.chat_intent.normalize_zia_response(resp);
  counters = thisapp.tests_common.assert_equals("normalize_answer: kind",result.get("kind"),"answer",counters);
  counters = thisapp.tests_common.assert_contains("normalize_answer: text",result.get("text"),"paquetería",counters);
  return counters;
}
map tests_chat_intent.test_normalize_clarify(map counters)
{
  resp = Map();
  resp.put("status",true);
  resp.put("data","{\"clarify\":\"¿Podrías decirme el país?\"}");
  result = thisapp.chat_intent.normalize_zia_response(resp);
  // Regresión: rama real clarify, NO el fallback de error (que también es kind:clarify)
  counters = thisapp.tests_common.assert_equals("normalize_clarify: status ok",result.get("status"),"ok",counters);
  counters = thisapp.tests_common.assert_equals("normalize_clarify: kind",result.get("kind"),"clarify",counters);
  counters = thisapp.tests_common.assert_equals("normalize_clarify: text exacto",result.get("text"),"¿Podrías decirme el país?",counters);
  return counters;
}
map tests_chat_intent.test_normalize_parse_error(map counters)
{
  resp = Map();
  resp.put("status",true);
  resp.put("data","no es json");
  result = thisapp.chat_intent.normalize_zia_response(resp);
  counters = thisapp.tests_common.assert_equals("normalize_parse_error: status",result.get("status"),"error",counters);
  counters = thisapp.tests_common.assert_equals("normalize_parse_error: kind",result.get("kind"),"clarify",counters);
  return counters;
}
map tests_chat_intent.test_normalize_unknown_key(map counters)
{
  resp = Map();
  resp.put("status",true);
  resp.put("data","{\"foo\":\"bar\"}");
  result = thisapp.chat_intent.normalize_zia_response(resp);
  counters = thisapp.tests_common.assert_equals("normalize_unknown: status",result.get("status"),"error",counters);
  return counters;
}
map tests_chat_intent.test_normalize_markdown_fence(map counters)
{
  resp = Map();
  resp.put("status",true);
  resp.put("data","```json\n{\"tool\":\"search_services\",\"params\":{\"destination\":\"Madrid\"}}\n```");
  result = thisapp.chat_intent.normalize_zia_response(resp);
  counters = thisapp.tests_common.assert_equals("normalize_fence: kind",result.get("kind"),"tool",counters);
  counters = thisapp.tests_common.assert_equals("normalize_fence: tool",result.get("tool"),"search_services",counters);
  return counters;
}
map tests_chat_intent.test_normalize_noise_wrapped(map counters)
{
  resp = Map();
  resp.put("status",true);
  resp.put("data","texto antes {\"answer\":\"hola\"} texto después");
  result = thisapp.chat_intent.normalize_zia_response(resp);
  counters = thisapp.tests_common.assert_equals("normalize_noise: kind",result.get("kind"),"answer",counters);
  return counters;
}

// --------------------------------------------------------------------------
// LIVE — Zia real, first-turn (history = List vacía)
// Precisión de primera respuesta. Cada caso llama chat_intent(prompt, List())
// con temperature 0. Asserts laxos: kind/tool y presencia de param key.
// --------------------------------------------------------------------------
map tests_chat_intent.live_assert_tool(string caseId, string prompt, string expectedTool, string expectedParamKey, map counters)
{
  info "LIVE " + caseId + " prompt: " + prompt;
  hist = List();
  result = thisapp.chat_intent.chat_intent(prompt,hist);
  info "LIVE " + caseId + " result: " + result.toString();
  counters = thisapp.tests_common.assert_equals(caseId + ": kind",result.get("kind"),"tool",counters);
  counters = thisapp.tests_common.assert_equals(caseId + ": tool",result.get("tool"),expectedTool,counters);
  if(expectedParamKey != null && expectedParamKey != "")
  {
    params = result.get("params");
    hasKey = false;
    if(params != null)
    {
      try
      {
        hasKey = params.containKey(expectedParamKey);
      } catch (e)
      {
        hasKey = false;
      }
    }
    // Para los casos que esperan params vacíos (vago), se verifica que params exista pero se permite que Zia infiera algo
    // así que solo se informa, no se falla si falta la key cuando params está vacío por diseño
    if(expectedParamKey == "EMPTY_OK")
    {
      // no assert de key
    }
    else
    {
      counters = thisapp.tests_common.assert_true(caseId + ": params contiene " + expectedParamKey,hasKey == true,counters,"params=" + params.toString());
    }
  }
  return counters;
}
map tests_chat_intent.run_live_first_turn(map counters)
{
  info "=== LIVE FIRST-TURN (10 casos, sin historial) ===";
  // 1 — track_package
  counters = thisapp.tests_chat_intent.live_assert_tool("LIVE-01 track_package","Rastrea mi paquete ABC123456","track_package","trackingNumber",counters);
  // 2 — search_services con destino
  counters = thisapp.tests_chat_intent.live_assert_tool("LIVE-02 search_services Madrid","¿Qué servicios tienen para paquetería a Madrid?","search_services","destination",counters);
  // 3 — find_offices
  counters = thisapp.tests_chat_intent.live_assert_tool("LIVE-03 find_offices Miami","¿Tienen oficinas en Miami, USA?","find_offices","city",counters);
  // 4 — check_coverage
  counters = thisapp.tests_chat_intent.live_assert_tool("LIVE-04 check_coverage Colombia","¿Tienen cobertura en Colombia para remesas?","check_coverage","country",counters);
  // 5 — find_contacts
  counters = thisapp.tests_chat_intent.live_assert_tool("LIVE-05 find_contacts Juan","Busca el contacto Juan Pérez teléfono 5551234","find_contacts","name",counters);
  // 6 — report_top_customers (genérico: SOLO tipos Locker/Store/Recharge/Online Store/Other)
  //   Prompt vago SIN tipo => NO debe caer aquí (contrato del cambio: serviceType
  //   obligatorio; ver LIVE-06b para el clarify). Este prompt nombra un tipo del dominio.
  counters = thisapp.tests_chat_intent.live_assert_tool("LIVE-06 report_top Locker","¿Quiénes son los clientes más frecuentes del servicio Locker del último mes?","report_top_customers","EMPTY_OK",counters);
  // 6b — report vago SIN tipo: el router NO debe llamar al genérico sin
  //   serviceType (contrato del cambio). Vale clarify, answer u otro tool;
  //   si eligiera report_top_customers, debe llevar serviceType.
  info "LIVE-06b clarify prompt: ¿Quiénes son los clientes más frecuentes del último mes?";
  r6b = thisapp.chat_intent.chat_intent("¿Quiénes son los clientes más frecuentes del último mes?",List());
  info "LIVE-06b result: " + r6b.toString();
  isSafe6b = true;
  if(r6b.get("kind") == "tool" && r6b.get("tool") == "report_top_customers")
  {
    p6b = r6b.get("params");
    if(p6b == null || p6b.get("serviceType") == null)
    {
      isSafe6b = false;
    }
  }
  counters = thisapp.tests_common.assert_true("LIVE-06b: report vago no llama al genérico sin serviceType",isSafe6b == true,counters,"kind=" + r6b.get("kind") + " tool=" + r6b.get("tool") + " params=" + r6b.get("params"));
  // 7 — answer (sin tool)
  info "LIVE-07 answer prompt: Hola, ¿qué hacen ustedes?";
  r7 = thisapp.chat_intent.chat_intent("Hola, ¿qué hacen ustedes?",List());
  info "LIVE-07 result: " + r7.toString();
  counters = thisapp.tests_common.assert_equals("LIVE-07: kind answer",r7.get("kind"),"answer",counters);
  // 8 — clarify ambiguo
  info "LIVE-08 clarify prompt: ayuda";
  r8 = thisapp.chat_intent.chat_intent("ayuda",List());
  info "LIVE-08 result: " + r8.toString();
  kind8 = r8.get("kind");
  isClarify8 = kind8 == "clarify" || kind8 == "answer";
  counters = thisapp.tests_common.assert_true("LIVE-08: clarify o answer para 'ayuda'",isClarify8 == true,counters,"kind=" + kind8);
  // 9 — vago sin destino/tipo: debe ser tool con params vacíos, NO clarify (config: Si no especifica, params vacíos)
  // Prompt ajustado a forma menos ambigua para estabilidad Zia; cubre still params {}
  info "LIVE-09 vago prompt: ¿Qué servicios tienen disponibles?";
  r9 = thisapp.chat_intent.chat_intent("¿Qué servicios tienen disponibles?",List());
  info "LIVE-09 result: " + r9.toString();
  counters = thisapp.tests_common.assert_equals("LIVE-09: kind tool (vago no es clarify)",r9.get("kind"),"tool",counters);
  // 10 — vacío/ruido (amplía a answer como graceful fallback de Zia)
  info "LIVE-10 vacío prompt: ABC";
  r10 = thisapp.chat_intent.chat_intent("ABC",List());
  info "LIVE-10 result: " + r10.toString();
  kind10 = r10.get("kind");
  isClarify10 = kind10 == "clarify" || kind10 == "answer" || r10.get("status") == "error";
  counters = thisapp.tests_common.assert_true("LIVE-10: clarify/answer/error para ABC",isClarify10 == true,counters,"kind=" + kind10);
  // 11 — off-topic clima (Zia puede devolver clarify o answer; el texto debe mencionar dominio)
  info "LIVE-11 off-topic prompt: ¿Cuál es el clima en Madrid?";
  r11 = thisapp.chat_intent.chat_intent("¿Cuál es el clima en Madrid?",List());
  info "LIVE-11 result: " + r11.toString();
  kind11 = r11.get("kind");
  isRelevant11 = kind11 == "clarify" || kind11 == "answer";
  counters = thisapp.tests_common.assert_true("LIVE-11: clarify/answer para off-topic clima",isRelevant11 == true,counters,"kind=" + kind11);
  text11 = r11.get("text");
  if(text11 == null) { text11 = ""; }
  counters = thisapp.tests_common.assert_contains("LIVE-11: respuesta menciona dominio",text11,"paquetería",counters);
  // 12 — off-topic fútbol
  info "LIVE-12 off-topic prompt: ¿Quién ganó el mundial?";
  r12 = thisapp.chat_intent.chat_intent("¿Quién ganó el mundial?",List());
  info "LIVE-12 result: " + r12.toString();
  kind12 = r12.get("kind");
  isRelevant12 = kind12 == "clarify" || kind12 == "answer";
  counters = thisapp.tests_common.assert_true("LIVE-12: clarify/answer para off-topic fútbol",isRelevant12 == true,counters,"kind=" + kind12);
  text12 = r12.get("text");
  if(text12 == null) { text12 = ""; }
  counters = thisapp.tests_common.assert_contains("LIVE-12: respuesta menciona dominio",text12,"paquetería",counters);
  // 13 — off-topic chiste
  info "LIVE-13 off-topic prompt: Cuéntame un chiste";
  r13 = thisapp.chat_intent.chat_intent("Cuéntame un chiste",List());
  info "LIVE-13 result: " + r13.toString();
  kind13 = r13.get("kind");
  isRelevant13 = kind13 == "clarify" || kind13 == "answer";
  counters = thisapp.tests_common.assert_true("LIVE-13: clarify/answer para off-topic chiste",isRelevant13 == true,counters,"kind=" + kind13);
  text13 = r13.get("text");
  if(text13 == null) { text13 = ""; }
  counters = thisapp.tests_common.assert_contains("LIVE-13: respuesta menciona dominio",text13,"paquetería",counters);
  // 14 — regression: parece off-topic pero es in-domain (Argentina → check_coverage)
  info "LIVE-14 regression in-domain prompt: ¿Tienen servicio en Argentina?";
  r14 = thisapp.chat_intent.chat_intent("¿Tienen servicio en Argentina?",List());
  info "LIVE-14 result: " + r14.toString();
  counters = thisapp.tests_common.assert_equals("LIVE-14: tool check_coverage para Argentina",r14.get("tool"),"check_coverage",counters);
  counters = thisapp.tests_common.assert_equals("LIVE-14: kind tool (Argentina es in-domain)",r14.get("kind"),"tool",counters);
  // 15 — regression: Bitcoin no aceptado, respuesta debe mencionar métodos reales
  info "LIVE-15 regression off-topic prompt: ¿Aceptan Bitcoin?";
  r15 = thisapp.chat_intent.chat_intent("¿Aceptan Bitcoin?",List());
  info "LIVE-15 result: " + r15.toString();
  kind15 = r15.get("kind");
  isClarify15 = kind15 == "clarify" || kind15 == "answer";
  counters = thisapp.tests_common.assert_true("LIVE-15: clarify/answer para Bitcoin (no es tool)",isClarify15 == true,counters,"kind=" + kind15);
  text15 = r15.get("text");
  if(text15 == null) { text15 = ""; }
  counters = thisapp.tests_common.assert_contains("LIVE-15: respuesta menciona transferencia",text15,"transferencia",counters);
  return counters;
}

// --------------------------------------------------------------------------
// LIVE — multiturno (con historial)
// --------------------------------------------------------------------------
map tests_chat_intent.run_live_multiturn(map counters)
{
  info "=== LIVE MULTITURNO (6 casos, con historial) ===";
  // M1 — completar tracking tras clarify
  histM1 = List();
  m = Map();
  m.put("role","user");
  m.put("content","rastrea mi paquete");
  histM1.add(m);
  m = Map();
  m.put("role","ai");
  m.put("content","¿Cuál es el número de seguimiento?");
  histM1.add(m);
  info "LIVE-M1 prompt: ABC123456 con historial clarify previo";
  rM1 = thisapp.chat_intent.chat_intent("ABC123456",histM1);
  info "LIVE-M1 result: " + rM1.toString();
  counters = thisapp.tests_common.assert_equals("LIVE-M1: kind",rM1.get("kind"),"tool",counters);
  counters = thisapp.tests_common.assert_equals("LIVE-M1: tool",rM1.get("tool"),"track_package",counters);
  // M2 — anáfora destino Barcelona tras Madrid
  histM2 = List();
  m = Map();
  m.put("role","user");
  m.put("content","qué servicios hay a Madrid");
  histM2.add(m);
  m = Map();
  m.put("role","ai");
  m.put("content","Servicios disponibles: ... Madrid ...");
  histM2.add(m);
  info "LIVE-M2 prompt: ¿y a Barcelona? con historial Madrid";
  rM2 = thisapp.chat_intent.chat_intent("¿y a Barcelona?",histM2);
  info "LIVE-M2 result: " + rM2.toString();
  counters = thisapp.tests_common.assert_equals("LIVE-M2: tool",rM2.get("tool"),"search_services",counters);
  // M3 — cambio de tool con referencia "allí"
  histM3 = List();
  m = Map();
  m.put("role","user");
  m.put("content","servicios de remesa a Colombia");
  histM3.add(m);
  m = Map();
  m.put("role","ai");
  m.put("content","Servicios de remesa disponibles para Colombia ...");
  histM3.add(m);
  info "LIVE-M3 prompt: ¿y qué oficinas tienen allí? con historial Colombia";
  rM3 = thisapp.chat_intent.chat_intent("¿y qué oficinas tienen allí?",histM3);
  info "LIVE-M3 result: " + rM3.toString();
  counters = thisapp.tests_common.assert_equals("LIVE-M3: tool",rM3.get("tool"),"find_offices",counters);
  // M4 — corrección segundo intento con teléfono
  histM4 = List();
  m = Map();
  m.put("role","user");
  m.put("content","busca contacto Juan Pérez");
  histM4.add(m);
  m = Map();
  m.put("role","ai");
  m.put("content","No encontré contactos con esos datos.");
  histM4.add(m);
  info "LIVE-M4 prompt: prueba con teléfono 5551234 con historial Juan Pérez";
  rM4 = thisapp.chat_intent.chat_intent("prueba con teléfono 5551234",histM4);
  info "LIVE-M4 result: " + rM4.toString();
  counters = thisapp.tests_common.assert_equals("LIVE-M4: tool",rM4.get("tool"),"find_contacts",counters);
  // M5 — historial irrelevante no contamina
  histM5 = List();
  m = Map();
  m.put("role","user");
  m.put("content","hola");
  histM5.add(m);
  m = Map();
  m.put("role","ai");
  m.put("content","¡Hola! ¿En qué puedo ayudarte?");
  histM5.add(m);
  info "LIVE-M5 prompt: rastrea paquete XYZ999 con historial saludo";
  rM5 = thisapp.chat_intent.chat_intent("rastrea paquete XYZ999",histM5);
  info "LIVE-M5 result: " + rM5.toString();
  counters = thisapp.tests_common.assert_equals("LIVE-M5: tool",rM5.get("tool"),"track_package",counters);
  // M6 — historial largo 4 turnos
  histM6 = List();
  m = Map();
  m.put("role","user");
  m.put("content","servicios a Madrid");
  histM6.add(m);
  m = Map();
  m.put("role","ai");
  m.put("content","Servicios a Madrid: ...");
  histM6.add(m);
  m = Map();
  m.put("role","user");
  m.put("content","oficinas en Miami");
  histM6.add(m);
  m = Map();
  m.put("role","ai");
  m.put("content","Oficinas en Miami: ...");
  histM6.add(m);
  info "LIVE-M6 prompt: ¿quiénes son top clientes remesa? con historial 4 turnos";
  rM6 = thisapp.chat_intent.chat_intent("¿quiénes son top clientes remesa?",histM6);
  info "LIVE-M6 result: " + rM6.toString();
  counters = thisapp.tests_common.assert_equals("LIVE-M6: tool",rM6.get("tool"),"report_top_remittance_customers",counters);
  return counters;
}

// --------------------------------------------------------------------------
// UNIT — normalize_category (Task 3.11) — mock sin Zia
// Valida que normalize_zia_response reconoce la key "category" y devuelve
// {status:ok, kind:category, category:<value>} para los 5 enums válidos.
// --------------------------------------------------------------------------
map tests_chat_intent.run_unit_normalize_category(map counters)
{
  categories = {"SEARCH","TRACKING","TOP_CUSTOMERS","PACKAGE_ANALYSIS","OTHER_ANALYSIS"};
  for each  cat in categories
  {
    resp = Map();
    resp.put("status",true);
    resp.put("data","{\"category\":\"" + cat + "\"}");
    result = thisapp.chat_intent.normalize_zia_response(resp);
    counters = thisapp.tests_common.assert_equals("normalize_category " + cat + ": status ok",result.get("status"),"ok",counters);
    counters = thisapp.tests_common.assert_equals("normalize_category " + cat + ": kind",result.get("kind"),"category",counters);
    counters = thisapp.tests_common.assert_equals("normalize_category " + cat + ": category",result.get("category"),cat,counters);
  }
  // answer → kind answer
  respA = Map();
  respA.put("status",true);
  respA.put("data","{\"answer\":\"Hola\"}");
  resA = thisapp.chat_intent.normalize_zia_response(respA);
  counters = thisapp.tests_common.assert_equals("normalize_category answer: kind",resA.get("kind"),"answer",counters);
  // clarify → kind clarify
  respC = Map();
  respC.put("status",true);
  respC.put("data","{\"clarify\":\"¿Qué necesitas?\"}");
  resC = thisapp.chat_intent.normalize_zia_response(respC);
  counters = thisapp.tests_common.assert_equals("normalize_category clarify: kind",resC.get("kind"),"clarify",counters);
  // null → kind clarify + texto genérico
  resN = thisapp.chat_intent.normalize_zia_response(null);
  counters = thisapp.tests_common.assert_equals("normalize_category null: kind",resN.get("kind"),"clarify",counters);
  counters = thisapp.tests_common.assert_contains("normalize_category null: texto genérico",resN.get("text"),"No pude interpretar",counters);
  info "run_unit_normalize_category done — passed: " + counters.get("passed") + " failed: " + counters.get("failed");
  return counters;
}

// --------------------------------------------------------------------------
// UNIT — resolve_period — fecha conocida 2025-03-15
// Valida que chat_common.resolve_period devuelve las ventanas correctas
// para cada enum sobre una fecha fija (endDate = 2025-03-15).
// --------------------------------------------------------------------------
map tests_chat_intent.run_unit_resolve_period(map counters)
{
  endDate = zoho.date(year:2025,month:3,day:15);
  info "resolve_period endDate: " + endDate.toString();
  // ultimo_mes: startDate = endDate - 30 = 2025-02-13
  r1 = thisapp.chat_common.resolve_period("ultimo_mes",endDate);
  counters = thisapp.tests_common.assert_equals("resolve_period ultimo_mes start",r1.get(0).toString(),zoho.date(year:2025,month:2,day:13).toString(),counters);
  counters = thisapp.tests_common.assert_equals("resolve_period ultimo_mes end",r1.get(1).toString(),endDate.toString(),counters);
  // mes_anterior: startDate = 2025-02-01, endDate = 2025-02-28
  r2 = thisapp.chat_common.resolve_period("mes_anterior",endDate);
  counters = thisapp.tests_common.assert_equals("resolve_period mes_anterior start",r2.get(0).toString(),zoho.date(year:2025,month:2,day:1).toString(),counters);
  counters = thisapp.tests_common.assert_equals("resolve_period mes_anterior end",r2.get(1).toString(),zoho.date(year:2025,month:2,day:28).toString(),counters);
  // este_mes: startDate = 2025-03-01, endDate = 2025-03-15
  r3 = thisapp.chat_common.resolve_period("este_mes",endDate);
  counters = thisapp.tests_common.assert_equals("resolve_period este_mes start",r3.get(0).toString(),zoho.date(year:2025,month:3,day:1).toString(),counters);
  counters = thisapp.tests_common.assert_equals("resolve_period este_mes end",r3.get(1).toString(),endDate.toString(),counters);
  // ultimos_7_dias: startDate = 2025-03-08, endDate = 2025-03-15
  r4 = thisapp.chat_common.resolve_period("ultimos_7_dias",endDate);
  counters = thisapp.tests_common.assert_equals("resolve_period ultimos_7_dias start",r4.get(0).toString(),zoho.date(year:2025,month:3,day:8).toString(),counters);
  counters = thisapp.tests_common.assert_equals("resolve_period ultimos_7_dias end",r4.get(1).toString(),endDate.toString(),counters);
  // default (desconocido): same as ultimo_mes
  r5 = thisapp.chat_common.resolve_period("periodo_inventado",endDate);
  counters = thisapp.tests_common.assert_equals("resolve_period default start",r5.get(0).toString(),zoho.date(year:2025,month:2,day:13).toString(),counters);
  counters = thisapp.tests_common.assert_equals("resolve_period default end",r5.get(1).toString(),endDate.toString(),counters);
  info "run_unit_resolve_period done — passed: " + counters.get("passed") + " failed: " + counters.get("failed");
  return counters;
}

// --------------------------------------------------------------------------
// UNIT — normalize_tool + normalize_params (mock sin Zia)
// validate normalize_tool: valid tool in category OK, tool outside category → clarify.
// validate normalize_params: required absent → clarify, optional absent → omitted,
// period returned as enum string (NOT date).
// --------------------------------------------------------------------------
map tests_chat_intent.run_unit_normalize_tool_params(map counters)
{
  // FORMAS INTERNAS (bare): normalize_tool devuelve {"tool","params"} | {"clarify"} |
  //   {"status":"error","kind":"clarify","text"}; normalize_params devuelve
  //   {"kind":"tool","tool","params"} | {"clarify"} | {"status":"error","kind":"clarify","text"}.
  // La fachada chat_intent() re-envuelve al contrato externo {status,kind,...}.
  // --- normalize_tool: valid tool in TRACKING category ---
  respToolOk = Map();
  respToolOk.put("status",true);
  respToolOk.put("data","{\"tool\":\"track_package\"}");
  rToolOk = thisapp.chat_intent.normalize_tool(respToolOk,"TRACKING");
  counters = thisapp.tests_common.assert_equals("normalize_tool valid: tool","track_package",rToolOk.get("tool"),counters);
  toolOkHasTool = rToolOk.containKey("tool");
  counters = thisapp.tests_common.assert_true("normalize_tool valid: has tool key",toolOkHasTool == true,counters,"resp=" + rToolOk.toString());
  // --- normalize_tool: tool outside category → clarify (status error + kind clarify) ---
  respToolBad = Map();
  respToolBad.put("status",true);
  respToolBad.put("data","{\"tool\":\"find_offices\"}");
  rToolBad = thisapp.chat_intent.normalize_tool(respToolBad,"TRACKING");
  counters = thisapp.tests_common.assert_equals("normalize_tool wrong cat: kind clarify","clarify",rToolBad.get("kind"),counters);
  // --- normalize_params: Zia devuelve clarify y normalize lo pasa (bare {"clarify"}) ---
  // normalize_params también valida requireds determinísticamente (no solo vía Prompt 3).
  respNoReq = Map();
  respNoReq.put("status",true);
  respNoReq.put("data","{\"clarify\":\"Necesito el número de seguimiento para rastrear tu paquete.\"}");
  rNoReq = thisapp.chat_intent.normalize_params(respNoReq,"track_package");
  noReqHasClarify = rNoReq.containKey("clarify");
  counters = thisapp.tests_common.assert_true("normalize_params missing required: has clarify key",noReqHasClarify == true,counters,"resp=" + rNoReq.toString());
  counters = thisapp.tests_common.assert_contains("normalize_params missing required: mention number",rNoReq.get("clarify"),"seguimiento",counters);
  // --- normalize_params: Zia ignora el contrato y devuelve params vacíos → clarify determinista ---
  respEmptyParams = Map();
  respEmptyParams.put("status",true);
  respEmptyParams.put("data","{\"params\":{}}");
  rEmptyParams = thisapp.chat_intent.normalize_params(respEmptyParams,"track_package");
  emptyHasClarify = rEmptyParams.containKey("clarify");
  counters = thisapp.tests_common.assert_true("normalize_params params empty track_package: clarify",emptyHasClarify == true,counters,"params vacío debe ser clarify determinista, no tool; resp=" + rEmptyParams.toString());
  // --- normalize_params: report_top_customers sin serviceType / serviceType no-lista → clarify ---
  respTopNoST = Map();
  respTopNoST.put("status",true);
  respTopNoST.put("data","{\"params\":{\"limit\":\"10\"}}");
  rTopNoST = thisapp.chat_intent.normalize_params(respTopNoST,"report_top_customers");
  topNoSTHasClarify = rTopNoST.containKey("clarify");
  counters = thisapp.tests_common.assert_true("normalize_params top_customers missing serviceType: clarify",topNoSTHasClarify == true,counters,"resp=" + rTopNoST.toString());
  respTopStrST = Map();
  respTopStrST.put("status",true);
  respTopStrST.put("data","{\"params\":{\"serviceType\":\"Locker\"}}");
  rTopStrST = thisapp.chat_intent.normalize_params(respTopStrST,"report_top_customers");
  topStrSTHasClarify = rTopStrST.containKey("clarify");
  counters = thisapp.tests_common.assert_true("normalize_params top_customers serviceType string: clarify",topStrSTHasClarify == true,counters,"serviceType string no es lista ≥1; resp=" + rTopStrST.toString());
  // --- normalize_params: report_top_customers con List válida → tool ---
  respTopListST = Map();
  respTopListST.put("status",true);
  respTopListST.put("data","{\"params\":{\"serviceType\":[\"Locker\"],\"limit\":\"10\"}}");
  rTopListST = thisapp.chat_intent.normalize_params(respTopListST,"report_top_customers");
  counters = thisapp.tests_common.assert_equals("normalize_params top_customers list valid: kind tool","tool",rTopListST.get("kind"),counters);
  // --- normalize_params: find_offices without city → params OK, city absent ---
  respNoOpt = Map();
  respNoOpt.put("status",true);
  respNoOpt.put("data","{\"params\":{\"country\":\"USA\"}}");
  rNoOpt = thisapp.chat_intent.normalize_params(respNoOpt,"find_offices");
  pNoOpt = rNoOpt.get("params");
  counters = thisapp.tests_common.assert_equals("normalize_params optional absent: country present",pNoOpt.get("country"),"USA",counters);
  cityKey = false;
  try { cityKey = pNoOpt.containKey("city"); } catch (e) {}
  counters = thisapp.tests_common.assert_true("normalize_params optional absent: city absent",cityKey == false,counters,"params=" + pNoOpt.toString());
  // --- normalize_params: period enum preserved, NOT converted to date ---
  respPeriod = Map();
  respPeriod.put("status",true);
  respPeriod.put("data","{\"params\":{\"period\":\"ultimo_mes\"}}");
  rPeriod = thisapp.chat_intent.normalize_params(respPeriod,"report_pounds_shipped");
  pPeriod = rPeriod.get("params");
  counters = thisapp.tests_common.assert_equals("normalize_params period: kind tool",rPeriod.get("kind"),"tool",counters);
  counters = thisapp.tests_common.assert_equals("normalize_params period: enum string preserved",pPeriod.get("period"),"ultimo_mes",counters);
  hasSD = false;
  try { hasSD = pPeriod.containKey("startDate"); } catch (e) {}
  counters = thisapp.tests_common.assert_true("normalize_params period: startDate exists (resolve_period applied)",hasSD == true,counters,"params=" + pPeriod.toString());
  hasED = false;
  try { hasED = pPeriod.containKey("endDate"); } catch (e) {}
  counters = thisapp.tests_common.assert_true("normalize_params period: endDate exists",hasED == true,counters,"params=" + pPeriod.toString());
  info "run_unit_normalize_tool_params done — passed: " + counters.get("passed") + " failed: " + counters.get("failed");
  return counters;
}

// --------------------------------------------------------------------------
// LIVE — hierarchical routing (10 frases del proposal)
// Usa chat_intent(prompt, List()) y valida que el pipeline 3 etapas
// produce el tool correcto o (out-of-scope) answer/clarify.
// --------------------------------------------------------------------------
map tests_chat_intent.hier_assert_tool(string caseId, string prompt, string expectedTool, string expectedParamKey, map counters)
{
  info "HIER " + caseId + " prompt: " + prompt;
  r = thisapp.chat_intent.chat_intent(prompt,List());
  info "HIER " + caseId + " result: " + r.toString();
  // Kind must be tool
  counters = thisapp.tests_common.assert_equals(caseId + ": kind tool",r.get("kind"),"tool",counters);
  counters = thisapp.tests_common.assert_equals(caseId + ": tool",r.get("tool"),expectedTool,counters);
  if(expectedParamKey != null && expectedParamKey != "" && expectedParamKey != "EMPTY_OK")
  {
    params = r.get("params");
    hasKey = false;
    if(params != null)
    {
      try { hasKey = params.containKey(expectedParamKey); } catch (e) {}
    }
    counters = thisapp.tests_common.assert_true(caseId + ": params contains " + expectedParamKey,hasKey == true,counters,"params=" + params.toString());
  }
  return counters;
}
map tests_chat_intent.run_live_hierarchical(map counters)
{
  info "=== LIVE HIERARCHICAL (10 cases, 5 cats + 3 ambiguous + 2 out-of-scope) ===";
  // SEARCH → find_offices
  counters = thisapp.tests_chat_intent.hier_assert_tool("HIER-01 find_offices","Dónde tienen oficina en Miami","find_offices","city",counters);
  // SEARCH → check_coverage
  counters = thisapp.tests_chat_intent.hier_assert_tool("HIER-02 check_coverage","cobertura en Cuba","check_coverage","country",counters);
  // TRACKING → track_package
  counters = thisapp.tests_chat_intent.hier_assert_tool("HIER-03 track_package","rastrear P-123456","track_package","trackingNumber",counters);
  // TOP_CUSTOMERS → report_top_package_customers
  counters = thisapp.tests_chat_intent.hier_assert_tool("HIER-04 top_package_customers","clientes más frecuentes de paquetería","report_top_package_customers","EMPTY_OK",counters);
  // OTHER_ANALYSIS → report_unscanned_packages
  counters = thisapp.tests_chat_intent.hier_assert_tool("HIER-05 unscanned_packages","cajas sin escanear","report_unscanned_packages","EMPTY_OK",counters);
  // TOP_CUSTOMERS → report_top_remittance_customers
  counters = thisapp.tests_chat_intent.hier_assert_tool("HIER-06 top_remittance","clientes con más remesas","report_top_remittance_customers","EMPTY_OK",counters);
  // OTHER_ANALYSIS → report_shipping_type_frequency
  counters = thisapp.tests_chat_intent.hier_assert_tool("HIER-07 shipping_frequency","frecuencia de envíos aéreos","report_shipping_type_frequency","EMPTY_OK",counters);
  // PACKAGE_ANALYSIS → report_pounds_shipped (Zia may return period or startDate)
  info "HIER-08 pounds_shipped prompt: libras enviadas en marzo";
  r8 = thisapp.chat_intent.chat_intent("libras enviadas en marzo",List());
  info "HIER-08 result: " + r8.toString();
  pass8 = false;
  try { pass8 = r8.get("kind") == "tool" && r8.get("tool") == "report_pounds_shipped"; } catch (e) { pass8 = false; }
  counters = thisapp.tests_common.assert_true("HIER-08: tool report_pounds_shipped for 'libras en marzo'",pass8 == true,counters,"kind=" + r8.get("kind") + " tool=" + r8.get("tool"));
  // For pounds_shipped Zia may return period enum, explicit startDate, OR omit both
  // (prompt rule: concrete month≠previous → omit period, system defaults to 30 days)
  p8 = null;
  try { p8 = r8.get("params"); } catch (e) {}
  hasPeriodOrDate8 = true;
  if(p8 != null)
  {
    hasPeriodOrDate8 = false;
    try { if(p8.containKey("period") || p8.containKey("startDate")) { hasPeriodOrDate8 = true; } } catch (e) {}
  }
  counters = thisapp.tests_common.assert_true("HIER-08: params period enum o startDate (o vacío=default 30d)",hasPeriodOrDate8 == true,counters,"params=" + p8);
  // PACKAGE_ANALYSIS → report_monthly_comparison
  counters = thisapp.tests_chat_intent.hier_assert_tool("HIER-09 monthly_comparison","comparación mensual de libras","report_monthly_comparison","EMPTY_OK",counters);
  // Out-of-scope → answer or clarify (NOT tool)
  info "HIER-10 out-of-scope prompt: ¿qué es Bitcoin?";
  r10 = thisapp.chat_intent.chat_intent("¿qué es Bitcoin?",List());
  info "HIER-10 result: " + r10.toString();
  pass10 = false;
  try { pass10 = r10.get("kind") != "tool"; } catch (e) { pass10 = false; }
  counters = thisapp.tests_common.assert_true("HIER-10: answer/clarify for 'Bitcoin' (out-of-scope)",pass10 == true,counters,"kind=" + r10.get("kind") + " tool=" + r10.get("tool"));
  info "=== LIVE HIERARCHICAL done — passed: " + counters.get("passed") + " failed: " + counters.get("failed");
  return counters;
}

// --------------------------------------------------------------------------
// SMOKE — tests_intent_hierarchical
// Suite manual con los 10 casos + medición de latencia.
// Inspirado en tests_report_top_customers.run().
// --------------------------------------------------------------------------
map tests_intent_hierarchical.run_smoke()
{
  counters = Map();
  counters.put("passed",0);
  counters.put("failed",0);
  startTime = zoho.currenttime;
  info "=== SMOKE hierarchical-intent-routing (" + startTime + ") ===";
  // SEARCH: find_offices
  counters = thisapp.tests_chat_intent.hier_assert_tool("S-01","Dónde tienen oficina en Miami","find_offices","city",counters);
  // SEARCH: check_coverage
  counters = thisapp.tests_chat_intent.hier_assert_tool("S-02","cobertura en Cuba","check_coverage","country",counters);
  // TRACKING: track_package
  counters = thisapp.tests_chat_intent.hier_assert_tool("S-03","rastrear P-123456","track_package","trackingNumber",counters);
  // TOP_CUSTOMERS: report_top_package_customers
  counters = thisapp.tests_chat_intent.hier_assert_tool("S-04","clientes más frecuentes de paquetería","report_top_package_customers","EMPTY_OK",counters);
  // OTHER_ANALYSIS: report_unscanned_packages
  counters = thisapp.tests_chat_intent.hier_assert_tool("S-05","cajas sin escanear","report_unscanned_packages","EMPTY_OK",counters);
  // TOP_CUSTOMERS: report_top_remittance_customers
  counters = thisapp.tests_chat_intent.hier_assert_tool("S-06","clientes con más remesas","report_top_remittance_customers","EMPTY_OK",counters);
  // OTHER_ANALYSIS: report_shipping_type_frequency
  counters = thisapp.tests_chat_intent.hier_assert_tool("S-07","frecuencia de envíos aéreos","report_shipping_type_frequency","EMPTY_OK",counters);
  // PACKAGE_ANALYSIS: report_pounds_shipped
  info "S-08 prompt: libras enviadas en marzo";
  r8 = thisapp.chat_intent.chat_intent("libras enviadas en marzo",List());
  info "S-08 result: " + r8.toString();
  pass8 = false;
  try { pass8 = r8.get("kind") == "tool" && r8.get("tool") == "report_pounds_shipped"; } catch (e) { pass8 = false; }
  counters = thisapp.tests_common.assert_true("S-08: report_pounds_shipped",pass8 == true,counters,"kind=" + r8.get("kind") + " tool=" + r8.get("tool"));
  p8 = null;
  try { p8 = r8.get("params"); } catch (e) {}
  hasPeriodOrDate8 = true;
  if(p8 != null)
  {
    hasPeriodOrDate8 = false;
    try { if(p8.containKey("period") || p8.containKey("startDate")) { hasPeriodOrDate8 = true; } } catch (e) {}
  }
  counters = thisapp.tests_common.assert_true("S-08: params period enum o startDate (o vacío=default 30d)",hasPeriodOrDate8 == true,counters,"params=" + p8);
  // PACKAGE_ANALYSIS: report_monthly_comparison
  counters = thisapp.tests_chat_intent.hier_assert_tool("S-09","comparación mensual de libras","report_monthly_comparison","EMPTY_OK",counters);
  // Out-of-scope
  info "S-10 prompt: ¿qué es Bitcoin?";
  r10 = thisapp.chat_intent.chat_intent("¿qué es Bitcoin?",List());
  info "S-10 result: " + r10.toString();
  pass10 = false;
  try { pass10 = r10.get("kind") != "tool"; } catch (e) { pass10 = false; }
  counters = thisapp.tests_common.assert_true("S-10: answer/clarify for 'Bitcoin'",pass10 == true,counters,"kind=" + r10.get("kind") + " tool=" + r10.get("tool"));
  endTime = zoho.currenttime;
  info "=== SMOKE done (" + endTime + ") — passed: " + counters.get("passed") + " failed: " + counters.get("failed") + " ===";
  info "Total time: " + endTime + " — " + counters.get("passed") + " passed, " + counters.get("failed") + " failed";
  return counters;
}

// --------------------------------------------------------------------------
// Orquestadores
// --------------------------------------------------------------------------
map tests_chat_intent.run_unit()
{
  counters = Map();
  counters.put("passed",0);
  counters.put("failed",0);
  info "=== UNIT: build_intent_prompt ===";
  counters = thisapp.tests_chat_intent.test_build_prompt_no_history(counters);
  counters = thisapp.tests_chat_intent.test_build_prompt_empty_history(counters);
  counters = thisapp.tests_chat_intent.test_build_prompt_with_history(counters);
  counters = thisapp.tests_chat_intent.test_build_prompt_catalog_in_prompt(counters);
  info "=== UNIT: normalize_zia_response (legacy) ===";
  counters = thisapp.tests_chat_intent.test_normalize_null(counters);
  counters = thisapp.tests_chat_intent.test_normalize_error_status(counters);
  counters = thisapp.tests_chat_intent.test_normalize_tool_ok(counters);
  counters = thisapp.tests_chat_intent.test_normalize_tool_null_params(counters);
  counters = thisapp.tests_chat_intent.test_normalize_track_package_missing_number(counters);
  counters = thisapp.tests_chat_intent.test_normalize_answer(counters);
  counters = thisapp.tests_chat_intent.test_normalize_clarify(counters);
  counters = thisapp.tests_chat_intent.test_normalize_parse_error(counters);
  counters = thisapp.tests_chat_intent.test_normalize_unknown_key(counters);
  counters = thisapp.tests_chat_intent.test_normalize_markdown_fence(counters);
  counters = thisapp.tests_chat_intent.test_normalize_noise_wrapped(counters);
  info "=== UNIT: normalize_category (3.11) ===";
  counters = thisapp.tests_chat_intent.run_unit_normalize_category(counters);
  info "=== UNIT: resolve_period ===";
  counters = thisapp.tests_chat_intent.run_unit_resolve_period(counters);
  info "=== UNIT: normalize_tool + normalize_params ===";
  counters = thisapp.tests_chat_intent.run_unit_normalize_tool_params(counters);
  info "UNIT done — passed: " + counters.get("passed") + " failed: " + counters.get("failed");
  return counters;
}
map tests_chat_intent.run_all()
{
  counters = thisapp.tests_chat_intent.run_unit();
  // Live requiere Zia habilitada; si falla, quedará como error/clarify y se verá en logs
  info "=== LIVE (requiere Zia habilitada) ===";
  counters = thisapp.tests_chat_intent.run_live_first_turn(counters);
  counters = thisapp.tests_chat_intent.run_live_multiturn(counters);
  info "=== RESUMEN TOTAL ===";
  info "passed: " + counters.get("passed") + " failed: " + counters.get("failed");
  if(counters.get("failed") == 0)
  {
    info "ALL TESTS PASSED";
  }
  else
  {
    info "SOME TESTS FAILED — revisar logs arriba";
  }
  return counters;
}
