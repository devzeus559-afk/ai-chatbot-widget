int chat_data_access.insert_chat_message(map data)
{
  // --------------------------------------------------------------------------
  // Insert helpers — devuelven el ID numérico del registro creado
  // --------------------------------------------------------------------------
  config = thisapp.chat_config.chat_config();
  newId = insert into ChatMessages
  [
  Session=data.get("Session")
  Role=data.get("Role")
  Content=data.get("Content")
  Created_Time=zoho.currenttime
  Added_User=zoho.loginuser
  ];
  return newId;
}
int chat_data_access.insert_chat_session(map data)
{
  // --------------------------------------------------------------------------
  // Insert helpers — devuelven el ID numérico del registro creado
  // --------------------------------------------------------------------------
  employee_record = Employee[User == data.get("User")];
  if(employee_record != null)
  {
    userId = employee_record.ID;
    newId = insert into ChatSessions
    [
    Session_ID=data.get("Session_ID")
    Title=data.get("Title")
    User=userId
    Last_Activity=data.get("Last_Activity")
    Added_User=zoho.loginuser
    ];
    return newId;
  }
  else
  {
    return 1;
  }
}
// --------------------------------------------------------------------------
// Capa de REPORTES (métricas 2-11). Todas usan acceso nativo; las cohortes
// se traen acotadas a 200 (range 0-199) con count-first y, si el conteo
// supera 200, la tool marca truncated: true (ranking aproximado).
// --------------------------------------------------------------------------
int chat_data_access.fetch_office_id_by_name(string officeName)
{
  // Buscar oficina por nombre base (primer substring antes de la primera coma).
  // Los nombres en Office_Name tienen formato: "Nombre, Ciudad, País, País"
  // Ej: "Elizabeth, New Jersey,United States, United States" -> nombre base "Elizabeth"
  // Evita colisiones como "New York" vs "West New York".
  if(officeName == null || officeName == "")
  {
    return 0;
  }
  // Normalizar input: tomar solo la parte antes de la primera coma si la hay
  inputBase = officeName;
  commaIdx = officeName.indexOf(",");
  if(commaIdx > 0)
  {
    inputBase = officeName.substring(0, commaIdx).trim();
  }
  // Buscar todos los registros y comparar por nombre base
  records = Commercial_Office[Office_Name != ""] range from 0 to 199;
  if(records == null || records.size() == 0)
  {
    return 0;
  }
  for each  rec in records
  {
    fullName = rec.Office_Name;
    if(fullName == null || fullName == "")
    {
      continue;
    }
    recBase = fullName;
    commaIdx = fullName.indexOf(",");
    if(commaIdx > 0)
    {
      recBase = fullName.substring(0, commaIdx).trim();
    }
    if(recBase == inputBase)
    {
      return rec.ID;
    }
  }
  return 0;
}
list chat_data_access.materialize_service_report(list records)
{
  resultList = List();
  if(records == null)
  {
    return resultList;
  }
  for each  r in records
  {
    item = Map();
    item.put("serviceType",r.Service_Type);
    item.put("zid",r.ID);
    item.put("customerId",r.Sender_field);
    item.put("date",r.Date_field1);
    amount = r.Amount;
    if(amount == null)
    {
      amount = 0;
    }
    item.put("amount",amount);
    weight = 0;
    if(r.Total_Weight != null)
    {
      weight = r.Total_Weight;
    }
    item.put("totalWeight",weight);
    officeName = "";
    if(r.Office != null)
    {
      OfficeRec = Commercial_Office[ID == r.Office];
      if(OfficeRec != null && OfficeRec.Office_Name != null)
      {
        officeName = OfficeRec.Office_Name;
      }
    }
    item.put("officeName",officeName);
    resultList.add(item);
  }
  return resultList;
}
list chat_data_access.fetch_services_report_by_date_window(date startDate, date endDate)
{
  records = Service[Date_field1 >= startDate && Date_field1 <= endDate] sort by Date_field1 range from 0 to 199;
  return thisapp.chat_data_access.materialize_service_report(records);
}
list chat_data_access.fetch_services_report_by_ids(list ids)
{
  records = Service[ID in ids] sort by Date_field1 range from 0 to 199;
  return thisapp.chat_data_access.materialize_service_report(records);
}
list chat_data_access.materialize_package_report(list records)
{
  resultList = List();
  if(records == null)
  {
    return resultList;
  }
  for each  r in records
  {
    item = Map();
    item.put("zid",r.ID);
    item.put("packageId",r.Package_ID);
    item.put("packageType",r.Package_Type);
    item.put("receiptDate",r.Receipt_Date);
    weight = r.Total_Weight;
    if(weight == null)
    {
      weight = 0;
    }
    item.put("totalWeight",weight);
    officeName = "";
    item.put("officeZid",r.Office);
    if(r.Office != null)
    {
      OfficeRec = Commercial_Office[ID == r.Office];
      if(OfficeRec != null && OfficeRec.Office_Name != null)
      {
        officeName = OfficeRec.Office_Name;
      }
    }
    item.put("officeName",officeName);
    // Shipment_Type -> Shipment (nombre Short_Name, clase air/maritime,
    // tipo de mercancía). Clasificación aéreo por Short_Name.contains("Air"),
    // convención del dashboard de la app.
    shipmentZid = r.Shipment_Type;
    item.put("shipmentZid",shipmentZid);
    shipmentName = "";
    className = "";
    merchType = "";
    if(shipmentZid != null)
    {
      ShipmentRec = Shipment[ID == shipmentZid];
      if(ShipmentRec != null)
      {
        if(ShipmentRec.Short_Name != null)
        {
          shipmentName = "" + ShipmentRec.Short_Name;
        }
        if(shipmentName != null && shipmentName.contains("Air"))
        {
          className = "air";
        }
        else
        {
          className = "maritime";
        }
        merchType = ShipmentRec.Type_of_Merchandise;
      }
    }
    item.put("shipmentName",shipmentName);
    item.put("className",className);
    item.put("merchType",merchType);
    resultList.add(item);
  }
  return resultList;
}
list chat_data_access.fetch_packages_report_by_window_office(date startDate, date endDate, int officeZid)
{
  records = null;
  if(officeZid == null || officeZid <= 0)
  {
    records = Package[Receipt_Date >= startDate && Receipt_Date <= endDate] sort by Receipt_Date desc range from 0 to 199;
  }
  else
  {
    records = Package[Receipt_Date >= startDate && Receipt_Date <= endDate && Office == officeZid] sort by Receipt_Date desc range from 0 to 199;
  }
  return thisapp.chat_data_access.materialize_package_report(records);
}
list chat_data_access.materialize_pkg_tracking_report(list records)
{
  resultList = List();
  if(records == null)
  {
    return resultList;
  }
  for each  r in records
  {
    item = Map();
    item.put("zid",r.ID);
    item.put("description",r.Description);
    item.put("latestStatus",r.Latest_Status);
    item.put("scanDate",r.Scan_Date);
    item.put("lastUpdated",r.Last_Updated);
    item.put("lastSync",r.Last_Sync);
    item.put("scanned",r.Scanned);
    // Package_ID picklist->Package: resolver el texto Package.Package_ID
    packageIdText = "";
    packageStatus = "";
    if(r.Package_ID != null)
    {
      PackageRec = Package[ID == r.Package_ID];
      if(PackageRec != null && PackageRec.Package_ID != null)
      {
        packageIdText = "" + PackageRec.Package_ID;
      }
      if(PackageRec != null && PackageRec.Status != null)
      {
        packageStatus = "" + PackageRec.Status;
      }
    }
    item.put("packageId",packageIdText);
    item.put("packageStatus",packageStatus);
    // destino: Package.Location -> Coverage_Location.Address_Information1.country
    destCountry = "";
    if(r.Package_ID != null)
    {
      PackageRec = Package[ID == r.Package_ID];
      if(PackageRec != null && PackageRec.Location != null)
      {
        LocationRec = Coverage_Location[ID == PackageRec.Location];
        if(LocationRec != null && LocationRec.Address_Information1 != null)
        {
          destCountry = LocationRec.Address_Information1.country;
        }
      }
    }
    item.put("destCountry",destCountry);
    // office
    officeName = "";
    item.put("officeZid",r.Office);
    if(r.Office != null)
    {
      OfficeRec = Commercial_Office[ID == r.Office];
      if(OfficeRec != null && OfficeRec.Office_Name != null)
      {
        officeName = OfficeRec.Office_Name;
      }
    }
    item.put("officeName",officeName);
    // Shipping_Type -> Shipment (nombre Short_Name, clase air/maritime)
    shipZid = r.Shipping_Type;
    item.put("shippingTypeZid",shipZid);
    shipmentName = "";
    className = "";
    if(shipZid != null)
    {
      ShipmentRec = Shipment[ID == shipZid];
      if(ShipmentRec != null && ShipmentRec.Short_Name != null)
      {
        shipmentName = "" + ShipmentRec.Short_Name;
      }
      if(shipmentName != null && shipmentName.contains("Air"))
      {
        className = "air";
      }
      else
      {
        className = "maritime";
      }
    }
    item.put("shippingTypeName",shipmentName);
    item.put("className",className);
    resultList.add(item);
  }
  return resultList;
}
list chat_data_access.fetch_pkg_tracking_scanned_all()
{
  records = Pkg_Tracking[Scanned == true] sort by ID range from 0 to 999;
  return thisapp.chat_data_access.materialize_pkg_tracking_report(records);
}
list chat_data_access.fetch_pkg_tracking_unscanned()
{
  records = Pkg_Tracking[Scanned == false] sort by ID range from 0 to 999;
  return thisapp.chat_data_access.materialize_pkg_tracking_report(records);
}
int chat_data_access.insert_unanswered_query(map data)
{
  config = thisapp.chat_config.chat_config();
  newId = insert into ChatUnansweredQueries
  [
  Prompt_Text=data.get("Prompt_Text")
  Timestamp=zoho.currenttime
  Session_ID=data.get("Session_ID")
  Status="pending"
  Notes=data.get("Notes")
  Added_User=zoho.loginuser
  ];
  return newId;
}