int chat_data_access.fetch_services_count_by_date_window(date startDate, date endDate)
{
  count = Service[Date_field1 >= startDate && Date_field1 <= endDate].count(ID);
  if(count == null)
  {
    return 0;
  }
  return count;
}
list chat_data_access.fetch_services_ids_by_date_window(date startDate, date endDate)
{
  ids = Service[Date_field1 >= startDate && Date_field1 <= endDate].ID.getAll();
  return ids;
}
list chat_data_access.fetch_services_ids_by_destination(string destination)
{
	// Cascada geográfica: país -> provincia -> ciudad (broad a specific).
	// País/provincia viven en Service.Location -> Coverage_Location
	// (Address_Information1), campo que SIEMPRE se llena en Service.
	location_country_ids = Coverage_Location[Address_Information1.country == destination].distinct(ID);
	location_province_ids = Coverage_Location[Address_Information1.state_province == destination].distinct(ID);
	if(location_country_ids.size() > 0)
	{
		ids = Service[Location in location_country_ids].distinct(ID);
	}
	else if(location_province_ids.size() > 0)
	{
		ids = Service[Location in location_province_ids].distinct(ID);
	}
	else
	{
		// Ciudad destino: fuentes COMPLEMENTARIAS según tipo de servicio, unión
		// de ambas. Service.City solo se llena cuando el tipo NO es Package
		// Receipt; en Package Receipt la ciudad vive en el Package asociado
		// (Package.Service picklist). Los duplicados de la unión los absorbe
		// el operador IN del fetch final (Service[ID in ids]).
		ids = Service[City == destination].distinct(ID);
		package_service_ids = Package[City == destination].distinct(Service);
		if(package_service_ids != null && package_service_ids.size() > 0)
		{
			ids.addAll(package_service_ids);
		}
	}
	if(ids == null || ids.size() == 0)
	{
		return List();
	}
	return ids;
}
list chat_data_access.fetch_services_ids_by_type(string serviceType)
{
  ids = Service[Service_Type == serviceType].ID.getAll();
  return ids;
}
list chat_data_access.fetch_services_ids_by_office(int officeZid)
{
  // Filtra servicios por oficina (lookup Office en módulo Service).
  // Usa campo literal Office (lookup a Commercial_Office).
  if(officeZid == null || officeZid <= 0)
  {
    return List();
  }
  ids = Service[Office == officeZid].ID.getAll();
  return ids;
}
list chat_data_access.fetch_services_ids_by_type_and_destination(string serviceType, string destination)
{
  // Combina filtro por tipo de servicio + ciudad destino.
  // typeIDs = Service[Service_Type == serviceType]
  // destIDs = fetch_services_ids_by_destination(destination)
  // Retorna intersección (AND).
  typeIDs = thisapp.chat_data_access.fetch_services_ids_by_type(serviceType);
  destIDs = thisapp.chat_data_access.fetch_services_ids_by_destination(destination);
  if(typeIDs == null || typeIDs.size() == 0 || destIDs == null || destIDs.size() == 0)
  {
    return List();
  }
  return typeIDs.intersect(destIDs);
}
