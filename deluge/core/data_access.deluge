// --------------------------------------------------------------------------
// Contacts — IDs por condición + fetch final por IDs + sin filtro (límite 50)
// --------------------------------------------------------------------------
List fetch_contacts_ids_by_full_name(String fullName)
{
    config = chat_config();
    ids = Contacts[Full_Name == fullName].ID.getAll();
    return ids;
}

List fetch_contacts_ids_by_phone(String phone)
{
    config = chat_config();
    ids = Contacts[Phone == phone].ID.getAll();
    return ids;
}

List fetch_contacts_ids_by_document(String document)
{
    config = chat_config();
    ids = Contacts[Document_Number == document].ID.getAll();
    return ids;
}

List fetch_contacts_by_ids(List ids)
{
    config = chat_config();
    records = Contacts[ID in ids] sort by Full_Name range from 0 to 49;
    return records;
}

List fetch_contacts_all()
{
    config = chat_config();
    records = Contacts[ID != 0] sort by Full_Name range from 0 to 49;
    return records;
}
