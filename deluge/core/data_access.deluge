int chat_data_access.insert_chat_message(map data)
{
  // --------------------------------------------------------------------------
  // Insert helpers — devuelven el ID numérico del registro creado
  // --------------------------------------------------------------------------
  config = thisapp.chat_config.chat_config();
  newId = insert into ChatMessages
  [
  Session=data.get("Session")
  Role=data.get("Role")
  Content=data.get("Content")
  Created_Time=zoho.currenttime
  Added_User=zoho.loginuser
  ];
  return newId;
}
int chat_data_access.insert_chat_session(map data)
{
  // --------------------------------------------------------------------------
  // Insert helpers — devuelven el ID numérico del registro creado
  // --------------------------------------------------------------------------
  employee_record = Employee[User == data.get("User")];
  if(employee_record != null)
  {
    userId = employee_record.ID;
    newId = insert into ChatSessions
    [
    Session_ID=data.get("Session_ID")
    Title=data.get("Title")
    User=userId
    Last_Activity=data.get("Last_Activity")
    Added_User=zoho.loginuser
    ];
    return newId;
  }
  else
  {
    return 1;
  }
}
// --------------------------------------------------------------------------
// Capa de REPORTES (métricas 2-11). Todas usan acceso nativo; las cohortes
// se traen acotadas a 200 (range 0-199) con count-first y, si el conteo
// supera 200, la tool marca truncated: true (ranking aproximado).
// --------------------------------------------------------------------------
int chat_data_access.fetch_office_id_by_name(string officeName)
{
  // Buscar oficina por nombre base (primer substring antes de la primera coma).
  // Los nombres en Office_Name tienen formato: "Nombre, Ciudad, País, País"
  // Ej: "Elizabeth, New Jersey,United States, United States" -> nombre base "Elizabeth"
  // Evita colisiones como "New York" vs "West New York".
  if(officeName == null || officeName == "")
  {
    return 0;
  }
  // Normalizar input: tomar solo la parte antes de la primera coma si la hay
  inputBase = officeName;
  commaIdx = officeName.indexOf(",");
  if(commaIdx > 0)
  {
    inputBase = officeName.substring(0, commaIdx).trim();
  }
  // Buscar todos los registros y comparar por nombre base
  records = Commercial_Office[Office_Name != ""] range from 0 to 199;
  if(records == null || records.count(ID) == 0)
  {
    return 0;
  }
  for each  rec in records
  {
    fullName = rec.Office_Name;
    if(fullName == null || fullName == "")
    {
      continue;
    }
    recBase = fullName;
    commaIdx = fullName.indexOf(",");
    if(commaIdx > 0)
    {
      recBase = fullName.substring(0, commaIdx).trim();
    }
    if(recBase == inputBase)
    {
      return rec.ID;
    }
  }
  return 0;
}
list chat_data_access.materialize_service_report(Service records, map officeById)
{
   resultList = List();
   if(records == null)
   {
      return resultList;
   }
   for each  r in records
   {
      item = Map();
      item.put("serviceType",r.Service_Type);
      item.put("zid",r.ID);
      item.put("customerId",r.Sender_field);
      item.put("date",r.Date_field1);
      amount = r.Amount;
      if(amount == null)
      {
         amount = 0;
      }
      item.put("amount",amount);
      weight = 0;
      if(r.Total_Weight != null)
      {
         weight = r.Total_Weight;
      }
      item.put("totalWeight",weight);
      officeName = "";
      if(r.Office != null && officeById != null)
      {
         cachedName = officeById.get(r.Office);
         if(cachedName != null)
         {
            officeName = cachedName;
         }
      }
      item.put("officeName",officeName);
      resultList.add(item);
   }
   return resultList;
}

list chat_data_access.fetch_services_report_by_date_window(date startDate, date endDate)
{
   records = Service[Date_field1 >= startDate && Date_field1 <= endDate] sort by Date_field1 range from 0 to 199;
   refs = thisapp.chat_data_access.prefetch_service_refs();
   return thisapp.chat_data_access.materialize_service_report(records, refs.get("office"));
}

list chat_data_access.fetch_services_report_by_ids(list ids)
{
   records = Service[ID in ids] sort by Service_ID range from 0 to 199;
   refs = thisapp.chat_data_access.prefetch_service_refs();
   return thisapp.chat_data_access.materialize_service_report(records, refs.get("office"));
}

map chat_data_access.prefetch_office_names()
{
  // La app tiene 3 Commercial_Office. Una sola query + Map en memoria reemplaza
  // N sub-queries Commercial_Office[ID == ...]. Se guarda el Office_Name COMPLETO
  // (con la dirección embebida) porque es lo que produce hoy el reporte y así el
  // output no cambia respecto de la versión con N+1.
  nameById = Map();
  offices = Commercial_Office[ID != 0] sort by ID range from 0 to 199;
  for each  o in offices
  {
    if(o.Office_Name != null)
    {
      nameById.put(o.ID,o.Office_Name);
    }
  }
  return nameById;
}
map chat_data_access.prefetch_shipment_info()
{
   // La app tiene 230 Shipment, que SUPERA el tope de 200 registros por query de
   // Creator: traerlos en una sola llamada truncaría en silencio y perdería 30.
   // Por eso se parte explícitamente en dos lotes (0-199 y 200-399).
   //
   // Clasificación aéreo/maritime por Short_Name.contains("Air"), convención del
   // dashboard de la app. Se precalcula la clase acá para no repetir el contains()
   // por cada paquete.
   infoById = Map();
   firstBatch = Shipment[ID != 0] sort by ID range from 0 to 199;
   for each  s in firstBatch
   {
     infoById.put(s.ID,thisapp.chat_data_access.shipment_info(s));
   }
   secondBatch = Shipment[ID != 0] sort by ID range from 200 to 399;
   for each  s in secondBatch
   {
     infoById.put(s.ID,thisapp.chat_data_access.shipment_info(s));
   }
   return infoById;
 }

// ------------------------------------------------------------
// Helper: populate a package batch (no while, reusable logic)
// ------------------------------------------------------------
void chat_data_access._populate_pkg_batch(int start, int end, map pkgById)
{
   batch = Package[ID != 0] sort by ID range from start to end;
   for each  p in batch
   {
      if(p.ID != null)
      {
         pkgInfo = Map();
         if(p.Package_ID != null) { pkgInfo.put("packageId",""+p.Package_ID); }
         if(p.Status != null) { pkgInfo.put("status",""+p.Status); }
         if(p.Location != null) { pkgInfo.put("location",p.Location); }
         pkgById.put(p.ID,pkgInfo);
      }
   }
}

// ------------------------------------------------------------
// prefetch_service_refs: un solo lugar para los mapas de referencia
// (office, vendor, location, shipment, pkg) que resuelven en memoria
// los lookups de los reportes de servicios, paquetes y tracking.
// ------------------------------------------------------------
map chat_data_access.prefetch_service_refs()
{
   // Office map – already implemented in prefetch_office_names()
   officeById = thisapp.chat_data_access.prefetch_office_names();
   // Vendor map – only need Vendor_Name
   vendorById = Map();
   vendors = Vendor[ID != 0] sort by ID range from 0 to 199;
   for each  v in vendors
   {
      if(v.Vendor_Name != null)
      {
         vendorById.put(v.ID,v.Vendor_Name);
      }
   }
   // Location map – Coverage_Location → country
   locationById = Map();
   locations = Coverage_Location[ID != 0] sort by ID range from 0 to 199;
   for each  loc in locations
   {
      if(loc.Address_Information1 != null && loc.Address_Information1.country != null)
      {
         locationById.put(loc.ID,loc.Address_Information1.country);
      }
   }
   // Shipment map – reuse existing prefetch_shipment_info()
   shipmentById = thisapp.chat_data_access.prefetch_shipment_info();
    // Package map – use reusable batch helper
    pkgById = Map();
    thisapp.chat_data_access._populate_pkg_batch(0,   199, pkgById);
    thisapp.chat_data_access._populate_pkg_batch(200, 399, pkgById);
    thisapp.chat_data_access._populate_pkg_batch(400, 599, pkgById);
    thisapp.chat_data_access._populate_pkg_batch(600, 799, pkgById);
    thisapp.chat_data_access._populate_pkg_batch(800, 999, pkgById);

   return {"office":officeById, "vendor":vendorById, "location":locationById, "shipment":shipmentById, "pkg":pkgById};
}


map chat_data_access.shipment_info(Shipment shipment)
{
  // Clasificación aéreo/maritime por Short_Name.contains("Air"), convención del
  // dashboard de la app. Se precalcula la clase acá para no repetir el contains()
  // por cada paquete.
  info = Map();
  shortName = "";
  if(shipment.Short_Name != null)
  {
    shortName = "" + shipment.Short_Name;
  }
  if(shortName.contains("Air"))
  {
    info.put("class","air");
  }
  else
  {
    info.put("class","maritime");
  }
  info.put("name",shortName);
  info.put("merch",shipment.Type_of_Merchandise);
  return info;
}
list chat_data_access.materialize_package_report(Package records, map officeNameById, map shipmentInfoById)
{
  // Sin N+1: las tablas de catálogo entran precargadas como Maps y se resuelven
  // en memoria. Antes cada registro disparaba Commercial_Office[ID == ...] +
  // Shipment[ID == ...]: con 5000 paquetes eso eran 10.000 sub-queries contra un
  // timeout de 40s. Ahora son 3 queries totales por invocación.
  resultList = List();
  if(records == null)
  {
    return resultList;
  }
  for each  r in records
  {
    item = Map();
    item.put("zid",r.ID);
    item.put("packageId",r.Package_ID);
    item.put("packageType",r.Package_Type);
    item.put("receiptDate",r.Receipt_Date);
    weight = r.Total_Weight;
    if(weight == null)
    {
      weight = 0;
    }
    item.put("totalWeight",weight);
    item.put("officeZid",r.Office);
    officeName = "";
    if(r.Office != null && officeNameById != null)
    {
      cachedName = officeNameById.get(r.Office);
      if(cachedName != null)
      {
        officeName = cachedName;
      }
    }
    item.put("officeName",officeName);
    // Shipment_Type -> Shipment. Sin Shipment_Type (o sin registro que lo
    // resuelva) la clase queda "" — se preserva el comportamiento previo, donde
    // esas ramas nunca entraban al if y la variable arrancaba en "".
    shipmentZid = r.Shipment_Type;
    item.put("shipmentZid",shipmentZid);
    shipmentName = "";
    className = "";
    merchType = "";
    if(shipmentZid != null && shipmentInfoById != null)
    {
      shipmentInfo = shipmentInfoById.get(shipmentZid);
      if(shipmentInfo != null)
      {
        className = shipmentInfo.get("class");
        shipmentName = shipmentInfo.get("name");
        merchType = shipmentInfo.get("merch");
      }
    }
    item.put("shipmentName",shipmentName);
    item.put("className",className);
    item.put("merchType",merchType);
    resultList.add(item);
  }
  return resultList;
}
boolean chat_data_access.report_scan_truncated(list records, boolean fullFlag)
{
  // Única fuente de verdad para el flag `truncated` de los report tools.
  //
  // - Cohorte acotada (full = false): siempre incompleta, la cohorte es de 200
  //   y no se recorre el resto.
  // - Recorrido completo (full = true): solo puede estar incompleto si agotó
  //   maxBatches con un lote COMPLETO de 200. Si el último lote hubiera tenido
  //   menos de 200, el recorrido terminó solo (break) y los datos están
  //   completos. El tope dura es maxBatches * 200 = 25 * 200 = 5000.
  if(!fullFlag)
  {
    return true;
  }
  if(records == null)
  {
    return false;
  }
  return records.size() >= 5000;
}
list chat_data_access.fetch_packages_report_by_window_office(date startDate, date endDate, int officeZid)
{
  // --------------------------------------------------------------------------
  // Cohorte ACOTADA a 200 registros (range 0-199). Es el path de vista rápida:
  // si la ventana tiene más de 200 paquetes el ranking es aproximado y el tool
  // lo señala con truncated. Devuelve el MISMO contrato que la variante full:
  // lista de mapas ya materializados (nunca registros crudos de Package).
  // --------------------------------------------------------------------------
  if(officeZid == null || officeZid <= 0)
  {
    records = Package[Receipt_Date >= startDate && Receipt_Date <= endDate] sort by Receipt_Date range from 0 to 199;
  }
  else
  {
    records = Package[Receipt_Date >= startDate && Receipt_Date <= endDate && Office == officeZid] sort by Receipt_Date range from 0 to 199;
  }
  officeNameById = thisapp.chat_data_access.prefetch_office_names();
  shipmentInfoById = thisapp.chat_data_access.prefetch_shipment_info();
  return thisapp.chat_data_access.materialize_package_report(records,officeNameById,shipmentInfoById);
}
list chat_data_access.fetch_all_packages_by_window_office(date startDate, date endDate, int officeZid)
{
  // --------------------------------------------------------------------------
  // Ventana COMPLETA: se recorre en lotes de 200 con cursor sobre ID y se
  // materializa cada lote por separado. Materializar miles de registros de una
  // sola vez puede exceder el timeout de 40s del script.
  //
  // Deluge NO soporta while: se genera una lista contadora con leftpad/toList
  // y se recorre con for each + break. OJO: el for each de elemento exige DOS
  // espacios ("for each  x in y"); con uno solo el live tira Improper Statement
  // en esa misma línea. maxBatches acota el trabajo (25 lotes = 5000 paquetes,
  // cubre la ventana anual observada); si se alcanza el tope el ranking queda
  // incompleto.
  // --------------------------------------------------------------------------
  resultList = List();
  lastId = 0;
  maxBatches = 25;
  // Catálogos precargados UNA vez por invocación y reutilizados en todos los
  // lotes: 3 queries en total, no 3 por lote.
  officeNameById = thisapp.chat_data_access.prefetch_office_names();
  shipmentInfoById = thisapp.chat_data_access.prefetch_shipment_info();
  counter = leftpad("1",maxBatches + 1).replaceAll(" ","1,").toList(",");
  for each  idx in counter
  {
    if(officeZid == null || officeZid <= 0)
    {
      recBatch = Package[Receipt_Date >= startDate && Receipt_Date <= endDate && ID > lastId] sort by ID range from 0 to 199;
    }
    else
    {
      recBatch = Package[Receipt_Date >= startDate && Receipt_Date <= endDate && Office == officeZid && ID > lastId] sort by ID range from 0 to 199;
    }
    // recBatch es colección de registros crudos: usa .count(), NO .size()
    // (.size() es solo para List/Map en memoria).
    if(recBatch == null || recBatch.count() == 0)
    {
      break;
    }
    resultList.addAll(thisapp.chat_data_access.materialize_package_report(recBatch,officeNameById,shipmentInfoById));
    // sort by ID es ascendente: el cursor avanza al mayor ID del lote.
    lastId = recBatch.get(recBatch.count() - 1).get("ID");
    if(recBatch.count() < 200)
    {
      break;
    }
  }
  return resultList;
}
list chat_data_access.materialize_pkg_tracking_report(Pkg_Tracking records, map refs)
{
   resultList = List();
   if(records == null)
   {
      return resultList;
   }
   for each r in records
   {
      item = Map();
      item.put("zid",r.ID);
      item.put("description",r.Description);
      item.put("latestStatus",r.Latest_Status);
      item.put("scanDate",r.Scan_Date);
      item.put("lastUpdated",r.Last_Updated);
      item.put("lastSync",r.Last_Sync);
      item.put("scanned",r.Scanned);
      // Package fields from pre‑fetched map
      packageIdText = "";
      packageStatus = "";
      if(r.Package_ID != null)
      {
         pkgInfo = refs.get("pkg").get(r.Package_ID);
         if(pkgInfo != null)
         {
            packageIdText = pkgInfo.get("packageId");
            packageStatus = pkgInfo.get("status");
         }
      }
      item.put("packageId",packageIdText);
      item.put("packageStatus",packageStatus);
      // Destination country via location map
      destCountry = "";
      if(r.Package_ID != null)
      {
         pkgInfo = refs.get("pkg").get(r.Package_ID);
         if(pkgInfo != null && pkgInfo.get("location") != null)
         {
            locationId = pkgInfo.get("location");
            cached = refs.get("location").get(locationId);
            if(cached != null) { destCountry = cached; }
         }
      }
      item.put("destCountry",destCountry);
      // Office name via map
      officeName = "";
      if(r.Office != null)
      {
         cached = refs.get("office").get(r.Office);
         if(cached != null) { officeName = cached; }
      }
      item.put("officeZid",r.Office);
      if(officeName != "") { item.put("officeName",officeName); }
      // Shipping type via shipment map
      shipZid = r.Shipping_Type;
      item.put("shippingTypeZid",shipZid);
      shipmentName = "";
      className = "";
      if(shipZid != null)
      {
         shipInfo = refs.get("shipment").get(shipZid);
         if(shipInfo != null)
         {
            shipmentName = shipInfo.get("name");
            className = shipInfo.get("class");
         }
      }
      item.put("shippingTypeName",shipmentName);
      item.put("className",className);
      resultList.add(item);
   }
   return resultList;
}

list chat_data_access.fetch_pkg_tracking_scanned_all()
{
  records = Pkg_Tracking[Scanned == true] sort by ID range from 0 to 999;
  refs = thisapp.chat_data_access.prefetch_service_refs();
  return thisapp.chat_data_access.materialize_pkg_tracking_report(records,refs);
}
list chat_data_access.fetch_pkg_tracking_unscanned()
{
  records = Pkg_Tracking[Scanned == false] sort by ID range from 0 to 999;
  refs = thisapp.chat_data_access.prefetch_service_refs();
  return thisapp.chat_data_access.materialize_pkg_tracking_report(records,refs);
}
int chat_data_access.insert_unanswered_query(map data)
{
  config = thisapp.chat_config.chat_config();
  newId = insert into ChatUnansweredQueries
  [
  Prompt_Text=data.get("Prompt_Text")
  Timestamp=zoho.currenttime
  Session_ID=data.get("Session_ID")
  Status="pending"
  Notes=data.get("Notes")
  Added_User=zoho.loginuser
  ];
  return newId;
}