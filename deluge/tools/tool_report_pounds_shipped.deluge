/**
 * tool_report_pounds_shipped.deluge
 *
 * Reporte métrico: libras totales enviadas en un período (Package.Total_Weight),
 * desglosado por oficina (Commercial_Office), por tipo de carga
 * (Package_Type: Box/Bag/Documents) y por clase de envío (air/maritime).
 *
 * Recibe: {"startDate"?: date, "endDate"?: date (default: últimos 30 días),
 *          "office"?: string (Office_Name), "full"?: bool}
 * Devuelve: {"ok": true, "data": {
 *   reportType: "pounds_shipped", periodStart, periodEnd, office (null sin),
 *   totalPounds, totalPackages, truncated,
 *   byOffice: [{name, pounds, count}],
 *   byPackageType: [{name, pounds, count}],
 *   byClass: [{name, pounds, count}]}}
 *
 * Viz: bar de libras por categoría (oficina).
 *
 * PRESUPUESTO DE SENTENCIAS (por qué este tool no materializa):
 * la versión anterior materializaba todos los paquetes y después los agregaba
 * en 3 maps separados: ~70 sentencias por registro contra un techo medido de
 * 40.000. Cualquier cohorte mayor a ~550 paquetes agotaba el presupuesto y la
 * ejecución moría sin persistir el ChatRequest (el usuario veía el cartel de
 * límite). Ahora se usa el agregador streaming de data_access: una sola pasada,
 * un solo map de clave compuesta. El tool solo PARTE ese map en los 3 desgloses,
 * y esa partición corre sobre unas pocas claves (no sobre cada paquete).
 */

map chat_tools.report_pounds_shipped(map params)
{
  config = thisapp.chat_config.chat_config();
  // Período (default últimos 30 días)
  endDate = zoho.currentdate;
  startDate = endDate.subDay(30);
  sd = params.get("startDate");
  if(sd != null && sd != "")
  {
    startDate = toDate("" + sd);
  }
  ed = params.get("endDate");
  if(ed != null && ed != "")
  {
    endDate = toDate("" + ed);
  }
  officeName = params.get("office");
  officeZid = 0;
  reportedOffice = null;
  if(officeName != null && officeName != "")
  {
    officeZid = thisapp.chat_data_access.fetch_office_id_by_name(officeName);
    if(officeZid == null || officeZid <= 0)
    {
      return {"ok":true,"data":{"reportType":"pounds_shipped","empty":true,"message":"Oficina no encontrada."}};
    }
    reportedOffice = officeName;
  }
  // Tope de lotes: completo (calibrado con el techo) o 1 lote para la vista rápida.
  fullFlag = params.get("full");
  if(fullFlag == null)
  {
    fullFlag = true;
  }
  if(fullFlag)
  {
    maxBatches = thisapp.chat_data_access.pounds_scan_batches();
  }
  else
  {
    maxBatches = 1;
  }
  aggResult = thisapp.chat_data_access.aggregate_pounds_by_window_office(startDate,endDate,officeZid,maxBatches);
  agg = aggResult.get("agg");
  totalPounds = aggResult.get("totalPounds");
  totalPackages = aggResult.get("totalPackages");
  truncated = aggResult.get("truncated");
  if(totalPounds == null)
  {
    totalPounds = 0;
  }
  if(totalPackages == null)
  {
    totalPackages = 0;
  }
  // Partición del acumulador único en los 3 desgloses del contrato.
  officeMap = Map();
  pkgTypeMap = Map();
  classMap = Map();
  if(agg != null)
  {
    for each  key in agg.keys()
    {
      e = agg.get(key);
      pounds = e.get("pounds");
      count = e.get("count");
      // --- por oficina ---
      n = e.get("office");
      oe = officeMap.get(n);
      if(oe == null)
      {
        oe = Map();
        oe.put("name",n);
        oe.put("pounds",pounds);
        oe.put("count",count);
        officeMap.put(n,oe);
      }
      else
      {
        oe.put("pounds",oe.get("pounds") + pounds);
        oe.put("count",oe.get("count") + count);
      }
      // --- por tipo de carga ---
      n2 = e.get("packageType");
      te = pkgTypeMap.get(n2);
      if(te == null)
      {
        te = Map();
        te.put("name",n2);
        te.put("pounds",pounds);
        te.put("count",count);
        pkgTypeMap.put(n2,te);
      }
      else
      {
        te.put("pounds",te.get("pounds") + pounds);
        te.put("count",te.get("count") + count);
      }
      // --- por clase de envío ---
      n3 = e.get("className");
      ce = classMap.get(n3);
      if(ce == null)
      {
        ce = Map();
        ce.put("name",n3);
        ce.put("pounds",pounds);
        ce.put("count",count);
        classMap.put(n3,ce);
      }
      else
      {
        ce.put("pounds",ce.get("pounds") + pounds);
        ce.put("count",ce.get("count") + count);
      }
    }
  }
  // Construir listas (ordeno desc por libras para el formato)
  byOffice = thisapp.chat_common.build_breakdown_list(officeMap);
  byPackageType = thisapp.chat_common.build_breakdown_list(pkgTypeMap);
  byClass = thisapp.chat_common.build_breakdown_list(classMap);
  data = Map();
  data.put("reportType","pounds_shipped");
  data.put("periodStart",startDate);
  data.put("periodEnd",endDate);
  data.put("office",reportedOffice);
  data.put("totalPounds",totalPounds);
  data.put("totalPackages",totalPackages);
  data.put("truncated",truncated);
  data.put("byOffice",byOffice);
  data.put("byPackageType",byPackageType);
  data.put("byClass",byClass);
  if(totalPackages == 0)
  {
    return {"ok":true,"data":data,"visualization":null};
  }
  vizLabels = List();
  vizValues = List();
  for each  b in byOffice
  {
    vizLabels.add(b.get("name"));
    vizValues.add(b.get("pounds"));
  }
  vizType = thisapp.chat_common.decidirVisualizacion(vizLabels,false);
  series = List();
  ss = Map();
  ss.put("name","Libras");
  ss.put("values",vizValues);
  series.add(ss);
  viz = thisapp.chat_common.build_viz(vizType,"Libras enviadas por oficina",vizLabels,series);
  return {"ok":true,"data":data,"visualization":viz};
}
