/**
 * tool_offices.deluge
 *
 * Busca oficinas comerciales en el módulo Commercial_Office.
 * Recibe (todos opcionales): {"city", "country"}
 * Devuelve: {"ok": true, "data": [{name, address, city, country, phone, hours}]}
 *
 * Acceso nativo vía data_access (0 llamadas de API de Creator). Patrón ID-list
 * (gate 5.1: Form[criteriaVar] es inválido):
 * - Sin filtros            -> fetch_offices_all()         (Form[ID != 0])
 * - 1+ filtros             -> IDs por condición (.ID.getAll()), addAll en el
 *                             primero e intersect en los siguientes, guard de
 *                             lista vacía y fetch final fetch_offices_by_ids.
 * Límite 200 (range 0-199), orden Office_Name asc.
 */

Map tool_offices(Map params)
{
    config = chat_config();
    fields = config.get("officeFields");

    targetIDs = List();
    hasFilter = false;

    city = params.get("city");
    if (city != null && city != "") {
        ids = fetch_offices_ids_by_city(city);
        targetIDs.addAll(ids);
        hasFilter = true;
    }

    country = params.get("country");
    if (country != null && country != "") {
        ids = fetch_offices_ids_by_country(country);
        if (hasFilter) {
            targetIDs = targetIDs.intersect(ids);
        } else {
            targetIDs.addAll(ids);
            hasFilter = true;
        }
    }

    // Guard: intersección vacía -> data:[] (Form[ID in []] es desconocido en Creator)
    if (!hasFilter) {
        records = fetch_offices_all();
    } else if (targetIDs.size() == 0) {
        records = List();
    } else {
        records = fetch_offices_by_ids(targetIDs);
    }

    resultList = List();
    if (records == null) {
        return {"ok": true, "data": resultList};
    }

    for each o in records {
        item = Map();
        item.put("name", o.get(fields.get("name")));
        item.put("address", o.get(fields.get("address")));
        item.put("city", o.get(fields.get("city")));
        item.put("country", o.get(fields.get("country")));
        item.put("phone", o.get(fields.get("phone")));
        item.put("hours", o.get(fields.get("hours")));
        resultList.add(item);
    }

    return {"ok": true, "data": resultList};
}
