/**
* tool_offices.deluge
*
* Busca oficinas comerciales en Commercial_Office.
* Recibe (todos opcionales): {"city", "country"}
*   NOTA DE ESQUEMA: Commercial_Office no tiene campos top-level City/Country
*   (ni Phone/Business_Hours). Existen como SUBCAMPOS del campo compuesto
*   `Address` (address_line_1, district_city, state_province, postal_Code,
*   country). Por tanto NO hay fetch por ID con condición; se trae todo con
*   fetch_offices_all() y se filtra EN MEMORIA sobre Address.<subfield>.
* Devuelve: {"ok": true, "data": [{name, address, city, country}]}
*
* Acceso nativo vía data_access (0 llamadas de API).
* Límite 200 (range 0-199), orden Office_Name asc.
*/

map chat_tools.find_offices(map params)
{
  targetIDs = List();
  hasFilter = false;
  city = params.get("city");
  if(city != null && city != "")
  {
    ids = thisapp.chat_data_access.fetch_office_ids_by_city(city);
    targetIDs.addAll(ids);
    hasFilter = true;
  }
  country = params.get("country");
  if(country != null && country != "")
  {
    ids = thisapp.chat_data_access.fetch_office_ids_by_country(country);
    if(hasFilter)
    {
      targetIDs = targetIDs.intersect(ids);
    }
    else
    {
      targetIDs.addAll(ids);
      hasFilter = true;
    }
  }
  // Guard: intersección vacía -> data:[] (Form[ID in []] es desconocido en Creator)
  if(!hasFilter)
  {
    records = thisapp.chat_data_access.fetch_offices_all();
  }
  else if(targetIDs.size() == 0)
  {
    records = List();
  }
  else
  {
    records = thisapp.chat_data_access.fetch_offices_by_ids(targetIDs);
  }
  // Prepare the result
  if(records == null)
  {
    return {"ok":true,"data":{}};
  }
  return {"ok":true,"data":records};
}