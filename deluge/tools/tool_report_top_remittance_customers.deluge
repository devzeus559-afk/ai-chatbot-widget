/**
 * tool_report_top_remittance_customers.deluge
 *
 * Reporte métrico: clientes top N por monto total remitido (suma de Amount USD)
 * en servicios de tipo "Remittance", en una ventana de 30 días sobre Date_field1.
 * El módulo Remittance es una tabla de configuración casi vacía -> se usa Service.
 *
 * Recibe: {"limit"?: string|number (default 10)}
 * Devuelve: {"ok": true, "data": {
 *   reportType: "top_remittance_customers", periodStart, periodEnd,
 *   totalServices, totalAmount, totalCustomers, truncated,
 *   customers: [{rank, customerId, customerName, totalAmount,
 *                firstServiceDate}]}}
 *
 * Acceso nativo vía data_access. Identico patrón count-first → fetch ≤200 →
 * agregación por remitente → top-N por inserción → nombres top-N. truncated
 * si el conteo de la ventana supera 200.
 */

map chat_tools.report_top_remittance_customers(map params)
{
  config = thisapp.chat_config.chat_config();
  limitNum = 10;
  limit = params.get("limit");
  if(limit != null && limit != "")
  {
    limitNum = toNumber("" + limit);
    if(limitNum == null || limitNum <= 0)
    {
      limitNum = 10;
    }
  }
  endDate = zoho.currentdate;
  startDate = endDate.subDay(30);
  // Remittances: window ∩ Service_Type == "Remittance"
  windowIDs = thisapp.chat_data_access.fetch_services_ids_by_date_window(startDate,endDate);
  typeIDs = thisapp.chat_data_access.fetch_services_ids_by_type("Remittance");
  if(windowIDs == null || windowIDs.size() == 0 || typeIDs == null || typeIDs.size() == 0)
  {
    return thisapp.chat_common.build_empty_remittance_report(startDate,endDate);
  }
  targetIDs = windowIDs.intersect(typeIDs);
  if(targetIDs == null || targetIDs.size() == 0)
  {
    return thisapp.chat_common.build_empty_remittance_report(startDate,endDate);
  }
  total = targetIDs.size();
  truncated = total > 200;
  records = thisapp.chat_data_access.fetch_services_report_by_ids(targetIDs);
  senderMap = Map();
  if(records == null)
  {
    records = List();
  }
  totalAmount = 0;
  for each  s in records
  {
    senderVal = s.get("customerId");
    if(senderVal == null)
    {
      continue;
    }
    senderStr = "" + senderVal;
    if(senderStr == "")
    {
      continue;
    }
    senderId = toNumber(senderStr);
    if(senderId == null)
    {
      continue;
    }
    key = "" + senderId;
    amt = s.get("amount");
    if(amt == null)
    {
      amt = 0;
    }
    totalAmount = totalAmount + amt;
    serviceDate = s.get("date");
    entry = senderMap.get(key);
    if(entry == null)
    {
      entry = Map();
      entry.put("customerId",senderId);
      entry.put("amount",amt);
      entry.put("firstDate",serviceDate);
      senderMap.put(key,entry);
    }
    else
    {
      entry.put("amount",entry.get("amount") + amt);
      if(serviceDate != null)
      {
        curDate = entry.get("firstDate");
        if(curDate == null || serviceDate < curDate)
        {
          entry.put("firstDate",serviceDate);
        }
      }
    }
  }
  // Top-N por inserción (amount desc; empate => fecha más antigua primero)
  ranking = List();
  for each  key in senderMap.keys()
  {
    entry = senderMap.get(key);
    entryValue = entry.get("amount");
    entryDate = entry.get("firstDate");
    pos = ranking.size();
    for each index i in ranking
    {
      cur = ranking.get(i);
      if(entryValue > cur.get("amount"))
      {
        pos = i;
        break;
      }
      if(entryValue == cur.get("amount"))
      {
        curDate = cur.get("firstDate");
        if(entryDate != null && (curDate == null || entryDate < curDate))
        {
          pos = i;
          break;
        }
      }
    }
    ranking = thisapp.chat_common.insert_ranked_entry(ranking,pos,entry);
    if(ranking.size() > limitNum)
    {
      ranking = ranking.subList(0,limitNum);
    }
  }
  // Nombres top-N
  nameIDs = List();
  for each  e in ranking
  {
    id = e.get("customerId");
    if(nameIDs.indexOf(id) < 0)
    {
      nameIDs.add(id);
    }
  }
  contactsMap = Map();
  if(nameIDs.size() > 0)
  {
    contactRecords = thisapp.chat_data_access.fetch_contacts_by_ids(nameIDs);
    if(contactRecords != null)
    {
      for each  c in contactRecords
      {
        contactsMap.put("" + c.get("id"),c);
      }
    }
  }
  for each index i in ranking
  {
    e = ranking.get(i);
    e.put("rank",i + 1);
    cid = e.get("customerId");
    name = "Unknown";
    cRec = contactsMap.get("" + cid);
    if(cRec != null)
    {
      name = cRec.get("fullName").toUpperCase();
    }
    e.put("customerName",name);
    e.put("totalAmount",e.get("amount"));
    e.put("firstServiceDate",e.get("firstDate"));
    e.remove("amount");
    e.remove("firstDate");
  }
  data = Map();
  data.put("reportType","top_remittance_customers");
  data.put("periodStart",startDate);
  data.put("periodEnd",endDate);
  data.put("totalServices",total);
  data.put("totalAmount",totalAmount);
  data.put("totalCustomers",ranking.size());
  data.put("truncated",truncated);
  data.put("customers",ranking);
  vizLabels = List();
  vizValues = List();
  for each  c in ranking
  {
    vizLabels.add(c.get("customerName"));
    vizValues.add(c.get("totalAmount"));
  }
  vizType = thisapp.chat_common.decidirVisualizacion(vizLabels,false);
  series = List();
  s = Map();
  s.put("name","Monto");
  s.put("values",vizValues);
  series.add(s);
  viz = thisapp.chat_common.build_viz(vizType,"Clientes de remesas más activos",vizLabels,series);
  return {"ok":true,"data":data,"visualization":viz};
}
