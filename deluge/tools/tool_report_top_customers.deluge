/**
* tool_report_top_customers.deluge
*
* Reporte métrico: clientes más frecuentes (top N) por cantidad de servicios
 * en una ventana FIJA de 30 días sobre Date_field1 (fecha de negocio del
 * servicio). serviceType es OBLIGATORIO y debe ser una List<string> con al
 * menos un elemento (coincidencia EXACTA, sensible a mayúsculas; los valores
 * del picklist están enumerados en la descripción del catálogo en
 * chat_config). Este tool cubre SOLO los tipos Locker, Store, Recharge,
 * Online Store y Other Services: paquetería y remesas usan los tools
 * específicos report_top_package_customers / report_top_remittance_customers.
 *
 * Recibe: {"serviceType": List<string> (≥1), "limit"?: string|number (default 10)}
 * Devuelve: {"ok": true, "data": {
 *   reportType: "top_customers", periodStart, periodEnd,
 *   serviceType (string con los tipos unidos por ", "), totalServices,
 *   totalCustomers, truncated, customers: [{rank, customerId, customerName,
 *   totalServices, firstServiceDate, serviceBreakdown}]}}
 * Si serviceType falta, está vacío o no es una lista => {"ok": false,
 * "kind": "clarify", "message": "Debes especificar al menos un tipo de servicio."}
 *
 * Acceso nativo vía data_access (0 llamadas de API de Creator). Algoritmo:
 * unión de IDs por tipo (uno por elemento de serviceType) → intersección con
 * la ventana de 30 días → fetch acotado a 200 (range 0-199) → agregación por
 * remitente (Sender_field; se ignoran los vacíos; IDs normalizados a Number)
 * → top-N por inserción O(n·limit) con desempate por fecha más antigua →
 * resolución de nombres SOLO para el top-N vía fetch_contacts_by_ids. Si la
 * intersección supera 200, el ranking es APROXIMADO (truncated: true) y la
 * reply muestra un aviso.
 *
 * GATE 5.1: todos los criterios usan campos LITERALES con valores variables;
 * el filtro por tipo se combina por ID-list (addAll por tipo + intersect con
 * la ventana), nunca criterios string. List.add() de Deluge solo APPENDEA:
 * la inserción indexada del ranking usa el helper shift-copy
 * insert_ranked_entry (operaciones garantizadas: size/get/add).
 */

map chat_tools.report_top_customers(map params)
{
  // serviceType es OBLIGATORIO y debe ser una List<string> con ≥1 elemento.
  serviceType = params.get("serviceType");
  validTypes = false;
  try
  {
    if(serviceType != null && serviceType.size() > 0 && serviceType.get(0) != null && serviceType.get(0) != "")
    {
      validTypes = true;
    }
  }
  catch(e)
  {
    validTypes = false;
  }
  if(!validTypes)
  {
    return {"ok":false,"kind":"clarify","message":"Debes especificar al menos un tipo de servicio."};
  }
  reportedType = "";
  for each  st in serviceType
  {
    if(reportedType == "")
    {
      reportedType = "" + st;
    }
    else
    {
      reportedType = reportedType + ", " + st;
    }
  }
  // limit: Zia puede enviarlo como string; toNumber + default 10
  limitNum = 10;
  limit = params.get("limit");
  if(limit != null && limit != "")
  {
    limitNum = toNumber("" + limit);
    if(limitNum == null || limitNum <= 0)
    {
      limitNum = 10;
    }
  }
  // --- Nuevos filtros: office, city, period/startDate/endDate ---
  officeName = params.get("office");
  officeZid = 0;
  if(officeName != null && officeName != "")
  {
    officeZid = thisapp.chat_data_access.fetch_office_id_by_name(officeName);
    if(officeZid == null || officeZid <= 0)
    {
      return {"ok":true,"data":{"reportType":"top_customers","empty":true,"message":"Oficina no encontrada."}};
    }
  }
  city = params.get("city");
  // Período: startDate/endDate ya vienen convertidos de normalize_params.
  // Fallback: si no vienen, default 30 días.
  sd = params.get("startDate");
  if(sd != null && sd != "")
  {
    startDate = toDate("" + sd);
  }
  else
  {
    startDate = zoho.currentdate.subDay(30);
  }
  ed = params.get("endDate");
  if(ed != null && ed != "")
  {
    endDate = toDate("" + ed);
  }
  else
  {
    endDate = zoho.currentdate;
  }
  // Unión de IDs por tipo (addAll) → intersección con la ventana.
  windowIDs = thisapp.chat_data_access.fetch_services_ids_by_date_window(startDate,endDate);
  typeIDs = List();
  for each  st in serviceType
  {
    ids = thisapp.chat_data_access.fetch_services_ids_by_type(st);
    if(ids != null)
    {
      typeIDs.addAll(ids);
    }
  }
  // Filtro por oficina (si se especificó)
  if(officeZid > 0)
  {
    officeIDs = thisapp.chat_data_access.fetch_services_ids_by_office(officeZid);
    if(officeIDs != null && officeIDs.size() > 0)
    {
      typeIDs = typeIDs.intersect(officeIDs);
    }
    else
    {
      typeIDs = List();
    }
  }
  // Filtro por ciudad destino (si se especificó)
  if(city != null && city != "")
  {
    cityIDs = thisapp.chat_data_access.fetch_services_ids_by_destination(city);
    if(cityIDs != null && cityIDs.size() > 0)
    {
      typeIDs = typeIDs.intersect(cityIDs);
    }
    else
    {
      typeIDs = List();
    }
  }
  // Guard: Form[ID in []] tiene comportamiento desconocido en Creator
  if(windowIDs == null || windowIDs.size() == 0 || typeIDs == null || typeIDs.size() == 0)
  {
    return thisapp.chat_common.build_empty_report(startDate,endDate,reportedType);
  }
  targetIDs = windowIDs.intersect(typeIDs);
  if(targetIDs == null || targetIDs.size() == 0)
  {
    return thisapp.chat_common.build_empty_report(startDate,endDate,reportedType);
  }
  total = targetIDs.size();
  truncated = total > 200;
  records = thisapp.chat_data_access.fetch_services_by_ids(targetIDs);
    // Agregación por remitente (Map clave = "" + senderId normalizado)
    senderMap = Map();
    if(records == null)
    {
      records = List();
    }
    for each  s in records
    {
      // 		service_record = Service[ID == s];
      senderVal = s.get("customerId");
      // 		senderVal = service_record.Sender_field;
      if(senderVal == null)
      {
        continue;
      }
      senderStr = "" + senderVal;
      if(senderStr == "")
      {
        continue;
      }
      senderId = toNumber(senderStr);
      if(senderId == null)
      {
        continue;
      }
      key = "" + senderId;
      serviceDate = s.get("date");
      st = s.get("serviceType");
      if(st == null || st == "")
      {
        st = "Other";
        // convención zia: tipo vacío cae a "Other"
      }
      entry = senderMap.get(key);
      if(entry == null)
      {
        entry = Map();
        entry.put("customerId",senderId);
        entry.put("count",1);
        entry.put("firstDate",serviceDate);
        breakdown = Map();
        breakdown.put(st,1);
        entry.put("breakdown",breakdown);
        senderMap.put(key,entry);
      }
      else
      {
        entry.put("count",entry.get("count") + 1);
        // Seniority tie-break: conservar la fecha de servicio MÁS antigua
        if(serviceDate != null)
        {
          current = entry.get("firstDate");
          if(current == null || serviceDate < current)
          {
            entry.put("firstDate",serviceDate);
          }
        }
        breakdown = entry.get("breakdown");
        n = breakdown.get(st);
        if(n == null)
        {
          n = 0;
        }
        breakdown.put(st,n + 1);
      }
    }
    // Top-N por inserción O(n·limit): recorre el ranking actual y coloca la
    // entrada en su posición (count desc; empate => fecha más antigua
    // primero); se trunca a limitNum sin ordenar la lista completa.
    ranking = List();
    for each  key in senderMap.keys()
    {
      entry = senderMap.get(key);
      entryCount = entry.get("count");
      entryDate = entry.get("firstDate");
      pos = ranking.size();
      for each index i in ranking
      {
        cur = ranking.get(i);
        if(entryCount > cur.get("count"))
        {
          pos = i;
          break;
        }
        if(entryCount == cur.get("count"))
        {
          curDate = cur.get("firstDate");
          if(entryDate != null && curDate == null || entryDate < curDate)
          {
            pos = i;
            break;
          }
        }
      }
      ranking = thisapp.chat_common.insert_ranked_entry(ranking,pos,entry);
      if(ranking.size() > limitNum)
      {
        ranking = ranking.subList(0,limitNum);
      }
    }
    // Nombres SOLO para el top-N (fetch_contacts_by_ids, ventana 0-49)
    nameIDs = List();
    for each  e in ranking
    {
      id = e.get("customerId");
      if(nameIDs.indexOf(id) < 0)
      {
        nameIDs.add(id);
      }
    }
    contactsMap = Map();
    if(nameIDs.size() > 0)
    {
      contactRecords = thisapp.chat_data_access.fetch_contacts_by_ids(nameIDs);
      if(contactRecords != null)
      {
        for each  c in contactRecords
        {
          contactsMap.put("" + c.get("id"),c);
        }
      }
    }
    // Completar cada entrada del ranking (shape final de data.customers[])
    for each index i in ranking
    {
      e = ranking.get(i);
      e.put("rank",i + 1);
      cid = e.get("customerId");
      name = "Unknown";
      cRec = contactsMap.get("" + cid);
      if(cRec != null)
      {
        name = cRec.get("fullName").toUpperCase();
      }
      e.put("customerName",name);
      b = e.get("breakdown");
      breakdownStr = "";
      if(b != null)
      {
        for each  t in b.keys()
        {
          if(breakdownStr == "")
          {
            breakdownStr = t + ": " + b.get(t);
          }
          else
          {
            breakdownStr = breakdownStr + ", " + t + ": " + b.get(t);
          }
        }
      }
      e.put("serviceBreakdown",breakdownStr);
      e.put("firstServiceDate",e.get("firstDate"));
      e.put("totalServices",e.get("count"));
      e.remove("count");
      e.remove("firstDate");
      e.remove("breakdown");
    }
    data = Map();
    data.put("reportType","top_customers");
    data.put("periodStart",startDate);
    data.put("periodEnd",endDate);
    data.put("serviceType",reportedType);
    if(officeName != null && officeName != "") { data.put("office",officeName); }
    if(city != null && city != "") { data.put("city",city); }
    data.put("totalServices",total);
    data.put("totalCustomers",ranking.size());
    data.put("truncated",truncated);
    data.put("customers",ranking);
    // Visualización: labels = nombres, values = servicios. Decisión determinista.
    vizLabels = List();
    vizValues = List();
    vizTitle = "Clientes más frecuentes (" + reportedType + ")";
    if(officeName != null && officeName != "") { vizTitle = vizTitle + " — " + officeName; }
    if(city != null && city != "") { vizTitle = vizTitle + " — " + city; }
    for each  c in ranking
    {
      vizLabels.add(c.get("customerName"));
      vizValues.add(c.get("totalServices"));
    }
    vizType = thisapp.chat_common.decidirVisualizacion(vizLabels,false);
    series = List();
    s = Map();
    s.put("name","Servicios");
    s.put("values",vizValues);
    series.add(s);
    viz = thisapp.chat_common.build_viz(vizType,vizTitle,vizLabels,series);
    return {"ok":true,"data":data,"visualization":viz};
  }