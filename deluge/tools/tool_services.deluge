/**
 * tool_services.deluge
 *
 * Lista servicios disponibles desde el módulo Service.
 * Recibe (todos opcionales): {"serviceType", "origin", "destination"}
 * Devuelve: {"ok": true, "data": [{name, type, price, currency, description, estimatedTime}]}
 *
 * Acceso nativo vía data_access (0 llamadas de API de Creator). Patrón ID-list
 * (gate 5.1: Form[criteriaVar] es inválido):
 * - Sin filtros            -> fetch_services_all()        (Form[ID != 0])
 * - 1+ filtros             -> IDs por condición (.ID.getAll()), addAll en el
 *                             primero e intersect en los siguientes, guard de
 *                             lista vacía y fetch final fetch_services_by_ids.
 * Límite 200 (range 0-199), orden Service_Name asc.
 */

Map tool_services(Map params)
{
    config = chat_config();
    fields = config.get("serviceFields");

    targetIDs = List();
    hasFilter = false;

    serviceType = params.get("serviceType");
    if (serviceType != null && serviceType != "") {
        ids = fetch_services_ids_by_type(serviceType);
        targetIDs.addAll(ids);
        hasFilter = true;
    }

    origin = params.get("origin");
    if (origin != null && origin != "") {
        ids = fetch_services_ids_by_origin(origin);
        if (hasFilter) {
            targetIDs = targetIDs.intersect(ids);
        } else {
            targetIDs.addAll(ids);
            hasFilter = true;
        }
    }

    destination = params.get("destination");
    if (destination != null && destination != "") {
        ids = fetch_services_ids_by_destination(destination);
        if (hasFilter) {
            targetIDs = targetIDs.intersect(ids);
        } else {
            targetIDs.addAll(ids);
            hasFilter = true;
        }
    }

    // Guard: intersección vacía -> data:[] (Form[ID in []] es desconocido en Creator)
    if (!hasFilter) {
        records = fetch_services_all();
    } else if (targetIDs.size() == 0) {
        records = List();
    } else {
        records = fetch_services_by_ids(targetIDs);
    }

    resultList = List();
    if (records == null) {
        return {"ok": true, "data": resultList};
    }

    for each s in records {
        item = Map();
        item.put("name", s.get(fields.get("name")));
        item.put("type", s.get(fields.get("type")));
        item.put("price", s.get(fields.get("price")));
        item.put("currency", s.get(fields.get("currency")));
        item.put("description", s.get(fields.get("description")));
        item.put("estimatedTime", s.get(fields.get("estimatedTime")));
        resultList.add(item);
    }

    return {"ok": true, "data": resultList};
}
