/**
 * tool_services.deluge
 *
 * Lista servicios disponibles desde el módulo Service.
 * Recibe (todos opcionales): {"serviceType", "origin", "destination"}
 * Devuelve: {"ok": true, "data": [{name, type, price, currency, description, estimatedTime}]}
 *
 * Acceso nativo vía data_access.fetch_services (0 llamadas de API de Creator).
 * Límite 200 (range 0-199), orden Service_Name asc; criterio vacío -> [ID != 0].
 */

Map tool_services(Map params)
{
    config = chat_config();
    fields = config.get("serviceFields");

    criteria = "";

    serviceType = params.get("serviceType");
    if (serviceType != null && serviceType != "") {
        criteria = append_criteria(criteria,
            fields.get("type") + " == '" + serviceType + "'");
    }

    originField = fields.get("origin");
    origin = params.get("origin");
    if (origin != null && origin != "" && originField != null && originField != "") {
        criteria = append_criteria(criteria,
            originField + " == '" + origin + "'");
    }

    destinationField = fields.get("destination");
    destination = params.get("destination");
    if (destination != null && destination != "" && destinationField != null && destinationField != "") {
        criteria = append_criteria(criteria,
            destinationField + " == '" + destination + "'");
    }

    records = fetch_services(criteria);

    resultList = List();
    if (records == null) {
        return {"ok": true, "data": resultList};
    }

    for each s in records {
        item = Map();
        item.put("name", s.get(fields.get("name")));
        item.put("type", s.get(fields.get("type")));
        item.put("price", s.get(fields.get("price")));
        item.put("currency", s.get(fields.get("currency")));
        item.put("description", s.get(fields.get("description")));
        item.put("estimatedTime", s.get(fields.get("estimatedTime")));
        resultList.add(item);
    }

    return {"ok": true, "data": resultList};
}
