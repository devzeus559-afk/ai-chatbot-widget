/**
 * tool_report_merchandise_type.deluge
 *
 * Reporte métrico: distribución de paquetes por tipo de mercancía en un período
 * sobre Package.Receipt_Date. El tipo se lee de Shipment.Type_of_Merchandise vía
 * el Package.Shipment_Type del paquete. Filtro opcional por oficina.
 *
 * Recibe: {"limit"?: string|number (default todos),
 *          "office"?: string (Office_Name de Commercial_Office),
 *          "startDate"?: date|string, "endDate"?: date|string (default: últimos 30 días),
 *          "full"?: boolean (default true; false = cohorte rápida de 200)}
 * Devuelve: {"ok": true, "data": {
 *   reportType: "merchandise_type", periodStart, periodEnd, office,
 *   totalPackages, truncated,
 *   merchandise: [{name, packageCount, sharePct}]}}
 *
 * Viz: bar de paquetes por tipo de mercancía.
 *
 * Las fechas llegan ya resueltas por chat_invoke: Zia emite el enum `period`
 * (ultimo_mes|mes_anterior|este_mes|ultimos_7_dias) y chat_invoke lo traduce a
 * startDate/endDate como string ISO antes del dispatch. Este tool solo lee las
 * fechas; no interpreta el enum.
 *
 * PRESUPUESTO DE SENTENCIAS: ver chat_data_access.aggregate_packages_by_merchandise.
 * La versión anterior materializaba todos los paquetes (~30-34 sentencias por
 * registro) y recién después contaba, así que agotaba el techo de 40.000 sin
 * llegar a degradar con `truncated`. Ahora se usa el agregador streaming.
 */

map chat_tools.report_merchandise_type(map params)
{
  config = thisapp.chat_config.chat_config();
  limitNum = 0;
  limit = params.get("limit");
  if(limit != null && limit != "")
  {
    limitNum = toNumber("" + limit);
    if(limitNum == null || limitNum <= 0)
    {
      limitNum = 0;
    }
  }
  officeName = params.get("office");
  officeZid = 0;
  reportedOffice = null;
  if(officeName != null && officeName != "")
  {
    officeZid = thisapp.chat_data_access.fetch_office_id_by_name(officeName);
    if(officeZid == null || officeZid <= 0)
    {
      return thisapp.chat_common.build_empty_merchandise_report(zoho.currentdate.subDay(30),zoho.currentdate,reportedOffice);
    }
    reportedOffice = officeName;
  }
  // Período (default: últimos 30 días). El parseo es defensivo: una fecha
  // ilegible no debe reventar el script ni mandar null al agregador.
  endDate = zoho.currentdate;
  ed = params.get("endDate");
  if(ed != null && ed != "")
  {
    parsedEnd = toDate("" + ed);
    if(parsedEnd != null)
    {
      endDate = parsedEnd;
    }
  }
  startDate = endDate.subDay(30);
  sd = params.get("startDate");
  if(sd != null && sd != "")
  {
    parsedStart = toDate("" + sd);
    if(parsedStart != null)
    {
      startDate = parsedStart;
    }
  }
  // Tope de lotes: recorrido completo o cohorte rápida de 200.
  fullFlag = params.get("full");
  if(fullFlag == null)
  {
    fullFlag = true;
  }
  if(fullFlag)
  {
    maxBatches = thisapp.chat_data_access.merchandise_scan_batches();
  }
  else
  {
    maxBatches = 1;
  }
  aggResult = thisapp.chat_data_access.aggregate_packages_by_merchandise(startDate,endDate,officeZid,maxBatches);
  counts = aggResult.get("counts");
  names = aggResult.get("names");
  total = aggResult.get("totalPackages");
  if(total == null)
  {
    total = 0;
  }
  // Ranking desc por cantidad (mismo patrón de inserción indexada que el resto).
  ranking = List();
  if(counts != null)
  {
    for each  key in counts.keys()
    {
      entry = Map();
      entry.put("name",names.get(key));
      entry.put("count",counts.get(key));
      pos = ranking.size();
      for each index i in ranking
      {
        cur = ranking.get(i);
        if(entry.get("count") > cur.get("count"))
        {
          pos = i;
          break;
        }
      }
      ranking = thisapp.chat_common.insert_ranked_entry(ranking,pos,entry);
      if(limitNum > 0 && ranking.size() > limitNum)
      {
        ranking = ranking.subList(0,limitNum);
      }
    }
  }
  // Porcentaje de participación + normalización de clave al contrato de salida.
  for each  e in ranking
  {
    share = 0;
    if(total > 0)
    {
      share = toNumber(e.get("count")) * 100.0 / toNumber(total);
      share = round(share,1);
    }
    e.put("sharePct",share);
    e.put("packageCount",e.get("count"));
    e.remove("count");
  }
  data = Map();
  data.put("reportType","merchandise_type");
  data.put("periodStart",startDate);
  data.put("periodEnd",endDate);
  data.put("office",reportedOffice);
  data.put("totalPackages",total);
  data.put("truncated",aggResult.get("truncated"));
  // Etiqueta de período pre-formateada acá (no en el formateador): acá sabemos
  // que startDate/endDate son del tipo date, así que toString(formato) es seguro.
  // Precedente: monthLabel en report_monthly_comparison.
  data.put("periodLabel",startDate.toString("yyyy-MM-dd") + " a " + endDate.toString("yyyy-MM-dd"));
  data.put("merchandise",ranking);
  if(total == 0)
  {
    return thisapp.chat_common.build_empty_merchandise_report(startDate,endDate,reportedOffice);
  }
  vizLabels = List();
  vizValues = List();
  for each  m in ranking
  {
    vizLabels.add(m.get("name"));
    vizValues.add(m.get("packageCount"));
  }
  vizType = thisapp.chat_common.decidirVisualizacion(vizLabels,false);
  series = List();
  ss = Map();
  ss.put("name","Paquetes");
  ss.put("values",vizValues);
  series.add(ss);
  viz = thisapp.chat_common.build_viz(vizType,"Paquetes por tipo de mercancía",vizLabels,series);
  return {"ok":true,"data":data,"visualization":viz};
}
